// ============================================================ RUN ALL (manual)

/**
 * Full sequential rebuild, in dependency order.
 *
 * This previously stopped after the four pulls, so computeMetrics never ran and the
 * Metrics tab stayed stale — which is why the Performance view rendered every KPI as
 * a dash with "no benchmark". A function called rebuildEverything has to mean it.
 *
 * Will likely exceed the 6-minute cap on a first full pull. Run the steps individually
 * the first time, then let the staged triggers handle it nightly.
 */
/**
 * MANUAL FULL REFRESH — everything, in dependency order, resumably.
 *
 * The whole chain is roughly fifteen minutes of work and Apps Script kills an execution
 * at six, so this checkpoints between steps and re-arms itself. Run it once and walk
 * away; watch _refresh_log for REFRESH COMPLETE.
 *
 * The nightly triggers do the same work, each job in its own execution. This exists for
 * when you want everything current NOW without waiting for tonight.
 *
 * ORDER IS NOT ARBITRARY:
 *   directories before everything      — every scope filter reads them
 *   financials/leasing/compliance      — the raw pulls each list is built from
 *   master scope                       — a human decision that gates what is in scope
 *   portfolio                          — address book first, then summaries and rent
 *   utilities, LeadSimple, ShowMojo    — vendor systems, independent of each other
 *   data quality, collections          — derived from the pulls above
 *   throughput                         — must see every list AFTER it is rebuilt
 *   metrics                            — reads everything; itself resumable
 *   dashboard cache LAST               — renders whatever the rest just produced
 */
var REFRESH_PROP_AT = 'REFRESH_STEP_AT';
var REFRESH_PROP_RUN = 'REFRESH_RUN_STAMP';
var REFRESH_PROP_TRIGGER = 'REFRESH_CONTINUATION_ID';

function refreshSteps_() {
  var steps = [
    ['rebuildAll', 'directories — properties, units, owners, tenants, PM groups'],
    ['rebuildFinancials', 'delinquency, receipts, deposits'],
    ['rebuildLeasing', 'applications, renewals, vacancy, lease expirations'],
    ['rebuildCompliance', 'inspections, work orders, tickler'],
    ['rebuildMasterScope', 'scope decisions — gates everything downstream'],
    ['rebuildPortfolio', 'address book, doors, rent timing, rent collection'],
    ['rebuildCollections', 'vendor bills, approvals, owner shortfalls'],
    ['rebuildDataQuality', 'rent vs market, insurance, field audit']
  ];
  if (typeof buildUtilitySchedule === 'function') {
    steps.push(['buildUtilitySchedule', 'utility posting clock']);
  }
  if (typeof rebuildLeadSimple === 'function' && systemEnabled_('leadsimple')) {
    steps.push(['rebuildLeadSimple', 'processes, deals, review, lead-to-move-in']);
  }
  if (typeof rebuildShowMojo === 'function' && systemEnabled_('showmojo')) {
    steps.push(['rebuildShowMojo', 'listings, showings, unit join']);
  }
  if (typeof buildSuppressionRegister === 'function') {
    steps.push(['buildSuppressionRegister', 'what is permanently hidden, and why']);
    steps.push(['buildDataFlagQueue', 'rows the team flagged as wrong']);
  }
  // AFTER every list exists, or it snapshots a half-built picture.
  if (typeof buildThroughput === 'function') {
    steps.push(['rebuildThroughput', 'added versus cleared per list']);
  }
  steps.push(['computeMetrics', 'the metric registry — resumable, may take several passes']);
  steps.push(['rebuildDashboardCache', 'render the page — must be last']);
  return steps;
}

function refreshEverything() {
  var t0 = new Date().getTime();
  var props = PropertiesService.getScriptProperties();

  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) {
    Logger.log('A refresh is already running. Nothing to do.');
    return { skipped_locked: true };
  }
  try {
    return refreshPass_(t0, props);
  } finally {
    try { lock.releaseLock(); } catch (e) {}
  }
}

function refreshPass_(t0, props) {
  var steps = refreshSteps_();
  var at = parseInt(props.getProperty(REFRESH_PROP_AT) || '0', 10) || 0;
  var stamp = props.getProperty(REFRESH_PROP_RUN);
  if (!at || !stamp) { stamp = nowStamp_(); props.setProperty(REFRESH_PROP_RUN, stamp); }

  // 240s, so a step that overruns still leaves room to checkpoint and re-arm.
  var BUDGET_MS = 240000;
  var done = [], i = at;

  for (; i < steps.length; i++) {
    if (new Date().getTime() - t0 > BUDGET_MS) break;

    var name = steps[i][0];
    var fn = null;
    try { fn = eval(name); } catch (e) { fn = null; }
    if (typeof fn !== 'function') {
      done.push(name + ' SKIPPED — not defined in this project');
      continue;
    }

    var s0 = new Date().getTime();
    try {
      var res = fn();
      var secs = Math.round((new Date().getTime() - s0) / 1000);
      // computeMetrics checkpoints internally. If it is not finished, stay on this
      // step rather than moving past it and rendering the cache against a partial set.
      if (res && res.partial) {
        done.push(name + ' PARTIAL (' + secs + 's) — needs another pass');
        break;
      }
      done.push(name + ' OK (' + secs + 's)');
    } catch (e) {
      done.push(name + ' FAILED: ' + e.message.slice(0, 140));
      logError_('refresh', name, e.message);
    }
  }

  var elapsed = new Date().getTime() - t0;

  if (i < steps.length) {
    props.setProperty(REFRESH_PROP_AT, String(i));
    try { refreshScheduleContinuation_(); } catch (e) {
      logError_('refresh', 'continuation',
        'Could not schedule the continuation: ' + e.message + ' — run refreshEverything() again.');
    }
    var left = steps.slice(i).map(function (x) { return x[0]; });
    logRun_('refreshEverything', 'system', '-', done.length, elapsed,
      'PARTIAL — ' + done.length + ' step(s) this pass, ' + left.length + ' to go: ' +
      left.slice(0, 5).join(', ') + (left.length > 5 ? '…' : ''));
    Logger.log(done.join('\n') + '\n\nPARTIAL — ' + left.length + ' step(s) remain: ' +
               left.join(', ') + '\nA continuation runs in about a minute.');
    return { partial: true, completed: done, remaining: left };
  }

  props.deleteProperty(REFRESH_PROP_AT);
  props.deleteProperty(REFRESH_PROP_RUN);
  try { refreshClearContinuation_(); } catch (e) {}

  var failed = done.filter(function (d) { return d.indexOf('FAILED') > -1; });
  logRun_('refreshEverything', 'system', '-', steps.length, elapsed,
    'REFRESH COMPLETE — ' + steps.length + ' step(s)' +
    (failed.length ? ' · ' + failed.length + ' FAILED' : ' · none failed'));
  Logger.log(done.join('\n') + '\n\nREFRESH COMPLETE.' +
    (failed.length ? '\n' + failed.length + ' step(s) failed — see _errors.' : ''));
  return { complete: true, steps: done, failed: failed.length };
}

function refreshScheduleContinuation_() {
  refreshClearContinuation_();
  var t = ScriptApp.newTrigger('refreshEverything').timeBased().after(60 * 1000).create();
  try {
    PropertiesService.getScriptProperties().setProperty(REFRESH_PROP_TRIGGER, t.getUniqueId());
  } catch (e) {}
}

/** By id, never by handler name — the nightly triggers share these handlers. */
function refreshClearContinuation_() {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty(REFRESH_PROP_TRIGGER);
  if (!id) return;
  ScriptApp.getProjectTriggers().forEach(function (t) {
    try { if (t.getUniqueId() === id) ScriptApp.deleteTrigger(t); } catch (e) {}
  });
  props.deleteProperty(REFRESH_PROP_TRIGGER);
}

/** Where is the refresh up to? */
function refreshStatus() {
  var props = PropertiesService.getScriptProperties();
  var at = props.getProperty(REFRESH_PROP_AT);
  var steps = refreshSteps_();
  if (at === null || at === undefined) {
    Logger.log('No refresh in progress. ' + steps.length + ' steps would run.');
    return 'idle';
  }
  var n = parseInt(at, 10) || 0;
  var out = ['Refresh in progress, started ' + props.getProperty(REFRESH_PROP_RUN),
             'Next step: ' + (steps[n] ? steps[n][0] : '(end)') + '  (' + n + ' of ' + steps.length + ')',
             '', 'Remaining:'];
  steps.slice(n).forEach(function (x) { out.push('  ' + x[0] + ' — ' + x[1]); });
  Logger.log(out.join('\n'));
  return out.join('\n');
}

/** Abandon a stuck refresh. */
function resetRefresh() {
  var props = PropertiesService.getScriptProperties();
  props.deleteProperty(REFRESH_PROP_AT);
  props.deleteProperty(REFRESH_PROP_RUN);
  try { refreshClearContinuation_(); } catch (e) {}
  Logger.log('Refresh checkpoint cleared. refreshEverything() will start from the top.');
  return 'reset';
}

/** Old name, kept so anything already pointing at it still works. */
function rebuildEverything() { return refreshEverything(); }

/**
 * What is actually installed, against what installTriggers would create.
 *
 * Triggers are the one part of this project that lives outside the code, so the code
 * cannot tell you they are right — it can only tell you what it expected.
 */
function verifyTriggers() {
  var live = ScriptApp.getProjectTriggers().filter(function (t) {
    return t.getEventType() === ScriptApp.EventType.CLOCK;
  });
  var liveNames = {};
  live.forEach(function (t) {
    var h = t.getHandlerFunction();
    liveNames[h] = (liveNames[h] || 0) + 1;
  });

  var expected = expectedTriggers_();
  var out = ['INSTALLED: ' + live.length + ' clock trigger(s)', ''];

  out.push('--- EXPECTED ---');
  var missing = [];
  expected.forEach(function (e) {
    var have = liveNames[e.fn] || 0;
    var defined = false;
    try { defined = typeof eval(e.fn) === 'function'; } catch (x) {}
    out.push('  ' + String(e.h).padStart(2, '0') + ':' + String(e.m).padStart(2, '0') +
             '  ' + e.fn.padEnd(26) +
             (e.dayOfMonth ? 'monthly/' + e.dayOfMonth + 'th ' : 'daily      ') +
             (have ? 'installed' : 'MISSING') +
             (defined ? '' : '   <-- function not defined!'));
    if (!have) missing.push(e.fn);
  });

  out.push('');
  out.push('--- INSTALLED BUT NOT EXPECTED ---');
  var expNames = {};
  expected.forEach(function (e) { expNames[e.fn] = 1; });
  var extra = Object.keys(liveNames).filter(function (n) { return !expNames[n]; });
  if (!extra.length) out.push('  none');
  extra.forEach(function (n) {
    var why = (n === 'computeMetrics' || n === 'refreshEverything' ||
               n === 'lsSeedProcesses' || n === 'lsSeedCompletedTasks')
      ? '  (a one-off continuation — normal while a resumable job is mid-flight)'
      : '  (left over from an earlier version — installTriggers() clears these)';
    out.push('  ' + n + ' x' + liveNames[n] + why);
  });

  var dupes = Object.keys(liveNames).filter(function (n) { return liveNames[n] > 1; });
  if (dupes.length) {
    out.push('');
    out.push('--- DUPLICATES (a job running twice a night) ---');
    dupes.forEach(function (n) { out.push('  ' + n + ' x' + liveNames[n]); });
    out.push('  Run installTriggers() to reset them.');
  }

  out.push('');
  out.push(missing.length
    ? missing.length + ' trigger(s) missing. Run installTriggers().'
    : 'Every expected trigger is installed.');
  out.push('NOTE: installTriggers() deletes ALL triggers first. Never run it while a');
  out.push('seed or a resumable job is mid-flight — it kills the continuation.');

  var text = out.join('\n');
  Logger.log(text);
  return text;
}
