        note: 'Renewal_Pipeline is empty. Run buildRenewalPipeline(), or wait for ' +
              'rebuildCompliance tonight.' });
    }
    function n(st) {
      return rows.filter(function (r) { return r.inspection_status === st; }).length;
    }
    var onTime = n('DONE ON TIME');
    var measurable = rows.filter(function (r) {
      return r.inspection_status !== 'NO RENEWAL DATE' &&
             r.inspection_status !== 'NOT YET DUE';
    }).length;
    if (!measurable) {
