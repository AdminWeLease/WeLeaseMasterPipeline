/**
 * WeLease Pipeline — COMPUTE LAYER  v1.0.0 · 2026-08-05
 * Requires Core_v2.gs and Jobs.gs. Reads the tabs the jobs wrote — never re-pulls the API.
 *
 * computeMetrics() walks the registry, runs the matching calculation, and writes one
 * row per metric per period to Metrics, appending the same rows to Metrics_History
 * so trends accumulate.
 *
 * Every result carries numerator, denominator, and n. A rate without a denominator
 * is not publishable, and this layer will not emit one.
 */

// ============================================================ SHEET READER

// _tabCache moved to Core_v2.gs, beside readTab_ which owns it.
// Two `var _tabCache = {}` declarations in one global scope would reset the cache
// depending on file load order, so this must NOT be reinstated here.



/** Lazy data context — each tab is read at most once per run. */
function dataContext_() {
  var cache = {};
  function get(tab) {
    if (!(tab in cache)) cache[tab] = readTab_(tab);
    return cache[tab];
  }
  return {
    units:      function () { return get('Unit_Directory'); },
    occ:        function () { return get('Occupancy_Summary'); },
    rentRoll:   function () { return get('Rent_Roll'); },
    delinq:     function () { return get('Delinquency_Aged'); },
    unpaid:     function () { return get('Unpaid_Charges'); },
    wo:         function () { return get('Work_Orders'); },
    tickler:    function () { return get('Tenant_Tickler'); },
    renewals:   function () { return get('Renewals'); },
    apps:       function () { return get('Applications'); },
    vacancy:    function () { return get('Unit_Vacancy'); },
    inspections:function () { return get('Inspections'); },
    groups:     function () { return get('PM_Groups'); }
  };
}

// ============================================================ RESULT SHAPE

function res_(value, numerator, denominator, n, extra) {
  var o = { value: value, numerator: numerator, denominator: denominator, n: n };
  if (extra) for (var k in extra) o[k] = extra[k];
  return o;
}

/** Monthly series from dated rows. fn receives the rows for one month. */
function monthly_(rows, dateField, fn) {
  var g = groupBy_(rows, function (r) { return monthKey_(r[dateField]); });
  return Object.keys(g).sort().map(function (m) {
    var out = fn(g[m]);
    out.period = m;
    return out;
  });
}

// ============================================================ CALCULATIONS

var MAKE_READY_NOTE = 'Make Ready is NOT separable from Turnover in the current AppFolio ' +
  'configuration — work_order_type has one turn value ("Unit Turn") and unit_turn_category ' +
  'has one non-null value. This is the same population as turnover_speed. Separating them ' +
  'requires a new work order type or populated turn categories in AppFolio.';

/**
 * Completed tasks inside the reporting window.
 *
 * The seed backfills five years because the step-duration metrics need history to find
 * enough completions. The RATE metrics do not — a skip rate averaged over five years
 * barely moves when the process changes, which is the opposite of what a dashboard is
 * for. Both read this instead of the whole tab.
 */
var LS_METRIC_WINDOW_DAYS = 400;

function lsRecentTasks_(days, opts) {
  opts = opts || {};
  var cutoff = ymd_(addDays_(today_(), -(days || LS_METRIC_WINDOW_DAYS)));
  return readTab_('LS_Tasks_All').filter(function (r) {
    // The tab holds every task now. A finished task is one with a completed date OR
    // one that was skipped — a skipped step is resolved, just not by doing it, and
    // leaving them out of the denominator is what made the skip rate unmeasurable.
    var done = ymd_(r.completed_date);
    var skipped = r.skipped === 'YES';
    if (!done && !skipped) return false;
    if (opts.completedOnly && !done) return false;
    var when = done || ymd_(r.due_date);
    return when && when >= cutoff;
  });
}

/**
 * Onboarding processes, assembled from BOTH tabs.
 *
 * onboarding_cycle_time read LS_Processes and needed closed_date. Every onboarding tile on
 * the Performance view was blank, and the reason is that LS_Processes carries the processes
 * the sync returns — which in practice skew open. A cycle time measured only on open
 * processes cannot exist.
 *
 * LS_Tasks_All solves it without another API call: every completed task carries its parent
 * process's created_at AND closed_at inline. A closed onboarding process that never reached
 * LS_Processes still has its tasks in there. The two sources are unioned and the one that
 * knows a close date wins.
 */
function lsOnboardingProcs_() {
  var byId = {};

  function put(id, type, created, closed, src) {
    // THE onboarding process, not everything matching "onboard" — see LS_ONBOARDING.
    if (!id || !lsIsOnboardingType_(type)) return;
    var cur = byId[id];
    if (!cur) {
      byId[id] = { id: id, type: type, created: created || null, closed: closed || null,
                   sources: [src] };
      return;
    }
    if (cur.sources.indexOf(src) === -1) cur.sources.push(src);
    if (!cur.created && created) cur.created = created;
    if (!cur.closed && closed) cur.closed = closed;
  }

  readTab_('LS_Processes').forEach(function (r) {
    put(r.process_id, r.process_type, ymd_(r.created_date), ymd_(r.closed_date), 'processes');
  });
  readTab_('LS_Tasks_All').forEach(function (r) {
    put(r.process_id, r.process_type, ymd_(r.process_created), ymd_(r.process_closed), 'tasks');
  });

  return Object.keys(byId).map(function (k) { return byId[k]; });
}

/** What "onboard" matches that we are deliberately NOT measuring, with counts. */
function lsOnboardingExcluded_() {
  var counts = {};
  readTab_('LS_Processes').forEach(function (r) {
    var t = String(r.process_type || '');
    if (!LS_ONBOARDING.ALSO_MATCHING.test(t)) return;
    if (lsIsOnboardingType_(t)) return;
    counts[t] = (counts[t] || 0) + 1;
  });
  return counts;
}

/**
 * Median days from an onboarding process opening to a named step being completed.
 *
 * The step is matched on a PATTERN against step.description rather than an exact name,
 * because LeadSimple step descriptions are free text and get edited. An exact-match list
 * stops matching silently the first time someone fixes a typo; a pattern survives that, and
 * the metric reports how many distinct step names it matched so a bad pattern is visible
 * rather than invisible.
 */
function lsOnboardingStepDays_(pattern, label) {
  var procs = lsOnboardingProcs_();
  if (!procs.length) {
    return res_(null, null, null, 0, {
      note: 'No onboarding processes in LS_Processes or LS_Tasks_All. Seed LeadSimple, then ' +
            'run lsListProcessTypes() to confirm a type name contains "onboard".' });
  }
  var createdOf = {};
  procs.forEach(function (p) { if (p.created) createdOf[p.id] = p.created; });

  var tasks = readTab_('LS_Tasks_All');
  var withStep = 0, matchedNames = {}, earliest = {};
  tasks.forEach(function (t) {
    if (!createdOf[t.process_id]) return;          // not an onboarding process
    var step = String(t.step || '');
    if (!step) return;
    withStep++;
    if (!pattern.test(step)) return;
    matchedNames[step] = (matchedNames[step] || 0) + 1;
    var done = ymd_(t.completed_date);
    if (!done) return;                              // skipped steps have no completion date
    var prev = earliest[t.process_id];
    if (!prev || done < prev) earliest[t.process_id] = done;
  });

  var days = [];
  Object.keys(earliest).forEach(function (pid) {
    var g = daysBetween_(createdOf[pid], earliest[pid]);
    if (g !== null && g >= 0) days.push(g);
  });

  var names = Object.keys(matchedNames);
  if (!days.length) {
    return res_(null, null, null, 0, {
      onboarding_processes: procs.length,
      onboarding_tasks_with_a_step_name: withStep,
      step_names_matched: names.length,
      note: !withStep
        ? 'Onboarding processes exist but none of their tasks carries a step name. Re-run ' +
          'lsSeedCompletedTasks() — tasks seeded before the step.description fix have a ' +
          'blank step column.'
        : names.length
          ? 'Matched ' + names.length + ' step name(s) for ' + label + ' but none has a ' +
            'completion date yet.'
          : 'No step name matches ' + label + ' across ' + withStep + ' onboarding tasks. ' +
            'Run lsListSteps() and send me the list — the pattern needs widening.' });
  }

  return res_(median_(days), null, null, days.length, {
    p90: p90_(days),
    step_names_matched: names.slice(0, 6).join(' | '),
    distinct_step_names: names.length,
    note: 'Days from the onboarding process opening to the first completed step matching ' +
          label + '. Matched on the step description, so a renamed step keeps counting.' });
}

var CALC = {

  // ---------- Vacancy & Leasing ----------
  occupancy_rate: function (D) {
    var occupied = D.occ().reduce(function (s, r) { return s + (num_(r.occupied) || 0); }, 0);
    var total = D.units().length;
    return res_(total ? round1_(occupied / total * 100) : null, occupied, total, total,
      { note: 'Denominator is unit_directory (canon). AppFolio UI shows this against occupancy_summary and will differ.' });
  },

  days_without_revenue: function (D) {
    var v = D.vacancy().map(function (r) { return num_(r.days_vacant); })
                       .filter(function (x) { return x !== null && x >= 0; });
    return res_(median_(v), null, null, v.length, {
      p90: p90_(v),
      over_30: v.filter(function (x) { return x > 30; }).length,
      over_60: v.filter(function (x) { return x > 60; }).length
    });
  },

  speed_to_lease_executed: function (D) {
    var d = D.apps().filter(function (r) { return r.approved_at && r.lease_start_date; })
      .map(function (r) { return daysBetween_(r.approved_at, r.lease_start_date); })
      .filter(function (x) { return x !== null && x >= 0 && x <= 120; });
    return res_(median_(d), null, null, d.length, { p90: p90_(d) });
  },

  // ---------- Applications ----------
  application_qualification_speed: function (D) {
    var rows = D.apps().filter(function (r) {
      return r.received && r.decision_made_at &&
             String(r.application_status || '').toLowerCase().indexOf('cancel') === -1;
    });
    var d = rows.map(function (r) { return daysBetween_(r.received, r.decision_made_at); })
                .filter(function (x) { return x !== null && x >= 0 && x <= 60; });
    var screen = D.apps().filter(function (r) { return r.received && r.screened_on; })
      .map(function (r) { return daysBetween_(r.received, r.screened_on); })
      .filter(function (x) { return x !== null && x >= 0 && x <= 60; });
    return res_(median_(d), null, null, d.length, {
      p90: p90_(d),
      screening_leg_median: median_(screen),
      screening_n: screen.length,
      note: 'Column is "received", not "received_on". Two legs: received to screened, screened to decided.'
    });
  },

  // ---------- Collections ----------
  rent_delinquency_rate: function (D) {
    var current = D.rentRoll().filter(function (r) {
      return String(r.status || '').toLowerCase() === 'current';
    });
    // Negative past_due is a prepaid credit, not delinquency. Excluded.
    var delq = current.filter(function (r) { return (num_(r.past_due) || 0) > 0; });

    // AS-OF SENSITIVITY. rent_roll.past_due is a snapshot. Pulled a few days after
    // rent is due, everyone still inside the grace period counts as delinquent — which
    // roughly doubles the rate versus a month-end pull. The aged figure below comes
    // from the delinquency report's server-side buckets and is cycle-independent.
    var aged = D.delinq().filter(function (r) {
      return (num_(r['30_plus']) || 0) > 0;
    });
    var agedRate = current.length ? round1_(aged.length / current.length * 100) : null;

    return res_(current.length ? round1_(delq.length / current.length * 100) : null,
      delq.length, current.length, current.length, {
        past_due_total: round2_(delq.reduce(function (s, r) { return s + num_(r.past_due); }, 0)),
        aged_30_plus_rate: agedRate,
        aged_30_plus_count: aged.length,
        as_of: ymd_(today_()),
        note: 'Headline value is a point-in-time snapshot and moves with the rent cycle. ' +
              'For trend and benchmark comparison use aged_30_plus_rate, which excludes ' +
              'residents still inside the grace period. Always state the as-of date.'
      });
  },

  total_delinquency_rate: function (D) {
    var rr = D.rentRoll();
    var delq = rr.filter(function (r) { return (num_(r.past_due) || 0) > 0; });
    var total = D.units().length;
    return res_(total ? round1_(delq.length / total * 100) : null, delq.length, total, total,
      { past_due_total: round2_(delq.reduce(function (s, r) { return s + num_(r.past_due); }, 0)) });
  },

  aged_delinquency_buckets: function (D) {
    var d = D.delinq();
    function sum(f) { return round2_(d.reduce(function (s, r) { return s + (num_(r[f]) || 0); }, 0)); }
    return res_(sum('amount_receivable'), null, null, d.length, {
      not_yet_due: sum('not_yet_due'), b00_30: sum('00_to30'), b30_60: sum('30_to60'),
      b60_90: sum('60_to90'), b90_plus: sum('90_plus'),
      in_collections: d.filter(function (r) { return r.in_collections; }).length
    });
  },

  // ---------- Maintenance ----------
  maint_speed_to_repair: function (D) {
    var wo = completedWO_(D);
    var d = spanDays_(wo, 'created_at', 'completed_on', 365);
    return res_(median_(d), null, null, d.length,
      { p90: p90_(d), monthly: monthly_(wo, 'created_at', function (rows) {
          var x = spanDays_(rows, 'created_at', 'completed_on', 365);
          return { value: median_(x), n: x.length };
        }) });
  },

  maint_speed_to_schedule: function (D) {
    var d = spanDays_(D.wo(), 'created_at', 'scheduled_start', 180);
    return res_(median_(d), null, null, d.length, { p90: p90_(d) });
  },

  maint_owner_approval: function (D) {
    var d = spanDays_(D.wo(), 'estimate_req_on', 'estimate_approved_on', 180);
    return res_(median_(d), null, null, d.length, { p90: p90_(d) });
  },

  maint_cancellation_rate: function (D) {
    var wo = D.wo();
    var canceled = wo.filter(function (r) { return r.canceled_on; }).length;
    return res_(wo.length ? round1_(canceled / wo.length * 100) : null, canceled, wo.length, wo.length,
      { note: 'Operational metric. NOT the KPI guide "resolved without dispatch" benchmark.' });
  },

  work_orders_aging: function (D) {
    var cut = ymd_(addDays_(today_(), -CFG.WORK_ORDER_AGING_DAYS));
    var open = D.wo().filter(function (r) {
      return !r.completed_on && !r.canceled_on && ymd_(r.created_at) && ymd_(r.created_at) < cut;
    });
    var ages = open.map(function (r) { return daysBetween_(r.created_at, ymd_(today_())); });
    return res_(open.length, open.length, D.wo().length, open.length,
      { median_age_days: median_(ages), oldest_days: ages.length ? Math.max.apply(null, ages) : null });
  },

  // ---------- Turnover / Make Ready ----------
  turnover_speed: function (D) {
    var turns = turnWO_(D);
    var d = spanDays_(turns, 'created_at', 'completed_on', 180);
    return res_(median_(d), null, null, d.length,
      { p90: p90_(d), note: 'work_order_type = "Unit Turn". Make Ready is not separable in the current AppFolio setup.' });
  },

  turnover_dispatch: function (D) {
    var d = spanDays_(turnWO_(D), 'created_at', 'scheduled_start', 180);
    return res_(median_(d), null, null, d.length, { p90: p90_(d) });
  },

  // ---------- Lease Renewal ----------
  renewal_signed_leadtime: function (D) {
    // INVERTED: higher is better. Signing far ahead of expiry is good.
    var d = D.renewals().filter(function (r) { return r.countersigned_date && r.previous_lease_end; })
      .map(function (r) { return daysBetween_(r.countersigned_date, r.previous_lease_end); })
      .filter(function (x) { return x !== null && x > -30 && x < 400; });
    return res_(median_(d), null, null, d.length,
      { p90: p90_(d), signed_after_expiry: d.filter(function (x) { return x < 0; }).length,
        note: 'INVERTED — higher is better.' });
  },

  renewal_rent_increase: function (D) {
    var p = D.renewals().map(function (r) { return num_(r.percent_difference); })
                        .filter(function (x) { return x !== null; });
    return res_(median_(p), null, null, p.length, {
      mean: p.length ? round2_(p.reduce(function (a, b) { return a + b; }, 0) / p.length) : null,
      zero_or_negative: p.filter(function (x) { return x <= 0; }).length,
      note: 'CALIFORNIA: reporting only. Increases are governed by statute, local ordinance, and lease terms.'
    });
  },

  // ---------- Portfolio ----------
  unit_churn: function (D) {
    var mo = D.tickler().filter(isMoveOutEvent_);
    var total = D.units().length;
    var span = 400; // rebuildCompliance pulls a 400-day window
    var annualized = total ? mo.length / total * (365 / span) * 100 : null;
    return res_(round1_(annualized), mo.length, total, mo.length, {
      raw_moveouts: mo.length, window_days: span,
      note: 'ANNUALIZED from the pull window before benchmark comparison.'
    });
  },

  resident_flow: function (D) {
    var t = D.tickler();
    var ins = t.filter(function (r) {
      var e = String(r.event || '').toLowerCase().replace(/[^a-z]/g, '');
      return e.indexOf('movein') !== -1 && e.indexOf('notice') === -1;
    });
    var outs = t.filter(isMoveOutEvent_);
    var notices = t.filter(function (r) {
      return String(r.event || '').toLowerCase().indexOf('notice') !== -1;
    });
    return res_(ins.length - outs.length, ins.length, outs.length, t.length, {
      move_ins: ins.length, move_outs: outs.length, notices: notices.length,
      note: 'Direction is context-dependent — move-ins up is good, move-outs up is not. Do not apply one colour rule.'
    });
  },

  rent_to_market_variance: function (D) {
    var rows = D.rentRoll().filter(function (r) {
      return String(r.status || '').toLowerCase() === 'current' && num_(r.rent) > 0;
    }).map(function (r) {
      var mkt = num_(r.market_rent) || num_(r.computed_market_rent);
      var rent = num_(r.rent);
      if (!mkt || mkt <= 0) return null;
      return { unit_id: r.unit_id, property_id: r.property_id, property_name: r.property_name,
               property_street: r.property_street, property_street2: r.property_street2,
               unit: r.unit, tenant_id: r.tenant_id, status: r.status,
               rent: rent, market_rent: mkt, gap: round2_(mkt - rent),
               gap_pct: round1_((mkt - rent) / mkt * 100), lease_to: ymd_(r.lease_to) };
    }).filter(function (x) { return x; });

    var under = rows.filter(function (r) { return r.gap > 0; })
                    .sort(function (a, b) { return b.gap - a.gap; });
    writeTab_('Rent_To_Market', under.slice(0, 500));
    return res_(round2_(under.reduce(function (s, r) { return s + r.gap; }, 0)),
      under.length, rows.length, rows.length, {
        median_gap_pct: median_(under.map(function (r) { return r.gap_pct; })),
        note: 'Monthly revenue gap across under-market occupied units. CALIFORNIA: identifies a gap only — any increase is statute and lease governed.'
      });
  },

  // ---------- Move-Out ----------
  // ---------- Make Ready ----------
  // AppFolio has ONE turn-related work_order_type ("Unit Turn") and unit_turn_category
  // carries a single non-null value. Make Ready and Turnover are therefore the SAME
  // population here. The numbers are real; the separation the KPI guide assumes is not
  // available without a configuration change in AppFolio.
  make_ready_speed: function (D) {
    var d = spanDays_(turnWO_(D), 'created_at', 'completed_on', 180);
    return res_(median_(d), null, null, d.length, { p90: p90_(d), note: MAKE_READY_NOTE });
  },
  make_ready_estimate_sent: function (D) {
    var d = spanDays_(turnWO_(D), 'estimate_req_on', 'estimated_on', 90);
    return res_(median_(d), null, null, d.length, { p90: p90_(d), note: MAKE_READY_NOTE });
  },
  make_ready_dispatch: function (D) {
    var d = spanDays_(turnWO_(D), 'estimate_approved_on', 'scheduled_start', 90);
    return res_(median_(d), null, null, d.length, { p90: p90_(d), note: MAKE_READY_NOTE });
  },
  make_ready_owner_approval: function (D) {
    var d = spanDays_(turnWO_(D), 'estimate_req_on', 'estimate_approved_on', 90);
    return res_(median_(d), null, null, d.length, { p90: p90_(d), note: MAKE_READY_NOTE });
  },

  turnover_callback_rate: function (D) {
    return callbackRate_(D, turnWO_(D),
      'Inferred from a 30-day same-unit window. Confirm the definition with the maintenance team before publishing.');
  },

  renewal_capture_rate: function (D) {
    // APPROXIMATION, and it is labelled as one. renewal_summary rows are completed
    // renewals; there is no "did not renew" record. Using move-outs as the negative
    // side overstates non-renewal, because early terminations and evictions are in
    // there too. The exact denominator needs historical lease_expiration_detail.
    var renewed = D.renewals().length;
    var movedOut = D.tickler().filter(isMoveOutEvent_).length;
    var denom = renewed + movedOut;
    return res_(denom ? round1_(renewed / denom * 100) : null, renewed, denom, denom, {
      renewals: renewed, move_outs: movedOut,
      note: 'APPROXIMATION — denominator is renewals + all move-outs. Early terminations and evictions inflate the negative side, so the true capture rate is HIGHER than this. Label the source on any published figure.'
    });
  },

  // ---------- Move-Out (computed by their own jobs, read back here) ----------
  moveout_deposit_disposition: function (D) {
    var rows = readTab_('Deposit_Compliance');
    if (!rows.length) return res_(null, null, null, 0, { note: 'Run buildDepositCompliance() first.' });
    var measured = rows.filter(function (r) {
      return r.status === 'WITHIN_THRESHOLD' || r.status === 'EXCEEDED_THRESHOLD';
    });
    var days = measured.map(function (r) { return num_(r.days_elapsed); });
    var within = measured.filter(function (r) { return r.status === 'WITHIN_THRESHOLD'; }).length;
    return res_(median_(days), within, measured.length, measured.length, {
      p90: p90_(days),
      compliance_rate_pct: measured.length ? round1_(within / measured.length * 100) : null,
      exceeded: measured.length - within,
      owner_held_unmeasurable: rows.filter(function (r) { return r.status === 'CANNOT_MEASURE_OWNER_HELD'; }).length,
      still_open: rows.filter(function (r) { return String(r.status || '').indexOf('OPEN') === 0; }).length,
      threshold_days: CFG.DEPOSIT_DISPOSITION_DAYS,
      note: 'CALIFORNIA: reporting only. Threshold is a configured standard, not a legal determination.'
    });
  },

  moveout_assessment_speed: function (D) {
    var rows = readTab_('MoveOut_Assessment');
    if (!rows.length) return res_(null, null, null, 0, { note: 'Run buildMoveOutAssessment() first.' });
    var ok = rows.filter(function (r) { return r.status === 'OK'; });
    var days = ok.map(function (r) { return num_(r.days_to_assessment); });
    var corrob = ok.filter(function (r) { return r.corroborated === 'YES'; }).length;
    return res_(median_(days), null, null, ok.length, {
      p90: p90_(days),
      no_inspection_found: rows.filter(function (r) { return r.status === 'NO_INSPECTION_FOUND'; }).length,
      name_corroboration_pct: ok.length ? round1_(corrob / ok.length * 100) : null,
      note: 'Date-driven: first inspection on or after move-out. Independent of inspection naming.'
    });
  },

  maint_callback_rate: function (D) {
    return callbackRate_(D, completedWO_(D),
      'Same-unit work order within 30 days of completion. Same unit does not always mean same issue.');
  },

  make_ready_callback_rate: function (D) {
    return callbackRate_(D, turnWO_(D).filter(function (r) { return r.completed_on; }),
      MAKE_READY_NOTE + ' Callback inferred from a 30-day same-unit window.');
  },

  maint_validation_speed: function (D) {
    var wo = completedWO_(D);
    var f = spanDays_(wo, 'completed_on', 'follow_up_on', 90);
    var i = spanDays_(wo, 'completed_on', 'inspection_date', 90);
    var use = f.length >= i.length ? f : i;
    var field = f.length >= i.length ? 'follow_up_on' : 'inspection_date';
    var zeros = use.filter(function (x) { return x === 0; }).length;
    var zeroPct = use.length ? Math.round(zeros / use.length * 100) : 0;

    // A median of exactly zero with most values at zero does not mean work is validated
    // the instant it completes — it means the field mirrors the completion date. Report
    // NO VALUE rather than a flattering 0.
    if (use.length > 5 && median_(use) === 0 && zeroPct >= 60) {
      return res_(null, null, null, use.length, {
        field_examined: field, zero_pct: zeroPct,
        follow_up_n: f.length, inspection_n: i.length,
        note: 'NO SOURCE. ' + zeroPct + '% of ' + field + ' values equal completed_on, so the field ' +
              'mirrors completion rather than recording a separate validation. AppFolio has no ' +
              'distinct validation date. To measure this, either adopt a follow-up inspection step ' +
              'or a work order status that marks verification.'
      });
    }
    return res_(median_(use), null, null, use.length, {
      p90: p90_(use), field_used: field, zero_pct: zeroPct,
      follow_up_n: f.length, follow_up_median: median_(f),
      inspection_n: i.length, inspection_median: median_(i),
      note: 'AppFolio has no explicit validation field. Confirm which date your team actually uses.'
    });
  },

  maint_resolved_without_dispatch: function (D) {
    var wo = D.wo();
    var ai = wo.filter(function (r) { return r.ai_resolved; }).length;
    return res_(wo.length ? round1_(ai / wo.length * 100) : null, ai, wo.length, wo.length, {
      note: ai === 0
        ? 'ai_resolved is unpopulated across the portfolio — AppFolio AI triage appears unused. ' +
          'This reports 0%, which is NOT the same as "no issues resolved without dispatch". ' +
          'The KPI guide metric has no source until either AI triage is adopted or a work order ' +
          'convention marks no-dispatch resolutions.'
        : 'Based on ai_resolved. Confirm it captures all no-dispatch resolutions, not just AI-channel ones.'
    });
  },

  movein_evaluation_speed: function (D) {
    // WINDOW MATTERS, and the first version got it wrong. A move-out assessment always
    // follows the resident leaving, so ">= move_out_date" is right there. A MOVE-IN
    // walkthrough is routinely done a few days BEFORE or on the day of handover — so
    // ">= move_in_date" matched only 25 of 184 move-ins. Window is -7 to +30 days,
    // nearest to the move-in date.
    var BEFORE = 7, AFTER = 30;
    var ins = D.tickler().filter(function (r) {
      var e = String(r.event || '').toLowerCase().replace(/[^a-z]/g, '');
      return r.move_in_date && e.indexOf('movein') !== -1 && e.indexOf('notice') === -1;
    });
    var byOcc = {};
    D.inspections().forEach(function (r) {
      if (r.occupancy_id === null || r.occupancy_id === undefined) return;
      var d = parseDate_(r.inspected_on);
      if (!d) return;
      (byOcc[r.occupancy_id] = byOcc[r.occupancy_id] || []).push(d.getTime());
    });

    var days = [], before = 0, matched = 0;
    ins.forEach(function (mi) {
      var mid = parseDate_(mi.move_in_date);
      if (!mid) return;
      var t = mid.getTime(), best = null;
      (byOcc[mi.occupancy_id] || []).forEach(function (x) {
        var diff = Math.round((x - t) / 86400000);
        if (diff < -BEFORE || diff > AFTER) return;
        if (best === null || Math.abs(diff) < Math.abs(best)) best = diff;
      });
      if (best === null) return;
      matched++;
      if (best < 0) before++;
      days.push(Math.max(0, best));   // inspected early counts as day 0, never negative
    });

    return res_(median_(days), null, null, days.length, {
      p90: p90_(days), move_ins: ins.length, matched: matched,
      match_rate_pct: ins.length ? round1_(matched / ins.length * 100) : null,
      inspected_before_movein: before,
      // Zero is a real, good answer here: the walkthrough happened on or before
      // handover day. Tells sanityCheck not to treat it as an empty date field.
      zero_is_meaningful: true,
      note: 'Nearest inspection within -7 to +30 days of move-in. Early inspections count as day 0. ' +
            'A low match rate means move-ins are happening without a recorded inspection — an operational ' +
            'gap worth checking, not a data error.'
    });
  },

  /** Share of completed tasks that were skipped rather than done. Lower is better. */
  skipped_step_rate: function (D) {
    // Windowed. The backfill holds five years of tasks; a skip rate averaged over five
    // years tells you nothing about how the process is running now, and would barely
    // move when it changed.
    var t = lsRecentTasks_(LS_METRIC_WINDOW_DAYS);
    if (!t.length) {
      return res_(null, null, null, 0, {
        note: 'LS_Tasks_Completed is empty. The nightly sync pulls only UPCOMING tasks — ' +
              'run lsSeedCompletedTasks() once to backfill.' });
    }
    var skipped = t.filter(function (r) { return r.skipped === 'YES'; }).length;
    if (!skipped) {
      // Zero across tens of thousands is a claim worth doubting. The extraction is
      // correct — skipped is a boolean on the payload — but due_type=completed may
      // simply never return a skipped task, in which case this is unmeasurable here
      // rather than genuinely zero. lsProbeTask() compares against an unfiltered pull.
      return res_(null, null, null, t.length, {
        window_days: LS_METRIC_WINDOW_DAYS,
        tasks_examined: t.length,
        note: 'Not a single skipped task in ' + t.length + ' completed tasks. Published ' +
              'as no-value rather than 0%, because a rate of exactly zero across a set ' +
              'that large is more likely a filter than a fact. Run lsProbeTask() and ' +
              're-seed if the tab predates 2026-08-13, when the seed still filtered to ' +
              'due_type=completed and could not see a skipped task at all.' });
    }
    return res_(round1_(skipped / t.length * 100), skipped, t.length, t.length, {
      window_days: LS_METRIC_WINDOW_DAYS,
      note: 'Last ' + LS_METRIC_WINDOW_DAYS + ' days. Tasks marked skipped as a share of ' +
            'all completed tasks in that window. A skipped step is ' +
            'not automatically wrong — some are genuinely not applicable — but a rising ' +
            'rate means the process is being worked around rather than followed.'
    });
  },

  /** Share of automated sends that errored. Lower is better. */
  automation_failure_rate: function (D) {
    var t = lsRecentTasks_(LS_METRIC_WINDOW_DAYS, { completedOnly: true })
              .filter(function (r) { return r.auto_send === 'YES'; });
    if (!t.length) {
      return res_(null, null, null, 0, {
        note: 'No completed task is flagged auto_send. Either automation is not in use on ' +
              'these process types, or LS_Tasks_Completed has not been seeded.' });
    }
    var failed = t.filter(function (r) { return String(r.auto_send_error || '').trim(); }).length;
    return res_(round1_(failed / t.length * 100), failed, t.length, t.length, {
      automated_tasks: t.length,
      window_days: LS_METRIC_WINDOW_DAYS,
      note: 'Last ' + LS_METRIC_WINDOW_DAYS + ' days. Automated sends carrying an error, ' +
            'as a share of all automated sends in that window.'
    });
  },

  /**
   * Share of renewals whose annual inspection was completed at least 80 days before the
   * renewal date. Direction: higher is better.
   *
   * The denominator is only renewals whose deadline HAS ARRIVED. A renewal six months out
   * is not late, and counting it as compliant-so-far would flatter the number into
   * uselessness — which is the failure mode of every on-time rate that includes the future.
   */
  renewal_inspection_ontime: function (D) {
    var rows = readTab_('Renewal_Pipeline').filter(function (r) { return r.address; });
    if (!rows.length) {
