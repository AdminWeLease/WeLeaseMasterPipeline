  },

  /** Units under management per person on the team. Direction: higher is better. */
  units_per_team_member: function (D) {
    // Not an API figure. Headcount is a fact about WeLease, so it lives in a tab
    // someone maintains rather than being inferred from process assignees — which
    // would silently drop anyone who happened to have no open work that day.
    var roster = readTab_('Team_Roster').filter(function (r) {
      return String(r.name || '').trim() && String(r.counts_toward_ratio || '')
        .toUpperCase() !== 'NO';
    });
    if (!roster.length) {
      return res_(null, null, null, 0, {
        note: 'Team_Roster is empty. This is the one metric that needs a number from a ' +
              'person rather than an API — add one row per team member. Set ' +
              'counts_toward_ratio to NO for anyone not carrying doors.' });
    }
    var fte = roster.reduce(function (a, r) {
      var f = num_(r.fte);
      return a + (f === null ? 1 : f);
    }, 0);
    var units = dropTPO_(readTab_('Unit_Directory')).length;
    if (!fte) return res_(null, null, null, 0, { note: 'Roster FTE totals zero.' });
    return res_(round1_(units / fte), units, fte, roster.length, {
      team_members: roster.length,
      total_fte: round1_(fte),
      units_counted: units,
      note: 'Managed units divided by team FTE from Team_Roster. TPO units are excluded, ' +
            'since WeLease does not manage them.'
    });
  },

  // ---- ShowMojo, live since 2026-08-12 ---------------------------------------
  //
  // READ THIS BEFORE EDITING. The registry's stated formulas for these metrics were
  // written against fields that do not exist. It assumed listing_and_showing_metrics
  // carried listing_id, listed_date, unlisted_date, leased_date and showings_count.
  // Verified against the live account, that report is an EVENT LOG — listing_uid,
  // timestamp, entry_type, referrer, listing_code — about 1,500 rows a month.
  //
  // The numbers below come from where the data actually is:
  //   detailed_listing_data   -> days_on_market, market_status, last_on_market
  //   listing_performance     -> Scheduled showings, Actual showings, Leads per listing
  //
  // Each returns a note saying what it measured, because it is not what the registry
  // formula says.

  /** Median days on market across listings. Straight from the field of that name. */
  days_on_market: function (D) {
    var rows = readTab_('SM_Listings');
    if (!rows.length) {
      return res_(null, null, null, 0, {
        note: 'SM_Listings is empty — run rebuildShowMojo().' });
    }
    var v = rows.map(function (r) { return num_(r.days_on_market); })
                .filter(function (x) { return x !== null && x >= 0; });
    if (!v.length) {
      return res_(null, null, null, 0, {
        note: 'No listing carries a days_on_market value.' });
    }
    return res_(median_(v), null, null, v.length, {
      p90: p90_(v),
      listings: rows.length,
      longest: Math.max.apply(null, v),
      note: 'Median of detailed_listing_data.days_on_market. The registry formula ' +
            '(unlisted/leased minus listed) was written against fields ShowMojo does ' +
            'not return; this reads the value ShowMojo publishes directly.'
    });
  },

  /** Actual showings as a share of scheduled. Higher is better. */
  showing_completion_rate: function (D) {
    var perf = readTab_('SM_Listing_Performance');
    if (!perf.length) {
      return res_(null, null, null, 0, {
        note: 'SM_Listing_Performance is empty — run rebuildShowMojo().' });
    }
    var sched = 0, actual = 0;
    perf.forEach(function (r) {
      sched += num_(r['Scheduled showings']) || 0;
      actual += num_(r['Actual showings']) || 0;
    });
    if (!sched) {
      return res_(null, null, null, 0, { note: 'No showings were scheduled in this period.' });
    }
    return res_(round1_(actual / sched * 100), actual, sched, sched, {
      listings: perf.length,
      no_shows: sched - actual,
      note: 'Actual over scheduled showings across every listing. listing_performance ' +
            'accepts no date parameters, so this is account-to-date rather than a window.'
    });
  },

  /**
   * Completed showings per listing that actually leased. Lower is better.
   *
   * ShowMojo cannot answer "did it lease". The live account carries exactly two
   * market_status values — "On market" and "Off market" — and a listing goes off market
   * when it leases, when the owner pulls it, or when it is paused. Counting all 47
   * off-market listings as leases would have inflated the denominator with withdrawals.
   *
   * The lease event lives in AppFolio. A listing counts as leased when its joined unit
   * has a move-in on or after the day it left the market.
   */
  showings_per_lease: function (D) {
    var join = readTab_('SM_Unit_Join').filter(function (r) { return r.unit_id; });
    var funnel = readTab_('SM_Listing_Funnel');
    if (!join.length) {
      return res_(null, null, null, 0, {
        note: 'SM_Unit_Join is empty. ShowMojo alone cannot tell which listings leased — ' +
              'its only statuses are On market and Off market. Run buildShowMojoJoin().' });
    }
    var showingsByCode = {};
    funnel.forEach(function (f) {
      showingsByCode[String(f.listing_code)] = num_(f.actual_showings);
    });

    // AppFolio move-ins per unit.
    var moveIns = {};
    D.tickler().forEach(function (r) {
      var e = String(r.event || '').toLowerCase().replace(/[^a-z]/g, '');
      if (!r.move_in_date || e.indexOf('movein') === -1 || e.indexOf('notice') !== -1) return;
      var d = ymd_(r.move_in_date);
      if (!d || !r.unit_id) return;
      if (!moveIns[r.unit_id] || d > moveIns[r.unit_id]) moveIns[r.unit_id] = d;
    });

    var v = [], leased = 0, offMarketNoLease = 0;
    join.forEach(function (j) {
      var off = /off/i.test(String(j.market_status || ''));
      if (!off) return;
      var left = ymd_(j.last_on_market);
      var mi = moveIns[j.unit_id];
      if (!mi || (left && mi < left)) { offMarketNoLease++; return; }
      leased++;
      var n = showingsByCode[String(j.listing_code)];
      if (n !== null && n !== undefined) v.push(n);
    });

    if (!v.length) {
      return res_(null, null, null, 0, {
        off_market_listings: offMarketNoLease + leased,
        off_market_without_a_movein: offMarketNoLease,
        note: 'No off-market listing has a matching AppFolio move-in, so none can be ' +
              'confirmed as leased. Either the join rate is low or those listings were ' +
              'withdrawn rather than let.' });
    }
    return res_(median_(v), null, null, v.length, {
      p90: p90_(v),
      leased_listings: leased,
      off_market_without_a_movein: offMarketNoLease,
      note: 'Median completed showings on listings that left the market AND whose ' +
            'AppFolio unit recorded a move-in afterwards. Off-market listings with no ' +
            'move-in are counted separately as withdrawals, not leases — ShowMojo has ' +
            'no "leased" status to distinguish them.'
    });
  },

  /** AppFolio applications per completed ShowMojo showing. Higher is better. */
  showing_to_application_rate: function (D) {
    var perf = readTab_('SM_Listing_Performance');
    var apps = D.apps ? D.apps() : readTab_('Applications');   // dataContext_ names it apps
    if (!perf.length) {
      return res_(null, null, null, 0, {
        note: 'SM_Listing_Performance is empty — run rebuildShowMojo().' });
    }
    var actual = perf.reduce(function (a, r) { return a + (num_(r['Actual showings']) || 0); }, 0);
    if (!actual) return res_(null, null, null, 0, { note: 'No completed showings.' });
    var n = (apps || []).length;
    return res_(round1_(n / actual * 100), n, actual, actual, {
      applications: n,
      completed_showings: actual,
      note: 'Applications received over completed showings, ACCOUNT-WIDE. The registry ' +
            'asks for this per unit per period; that needs listing_code matched to an ' +
            'AppFolio unit, which is not built yet — run diagnoseShowMojo() to see ' +
            'whether the codes can be joined. Periods also differ: listing_performance ' +
            'takes no dates, so showings are account-to-date while applications are ' +
            'windowed. Read this as a ratio of scale, not a conversion rate.'
    });
  },

  /** Days from a unit going vacant to the listing going live. Lower is better. */
  speed_to_listing: function (D) {
    var join = readTab_('SM_Unit_Join').filter(function (r) { return r.unit_id && r.last_on_market; });
    if (!join.length) {
      return res_(null, null, null, 0, {
        note: 'SM_Unit_Join is empty — run buildShowMojoJoin().' });
    }
    var vac = {};
    D.vacancy().forEach(function (r) {
      var d = ymd_(r.last_move_out);
      if (r.unit_id && d) vac[r.unit_id] = d;
    });
    var days = [], noVacancy = 0, listedFirst = 0;
    join.forEach(function (j) {
      var out = vac[j.unit_id];
      if (!out) { noVacancy++; return; }
      var gap = daysBetween_(out, j.last_on_market);
      if (gap === null) return;
      // Listed before the resident left is normal practice, not negative time.
      if (gap < 0) { listedFirst++; days.push(0); return; }
      days.push(gap);
    });
    if (!days.length) {
      return res_(null, null, null, 0, {
        joined_listings: join.length, without_a_move_out_date: noVacancy,
        note: 'No joined listing has a last_move_out to measure from.' });
    }
    return res_(median_(days), null, null, days.length, {
      p90: p90_(days),
      listed_before_move_out: listedFirst,
      without_a_move_out_date: noVacancy,
      zero_is_meaningful: true,
      note: 'AppFolio last_move_out to ShowMojo last_on_market, on listings joined by ' +
            'address. Listings that went live before the resident left count as 0 rather ' +
            'than a negative — pre-marketing is good practice, not negative elapsed time.'
    });
  },

  /** Days from listing live to the first application. Lower is better. */
  speed_to_first_applicant: function (D) {
    var join = readTab_('SM_Unit_Join').filter(function (r) { return r.unit_id && r.last_on_market; });
    if (!join.length) {
      return res_(null, null, null, 0, {
        note: 'SM_Unit_Join is empty — run buildShowMojoJoin().' });
    }
    var firstApp = {};
    D.apps().forEach(function (a) {
      var d = ymd_(a.received);
      if (!a.unit_id || !d) return;
      if (!firstApp[a.unit_id] || d < firstApp[a.unit_id]) firstApp[a.unit_id] = d;
    });
    var days = [], noApp = 0;
    join.forEach(function (j) {
      var got = firstApp[j.unit_id];
      if (!got) { noApp++; return; }
      var gap = daysBetween_(j.last_on_market, got);
      // An application dated before the listing went live belongs to an earlier
      // vacancy, not this one.
      if (gap === null || gap < 0) return;
      days.push(gap);
    });
    if (!days.length) {
      return res_(null, null, null, 0, {
        joined_listings: join.length, without_an_application: noApp,
        note: 'No joined listing has an application dated after it went live.' });
    }
    return res_(median_(days), null, null, days.length, {
      p90: p90_(days),
      listings_with_no_application: noApp,
      note: 'ShowMojo last_on_market to the first AppFolio application on the joined ' +
            'unit. Applications dated before the listing went live belong to an earlier ' +
            'vacancy and are excluded.'
    });
  },

  // ---- LeadSimple, live since 2026-08-10 -------------------------------------
  // These three read the LS_* tabs rebuildLeadSimple already writes. They stay null
  // until their registry status is changed from "deferred" — computeMetrics skips a
  // deferred metric before it ever reaches CALC, so adding a calculation alone
  // changes nothing. See FINDINGS for the exact registry edits.

  /** Share of open processes that are NOT past their due date. Higher is better. */
  process_ontime_rate: function (D) {
    var open = readTab_('LS_Processes').filter(function (r) { return r.is_open === 'YES'; });
    var dated = open.filter(function (r) { return r.due_date; });
    if (!dated.length) {
      return res_(null, null, null, 0, {
        note: 'No open process carries a due date, so on-time cannot be measured. ' +
              'Set due dates on processes in LeadSimple.' });
    }
    var onTime = dated.filter(function (r) { return !(num_(r.days_overdue) > 0); }).length;
    return res_(round1_(onTime / dated.length * 100), onTime, dated.length, dated.length, {
      open_total: open.length,
      without_due_date: open.length - dated.length,
      note: 'Open processes with a due date, not yet past it. Processes with no due date ' +
            'are excluded from the denominator rather than counted as on time \u2014 ' +
            'they cannot be either.'
    });
  },

  /** Share of open processes nobody has touched recently. Lower is better. */
  stalled_process_rate: function (D) {
    var open = readTab_('LS_Processes').filter(function (r) { return r.is_open === 'YES'; });
    if (!open.length) return res_(null, null, null, 0, { note: 'No open processes.' });
    var stalled = open.filter(function (r) { return r.is_stalled === 'YES'; }).length;
    return res_(round1_(stalled / open.length * 100), stalled, open.length, open.length, {
      threshold_days: (typeof LS !== 'undefined' && LS.STALLED_DAYS) || 30,
      note: 'Untouched longer than the stalled threshold. Counts activity, not lateness ' +
            '\u2014 a process with no due date can stall without ever being overdue.'
    });
  },

  /**
   * Hours from an owner lead arriving to the first recorded contact. Lower is better.
   *
   * time_to_first_touch is in HOURS — confirmed by Frank, 2026-08-13. My earlier ratio
   * check called the unit UNCLEAR, and the check was not wrong so much as asking the
   * wrong question: it compared every deal, including leads tagged "Bad Email Address"
   * or "Unsubscribed" and records that sat dormant for months before anyone tried. A
   * median across those describes the state of the data, not the speed of the team.
   *
   * So the field is used as hours, and LS_Deal_Review decides which deals belong in the
   * average. Blank action follows the suggestion; KEEP or FIXED overrides it. The count
   * of exclusions is published alongside the figure — a median over a quietly filtered
   * population is exactly the kind of number that stops being trustworthy.
   */
  lead_first_touch_speed: function (D) {
    var deals = readTab_('LS_Deals');
    if (!deals.length) return res_(null, null, null, 0, { note: 'LS_Deals is empty.' });

    var ignored = (typeof lsIgnoredDeals_ === 'function') ? lsIgnoredDeals_() : {};
    var hrs = [], never = 0, active = 0, excluded = 0, disagreed = 0;

    deals.forEach(function (d) {
      if (d.is_active === 'YES') active++;
      if (ignored[String(d.deal_id)]) { excluded++; return; }

      var v = num_(d.ls_time_to_first_touch_raw);      // hours, per the vendor
      var ours = num_(d.hours_to_first_touch);         // hours, computed from timestamps
      if (v === null || v < 0) {
        if (d.is_active === 'YES' && !d.first_contacted_date) never++;
        return;
      }
      if (ours !== null && v > 0 && Math.abs(ours - v) / Math.max(v, 1) > 0.5) disagreed++;
      hrs.push(v);
    });

    if (!hrs.length) {
      return res_(null, null, null, 0, {
        deals_excluded_by_review: excluded,
        never_contacted_active: never,
        note: 'No deal carries a usable time_to_first_touch once LS_Deal_Review exclusions ' +
              'are applied. If that number is large, open LS_Deal_Review \u2014 a blank ' +
              'action follows the suggestion, so a wave of newly tagged leads can empty ' +
              'this on its own.' });
    }
    return res_(median_(hrs), null, null, hrs.length, {
      p90: p90_(hrs),
      within_2_hours: hrs.filter(function (x) { return x <= 2; }).length,
      within_1_day: hrs.filter(function (x) { return x <= 24; }).length,
      slowest_hours: Math.max.apply(null, hrs),
      deals_excluded_by_review: excluded,
      timestamps_disagree: disagreed,
      never_contacted_active: never,
      active_deals: active,
      note: 'LeadSimple time_to_first_touch, in hours. ' + excluded + ' deal(s) left out ' +
            'via LS_Deal_Review \u2014 leads tagged as a bad email address, unsubscribed ' +
            'or similar, plus records dormant long enough that the figure describes ' +
            'neglect rather than response time. Deals never contacted have no duration ' +
            'and are counted separately.' +
            (disagreed ? ' ' + disagreed + ' deal(s) where the vendor figure and the ' +
             'created-to-first-contact timestamps disagree by more than half \u2014 they ' +
             'are in the review tab and still counted, since the field is authoritative.' : '')
    });
  },

  moveout_trigger_mix: function (D) {
    var mo = D.tickler().filter(isMoveOutEvent_);
    var g = groupBy_(mo, function (r) { return r.move_out_reason || '(not recorded)'; });
    var mix = Object.keys(g).sort(function (a, b) { return g[b].length - g[a].length; })
      .map(function (k) { return k + ': ' + g[k].length + ' (' + Math.round(g[k].length / mo.length * 100) + '%)'; });
    return res_(mo.length, mo.length, mo.length, mo.length, {
      mix: mix.join(' · '),
      not_recorded: (g['(not recorded)'] || []).length,
      note: 'Separate controllable from uncontrollable (owner termination, military orders) before drawing a retention conclusion. FAIR HOUSING: never segment by protected characteristic.'
    });
  }
};

/**
 * Callback rate — a new work order on the same unit within 30 days of a completion.
 *
 * PERFORMANCE: the first version compared every completed job against every work
 * order and re-parsed dates inside the loop. At 120 rows that was instant; once the
 * status filter was corrected and thousands of rows came back, it hung past Apps
 * Script's execution cap. This indexes by unit once and compares epoch millis.
 */
function callbackRate_(D, population, note) {
  var done = population.filter(function (r) { return r.completed_on; });
  var byUnit = {};
  D.wo().forEach(function (w) {
    var u = w.unit_id;
    if (u === null || u === undefined) return;
    var c = parseDate_(w.created_at);
    if (!c) return;
    (byUnit[u] = byUnit[u] || []).push(c.getTime());
  });

  var WINDOW = 30 * 86400000, callbacks = 0;
  done.forEach(function (t) {
    var d = parseDate_(t.completed_on);
    if (!d) return;
    var t0 = d.getTime(), t1 = t0 + WINDOW;
    var list = byUnit[t.unit_id] || [];
    for (var i = 0; i < list.length; i++) {
      if (list[i] > t0 && list[i] <= t1) { callbacks++; return; }
    }
  });

  return res_(done.length ? round1_(callbacks / done.length * 100) : null,
    callbacks, done.length, done.length, { note: note });
}

// ============================================================ SHARED FILTERS

function completedWO_(D) {
  return D.wo().filter(function (r) { return r.completed_on && !r.canceled_on; });
}

function turnWO_(D) {
  return D.wo().filter(function (r) {
    return String(r.work_order_type || '').toLowerCase().indexOf('turn') !== -1 || r.unit_turn_id;
  });
}

function spanDays_(rows, fromField, toField, maxDays) {
  return rows.map(function (r) { return daysBetween_(r[fromField], r[toField]); })
             .filter(function (x) { return x !== null && x >= 0 && x <= (maxDays || 365); });
}


// ============================================================ RUNNER

/**
 * RESUMABLE, because one pass is not enough.
 *
 * 55 metrics against a 400-unit portfolio does not fit in the six minutes Apps Script
 * allows. On 2026-08-12 exactly 9 metrics computed and 41 were marked not_run — which
 * on the dashboard looked like "the Performance view is broken", when in fact the job
 * simply ran out of time and gave up.
 *
 * So it now checkpoints. Each pass computes what it can, appends to _metrics_partial,
 * saves its position, and re-arms itself a minute later. When the last metric lands it
 * promotes _metrics_partial to Metrics in one write and clears the checkpoint.
 *
 * The Metrics tab is therefore never half-written: the dashboard keeps serving the
 * previous complete set until a full run finishes. Same pattern as lsSeedProcesses.
 *
 * Run it once and walk away. Watch _refresh_log for PARTIAL, then COMPLETE.
 */
var METRICS_PROP_AT = 'METRICS_RESUME_AT';
var METRICS_PROP_RUN = 'METRICS_RUN_STAMP';
var METRICS_PARTIAL_TAB = '_metrics_partial';
var METRICS_TIMING_TAB = '_metric_timing';

var METRICS_PROP_TRIGGER = 'METRICS_CONTINUATION_ID';

/**
 * Continuations are deleted BY ID, never by handler name.
 *
 * A one-off after() trigger and the nightly 4:30 schedule are both CLOCK triggers on
 * the same handler, and the API gives no way to tell them apart after creation. Sweeping
 * by handler name would have quietly deleted the nightly run every time a resumable
 * pass finished — the metrics would have stopped updating and nothing would have said so.
 */
function metricsClearContinuation_() {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty(METRICS_PROP_TRIGGER);
  if (!id) return;
  ScriptApp.getProjectTriggers().forEach(function (t) {
    try { if (t.getUniqueId() === id) ScriptApp.deleteTrigger(t); } catch (e) {}
  });
  props.deleteProperty(METRICS_PROP_TRIGGER);
}

function metricsScheduleContinuation_() {
  metricsClearContinuation_();
  var t = ScriptApp.newTrigger('computeMetrics').timeBased().after(60 * 1000).create();
  try {
    PropertiesService.getScriptProperties()
      .setProperty(METRICS_PROP_TRIGGER, t.getUniqueId());
  } catch (e) {}
}

/** Wipes the checkpoint so the next call starts clean. */
function resetComputeMetrics() {
  var props = PropertiesService.getScriptProperties();
  props.deleteProperty(METRICS_PROP_AT);
  props.deleteProperty(METRICS_PROP_RUN);
  try { clearTabRows_(METRICS_PARTIAL_TAB); } catch (e) {}
  try { metricsClearContinuation_(); } catch (e) {}
  Logger.log('Checkpoint cleared. computeMetrics() will start from the beginning.');
  return 'reset';
}

function computeMetrics() {
  var t0 = new Date().getTime();
  var props = PropertiesService.getScriptProperties();

  /**
   * ONE AT A TIME.
   *
   * This is what broke the Metrics tab on 2026-08-12. A continuation trigger and a
   * manual run overlapped: both read the same checkpoint, both computed from the same
   * index, and the first to finish promoted its rows and cleared the partial tab. The
   * second then reached the end, found the partial tab empty, and promoted only the
   * tail it happened to hold — so occupancy_rate and everything else early in the
   * registry vanished from a run that reported COMPLETE.
   *
   * A second caller now backs off instead of racing.
   */
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) {
    logRun_('computeMetrics', 'derived', '-', 0, 0,
            'SKIPPED — another pass is already running.');
    Logger.log('Another computeMetrics pass is already running. Nothing to do.');
    return { skipped_locked: true };
  }

  try {
    return computeMetricsPass_(t0, props);
  } finally {
    try { lock.releaseLock(); } catch (e) {}
  }
}

function computeMetricsPass_(t0, props) {
  var reg = loadRegistry_();
  var D = dataContext_();

  var startAt = parseInt(props.getProperty(METRICS_PROP_AT) || '0', 10) || 0;
  var runDate = props.getProperty(METRICS_PROP_RUN);
  if (!startAt || !runDate) { runDate = nowStamp_(); props.setProperty(METRICS_PROP_RUN, runDate); }

  var rows = [], timing = [], computed = 0, skipped = 0, failed = 0, abandoned = 0;
  // 240s, not 280s. The old margin left nothing for the promote-and-write at the end,
  // and a pass that dies mid-write loses everything it just computed.
  var BUDGET_MS = 240000;
  var stoppedAt = -1;

  reg.metrics.forEach(function (m, idx) {
    if (idx < startAt) return;                       // done on an earlier pass
    if (stoppedAt >= 0) return;                      // budget already blown
    if (new Date().getTime() - t0 > BUDGET_MS) {
      stoppedAt = idx;
      return;
    }
    var mStart = new Date().getTime();
    var base = {
      run_date: runDate, metric_id: m.id, name: m.name, kpi_category: m.kpi_category,
      system: m.system, direction: m.direction, status: m.status,
      benchmark_median: m.benchmark ? m.benchmark.median : null,
      benchmark_top25: m.benchmark ? m.benchmark.top_25_pct : null,
      benchmark_unit: m.benchmark ? m.benchmark.unit : null,
      // Carries whether this target is ours or an industry survey, so the dashboard
      // can stop calling a WeLease standard an "industry average".
      benchmark_source: m.benchmark ? (m.benchmark.source || '') : ''
    };

    if (m.status === 'deferred' || m.status === 'blocked') {
      rows.push(Object.assign({}, base, {
        period: 'ALL', value: null,
        notes: m.status === 'deferred'
          ? 'Source system not connected — ' + String(m.system).split('+')[0]
          : 'No source available in any current endpoint'
      }));
      skipped++;
      return;
    }

    var fn = CALC[m.id];
    if (!fn) {
      rows.push(Object.assign({}, base, {
        period: 'ALL', value: null, status: 'not_implemented',
        notes: 'Defined in the registry, no calculation written yet'
      }));
      skipped++;
      return;
    }

    try {
      var r = fn(D);
      var publishable = (r.n === null || r.n === undefined) ? true : r.n >= CFG.MIN_N_TO_PUBLISH;
      var extras = {};
      Object.keys(r).forEach(function (k) {
        if (['value', 'numerator', 'denominator', 'n', 'monthly', 'note'].indexOf(k) === -1) {
          // mean, p90 and the rest land in the detail JSON and are read by people.
          // Same rounding, same reason.
          extras[k] = publishNum_(r[k]);
        }
      });

      rows.push(Object.assign({}, base, {
        // Rounded here, once, for every metric. See publishNum_ in Core_v2.gs.
        period: 'ALL', value: publishNum_(r.value),
        numerator: publishNum_(r.numerator), denominator: publishNum_(r.denominator), n: r.n,
        vs_benchmark: vsBenchmark_(r.value, m.benchmark, m.direction),
        publishable: publishable ? 'YES' : 'NO — n below ' + CFG.MIN_N_TO_PUBLISH,
        detail: Object.keys(extras).length ? JSON.stringify(extras) : null,
        notes: r.note || null
      }));

      (r.monthly || []).forEach(function (mo) {
        rows.push(Object.assign({}, base, {
          period: mo.period, value: publishNum_(mo.value), n: mo.n,
          vs_benchmark: vsBenchmark_(mo.value, m.benchmark, m.direction),
          publishable: (mo.n >= CFG.MIN_N_TO_PUBLISH) ? 'YES' : 'NO — n below ' + CFG.MIN_N_TO_PUBLISH
        }));
      });
      computed++;
    } catch (e) {
      rows.push(Object.assign({}, base, { period: 'ALL', value: null, status: 'error',
                                          notes: e.message.slice(0, 300) }));
      logError_('compute', m.id, e.message);
      failed++;
    }
    timing.push({ metric_id: m.id, name: m.name, ms: new Date().getTime() - mStart,
                  status: m.status || '', run_date: runDate });
  });

  var headers = ['run_date','metric_id','name','kpi_category','system','period','value',
                 'numerator','denominator','n','benchmark_median','benchmark_top25','benchmark_unit',
                 'benchmark_source','direction','vs_benchmark','publishable','status','detail','notes'];

  // Everything computed on this pass joins what earlier passes produced.
  if (rows.length) appendTab_(METRICS_PARTIAL_TAB, rows, headers);
  if (timing.length) appendTab_(METRICS_TIMING_TAB, timing,
    ['run_date', 'metric_id', 'name', 'ms', 'status']);

  var elapsed = new Date().getTime() - t0;

  if (stoppedAt >= 0) {
    // More to do. Save the position and come back in a minute.
    props.setProperty(METRICS_PROP_AT, String(stoppedAt));
    var remaining = reg.metrics.length - stoppedAt;
    try { metricsScheduleContinuation_(); } catch (e) {
      logError_('compute', 'continuation',
        'Could not schedule the continuation: ' + e.message + ' — run computeMetrics() again by hand.');
    }
    logRun_('computeMetrics', 'derived', METRICS_PARTIAL_TAB, rows.length, elapsed,
      'PARTIAL — ' + computed + ' computed this pass, paused at metric ' + stoppedAt +
      ' of ' + reg.metrics.length + ', ' + remaining + ' to go. Continuation scheduled.');
    Logger.log('PARTIAL — paused at ' + stoppedAt + '/' + reg.metrics.length +
               '. ' + remaining + ' metrics remain. A continuation runs in ~1 minute.');
    return { partial: true, computed: computed, paused_at: stoppedAt,
             remaining: remaining, rows: rows.length };
  }

  // Finished — but prove it before overwriting anything.
  var all = readTab_(METRICS_PARTIAL_TAB).concat(rows);

  // Overlapping passes could append the same metric twice. Last write wins.
  var seen = {}, deduped = [];
  for (var i = all.length - 1; i >= 0; i--) {
    var k = String(all[i].metric_id) + '|' + String(all[i].period);
    if (seen[k]) continue;
    seen[k] = 1;
    deduped.unshift(all[i]);
  }

  var haveAll = {};
  deduped.forEach(function (r) { if (r.period === 'ALL') haveAll[String(r.metric_id)] = 1; });
  var absent = reg.metrics.filter(function (m) { return !haveAll[String(m.id)]; })
                          .map(function (m) { return m.id; });

  /**
   * REFUSE TO PUBLISH AN INCOMPLETE SET.
   *
   * writeTab_ with an empty array does not leave a tab alone — it clears the sheet and
   * writes "No rows returned" into A1. So a pass that reached the end holding nothing
   * did not skip the write, it destroyed the Metrics tab. A partial set is just as bad
   * in a quieter way: the dashboard reports every missing metric as "not in the Metrics
   * tab at all", which reads like a wiring fault rather than an interrupted job.
   *
   * The previous complete set stays up until a full one is ready to replace it.
   */
  if (absent.length) {
    props.setProperty(METRICS_PROP_AT, '0');           // start the next attempt clean
    logError_('compute', 'incomplete',
      'Refused to publish: ' + deduped.length + ' rows covering ' +
      Object.keys(haveAll).length + ' of ' + reg.metrics.length + ' metrics. Missing ' +
      absent.slice(0, 12).join(', ') + (absent.length > 12 ? ' and ' + (absent.length - 12) + ' more' : '') +
      '. The Metrics tab was left untouched. Most likely two passes overlapped. ' +
      'Run resetComputeMetrics() then computeMetrics().');
    try { metricsScheduleContinuation_(); } catch (e) {}
    logRun_('computeMetrics', 'derived', METRICS_PARTIAL_TAB, deduped.length, elapsed,
      'INCOMPLETE — ' + absent.length + ' metric(s) missing, Metrics tab NOT overwritten');
    Logger.log('INCOMPLETE — ' + absent.length + ' metrics missing. Metrics tab untouched.\n' +
               'Missing: ' + absent.join(', '));
    return { incomplete: true, missing: absent, rows: deduped.length };
  }

  var final = deduped;
  writeTab_('Metrics', final, { headers: headers });
  appendTab_('Metrics_History', final, headers);

  props.deleteProperty(METRICS_PROP_AT);
  props.deleteProperty(METRICS_PROP_RUN);
  try { clearTabRows_(METRICS_PARTIAL_TAB); } catch (e) {}
  try { metricsClearContinuation_(); } catch (e) {}

  var withValue = final.filter(function (r) {
    return r.period === 'ALL' && r.value !== null && r.value !== '';
  }).length;
  var stillNotRun = final.filter(function (r) { return r.status === 'not_run'; }).length;

  logRun_('computeMetrics', 'derived', 'Metrics', final.length, elapsed,
    'COMPLETE — ' + withValue + ' of ' + reg.metrics.length + ' metrics published a value · ' +
    computed + ' computed on the final pass · ' + skipped + ' skipped · ' + failed + ' failed');
  Logger.log('COMPLETE — ' + final.length + ' rows, ' + withValue + ' metrics with a value.');

  if (stillNotRun) {
    logError_('compute', 'not_run',
      stillNotRun + ' row(s) are still marked not_run after a complete pass. Run ' +
      'resetComputeMetrics() then computeMetrics() to rebuild from scratch.');
  }

  // Which calculations are eating the clock. Answers "why did this need three passes".
  try {
    var t = readTab_(METRICS_TIMING_TAB).filter(function (r) { return r.run_date === runDate; })
      .sort(function (a, b) { return (num_(b.ms) || 0) - (num_(a.ms) || 0); });
    if (t.length) {
      Logger.log('Slowest: ' + t.slice(0, 8).map(function (r) {
        return r.metric_id + ' ' + Math.round((num_(r.ms) || 0) / 1000) + 's'; }).join(' · '));
    }
  } catch (e) {}

  return { complete: true, rows: final.length, with_value: withValue,
           computed: computed, skipped: skipped, failed: failed };
}
