    return res_(round1_(onTime / measurable * 100), onTime, measurable, measurable, {
      done_late: n('DONE LATE'),
      overdue: n('OVERDUE'),
      due_soon: n('DUE SOON'),
      scheduled: n('SCHEDULED'),
      no_renewal_date: n('NO RENEWAL DATE'),
      lead_days_standard: RENEWAL.INSPECTION_LEAD_DAYS,
      note: 'Inspection completed at least ' + RENEWAL.INSPECTION_LEAD_DAYS + ' days before ' +
            'the renewal date — a WeLease operating standard, not a statute. Measured only ' +
            'against renewals whose deadline has passed.' });
  },

  /** Days from an onboarding process opening to closing. Lower is better. */
  onboarding_cycle_time: function (D) {
    // Reads BOTH LS_Processes and LS_Tasks_All — see lsOnboardingProcs_. Reading only
    // LS_Processes is why every onboarding tile was blank.
    var all = lsOnboardingProcs_();
    var closed = all.filter(function (p) { return p.created && p.closed; });

    if (!closed.length) {
      var types = {};
      readTab_('LS_Processes').forEach(function (r) {
        types[String(r.process_type || '(none)')] = 1;
      });
      var other = lsOnboardingExcluded_();
      var otherNames = Object.keys(other);
      return res_(null, null, null, 0, {
        onboarding_processes_found: all.length,
        process_types_present: Object.keys(types).length,
        measuring: LS_ONBOARDING.TYPES.join(' / '),
        note: all.length
          ? all.length + ' "' + LS_ONBOARDING.TYPES.join('" / "') + '" process(es) found, ' +
            'none with both an open and a close date. If they are genuinely all still open ' +
            'this fills in as they close; if not, the sync is returning open processes only ' +
            'and the closed ones reach us via their tasks — diagnoseOnboarding() separates ' +
            'those two.'
          : 'No process of type "' + LS_ONBOARDING.TYPES.join('" or "') + '" found across ' +
            Object.keys(types).length + ' types.' +
            (otherNames.length
              ? ' ' + otherNames.length + ' other type(s) do contain "onboard" (' +
                otherNames.join(', ') + ') but are deliberately excluded — if the owner ' +
                'onboarding process has been renamed, update LS_ONBOARDING.TYPES.'
              : ' Run lsListProcessTypes().') });
    }

    var days = [];
    closed.forEach(function (p) {
      var g = daysBetween_(p.created, p.closed);
      if (g !== null && g >= 0) days.push(g);
    });
    if (!days.length) return res_(null, null, null, 0, { note: 'No usable open-to-close dates.' });

    var fromTasks = closed.filter(function (p) {
      return p.sources.indexOf('processes') === -1;
    }).length;

    var excluded = lsOnboardingExcluded_();
    var exNames = Object.keys(excluded);
    return res_(median_(days), null, null, days.length, {
      p90: p90_(days),
      measuring: LS_ONBOARDING.TYPES.join(' / '),
      onboarding_processes_total: all.length,
      recovered_from_tasks_only: fromTasks,
      excluded_types: exNames.length
        ? exNames.map(function (k) { return k + ' (' + excluded[k] + ')'; }).join(', ') : '',
      note: 'The owner onboarding process, created to closed. This is the process LeadSimple ' +
            'opens when an owner is won, so the clock starts when WeLease takes the property ' +
            'on.' +
            (exNames.length ? ' ' + exNames.length + ' other "onboard" type(s) are excluded ' +
                              'on purpose — they start from different events.' : '') +
            (fromTasks ? ' ' + fromTasks + ' were found only through their tasks, not in ' +
                         'LS_Processes.' : '') });
  },

  /** Days from onboarding start to the information-collected step. Lower is better. */
  onboarding_info_collected: function (D) {
    return lsOnboardingStepDays_(/inform.*collect|collect.*inform|gather.*inform/i,
                                 'information collected');
  },

  /** Days from onboarding start to the information-in-system step. Lower is better. */
  onboarding_info_in_system: function (D) {
    return lsOnboardingStepDays_(/in\s*(the\s*)?system|enter.*(appfolio|system)|set\s*up.*system/i,
                                 'information in the system');
  },

  /** Days from onboarding start to proof of insurance. Lower is better. */
  onboarding_proof_of_insurance: function (D) {
