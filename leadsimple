// ============================================================ COMPLETED TASKS

/**
 * The sync pulls only UPCOMING tasks (1,433). Seven deferred metrics need COMPLETED
 * ones — every onboarding and renewal step duration, skipped_step_rate, and
 * automation_failure_rate all read Task.completed_at, Task.step, Task.skipped and
 * Task.auto_send.
 *
 * There are 68,222 of them. A full pull is roughly 75 minutes, so it seeds once,
 * resumably, and then rides updated_since like the processes do — about 285 a day.
 *
 * Only the fields the metrics use are kept. Task descriptions are free text written by
 * staff and occasionally contain resident details; nothing reads them, so they are
 * dropped rather than stored.
 */
var LS_TASK_PROP_PAGE = 'LS_TASK_SEED_PAGE';

/**
 * DO NOT PUBLISH A METRIC FROM time_to_first_touch. Its baseline is unknown.
 *
 * I assumed seconds because 6377 read as 1h 46m and that looked right. Measuring it
 * disagreed: across 60 deals the ratio of real elapsed seconds (created_at to
 * first_contacted_at) against the reported value came out at a median of 23.4 — not 1
 * for seconds, not 60 for minutes, not 3600 for hours. It matches no unit, which means
 * LeadSimple is not measuring from deal creation at all. It could be from assignment,
 * or business hours only, or some other event. A ratio cannot tell them apart.
 *
 * So durations are stored RAW and clearly labelled raw, and lead_first_touch_speed is
 * computed from timestamps this pipeline controls instead. An opaque vendor number with
 * an unknown baseline is worse than a slightly cruder one you can explain.
 *
 * This constant survives only for time_to_close, where nothing downstream reads it yet.
 */
var LS_DURATION_UNIT_VERIFIED = false;

/**
 * Every task, not only completed ones. Named for what it holds — a tab called
 * LS_Tasks_Completed containing skipped and upcoming tasks is the kind of quiet
 * mislabel that produces the next bug.
 */
var LS_TASK_TAB = 'LS_Tasks_All';

/** Hours between two ISO timestamps. Ours, so the definition is knowable. */
function lsHoursBetween_(a, b) {
  if (!a || !b) return null;
  var t0 = new Date(a).getTime(), t1 = new Date(b).getTime();
  if (!isFinite(t0) || !isFinite(t1)) return null;
  var h = (t1 - t0) / 3600000;
  return h < 0 ? null : round2_(h);
}

function lsCompletedTaskRow_(t) {
  var proc = t.process || {}, step = t.step || {}, deal = t.deal || {};
  return {
    task_id: t.id,
    kind: t.kind || null,
    // A third of completed tasks came back with no process type. Those are almost
    // certainly attached to a DEAL rather than a process — the old upcoming-task
    // shaper carried
    // both — and this shape was dropping the deal entirely, so they looked like
    // orphans. Captured now so the count reconciles.
    deal_id: deal.id || null,
    pipeline: (deal.pipeline || {}).name || null,
    // A step object carries { created_at, updated_at, id, kind, description,
    // delay_minutes, sort_order } — verified against the live payload 2026-08-13.
    // There is NO name field. Reading step.name returned undefined on all 57,913
    // tasks, which is why every step came back blank.
    // description is empty on most 'email' steps and populated on 'todo' ones. Falling
    // back to kind alone would collapse every email step in every process into one
    // bucket called "email", which is how a step list stops being a step list.
    step: step.description ||
          (step.kind ? step.kind + ' #' + (step.sort_order === null ||
             step.sort_order === undefined ? '?' : step.sort_order) : null),
    step_kind: step.kind || null,
    step_order: (step.sort_order === null || step.sort_order === undefined)
      ? null : step.sort_order,
    step_id: step.id || null,
    assignee: (t.assignee || {}).name || null,
    due_date: t.due_at ? ymd_(t.due_at) : null,
    completed_date: t.completed_at ? ymd_(t.completed_at) : null,
    skipped: t.skipped ? 'YES' : '',
    auto_send: t.auto_send ? 'YES' : '',
    auto_send_error: t.auto_send_error ? String(t.auto_send_error).slice(0, 120) : '',
    process_id: proc.id || null,
    process_type: (proc.process_type || {}).name || null,
    process_created: proc.created_at ? ymd_(proc.created_at) : null,
    process_closed: proc.closed_at ? ymd_(proc.closed_at) : null
  };
}

/** Removes duplicate rows by key, keeping the last. Cheap: one read, one write. */
function lsDedupeTab_(tabName, keyField) {
  var rows = readTab_(tabName);
  if (!rows.length) return 0;
  var seen = {}, out = [];
  for (var i = rows.length - 1; i >= 0; i--) {
    var k = rows[i][keyField];
    if (k === null || k === undefined || k === '') continue;
    if (seen[k]) continue;
    seen[k] = 1;
    out.unshift(rows[i]);
  }
  if (out.length !== rows.length) writeTab_(tabName, out);
  return out.length;
}

/**
 * Resumable seed. Re-arms itself until it logs SEED COMPLETE.
 *
 * APPENDS, never upserts. lsUpsertTab_ reads the whole tab, merges in memory and
 * rewrites it — fine for the nightly delta of ~285 rows, quietly quadratic across a
 * 342-page backfill. By the last pass it would have been reading 60,000 rows and
 * writing 68,000 before fetching a single page, so each pass would fetch less than the
 * one before it and the seed would crawl.
 *
 * A paginated walk yields distinct pages, so within one seed there is nothing to merge.
 * Re-running a checkpointed page can overlap, which is what the dedupe at the end is
 * for. Safe to paste while a seed is mid-flight: rows already written stay put and the
 * next pass appends after them.
 */
function lsSeedCompletedTasks() {
  // Name kept so an in-flight checkpoint and any existing trigger still resolve. It
  // pulls EVERY task now, not just completed ones — see the fetch below.
  if (!systemEnabled_('leadsimple')) return 'LeadSimple is disabled.';
  var t0 = new Date().getTime();
  var props = PropertiesService.getScriptProperties();
  var page = parseInt(props.getProperty(LS_TASK_PROP_PAGE) || '1', 10) || 1;

  // A fresh seed over a tab that already holds rows would double everything.
  if (page === 1 && readTab_(LS_TASK_TAB).length) {
    clearTabRows_(LS_TASK_TAB);
    Logger.log('Starting from page 1 — cleared the previous ' + LS_TASK_TAB + ' contents.');
  }

  // 240s not 270s. The old margin let one more page start and then spend the overrun
  // writing; the observed pass ran 6m04s against a 6m ceiling.
  // NO due_type FILTER. due_type=completed never returns a skipped task — measured at
  // 0 of 50 there against 6 of 50 unfiltered — so seeding the completed set made
  // skipped_step_rate structurally unmeasurable rather than merely zero. The tab holds
  // every task now, and metrics that want completions filter on completed_date.
  var res = lsPaged_('/tasks', {},
                     { startedAt: t0, budgetMs: 240000, startPage: page });
  var rows = (res.rows || []).map(lsCompletedTaskRow_);
  if (rows.length) {
    appendTab_(LS_TASK_TAB, rows,
      ['task_id', 'kind', 'deal_id', 'pipeline', 'step', 'step_kind', 'step_order',
       'step_id', 'assignee', 'due_date', 'completed_date', 'skipped', 'auto_send',
       'auto_send_error', 'process_id', 'process_type', 'process_created',
       'process_closed']);
  }

  if (res.complete) {
    props.deleteProperty(LS_TASK_PROP_PAGE);
    lsClearContinuation_('lsSeedCompletedTasks');
    var total = lsDedupeTab_(LS_TASK_TAB, 'task_id');
    logRun_('lsSeedCompletedTasks', 'leadsimple', LS_TASK_TAB, total,
            new Date().getTime() - t0, 'SEED COMPLETE — ' + total + ' completed tasks');
    Logger.log('SEED COMPLETE — ' + total + ' completed tasks. Run lsListSteps() next.');
    return 'complete';
  }
  props.setProperty(LS_TASK_PROP_PAGE, String(res.nextPage || (page + 1)));
  lsScheduleContinuation_('lsSeedCompletedTasks');
  logRun_('lsSeedCompletedTasks', 'leadsimple', LS_TASK_TAB, rows.length,
          new Date().getTime() - t0,
          'PARTIAL — +' + rows.length + ' rows, paused at page ' + (res.nextPage || page + 1));
  Logger.log('PARTIAL — +' + rows.length + ' rows, paused at page ' +
             (res.nextPage || page + 1) + '. Continues in ~1 minute.');
  return 'partial';
}

/** Every step name LeadSimple actually uses, so LS_STEPS can be written from fact. */
function lsListSteps() {
  var by = {};
  readTab_(LS_TASK_TAB).forEach(function (r) {
    var k = (r.process_type || '(no type)') + '  ::  ' + (r.step || '(no step)');
    var b = by[k] || (by[k] = { k: k, n: 0, skipped: 0 });
    b.n++;
    if (r.skipped === 'YES') b.skipped++;
  });
  var rows = Object.keys(by).map(function (k) { return by[k]; })
    .sort(function (a, b) { return b.n - a.n; });
  var out = rows.length
    ? rows.map(function (r) {
        return String(r.n).padStart(6) + ' tasks  ' + String(r.skipped).padStart(4) +
               ' skipped   ' + r.k; }).join('\n')
    : LS_TASK_TAB + ' is empty — run lsSeedCompletedTasks() first.';
  Logger.log(out);
  return out;
}

// ============================================================ DEAL DATA REVIEW

/**
 * The outliers that were making a good field look broken.
 *
 * time_to_first_touch IS in hours — Frank, 2026-08-13. My ratio check called it
 * UNCLEAR because it compared every deal including the ones nobody should be measuring:
 * leads tagged "Bad Email Address" or "Unsubscribed", deals that sat dormant for months
 * before anyone tried, records where first_contacted_at was backfilled. A median across
 * those says nothing about how fast the team responds.
 *
 * So this is a worksheet, in the same shape as Master_Units: the pipeline recomputes the
 * signals every night and suggests an action, and the `action` column is yours and never
 * overwritten.
 *
 *   action = IGNORE   left out of every timing metric
 *   action = KEEP     included, overriding the suggestion
 *   action = FIXED    you corrected it in LeadSimple; treated as KEEP until it recomputes
 *   action = blank    follow `suggested`
 *
 * Reversing anything is deleting the value in that column.
 */
var LS_REVIEW_TAB = 'LS_Deal_Review';

/** Tags that mean the clock was never really running on this lead. */
var LS_DEAD_TAGS = [/bad\s*e-?mail/i, /unsubscrib/i, /do\s*not\s*contact/i,
                    /spam/i, /duplicate/i, /test/i, /wrong\s*number/i];

/** Beyond this, "time to first touch" is describing a dormant record, not a response. */
var LS_TOUCH_OUTLIER_HOURS = 336;      // two weeks

function lsDeadTags_(tags) {
  var t = String(tags || '');
  if (!t) return [];
  var hits = [];
  LS_DEAD_TAGS.forEach(function (re) {
    var m = t.match(re);
    if (m) hits.push(m[0]);
  });
  return hits;
}

function buildLeadSimpleReview() {
  var t0 = new Date().getTime();
  var deals = readTab_('LS_Deals');
  if (!deals.length) return { rows: 0 };

  // Your column, preserved by deal_id.
  var prevBy = {};
  readTab_(LS_REVIEW_TAB).forEach(function (r) {
    if (r.deal_id) prevBy[String(r.deal_id)] = r;
  });

  var rows = [];
  deals.forEach(function (d) {
    var vendor = num_(d.ls_time_to_first_touch_raw);
    var ours = num_(d.hours_to_first_touch);
    var dead = lsDeadTags_(d.tags);
    var flags = [];

    if (dead.length) flags.push('tagged: ' + dead.join(', '));
    if (vendor !== null && vendor > LS_TOUCH_OUTLIER_HOURS) {
      flags.push('first touch after ' + Math.round(vendor / 24) + ' days');
    }
    if (d.is_active === 'YES' && d.never_contacted === 'YES') flags.push('never contacted');
    // The two numbers should agree if both measure the same thing. Where they do not,
    // one of the timestamps is wrong, and that is worth a human look rather than a guess.
    if (vendor !== null && ours !== null && vendor > 0) {
      var gap = Math.abs(ours - vendor) / Math.max(vendor, 1);
      if (gap > 0.5) {
        flags.push('vendor ' + round1_(vendor) + 'h vs computed ' + round1_(ours) + 'h');
      }
    }
    if (vendor === null && ours === null && d.is_active === 'YES') {
      flags.push('no timing on an active deal');
    }

    if (!flags.length) return;                       // nothing to review

    var prev = prevBy[String(d.deal_id)] || {};
    rows.push({
      deal_id: d.deal_id,
      deal: d.deal_name || '',
      contact: d.contact || d.company || '',
      assignee: d.assignee || '',
      stage: d.stage || '',
      stage_status: d.stage_status || '',
      tags: d.tags || '',
      created: d.created_date || '',
      first_contacted: d.first_contacted_date || '',
      vendor_hours: vendor === null ? '' : round1_(vendor),
      computed_hours: ours === null ? '' : round1_(ours),
      why: flags.join(' · '),
      // A dead tag is not a response-time failure, so the default is to leave it out.
      suggested: dead.length ? 'IGNORE'
               : (vendor !== null && vendor > LS_TOUCH_OUTLIER_HOURS) ? 'IGNORE' : 'REVIEW',
      action: prev.action || '',                      // YOUR column — never overwritten
      note: prev.note || '',
      link: d.link || ''
    });
  });

  rows.sort(function (a, b) {
    // Undecided first, then the biggest distortions.
    var ap = a.action ? 1 : 0, bp = b.action ? 1 : 0;
    if (ap !== bp) return ap - bp;
    return (num_(b.vendor_hours) || 0) - (num_(a.vendor_hours) || 0);
  });

  writeTab_(LS_REVIEW_TAB, rows.length ? rows
    : [{ note: 'No deal needs review. Every active deal has plausible timing and no ' +
               'disqualifying tag.' }]);

  var undecided = rows.filter(function (r) { return !r.action; }).length;
  logRun_('buildLeadSimpleReview', 'leadsimple', LS_REVIEW_TAB, rows.length,
          new Date().getTime() - t0,
          rows.length + ' deal(s) flagged · ' + undecided + ' awaiting a decision');
  return { rows: rows.length, undecided: undecided };
}

/**
 * Deal ids to leave out of timing metrics.
 *
 * Blank action follows the suggestion, so a freshly flagged "Bad Email Address" lead is
 * excluded on the first night rather than waiting for someone to confirm it. KEEP and
 * FIXED override that and put the deal back in.
 */
function lsIgnoredDeals_() {
  var out = {};
  readTab_(LS_REVIEW_TAB).forEach(function (r) {
    if (!r.deal_id) return;
    var a = String(r.action || '').trim().toUpperCase();
    if (a === 'KEEP' || a === 'FIXED') return;
    if (a === 'IGNORE') { out[String(r.deal_id)] = r.why || 'excluded by hand'; return; }
    if (!a && String(r.suggested || '').toUpperCase() === 'IGNORE') {
      out[String(r.deal_id)] = r.why || 'suggested';
    }
  });
  return out;
}

// ============================================================ ONBOARDING STEPS

/**
 * Where the time actually goes inside owner onboarding.
 *
 * A single cycle-time number tells you onboarding takes N days. It does not tell you which
 * step is eating them, so it cannot tell you what to fix. Frank's example — sending the
 * onboarding documents takes time — is exactly the kind of thing that is invisible in a
 * median and obvious in a step breakdown.
 *
 * Per step: how many processes reached it, the median and p90 days from the process opening
 * to that step completing, how long the step waited after the PREVIOUS one, how often it is
 * skipped, and how many processes are sitting at it right now unfinished.
 *
 * DAYS FROM PROCESS START, not from the step being created. LeadSimple creates every step up
 * front, so a "step age" would just be the process age for all of them. Elapsed-since-start
 * is what compounds into the cycle time, and the gap between consecutive steps is what
 * isolates the slow one.
 */
/**
 * One row per onboarding, in the shape a person asks about it.
 *
 * The step table answers "where does the time go". This answers "how did THIS owner's
 * onboarding go", which is the question the team actually has, and it is the only place
 * the TPO / Full PMA split can live — because the split is a property of the process,
 * not of a step.
 *
 * THREE THINGS IT MEASURES AND WHY EACH ONE IS DEFINED THE WAY IT IS.
 *
 * FIRST TOUCH is process creation to the first intro email, automated or not. The owner
 * has no idea which kind it was. Measuring only manual emails here would report a first
 * touch of "never" for every owner the automation served correctly.
 *
 * MANUAL EMAILS are counted separately, and they are the ones that measure the team. An
 * automated send completes whether anyone is watching; including it in an adherence
 * figure measures LeadSimple's uptime.
 *
 * SUBJECT CONSISTENCY is the share of onboardings that received each manual email. A
 * subject sent to 40% of owners is either optional — in which case it should not be a
 * step — or it is being missed. Both are worth knowing; neither is visible from a
 * completion count alone.
 */
function buildOnboardingJourneys() {
  var t0 = new Date().getTime();
  var procs = lsOnboardingProcs_();
  if (!procs.length) {
    writeTab_('Onboarding_Journeys', [{ note: 'No onboarding processes. Run diagnoseOnboarding().' }]);
    return { processes: 0 };
  }

  var byId = {};
  procs.forEach(function (p) {
    byId[p.id] = { process_id: p.id, created: p.created || null, closed: p.closed || null,
                   service: null, first_email: null, first_email_auto: '',
                   manual_emails_sent: 0, manual_emails_open: 0, ms: {}, subjects: {} };
  });

  var emailSubjects = {};     // subject -> { auto, sent, processes }
  readTab_('LS_Tasks_All').forEach(function (r) {
    var j = byId[r.process_id];
    if (!j) return;
    var name = String(r.step || '').trim();
    if (!name) return;
    var isEmail = String(r.step_kind || '').toLowerCase().indexOf('email') > -1;
    var auto = String(r.auto_send || '') === 'YES';
    var done = ymd_(r.completed_date);

    // The service branch. Whichever intro email fired names it.
    if (!j.service && LS_ONBOARDING.FIRST_TOUCH.test(name)) {
      var svc = lsServiceOf_(name);
      // Only a COMPLETED intro email settles the branch. Both sit on every process; the
      // one that did not fire is skipped, and reading the unfired one would label half
      // the portfolio with the wrong service.
      if (svc && done) j.service = svc;
    }

    // First touch: earliest completed intro email, whoever or whatever sent it.
    if (isEmail && done && LS_ONBOARDING.FIRST_TOUCH.test(name)) {
      if (!j.first_email || done < j.first_email) {
        j.first_email = done;
        j.first_email_auto = auto ? 'YES' : '';
      }
    }

    // Manual email traffic — the part that measures the team.
    if (isEmail && !auto) {
      var s = emailSubjects[name] || (emailSubjects[name] = { subject: name, sent: 0, open: 0, procs: {} });
      s.procs[r.process_id] = 1;
      if (done) { s.sent++; j.manual_emails_sent++; j.subjects[name] = 1; }
      else if (String(r.skipped || '') !== 'YES' && !j.closed) { s.open++; j.manual_emails_open++; }
    }

    var key = lsMilestoneOf_(name);
    if (key && done && (!j.ms[key] || done < j.ms[key])) j.ms[key] = done;
  });

  var rows = Object.keys(byId).map(function (id) {
    var j = byId[id];
    var row = {
      process_id: id,
      created: j.created, closed: j.closed,
      service: j.service || 'UNKNOWN',
      is_open: j.closed ? '' : 'YES',
      first_touch_date: j.first_email || '',
      first_touch_days: (j.created && j.first_email) ? daysBetween_(j.created, j.first_email) : null,
      first_touch_automated: j.first_email_auto,
      manual_emails_sent: j.manual_emails_sent,
      manual_emails_open: j.manual_emails_open,
      cycle_days: (j.created && j.closed) ? daysBetween_(j.created, j.closed) : null,
      age_days: j.created && !j.closed ? daysBetween_(j.created, ymd_(today_())) : null
    };
    LS_ONBOARDING.MILESTONES.forEach(function (m) {
      var d = j.ms[m.key] || '';
      row[m.key + '_date'] = d;
      row[m.key + '_days'] = (j.created && d) ? daysBetween_(j.created, d) : null;
    });
    return row;
  }).sort(function (a, b) { return String(b.created) < String(a.created) ? -1 : 1; });

  writeTab_('Onboarding_Journeys', rows);

  // Consistency, per manual email subject.
  var total = rows.length;
  var subs = Object.keys(emailSubjects).map(function (k) {
    var s = emailSubjects[k];
    var reached = Object.keys(s.procs).length;
    return {
      subject: s.subject,
      onboardings_with_this_step: reached,
      sent: s.sent,
      still_open: s.open,
      sent_pct: reached ? round1_(s.sent / reached * 100) : null,
      coverage_pct: total ? round1_(reached / total * 100) : null
    };
  }).sort(function (a, b) { return (a.sent_pct || 0) - (b.sent_pct || 0); });
  writeTab_('Onboarding_Emails', subs);

  var unknown = rows.filter(function (r) { return r.service === 'UNKNOWN'; }).length;
  if (unknown) {
    logError_('leadsimple', 'onboarding',
      unknown + ' of ' + rows.length + ' onboarding(s) could not be identified as TPO or ' +
      'Full PMA, because neither intro email is recorded as completed. They are shown ' +
      'separately rather than folded into one of the two — the split only means something ' +
      'if every process is on one side of it.');
  }

  logRun_('buildOnboardingJourneys', 'derived', 'Onboarding_Journeys', rows.length,
          new Date().getTime() - t0,
          rows.length + ' onboarding(s) · ' + subs.length + ' manual email subject(s) · ' +
          unknown + ' unidentified service');
  return { processes: rows.length, subjects: subs.length, unknown: unknown };
}

function buildOnboardingSteps() {
  var t0 = new Date().getTime();
  var t = ymd_(today_());

  var procs = lsOnboardingProcs_();
  if (!procs.length) {
    writeTab_('Onboarding_Steps', [{
      note: 'No "' + LS_ONBOARDING.TYPES.join('" / "') + '" process found. Run ' +
            'diagnoseOnboarding() — it lists every type containing "onboard" and marks ' +
            'which one is being measured.' }]);
    logRun_('buildOnboardingSteps', 'derived', 'Onboarding_Steps', 0,
            new Date().getTime() - t0, 'no onboarding processes');
    return { steps: 0, processes: 0 };
  }

  var startOf = {}, closeOf = {};
  procs.forEach(function (p) {
    if (p.created) startOf[p.id] = p.created;
    if (p.closed) closeOf[p.id] = p.closed;
  });

  // Gather every task belonging to an onboarding process, keyed by step name.
  var steps = {};
  var order = {};
  var tasksSeen = 0, withStepName = 0;
  readTab_('LS_Tasks_All').forEach(function (r) {
    var start = startOf[r.process_id];
    if (!start) return;
    tasksSeen++;
    var name = String(r.step || '').trim();
    if (!name) return;
    withStepName++;

    var b = steps[name] || (steps[name] = {
      name: name, reached: 0, completed: 0, skipped: 0, open: 0,
      days: [], processes: {}, autoFail: 0 });
    b.reached++;
    b.processes[r.process_id] = 1;
    if (r.skipped === 'YES') b.skipped++;
    if (r.auto_send_error) b.autoFail++;

    // sort_order puts the table in the sequence the team works, not alphabetically.
    var so = num_(r.step_order);
    if (so !== null) {
      order[name] = (order[name] === undefined) ? so : Math.min(order[name], so);
    }

    var done = ymd_(r.completed_date);
    if (done) {
      b.completed++;
      var g = daysBetween_(start, done);
      if (g !== null && g >= 0) b.days.push({ d: g, pid: r.process_id });
    } else if (r.skipped !== 'YES' && !closeOf[r.process_id]) {
      // Still open, on a process that has not closed — someone is waiting on this.
      b.open++;
    }
  });

  var names = Object.keys(steps);
  if (!names.length) {
    writeTab_('Onboarding_Steps', [{
      note: procs.length + ' onboarding process(es) found and ' + tasksSeen + ' task(s) ' +
            'belong to them, but none carries a step name. Tasks seeded before the ' +
            'step.description fix have a blank step column — re-run lsSeedCompletedTasks().' }]);
    logError_('leadsimple', 'onboarding steps',
      tasksSeen + ' onboarding tasks carry no step name. Re-run lsSeedCompletedTasks().');
    logRun_('buildOnboardingSteps', 'derived', 'Onboarding_Steps', 0,
            new Date().getTime() - t0, 'no step names on ' + tasksSeen + ' tasks');
    return { steps: 0, processes: procs.length };
  }

  names.sort(function (a, b) {
    var oa = order[a] === undefined ? 9999 : order[a];
    var ob = order[b] === undefined ? 9999 : order[b];
    return oa - ob || a.localeCompare(b);
  });

  var rows = [], prevMedian = null;
  names.forEach(function (name, i) {
    var b = steps[name];
    var ds = b.days.map(function (x) { return x.d; });
    var med = ds.length ? median_(ds) : null;

    // The wait ADDED by this step: its median elapsed minus the previous step's. Negative
    // values are possible when steps complete out of order, and are reported as 0 rather
    // than as time saved — a step cannot give days back.
    var added = (med !== null && prevMedian !== null) ? Math.max(0, round1_(med - prevMedian))
              : (med !== null && i === 0 ? med : null);

    rows.push({
      seq: i + 1,
      step: name,
      processes_reached: Object.keys(b.processes).length,
      completed: b.completed,
      still_open: b.open,
      skipped: b.skipped,
      skipped_pct: b.reached ? round1_(b.skipped / b.reached * 100) : null,
      median_days_from_start: publishNum_(med),
      p90_days_from_start: publishNum_(ds.length ? p90_(ds) : null),
      days_added_by_this_step: publishNum_(added),
      slowest_days: ds.length ? Math.max.apply(null, ds) : null,
      automation_failures: b.autoFail
    });
    if (med !== null) prevMedian = med;
  });

  // The bottleneck: the step adding the most elapsed time, among steps with enough
  // observations to mean anything.
  var ranked = rows.filter(function (r) {
    return num_(r.days_added_by_this_step) !== null && r.completed >= 3;
  }).sort(function (a, b) {
    return num_(b.days_added_by_this_step) - num_(a.days_added_by_this_step);
  });

  writeTab_('Onboarding_Steps', rows);

  var summary = {
    run_date: nowStamp_(),
    metric: 'onboarding_step_breakdown',
    measuring: LS_ONBOARDING.TYPES.join(' / '),
    processes: procs.length,
    closed_processes: procs.filter(function (p) { return p.created && p.closed; }).length,
    steps: rows.length,
    tasks_with_a_step_name: withStepName,
    tasks_total: tasksSeen,
    slowest_step: ranked.length ? ranked[0].step : null,
    slowest_step_days_added: ranked.length ? ranked[0].days_added_by_this_step : null,
    steps_with_anyone_waiting: rows.filter(function (r) { return r.still_open > 0; }).length
  };
  appendTab_('Metrics_History', [summary]);

  logRun_('buildOnboardingSteps', 'derived', 'Onboarding_Steps', rows.length,
          new Date().getTime() - t0,
          rows.length + ' steps across ' + procs.length + ' process(es)' +
          (summary.slowest_step ? ' · slowest: "' + summary.slowest_step + '" adding ' +
            summary.slowest_step_days_added + ' days' : ''));
  Logger.log(JSON.stringify(summary, null, 1));
  return summary;
}
