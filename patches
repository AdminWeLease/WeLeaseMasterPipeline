/** A neutral category for a work order. NEVER returns source text. */
function workCategory_(w) {
  if (!w) return 'General repair';
  if (String(w.work_order_type || '').trim().toLowerCase() === 'unit turn') return 'Unit turnover';
  var hay = String(w.vendor_trade || '') + ' ' + String(w.work_order_type || '') + ' ' +
            String(w.job_description || '');
  for (var i = 0; i < WORK_CATEGORIES.length; i++) {
    if (WORK_CATEGORIES[i][0].test(hay)) return WORK_CATEGORIES[i][1];
  }
  return 'General repair';
}

