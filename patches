// 7. RECEIPTS BY PROPERTY — add to buildRentCollection, after the existing loop.
//
// Receivables_Activity already carries property_id (see COLS.receivables_activity), so
// this needs no new AppFolio call. The existing monthly roll-up is untouched.
// =====================================================================================

function buildRentCollectionByProperty(monthsBack) {
  var t0 = new Date().getTime();
  monthsBack = monthsBack || 12;
  var rec = inScopeIncludingInactive_(readTab_('Receivables_Activity'));

  var agg = {};
  rec.forEach(function (r) {
    var m = monthKey_(r.txn_receipt_date);
    var pid = String(r.property_id || '');
    var amt = num_(r.txn_amount);
    if (!m || !pid || amt === null) return;
    var k = m + '|' + pid;
    var b = agg[k] || (agg[k] = { month: m, property_id: pid, property_name: r.property_name || '',
                                  collected: 0, refunds: 0, receipts: 0, households: {} });
    b.collected += amt;
    if (amt < 0) b.refunds += amt;
    if (amt > 0) { b.receipts++; if (r.occupancy_id) b.households[r.occupancy_id] = 1; }
  });

  // Rent charged per property, so a collection rate can be stated per owner.
  var chargedByProp = {};
  dropTPO_(readTab_('Rent_Roll')).forEach(function (r) {
    if (String(r.status || '').toLowerCase().indexOf('current') === -1) return;
    var pid = String(r.property_id || '');
    if (!pid) return;
    chargedByProp[pid] = (chargedByProp[pid] || 0) + (num_(r.rent) || 0);
  });

  var thisMonth = monthKey_(ymd_(today_()));
  var rows = Object.keys(agg).sort().map(function (k) {
    var b = agg[k];
    var charged = chargedByProp[b.property_id];
    return {
      month: b.month,
      property_id: b.property_id,
      property_name: b.property_name,
      is_partial: (b.month === thisMonth) ? 'YES' : '',
      rent_charged_now: charged === undefined ? null : round2_(charged),
      rent_collected: round2_(b.collected),
      refunds_and_reversals: round2_(b.refunds),
      receipts: b.receipts,
      households_paying: Object.keys(b.households).length,
      // Rent charged is TODAY's rent roll, not the rent in force in that month. Fine for the
      // current month, unreliable for history — which is why the column says "_now".
      collected_vs_charged_pct: (b.month === thisMonth || !charged || charged <= 0) ? null
        : round1_(b.collected / charged * 100),
      basis: 'collected = every resident receipt on that property, cash basis, not rent only'
    };
  });

  writeTab_('Rent_Collection_ByProperty', rows);
  logRun_('buildRentCollectionByProperty', 'derived', 'Rent_Collection_ByProperty',
          rows.length, new Date().getTime() - t0,
          rows.length + ' property-month(s) across ' +
          Object.keys(chargedByProp).length + ' properties');
  return { rows: rows.length };
}
