// 2. STALE ESTIMATES — add to Core, and use everywhere an approval is shown to an owner.
//
// estimate_approval_status is a leftover, not a state. Of 252 work orders reading
// "Pending" on this account, 147 are CANCELED and 74 are COMPLETED. Only 31 are genuinely
// waiting on anybody, and 169 of the stale ones closed more than sixty days ago — the
// oldest in August 2025.
//
// The prototype owner brief asked Ritter-Krutop to approve #11187-3, bathtub caulking at
// 8937 1/2 Fair Lane. That order was canceled on 6 July 2026. An owner replying "go ahead"
// would be approving work that cannot happen.
// =====================================================================================

/** True only when an estimate is genuinely waiting on the owner. */
function estimateAwaitingOwner_(w) {
  if (!w) return false;
  var st = String(w.estimate_approval_status || '').trim().toLowerCase();
  if (st !== 'pending' && st !== 'requested' && st !== 'sent') return false;
  if (ymd_(w.completed_on)) return false;          // work is done; nothing left to approve
  if (ymd_(w.canceled_on)) return false;           // work was called off
  var s = String(w.status || '').trim().toLowerCase();
  if (s === 'canceled' || s === 'cancelled' || s === 'completed' ||
      s === 'completed no need to bill') return false;
  return true;
}

/** Stale approvals, for the internal QA sheet — never for an owner. */
function staleEstimates_(workOrders) {
  var out = [];
  (workOrders || []).forEach(function (w) {
    var st = String(w.estimate_approval_status || '').trim().toLowerCase();
    if (st !== 'pending' && st !== 'requested' && st !== 'sent') return;
    var closed = ymd_(w.canceled_on) || ymd_(w.completed_on);
    if (!closed) return;
    out.push({
      work_order_number: w.work_order_number || '',
      property: w.property_name || '',
      closed_on: closed,
      closed_as: ymd_(w.canceled_on) ? 'canceled' : 'completed',
      days_stale: daysBetween_(closed, ymd_(today_())),
      estimate_status: w.estimate_approval_status,
      vendor: w.vendor || ''
    });
  });
  out.sort(function (a, b) { return (b.days_stale || 0) - (a.days_stale || 0); });
  return out;
}


