/*  IN setupOwnerUpdateScope, REPLACE the headers line:

      var headers = ['owner_key', 'doors', 'include', 'preferred_name', 'contact_email',
                     'prepared_by', 'notes'];
    WITH:
      var headers = ['portfolio_id', 'owner_key', 'doors', 'include', 'preferred_name',
                     'contact_email', 'prepared_by', 'notes'];

    and in the row builder add:   portfolio_id: e.portfolio_id || '',

    IN buildOwnerPacks, REPLACE the scope loop so several owner_keys can share a pack:     */

function ownerPackGroups_(scope) {
  var groups = {}, order = [];
  scope.forEach(function (s) {
    var id = String(s.portfolio_id || '').trim() || String(s.owner_key || '').trim();
    if (!groups[id]) {
      groups[id] = { portfolio_id: id, keys: [], preferred_name: '', contact_email: '',
                     prepared_by: '', notes: '' };
      order.push(id);
    }
    var g = groups[id];
    g.keys.push(String(s.owner_key || '').trim());
    // First non-blank wins, so one row carries the display name for the whole portfolio.
    ['preferred_name', 'contact_email', 'prepared_by', 'notes'].forEach(function (f) {
      if (!g[f] && s[f]) g[f] = s[f];
    });
  });
  return order.map(function (id) { return groups[id]; });
}

