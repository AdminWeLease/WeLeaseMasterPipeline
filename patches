// 3. ONE CANONICAL ADDRESS COLUMN — in pull_() and pullWindowed_(), before writeTab_.
//
// addr_() already produces street-number-first addresses (324 of 326 on this account).
// The problem is that Rent_Roll, Work_Orders and Inspections carry no address column, so
// every consumer re-derives one and each does it differently. Derive it once.
//
//   var n = writeTab_(tab, rows);
// becomes
//   rows = addAddressColumn_(tab, rows);
//   var n = writeTab_(tab, rows);
// =====================================================================================

function addAddressColumn_(tab, rows) {
  if (!rows || !rows.length) return rows;
  var r0 = rows[0];
  var hasStreet = ('property_street' in r0) || ('street' in r0) || ('unit_street' in r0);
  var needsLookup = !hasStreet && (('unit_id' in r0) || ('property_id' in r0));
  if (!hasStreet && !needsLookup) return rows;

  var byUnit = {}, byProp = {};
  if (needsLookup) {
    ['Unit_Directory_All', 'Unit_Directory'].forEach(function (t) {
      (readTab_(t) || []).forEach(function (u) {
        if (u.unit_id && !byUnit[u.unit_id]) byUnit[u.unit_id] = u;
        if (u.property_id && !byProp[u.property_id]) byProp[u.property_id] = u;
      });
    });
    ['Properties_All', 'Properties_Units'].forEach(function (t) {
      (readTab_(t) || []).forEach(function (p) {
        if (p.property_id && !byProp[p.property_id]) byProp[p.property_id] = p;
      });
    });
  }

  var unresolved = 0;
  var out = rows.map(function (r) {
    var o = {};
    Object.keys(r).forEach(function (k) { o[k] = r[k]; });
    var src = r;
    if (needsLookup) {
      var f = (r.unit_id && byUnit[r.unit_id]) || (r.property_id && byProp[r.property_id]);
      if (f) {
        src = { property_street: f.property_street || f.unit_street || f.street || '',
                property_street2: f.property_street2 || f.unit_street2 || f.street2 || '',
                unit: r.unit || r.unit_name || f.unit_name || '',
                property_name: r.property_name || f.property_name || '' };
      } else { unresolved++; }
    }
    // ALWAYS set the key, even when blank. writeTab_ takes headers from unionKeys_, which
    // samples only the first 200 rows — a conditionally-set key can be dropped silently.
    o.address = '';
    try { o.address = addrTidyOutput_(addr_(src)); } catch (e) { o.address = ''; }
    return o;
  });

  if (unresolved) {
    logError_('pipeline', 'address',
      tab + ': ' + unresolved + ' row(s) carry no street field and could not be resolved ' +
      'from Unit_Directory_All by unit_id or property_id. Their address column is blank ' +
      'rather than guessed.');
  }
  return out;
}


// =====================================================================================
// 4. addr_() COSMETIC FIXES — three bugs visible in its own output today.
//
//   450 W Vermont Ave ##904     24 rows   street2 already held a #, addr_ added another
//   4195 Marzo St. #Back House  11 rows   full stop left in front of the hash
//   45129 Via  Quivera           1 row    double space
//
// Rather than edit addr_() blind, wrap its output. If you prefer, fold this into addr_()
// itself as the last line before it returns.
// =====================================================================================

function addrTidyOutput_(s) {
  return String(s === null || s === undefined ? '' : s)
    .replace(/#\s*#/g, '#')
    .replace(/\.\s*#/g, ' #')
    .replace(/\s{2,}/g, ' ')
    // "1134 Koe St #1134" — the unit repeats the building number already at the front.
    .replace(/^(\d+(?:\s+1\/2)?)(\s+.*?)\s+#\s*\1$/, '$1$2')
    .trim();
}


