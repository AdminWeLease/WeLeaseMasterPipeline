/**
 * WeLease Pipeline — UTILITY BILLING SCHEDULE  v2.0.0 · 2026-08-05
 * Requires Core_v2.gs, Shared.gs, Metrics.gs (readTab_), Discover_v2.gs (sleepFor_).
 *
 * WHAT THIS IS
 *   A compliance clock, not a bill processor. It watches every recurring utility
 *   account, learns its cycle from posted history, projects when the next posting is
 *   due, and alerts when one is late. It also checks that the service period is
 *   recorded, because that is what makes a charge auditable.
 *
 * THE CLOCK — Frank's 4195 Marzo St example, which is the test case
 *   Water charge posted            2026-08-03   (GL 6173, Occupancy 821, Front House)
 *   + 2-month cycle -> expected    2026-10-03
 *   + 5-day window  -> POST BY     2026-10-08   <- the compliance deadline
 *   + 3 days grace  -> alert after 2026-10-11
 *   Calendar days throughout.
 *
 *   NOTE FOR ANYONE READING v1: the old "Jul 25 issued -> Aug 04 post by" chain is
 *   RETIRED. That version anchored on the date the bill was RECEIVED and added a
 *   5-day receive window plus a 5-day processing window. v2 anchors on WeLease's own
 *   POSTING date, which already absorbs receipt, so there is ONE 5-day window. Keeping
 *   both windows would have pushed every deadline five days late.
 *
 * HOW ACCOUNTS ARE GROUPED — this is the part that is easy to get wrong
 *   Water and sewer are NEVER billed separately. The providers WeLease uses bill sewer
 *   inside the water bill, and it always posts to 6173. So 6173 and 6174 are ONE clock,
 *   and a stray 6174 posting is folded in and flagged rather than creating a phantom
 *   second clock that reads as permanently missing.
 *
 *   Energy is grouped by PROVIDER. SDG&E bills gas and electric together (6177), but
 *   some properties post gas alone (6172) or electric alone (6171) depending on setup.
 *   Grouping by payee means one SDG&E bill is one clock however it was coded, and a
 *   different provider on the same property gets its own clock automatically.
 *
 * WHICH POSTING STOPS THE CLOCK
 *   Resident charges and vendor bills BOTH post to the same GL — a resident water
 *   charge and the City of San Diego bill are both 6173. Per property, the schedule
 *   locks onto whichever side that property actually uses: resident charges where they
 *   exist, otherwise the vendor bill. The measured side is reported on every row, so a
 *   property is never silently measured on the wrong thing.
 *
 * WHAT COUNTS AS ONE BILL
 *   Marzo has a Front House and a Back House. One water bill becomes two resident
 *   charges, and they may not post on the same day. Charges are grouped by SERVICE
 *   PERIOD, so "May 05 - Jul 06, 2026" is one bill no matter when each unit was
 *   charged. Date-clustering is only the fallback when no period is recorded.
 *
 * WHAT THIS DOES NOT DO
 *   No allocation, no import files. Multifamily bill splitting happens outside this
 *   pipeline. This module answers one question: did the posting happen, on time, with
 *   its service period intact.
 */

// ============================================================ CONFIG

var USCHED = {
  // The clock. Anchored on our own posting date, so there is a single window.
  POST_WINDOW_DAYS: 5,      // expected posting date -> compliance deadline
  ALERT_GRACE_DAYS: 3,      // deadline -> raise the alert
  DUE_SOON_DAYS: 5,         // how far ahead "Due Soon" looks

  LOOKBACK_MONTHS: 24,      // history used to infer a cycle
  MIN_EVENTS_TO_INFER: 3,   // below this, say so rather than guess

  // Recurring-with-rent signature. Every signal is reported so the call is auditable.
  RECURRING_DOM_MAX: 3,
  RECURRING_GAP_MIN: 26,
  RECURRING_GAP_MAX: 35,
  RECURRING_AMOUNT_CV: 0.06,

  SAME_EVENT_DAYS: 4        // fallback only, when no service period is recorded
};

/**
 * SCOPE — what the schedule measures. Added 2026-08-06 at Frank's direction.
 *
 * The point of this clock is to hold WeLease to the standard a utility company is held
 * to: charge the resident consistently, every cycle, on time. That reframes what belongs
 * in it.
 *
 * TENANT_CHARGES_ONLY    Vendor bills and owner draws are how WeLease pays the provider.
 *                        They are not what the resident sees. Vendor rows are still read,
 *                        but ONLY to learn the provider name — a resident charge never
 *                        carries one.
 *
 * MIN_POSTINGS_TO_TRACK  A property posted once, three years ago, is not a billing cycle.
 *                        Those previously surfaced as "INSUFFICIENT HISTORY", which reads
 *                        as a task. Now dropped and written to Utility_Schedule_Dropped,
 *                        so nothing disappears silently.
 *
 * ACTIVE_PROPERTIES_ONLY Ledger history outlives the management relationship. We cannot
 *                        post a utility charge for a property we no longer manage.
 *
 * SINGLE-FAMILY          A single-family resident is usually billed directly by the
 *                        provider, leaving nothing for WeLease to post. Excluded by
 *                        default UNLESS the team has demonstrably been posting by hand —
 *                        proven by MIN_MANUAL_POSTINGS_SFH postings carrying a typed
 *                        service period.
 */
var USCHED_SCOPE = {
  TENANT_CHARGES_ONLY: true,
  MIN_POSTINGS_TO_TRACK: 3,
  ACTIVE_PROPERTIES_ONLY: true,
  EXCLUDE_SINGLE_FAMILY: true,
  MIN_MANUAL_POSTINGS_SFH: 3,
  SINGLE_FAMILY_TYPES: ['single-family', 'single family', 'sfr', 'sfh', 'condo', 'townhome', 'townhouse']
};

/**
 * A manual posting, detected from the description.
 *
 * WeLease types the service period into the description when entering a utility charge
 * by hand — "SDGE Utilities 06/12/2026-07/13/2026". A system-generated recurring charge
 * carries no such period, so a date range in the description is the manual signature.
 *
 * If the team's convention differs, this is the ONE function to change.
 */
function usIsManualPosting_(desc) {
  var d = String(desc || '');
  if (!d) return false;
  if (/\d{1,2}\/\d{1,2}\/\d{2,4}\s*[-\u2013\u2014]|\d{1,2}\/\d{1,2}\/\d{2,4}\s*to\s/i.test(d) &&
      /\d{1,2}\/\d{1,2}\/\d{2,4}[\s\S]{0,6}\d{1,2}\/\d{1,2}\/\d{2,4}/.test(d)) return true;
  if (/\d{4}-\d{2}-\d{2}[\s\S]{0,6}\d{4}-\d{2}-\d{2}/.test(d)) return true;
  if (/(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?\s*\d{1,2}[^a-z0-9]{1,4}(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)/i.test(d)) return true;
  return false;
}

/**
 * Applies the scope rules to the assembled series and reports every drop.
 *
 * Runs AFTER series assembly so the decision can use posting counts and manual-entry
 * evidence, neither of which exists per-row. Everything dropped is returned with a
 * reason and written to a tab — a series that vanishes without explanation is
 * indistinguishable from a bug.
 */
function usApplyScope_(series) {
  var props = {};
  readTab_('Properties_Units').forEach(function (p) {
    props[String(p.property_id)] = p;
  });
  var t = ymd_(today_());
  var kept = {}, dropped = [], counts = {};

  function drop(s, reason, detail) {
    counts[reason] = (counts[reason] || 0) + 1;
    dropped.push({
      property_label: s.property_label, property_id: s.property_id,
      utility: s.group_label, provider: s.provider || '',
      postings: (s.events || []).length, manual_postings: s.manual_postings || 0,
      reason: reason, detail: detail || ''
    });
  }

  Object.keys(series).forEach(function (k) {
    var s = series[k];
    var p = props[String(s.property_id)] || {};
    var n = (s.events || []).length;

    if (USCHED_SCOPE.ACTIVE_PROPERTIES_ONLY) {
      var end = ymd_(p.management_end_date);
      if (end && end <= t) { drop(s, 'Management ended', 'ended ' + end); return; }
    }

    if (n < USCHED_SCOPE.MIN_POSTINGS_TO_TRACK) {
      drop(s, 'Too few postings', n + ' in ' + USCHED.LOOKBACK_MONTHS + ' months, need ' +
           USCHED_SCOPE.MIN_POSTINGS_TO_TRACK);
      return;
    }

    if (USCHED_SCOPE.EXCLUDE_SINGLE_FAMILY) {
      var ptype = String(p.property_type || '').toLowerCase();
      var isSF = USCHED_SCOPE.SINGLE_FAMILY_TYPES.some(function (x) {
        return ptype.indexOf(x) !== -1;
      });
      if (isSF && (s.manual_postings || 0) < USCHED_SCOPE.MIN_MANUAL_POSTINGS_SFH) {
        drop(s, 'Single-family, not manually billed',
             ptype + ' with ' + (s.manual_postings || 0) + ' manual posting(s), need ' +
             USCHED_SCOPE.MIN_MANUAL_POSTINGS_SFH);
        return;
      }
    }
    kept[k] = s;
  });

  if (dropped.length) {
    writeTab_('Utility_Schedule_Dropped', dropped);
    logRun_('usApplyScope_', 'derived', 'Utility_Schedule_Dropped', dropped.length, 0,
      Object.keys(counts).map(function (r) { return r + ': ' + counts[r]; }).join(' · '));
  } else {
    writeTab_('Utility_Schedule_Dropped', [{ note: 'Nothing dropped by the scope rules' }]);
  }
  return { series: kept, dropped: dropped.length, reasons: counts };
}


/**
 * Service groups, not individual GL accounts. One group is one bill is one clock.
 * Source: chart_of_accounts, verified live 2026-08-04.
 *
 * 4470 Monthly Utilities is deliberately ABSENT. It is flagged Hidden in the chart of
 * accounts and Frank confirmed it is not used — utilities post to the utility GL by
 * type (6173 for water, and so on) for residents and vendors alike. An earlier version
 * tracked it because the API master lists it under gl_ids_to_track; that was wrong.
 */
var USCHED_GROUPS = {
  WATER: {
    label: 'Water & Sewer', numbers: ['6173', '6174'], byProvider: true,
    note: 'Sewer is billed inside the water bill and posts to 6173. 6174 is folded in.'
  },
  ENERGY: {
    label: 'Gas & Electric', numbers: ['6171', '6172', '6177'], byProvider: true,
    note: 'Grouped by provider. SDG&E bills gas and electric together; a separate ' +
          'provider gets its own clock.'
  },
  WASTE: {
    label: 'Garbage & Recycling', numbers: ['6175', '6176'], byProvider: true, note: null
  },
  SOLAR: {
    label: 'Solar', numbers: ['6178', '4490'], byProvider: false,
    note: 'Expense 6178 and income 4490 together — net metering runs both directions.'
  }
};

/** GL descriptors. `name` matters: general_ledger may return account_number as null. */
var USCHED_GL = [
  { id: 89,  number: '6171', name: 'Electricity',           group: 'ENERGY' },
  { id: 90,  number: '6172', name: 'Gas',                   group: 'ENERGY' },
  { id: 115, number: '6177', name: 'Gas & Electricity',     group: 'ENERGY' },
  { id: 91,  number: '6173', name: 'Water',                 group: 'WATER'  },
  { id: 92,  number: '6174', name: 'Sewer',                 group: 'WATER', stray: true },
  { id: 93,  number: '6175', name: 'Garbage and Recycling', group: 'WASTE'  },
  { id: 110, number: '6176', name: 'Trash Replacement',     group: 'WASTE'  },
  { id: 116, number: '6178', name: 'Solar Panel',           group: 'SOLAR'  },
  { id: 125, number: '4490', name: 'Solar Panel Income',    group: 'SOLAR'  }
];

function uschedGlIds_() { return USCHED_GL.map(function (g) { return String(g.id); }); }

/**
 * Resolve a ledger row to a GL descriptor.
 *
 * WHY BY NAME AS WELL AS NUMBER: in the sampled general_ledger response account_number
 * comes back NULL while account_name is populated. Matching on the number alone would
 * discard every row and produce an empty schedule. Number first, name second.
 */
function uschedResolveGl_(row) {
  var num = String(row.account_number || '').trim();
  var i;
  if (num) {
    for (i = 0; i < USCHED_GL.length; i++) if (USCHED_GL[i].number === num) return USCHED_GL[i];
  }
  var nm = String(row.account_name || '').trim().toLowerCase();
  if (nm) {
    for (i = 0; i < USCHED_GL.length; i++) {
      if (USCHED_GL[i].name.toLowerCase() === nm) return USCHED_GL[i];
    }
    // "6173 Water" or "6173 - Water" in a single field
    var m = nm.match(/^(\d{4})\b/);
    if (m) for (i = 0; i < USCHED_GL.length; i++) if (USCHED_GL[i].number === m[1]) return USCHED_GL[i];
  }
  return null;
}

var TABS_USCHED = [
  'Utility_Schedule', 'Utility_Schedule_Alerts', 'Utility_Schedule_Overrides',
  'Utility_Schedule_History', 'Utility_Schedule_Anomalies', '_uschedule_events'
];

function setupUtilityScheduleSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), made = [];
  TABS_USCHED.forEach(function (t) {
    if (!ss.getSheetByName(t)) { ss.insertSheet(t); made.push(t); }
