  var days = rows.map(function (r) { return num_(r.days_lead_to_movein); });
  var med = median_(days), mean = days.length
    ? days.reduce(function (a, b) { return a + b; }, 0) / days.length : null;
  var examined = rows.length + exceptions.length;
  var rate = examined ? Math.round(rows.length / examined * 100) : null;
  var enough = rows.length >= CFG.MIN_N_TO_PUBLISH && rate !== null && rate >= 50;

