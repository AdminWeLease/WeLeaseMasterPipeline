      html: pmInfo.unjoinable + ' row' + (pmInfo.unjoinable === 1 ? '' : 's') + ' on this tab ' +
        'show as <strong>Unassigned</strong> because a LeadSimple process carries a ' +
        'LeadSimple property id, which cannot be matched to an AppFolio PM group without ' +
