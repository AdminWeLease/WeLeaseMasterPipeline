/**
 * Rent payment timing by month — the health story.
 * Stacked bar per month: paid on the 1st, by the 5th, after the 5th.
 */
/**
 * Line-and-dot chart. Lines answer "which way is this going", which is the actual
 * question for doors, churn and leasing volume — bars answer "how big was each month",
 * which matters less here.
 *
 * series: [{ key, label, color, dashed, axis }]  axis 'right' scales independently.
 * Rendered as inline SVG: no CDN, no dependency, prints cleanly.
 */
/**
 * A number as it should appear on a chart axis.
 *
 * Grouped in thousands, always — $1000 costs the reader a beat to parse and a chart of
 * six-figure sums makes them pay it on every glance.
 *
 * Money above ten thousand is abbreviated on the AXIS only ($1.1M), because five gridline
 * labels each fourteen characters wide push the plot area over and the axis is for scale
 * rather than for the figure. The hover readout gives the exact number, and the table
 * underneath gives it again.
 */
function axisNum_(v, format) {
  var n = Number(v);
  if (isNaN(n)) return '—';
  if (format === '%') return (Math.round(n * 10) / 10) + '%';
  var group = function (x) {
    return String(Math.round(x)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  };
  if (format === '$') {
    // Sign OUTSIDE the currency mark. "$-4,200" is a typo everywhere except a spreadsheet.
    var a = Math.abs(n), sign = n < 0 ? '-' : '';
    if (a >= 1000000) return sign + '$' + (Math.round(a / 100000) / 10) + 'M';
    if (a >= 10000) return sign + '$' + Math.round(a / 1000) + 'k';
    return sign + '$' + group(a);
  }
  return group(n);
}

function lineChart_(rows, series, opts) {
  opts = opts || {};
  if (!rows.length) return '<p class="muted small">No data yet.</p>';
  var W = opts.width || 980, H = opts.height || 280;
  var padL = 52, padR = 52, padT = 16, padB = 34;
  var iw = W - padL - padR, ih = H - padT - padB;

  function vals(axis) {
    var out = [];
    series.filter(function (s) { return (s.axis || 'left') === axis; }).forEach(function (s) {
      rows.forEach(function (r) { var v = num_(r[s.key]); if (v !== null) out.push(v); });
    });
    return out;
  }
  function scale(axis) {
    var v = vals(axis);
    if (!v.length) return { min: 0, max: 1 };
    var mn = Math.min.apply(null, v), mx = Math.max.apply(null, v);
    if (mn === mx) { mn = mn - 1; mx = mx + 1; }
    var pad = (mx - mn) * 0.15;
    return { min: axis === 'left' ? Math.max(0, mn - pad) : Math.max(0, mn - pad), max: mx + pad };
  }
  var L = scale('left'), R = scale('right');
  var hasRight = series.some(function (s) { return s.axis === 'right'; });

  function x(i) { return padL + (rows.length === 1 ? iw / 2 : i / (rows.length - 1) * iw); }
  function y(v, axis) {
    var s = axis === 'right' ? R : L;
    return padT + ih - ((v - s.min) / (s.max - s.min)) * ih;
  }

  // Series labels and colours go on the SVG once. Repeating them inside every hover
  // strip is the same handful of words written a few hundred times, and on a page
  // holding four range variants of three charts that is most of the file.
  // FORMAT TRAVELS WITH THE SERIES. $1000 on an axis reads as a thousand-and-something
  // for the half-second it takes to count the digits, and on a chart of six-figure sums
  // that half-second happens on every glance. The hint is one character per series.
  //   f: '$' money · '%' percent · '' a plain count
  var meta = series.map(function (s) {
    var f = s.format || (s.axis === 'right' ? '%' : '');
    return { l: s.label, c: s.color, p: s.axis === 'right' ? 1 : 0, f: f };
  });
  var leftFmt = (series.filter(function (s) { return (s.axis || 'left') === 'left'; })[0] || {}).format || '';
  // Month labels once on the SVG, not repeated inside every hover strip.
  var months = rows.map(function (r) { return monthLabel_(r.month); });
  var h = ['<svg viewBox="0 0 ' + W + ' ' + H + '" class="lc" preserveAspectRatio="xMidYMid meet" ' +
    'data-series="' + esc_(JSON.stringify(meta)) + '" ' +
    'data-months="' + esc_(months.join('|')) + '" data-w="' + W + '">'];

  // gridlines + left axis
  for (var g = 0; g <= 4; g++) {
    var gy = padT + ih - (g / 4) * ih;
    var lv = L.min + (g / 4) * (L.max - L.min);
    h.push('<line x1="' + padL + '" y1="' + gy.toFixed(1) + '" x2="' + (W - padR) +
      '" y2="' + gy.toFixed(1) + '" class="grid"/>');
    h.push('<text x="' + (padL - 8) + '" y="' + (gy + 4).toFixed(1) +
      '" text-anchor="end" class="axl">' + esc_(axisNum_(lv, leftFmt)) + '</text>');
    if (hasRight) {
      var rv = R.min + (g / 4) * (R.max - R.min);
      h.push('<text x="' + (W - padR + 8) + '" y="' + (gy + 4).toFixed(1) +
        '" text-anchor="start" class="axl axr">' + (Math.round(rv * 10) / 10) + '%</text>');
    }
  }

  // month labels — thinned so they never collide
  var step = Math.ceil(rows.length / 12);
  rows.forEach(function (r, i) {
    if (i % step !== 0 && i !== rows.length - 1) return;
    h.push('<text x="' + x(i).toFixed(1) + '" y="' + (H - 10) +
      '" text-anchor="middle" class="axl">' + esc_(monthLabel_(r.month, true)) + '</text>');
  });

  series.forEach(function (s) {
    var pts = [];
    rows.forEach(function (r, i) {
      var v = num_(r[s.key]);
      if (v === null) return;
      pts.push({ x: x(i), y: y(v, s.axis || 'left'), v: v, m: r.month });
    });
    if (!pts.length) return;
    h.push('<polyline points="' + pts.map(function (p) {
      return p.x.toFixed(1) + ',' + p.y.toFixed(1); }).join(' ') +
      '" fill="none" stroke="' + s.color + '" stroke-width="2.5" ' +
      (s.dashed ? 'stroke-dasharray="5 4" ' : '') + 'stroke-linejoin="round"/>');
    // Dots only when they are readable. At 24+ points they overlap into a smear and
    // each one costs an SVG element plus a title — the "all available" range was the
    // single biggest contributor to a 428 KB page.
    // Dots carry no <title>. They used to, and it was 28% of the entire page — the
    // month and series name spelled out again inside every single point. The hover
    // strip added alongside them reads out every series at once and does not wait for
    // the browser's tooltip delay, so the titles were paying for a worse experience.
    if (pts.length <= 30) {
      // class="pt" is the animation hook. Two characters per dot, and it lets the points
      // arrive behind the line as it draws rather than all being there from the start.
      pts.forEach(function (p) {
        h.push('<circle class="pt" cx="' + p.x.toFixed(1) + '" cy="' + p.y.toFixed(1) + '" r="4" ' +
          'fill="var(--surface)" stroke="' + s.color + '" stroke-width="2.5"/>');
      });
    }
  });

  // ---- hover layer -------------------------------------------------------------
  // A <title> on each dot works, but only if you land on the dot, and it waits for the
  // browser's tooltip delay. A full-height hit strip per month means anywhere in the
  // column reads out every series at once — which is the actual question being asked.
  h.push('<line class="xhair" x1="0" y1="' + padT + '" x2="0" y2="' + (padT + ih) +
    '" style="display:none"/>');
  var slotW = rows.length === 1 ? iw : iw / (rows.length - 1);
  rows.forEach(function (r, i) {
    var cx = x(i);
    var vals = series.map(function (s) {
      var v = num_(r[s.key]);
      return v === null ? '' : v;
    }).join('|');
    h.push('<rect class="hitr" x="' + Math.max(padL, cx - slotW / 2).toFixed(1) + '" y="' + padT +
      '" width="' + slotW.toFixed(1) + '" height="' + ih + '" fill="transparent" ' +
      'data-i="' + i + '" data-cx="' + cx.toFixed(1) + '" data-v="' + esc_(vals) + '"/>');
  });
  h.push('</svg>');
  h.push('<div class="lctip" style="display:none"></div>');
  h.push('<div class="legend">');
  series.forEach(function (s) {
    h.push('<span class="lg"><i class="ln" style="background:' + s.color +
      (s.dashed ? ';opacity:.75' : '') + '"></i>' + esc_(s.label) + '</span>');
  });
  h.push('</div>');
  return '<div class="lcwrap">' + h.join('') + '</div>';
}

/**
 * Sparkline of a list's open count over the last runs.
 *
 * A scorecard number answers "how many", which is the smaller half of the question.
 * Eighteen and falling is a different morning from eighteen and climbing, and the
 * Throughput ledger already records open_now on every run — so the shape is free.
 *
 * Below three points a line implies a trend that is not there yet, so nothing renders.
 */
var _tpSeries = null;
function throughputSeries_(listId) {
  if (_tpSeries === null) {
    _tpSeries = {};
    try {
      readTab_(typeof THRU === 'undefined' ? 'Throughput' : THRU.LEDGER_TAB)
        .forEach(function (r) {
          if (!r.list_id) return;
          var v = num_(r.open_now);
          if (v === null) return;
          (_tpSeries[r.list_id] = _tpSeries[r.list_id] || []).push(v);
        });
    } catch (e) { _tpSeries = {}; }
  }
  return _tpSeries[listId] || [];
}

function sparkline_(listId) {
  var v = throughputSeries_(listId).slice(-14);
  if (v.length < 3) return '';
  var mn = Math.min.apply(null, v), mx = Math.max.apply(null, v);
  var W = 100, H = 22, pad = 2;
  var span = (mx - mn) || 1;
  var pts = v.map(function (n, i) {
    var px = pad + (i / (v.length - 1)) * (W - pad * 2);
    var py = pad + (1 - (n - mn) / span) * (H - pad * 2);
    return px.toFixed(1) + ',' + py.toFixed(1);
  });
  // Direction over the last third, not first-to-last — one spike at the start
  // should not colour a list that has been flat for weeks.
  var tail = v.slice(-Math.max(2, Math.round(v.length / 3)));
  var dir = tail[tail.length - 1] - tail[0];
  var tone = dir > 0 ? 'up' : (dir < 0 ? 'down' : 'flat');
  var lastPt = pts[pts.length - 1].split(',');
  return '<svg class="spk ' + tone + '" viewBox="0 0 ' + W + ' ' + H + '" ' +
    'preserveAspectRatio="none" aria-hidden="true">' +
    '<polyline points="' + pts.join(' ') + '" fill="none" stroke-width="1.6" ' +
    'stroke-linejoin="round" stroke-linecap="round"/>' +
    '<circle cx="' + lastPt[0] + '" cy="' + lastPt[1] + '" r="2.2"/></svg>';
}

/**
 * Renders the chart at every range and toggles visibility client-side.
 *
 * The page is pre-rendered nightly and served from cache, so the range selector cannot
 * call back to the server without giving up that speed. Four small SVGs cost far less
 * than a round trip.
 */
/**
 * The widest window a monthly chart is worth drawing.
 *
 * Door history holds five years. Sixty points on a 980px axis is a smear, and the
 * "all available" variant was rendering every one of them a second time on top of the
 * other three windows. Three years is more history than any decision on this page needs.
 */
var CHART_MAX_MONTHS = 36;

var CHART_DEFAULT_RANGE = 12;

/**
 * One block of range variants, with duplicates collapsed.
 *
 * Variants are keyed by how many months they actually contain, so 24 and 36 share a
 * single SVG when only 18 months of history exist — which is most of the time on a
 * young series. A map tells the client which variant serves each option.
 *
 * The variant serving the default range is the only one visible in the markup. Leaving
 * them all visible and letting JS hide them made the page render three charts tall and
 * then snap shorter as the script caught up.
 */
function rangedBlock_(selId, render) {
  var byLen = {}, panels = [], map = {};
  CHART_RANGES.forEach(function (n) {
    var r = render(Math.min(n, CHART_MAX_MONTHS));
    var key = String(r.key);
    map[n] = key;
    if (byLen[key]) return;
    byLen[key] = true;
    panels.push({ key: key, html: r.html });
  });
  var shownKey = map[CHART_DEFAULT_RANGE] || panels[0].key;
  var out = ['<div class="ranged" data-sel="' + selId + '" ' +
    'data-map="' + esc_(JSON.stringify(map)) + '">'];
  panels.forEach(function (p) {
    out.push('<div class="rv" data-r="' + p.key + '"' +
      (p.key === shownKey ? '' : ' style="display:none"') + '>' + p.html + '</div>');
  });
  out.push('</div>');
  return out.join('');
}

function lineChartRanged_(rows, series, opts, selId) {
  return rangedBlock_(selId, function (take) {
    var slice = rows.slice(-take);
    return { key: slice.length, html: lineChart_(slice, series, opts) };
  });
}

/** Reusable range selector. Filters client-side by row index from the end. */
/**
 * Three windows, not four.
 *
 * Every option renders its own SVG into the page, so each one costs real bytes on
 * every load. Six months was the weakest of the four — twelve is the default and the
 * one people read, and a six-month window of a monthly series rarely says anything
 * twelve does not. Dropping it removed a quarter of all chart weight for nothing anyone
 * was using.
 */
var CHART_RANGES = [12, 24, 36];

function rangeSelect_(id) {
  return '<select id="' + id + '" class="mini-sel" onchange="setRange(\'' + id + '\')">' +
    '<option value="12" selected>Last 12 months</option>' +
    '<option value="24">Last 24</option>' +
    '<option value="36">Last ' + CHART_MAX_MONTHS + '</option></select>';
}

/**
 * THE EMPTY STATE, as one component.
 *
 * "No overdue renewals" and "last night's job failed" were rendering the same way: a
 * blank space, or one grey line of text. Those are opposite facts. One means the team is
 * on top of it; the other means the screen is lying and somebody should stop trusting it.
 * A person cannot tell them apart, so they eventually treat every blank as suspicious —
 * and a dashboard nobody quite believes is worse than no dashboard, because it still
 * costs the time it takes to check.
 *
 * Four kinds, and the difference between them is the whole point:
 *
 *   clear    Good news. There is genuinely nothing to do. Quiet, green, no call to action.
 *   broken   We could not build this. Says what is missing and what to run.
 *   waiting  The job has not run YET — new, or first-run. Not an error, and says so.
 *   filtered Rows exist; the current filter hides them all. Offers to clear it.
 *
 * Every one names WHY, and every one that a person can act on says what to do. An empty
 * state with no next step is just a nicer-looking dead end.
 */
function emptyState_(kind, o) {
  o = o || {};
  var icon = { clear: '✓', broken: '⚠', waiting: '○', filtered: '⊘' }[kind] || '○';
  var h = ['<div class="estate ' + esc_(kind) + (o.quiet ? ' quiet' : '') + '"' +
    (o.id ? ' id="' + esc_(o.id) + '"' : '') + '>'];
  h.push('<span class="estate-i" aria-hidden="true">' + icon + '</span>');
  h.push('<div class="estate-t">');
  h.push('<strong>' + (o.title || '') + '</strong>');
  if (o.body) h.push('<p>' + o.body + '</p>');
  if (o.action) h.push('<p class="estate-a">' + o.action + '</p>');
  // THE FIX IS ADMIN-ONLY; THE FACT IS NOT.
  //
  // "This list could not be built" has to reach everybody, or somebody reads a blank
  // panel as "nothing outstanding" and stops chasing. "Run buildRenewalPipeline()" only
  // means anything to whoever maintains it, and to everyone else it reads as breakage
  // they cannot do anything about.
  if (o.adminAction && isAdmin_()) {
    h.push('<p class="estate-a adminonly">' + o.adminAction + '</p>');
  }
  h.push('</div></div>');
  return h.join('');
}

/**
 * A maintenance note — visible only to whoever maintains this.
 *
 * Returns an empty string for everybody else, so the markup is not merely hidden with
 * CSS. A `display:none` block is still in the page source, still in the 397 KB, and
 * still readable by anybody who opens the developer tools; if a note is not for the
 * team, it should not be sent to the team.
 *
 * Use for: run this job, set this property, this tab is empty, this is a code defect.
 * Do NOT use for: anything that changes how a number should be read. Those belong to
 * everyone, and hiding them would leave the team confidently misreading the page.
 */
function adminNote_(html, opts) {
  if (!isAdmin_()) return '';
  opts = opts || {};
  return '<p class="warnrow adminonly' + (opts.quiet ? ' quiet' : '') + '">' +
    '<span class="adminbadge" title="Only maintainers see this">maintenance</span> ' +
    html + '</p>';
}

/**
 * The header badge. Says which of the two pages you are looking at, because an admin who
 * forgets they are an admin will not understand why a colleague cannot see what they are
 * describing over the phone.
 */
/**
 * Told once, at the top, to the person it affects.
 *
 * Under "execute as user" every write happens as the visitor. Somebody with view-only
 * access to the workbook can read the whole dashboard perfectly and cannot save a status,
 * add a note, log an insurance chase or send feedback — and every one of those fails
 * silently from their side, because the failure itself cannot be logged.
 *
 * Without this they conclude the buttons are broken. With it they know what to ask for.
 */
function readOnlyBanner_() {
  if (canWrite_()) return '';
  return '<p class="warnrow"><strong>You are signed in with view-only access.</strong> ' +
    'Everything on this page is current and correct to read. <strong>Nothing you change ' +
    'will save</strong> — statuses, notes, the insurance chase log and feedback all ' +
    'write back to the workbook, and that needs edit access. Ask for edit access to the ' +
    'operations workbook and it will start working; nothing else needs to change.</p>';
}

/** The same fact, in the shape a failed button can return to the browser. */
function writeBlockedMessage_() {
  return 'Not saved — you have view-only access to the operations workbook. Ask for ' +
    'edit access and try again. Nothing was lost; the page is unchanged.';
}

function adminBadge_() {
  // Says which of the two pages you are on. A maintainer who forgets they are one will
  // otherwise spend a while wondering why a colleague cannot see what they are describing
  // over the phone, and somebody previewing the team view needs to know they are not
  // looking at their own page.
  if (_maintOverride === false) {
    return '<span class="asof admin" title="You are looking at exactly what the team sees. ' +
      'Drop ?maint=0 from the URL to go back.">team view · preview</span>';
  }
  if (!isAdmin_()) return '';
  // IDENTITY FAILING IS A MAINTENANCE FACT, so it does not go on everybody's page. The
  // first version of this badge showed "identity unavailable" to whoever was looking,
  // which under a deployment where identity never resolves means all fifteen people get a
  // warning about a thing none of them can fix — the exact problem this feature exists to
  // remove. It is reported by whoAmI() and verifyTeamAccess() instead.
  return '<span class="asof admin" title="You see maintenance notes. The team does not. ' +
    'Add ?maint=0 to the URL to check what they see.">maintainer view</span>';
}

function rentTimingStory_() {
  var rows = readTab_('Rent_Timing');
  if (!rows.length) {
    return '<section class="card"><h2>Rent payment timing</h2>' +
      '<p class="warnrow">No data \u2014 the <code>Rent_Timing</code> tab is empty. ' +
      'Run rebuildFinancials then rebuildPortfolio.</p></section>';
  }
  // monthNorm_, not String() — String(a Date) begins with the weekday name, so a raw sort
  // would order these by "Fri" before "Mon" the moment Sheets coerces a month cell.
  rows.sort(function (a, b) { return monthNorm_(a.month) < monthNorm_(b.month) ? -1 : 1; });
  var recent = rows.slice(-12);

  // THE HEADLINE IS THE LAST COMPLETE MONTH, NOT THE ONE IN PROGRESS.
  //
  // On the 2nd of the month, "% paid after the 5th" is not a wrong answer \u2014 it is an
  // answer to a question that has not happened yet. Everyone still to pay is counted as
  // late by arithmetic alone, and the figure comes out as very nearly the exact
  // complement of the truth. The month in progress stays on the trend, where its shape
  // is informative, and is kept out of the headline, where it is not.
  var closed = recent.filter(function (r) { return String(r.window_closed || 'YES') !== 'NO'; });
  var last = closed[closed.length - 1] || recent[recent.length - 1];
  var running = recent[recent.length - 1];
  var isRunning = String(running.window_closed || 'YES') === 'NO';

  var BANDS = [
    // Paying BEFORE the 1st is its own bucket. Most of WeLease's residents do it \u2014 172
    // households prepaid September \u2014 and folding them into "on the 1st" would hide the
    // single best thing this chart has to say.
    { k: 'before_1st', label: 'Before the 1st', color: '#0B6E4F' },
    { k: 'on_1st',    label: 'On the 1st', color: '#0F8A5F' },
    { k: 'on_2nd',    label: '2nd',        color: '#4FA36B' },
    { k: 'on_3rd',    label: '3rd',        color: '#9FBF57' },
    { k: 'on_4th',    label: '4th',        color: '#D9A400' },
    { k: 'on_5th',    label: '5th',        color: '#E07B39' },
    { k: 'after_5th', label: 'After the 5th', color: '#C0392B' }
  ];

  var h = ['<section class="card"><h2>Rent payment timing</h2>' +
    '<p class="note">The day a resident\u2019s rent is satisfied, as a share of every household ' +
    'on the rent roll. This is the leading indicator \u2014 a month drifting later shows up here ' +
    'well before it reaches the aged delinquency buckets.</p>'];

  if (isRunning) {
    h.push('<p class="warnrow"><strong>' + esc_(monthLabel_(running.month)) +
      ' is still running \u2014 day ' + esc_(running.as_of_day) + '.</strong> The headline below ' +
      'is <strong>' + esc_(monthLabel_(last.month)) + '</strong>, the last month whose window ' +
      'actually closed. A month cannot report how it ended on the second of it: everyone ' +
      'still to pay would count as late.</p>');
  }
  h.push('<p class="note"><strong>Paying early counts as early.</strong> Most residents here ' +
    'pay before the month begins \u2014 the money sits in prepayment and is applied on the 1st. ' +
    'Those households are counted from the day their money arrived, not from the day the ' +
    'ledger moved it, and a benefits or utility charge paid mid-month cannot push them into ' +
    'a later band.</p>');

  // The trend's own limits, stated where the trend is read rather than buried.
  h.push('<p class="note"><strong>Reading the older months.</strong> A household is placed ' +
    'in a band by when its receipts reach half its rent — and the only rent this pipeline ' +
    'stores is <em>today\u2019s</em>. Months before a renewal increase are judged against a ' +
    'rent that was not charged then, and former residents drop out entirely once they leave ' +
    'the rent roll. Recent months are sound; older ones describe a shrinking subset. ' +
    'A utility bill paid late does NOT move a household into a later band \u2014 the ' +
    'threshold is reached on the day rent lands.</p>');
  h.push(adminNote_('<code>diagnoseRentTiming()</code> reports per-month coverage.',
    { quiet: true }));

  h.push('<div class="timing">');

  // Donut — one month, which is what a pie does well.
  h.push('<div class="donutwrap"><h3>' + esc_(monthLabel_(last.month)) + '</h3>');
  var total = num_(last.payers) || 1;
  var acc = 0, C = 2 * Math.PI * 54;
  h.push('<svg viewBox="0 0 140 140" class="donut">');
  BANDS.forEach(function (b) {
    var v = num_(last[b.k]) || 0;
    if (!v) return;
    var frac = v / total, len = frac * C;
    h.push('<circle cx="70" cy="70" r="54" fill="none" stroke="' + b.color + '" stroke-width="20" ' +
      'stroke-dasharray="' + len.toFixed(2) + ' ' + (C - len).toFixed(2) + '" ' +
      'stroke-dashoffset="' + (-acc).toFixed(2) + '" transform="rotate(-90 70 70)">' +
      '<title>' + esc_(b.label) + ': ' + v + ' (' + Math.round(frac * 100) + '%)</title></circle>');
    acc += len;
  });
  h.push('<text x="70" y="64" text-anchor="middle" class="dnum">' +
    esc_(last.by_1st_pct === null ? '\u2014' : last.by_1st_pct + '%') + '</text>' +
    '<text x="70" y="80" text-anchor="middle" class="dlab">by the 1st</text>' +
    '<text x="70" y="92" text-anchor="middle" class="dlab">' +
    esc_(monthLabel_(last.month, true)) + '</text></svg>');
  h.push('<div class="legend">');
  BANDS.forEach(function (b) {
    var v = num_(last[b.k]) || 0;
    h.push('<span class="lg"><i style="background:' + b.color + '"></i>' + esc_(b.label) +
      ' <strong>' + Math.round(v / total * 100) + '%</strong></span>');
  });
  h.push('</div></div>');

  // Stacked bars — comparison across months, which a row of pies cannot do.
  h.push('<div class="trendwrap"><h3>Last 12 months</h3><div class="stack">');
  recent.forEach(function (r) {
    var p = num_(r.payers) || 1;
    var tip = monthLabel_(r.month) + ' \u00b7 ' + r.payers + ' payers\\n' +
      '1st: ' + (r.on_1st || 0) + ' (' + Math.round((num_(r.on_1st) || 0) / p * 100) + '%)\\n' +
      '2nd: ' + (r.on_2nd || 0) + '  3rd: ' + (r.on_3rd || 0) + '\\n' +
      '4th: ' + (r.on_4th || 0) + '  5th: ' + (r.on_5th || 0) + '\\n' +
      'after the 5th: ' + (r.after_5th || 0) + ' (' + Math.round((num_(r.after_5th) || 0) / p * 100) + '%)';
    h.push('<div class="stcol" title="' + esc_(tip) + '"><span class="stbar">');
    BANDS.slice().reverse().forEach(function (b) {
      var pct = (num_(r[b.k]) || 0) / p * 100;
      if (pct > 0) h.push('<i style="height:' + pct.toFixed(1) + '%;background:' + b.color + '"></i>');
    });
    h.push('</span><span class="slab">' + esc_(monthLabel_(r.month, true)) + '</span></div>');
  });
  h.push('</div></div>');
  h.push('</div>');

  // Exact numbers, because a chart is for the shape and a table is for the argument.
  h.push('<table class="mini2"><thead><tr><th>Month</th><th class="num">Households</th>' +
    '<th class="num">Before 1st</th>' +
    '<th class="num">1st</th><th class="num">2nd</th><th class="num">3rd</th>' +
    '<th class="num">4th</th><th class="num">5th</th><th class="num">After 5th</th>' +
    '<th class="num">By the 5th</th></tr></thead><tbody>');
  recent.slice().reverse().forEach(function (r) {
    // Denominator is every household on the rent roll, not just the ones who happened to
    // send money that month. Percentages over payers-only flattered every figure.
    var p = num_(r.households) || num_(r.payers) || 1;
    function pc(k) { return Math.round((num_(r[k]) || 0) / p * 100) + '%'; }
    var run = String(r.window_closed || 'YES') === 'NO';
    h.push('<tr' + (run ? ' class="off"' : '') + '><td class="strong">' +
      esc_(monthLabel_(r.month)) +
      (run ? ' <span class="tag none">day ' + esc_(r.as_of_day) + ', still running</span>' : '') +
      '</td>' +
      '<td class="num muted">' + esc_(p) + '</td>' +
      '<td class="num">' + pc('before_1st') + '</td>' +
      '<td class="num">' + pc('on_1st') + '</td><td class="num">' + pc('on_2nd') + '</td>' +
      '<td class="num">' + pc('on_3rd') + '</td><td class="num">' + pc('on_4th') + '</td>' +
      '<td class="num">' + pc('on_5th') + '</td>' +
      // A month that has not reached the 5th cannot be judged against a 10% threshold.
      '<td class="num">' + (run ? '<span class="muted">\u2014</span>' :
        '<span class="tag ' + ((num_(r.after_5th_pct) || 0) > 10 ? 'bad' : 'good') +
        '">' + pc('after_5th') + '</span>') + '</td>' +
      '<td class="num strong">' + (run ? '\u2014' : esc_(r.by_5th_pct) + '%') + '</td></tr>');
  });
  h.push('</tbody></table></section>');
  return h.join('');
}

/**
 * Views built by an optional file.
 *
 * Utility Billing rendered "Nothing configured for this view" for a week because
 * Dashboard_Utilities_patch.gs was never pasted. The typeof guard around it did its job
 * — the page stayed up — but it swallowed the reason, and an absent file looked exactly
 * like a quiet week. Nothing landed in _errors either, because nothing threw.
 *
 * A view whose builder is missing now says so, and names the file to paste.
 */
var VIEW_REQUIRES = {
  utilities: { file: 'Dashboard_Utilities_patch.gs',
               fns: ['utilityScheduleBlocks_', 'utilitySchedulePanel_'],
               also: 'Utility_Schedule.gs (which defines USCHED and builds the tab)' },
  collections: { file: 'Collections.gs', fns: ['collectionsBlocks_', 'collectionsPanel_'] },
  processes: { file: 'LeadSimple.gs', fns: ['buildLeadSimpleSummary'] },
  pipeline: { file: 'LeadSimple.gs', fns: ['buildLeadSimpleSummary'] }
};

function missingBuilderNotice_(viewId) {
  var req = VIEW_REQUIRES[viewId];
  if (!req) return '';
  var missing = req.fns.filter(function (fn) {
    try { return typeof eval(fn) !== 'function'; } catch (e) { return true; }
  });
  if (!missing.length) return '';
  return '<section class="card"><h2>This view has no builder</h2>' +
    '<p class="warnrow"><strong>' + esc_(req.file) + ' is not in the project.</strong> ' +
    'The function' + (missing.length > 1 ? 's ' : ' ') +
    missing.map(function (f) { return '<code>' + esc_(f) + '</code>'; }).join(' and ') +
    (missing.length > 1 ? ' are' : ' is') + ' undefined, so nothing was built for this tab. ' +
    'Paste ' + esc_(req.file) + (req.also ? ' and ' + esc_(req.also) : '') +
    ', run <code>verifyProject()</code>, then rebuild the cache. ' +
    'This is a deployment gap, not a data problem \u2014 which is why nothing appears in ' +
    '<code>_errors</code>.</p></section>';
}

/** One operational view: every list tagged to it. */
/** A notice that belongs to one view, and stays dismissed once dismissed. */
function viewNotice_(id, html, opts) {
  // Belt and braces. The two current notices are already filtered before they reach the
  // array; this stops a future one being added somewhere else and quietly going out to
  // everybody, which is exactly how the first four got there.
  if (opts && opts.adminOnly && !isAdmin_()) return '';
  return '<p class="warnrow dismissible" id="note-' + id + '">' +
    '<button type="button" class="notex" onclick="dismissNote(\'' + id + '\')" ' +
    'aria-label="Dismiss this notice">\u00d7</button>' + html + '</p>';
}

function renderListView_(U, viewId, notices) {
  var blocks = U.filter(function (b) { return b.view === viewId; });
  var h = ['<div id="view-' + viewId + '" class="view">'];
  (notices || []).filter(function (n) { return n.view === viewId; }).forEach(function (n) {
    h.push(viewNotice_(n.id, n.html));
  });
  if (viewId === 'delinquency') h.push(rentTimingStory_());
  if (viewId === 'collections' && typeof collectionsPanel_ === 'function') {
    try { h.push(collectionsPanel_()); }
    catch (e) { logError_('dashboard', 'collectionsPanel_', e.message); }
  }
  if (viewId === 'utilities' && typeof utilitySchedulePanel_ === 'function') {
    try { h.push(utilitySchedulePanel_()); }
    catch (e) { logError_('dashboard', 'utilitySchedulePanel_', e.message); }
  }
  if (viewId === 'processes') {
    try { h.push(lsCompliancePanel_()); }
    catch (e) { logError_('dashboard', 'lsCompliancePanel_', e.message); }
  }
  if (viewId === 'pipeline') {
    try { h.push(lsPipelinePanel_()); }
    catch (e) { logError_('dashboard', 'lsPipelinePanel_', e.message); }
  }
  if (viewId === 'renewals' && typeof renewalPipelinePanel_ === 'function') {
    try { h.push(renewalPipelinePanel_()); }
    catch (e) { logError_('dashboard', 'renewalPipelinePanel_', e.message); }
  }
  if (viewId === 'weekly' && typeof weeklyReportPanel_ === 'function') {
    try { h.push(weeklyReportPanel_()); }
    catch (e) { logError_('dashboard', 'weeklyReportPanel_', e.message); }
  }
  if (viewId === 'insurance' && typeof insurancePanel_ === 'function') {
    try { h.push(insurancePanel_()); }
    catch (e) { logError_('dashboard', 'insurancePanel_', e.message); }
  }
  if (!blocks.length) {
    var notice = missingBuilderNotice_(viewId);
    h.push(notice || '<section class="card"><p class="muted">Nothing configured for this view.</p></section>');
  }

  blocks.forEach(function (b) {
    h.push('<section class="card" id="sec-' + b.id + '" data-block="' + b.id + '">');
    h.push('<div class="card-head" onclick="toggleCard(\'' + b.id + '\')" ' +
      'role="button" tabindex="0" aria-expanded="true" aria-controls="body-' + b.id + '"><h2>' +
      '<span class="caret" id="car-' + b.id + '">\u25BE</span> ' + esc_(b.title) +
      '<span class="count" data-count="' + b.id + '">' + b.count + '</span></h2>' +
      '<span class="muted small headhint">' + (b.rows.length ? 'click to collapse' : '') +
      '</span></div>');
    h.push('<div class="card-body" id="body-' + b.id + '">');
    if (b.note) h.push('<p class="note">' + esc_(b.note) + '</p>');
    if (!b.rows.length) {
      if (b.sourceTab && b.sourceRows === 0) {
        h.push(emptyState_('broken', {
          title: 'This list could not be built',
          body: 'That is <strong>not</strong> the same as having nothing outstanding \u2014 ' +
                'the data behind this list did not arrive, so nothing can be shown. Treat it ' +
                'as unknown rather than clear.',
          adminAction: 'The <code>' + esc_(b.sourceTab) + '</code> tab is empty. Run the job ' +
                  'that fills it, then refresh. Check <code>_errors</code> if it keeps ' +
                  'coming back empty.'
        }));
      } else {
        h.push(emptyState_('clear', {
          title: 'Nothing outstanding',
          body: 'Every item on this list has been dealt with.',
          quiet: true
        }));
      }
    } else {
      // listtbl scopes the sticky header rule — the metric and portfolio tables are
      // short enough that a floating header there would be noise, not help.
      h.push('<table class="listtbl"><thead><tr>');
      b.headers.forEach(function (x, j) {
        h.push('<th' + (j === b.headers.length - 1 ? ' class="num"' : '') + '>' + esc_(x) + '</th>');
      });
      h.push('<th class="stcol-h">Status</th>');
      h.push('</tr></thead><tbody>');
      b.rows.slice(0, 100).forEach(function (r) {
        var key = String(r.key === null || r.key === undefined ? '' : r.key);
        // data-list used to repeat the block id on every row. The section already
        // carries it as data-block, and at a thousand-plus rows the repetition was
        // real weight for no information.
        h.push('<tr data-pm="' + esc_(r.pm) + '" ' +
          'data-key="' + esc_(key) + '" data-sev="' + r.sev + '"' +
          (r.inactive ? ' class="off"' : '') + '>');
        r.cells.forEach(function (c, j) {
          var last = (j === r.cells.length - 1);
          var body;
          // "cell" gives the countdown column one fixed width so the pills line up
          // down the page instead of ragging with the length of the text.
          if (last) body = '<span class="tag cell ' + r.sev + '">' + esc_(c) + '</span>';
          // extLink wins. addrLink_ builds an AppFolio URL from property_id/unit_id,
          // and a LeadSimple row carries a LeadSimple property_id — a different ID
          // space entirely. Left to itself it would produce a confident link to the
          // wrong AppFolio property, which is worse than no link at all.
          else if (j === (r.linkCol || 0) && r.extLink) {
            body = '<a class="af" href="' + esc_(r.extLink) + '" target="_blank" ' +
                   'rel="noopener">' + esc_(c) + '</a>';
          }
          else if (j === (r.linkCol || 0) && r.src && !r.noLink) body = addrLink_(r.src, c);
          else body = esc_(c);
          h.push('<td' + (last ? ' class="num"' : (j === 0 ? ' class="strong"' : ' class="muted"')) +
            '>' + body + '</td>');
        });
        // Empty on purpose. Statuses are painted on load anyway — the page is cached
        // HTML and the live state comes from the sheet — so shipping a placeholder
        // widget per row was ~90 bytes each to render something JS immediately
        // overwrites. Clicks are handled by one delegated listener.
        h.push('<td class="stcell"></td>');
        h.push('</tr>');
      });
      h.push('</tbody></table>');
      // Rendered once per list and hidden. When the manager filter or the search box
      // hides every row, a table of headers over nothing is indistinguishable from a
      // list that is genuinely clear — and it is the single most common way somebody
      // concludes the dashboard is broken when it is doing exactly what they asked.
      h.push(emptyState_('filtered', {
        id: 'nomatch-' + b.id,
        title: 'Nothing here matches the current filter',
        body: 'This list has <strong>' + b.rows.length + '</strong> item' +
              (b.rows.length === 1 ? '' : 's') + '. None of them match what is set above.',
        action: '<button type="button" class="btn-mini ghost" onclick="clearFilters()">' +
                'Clear the filter</button>'
      }));
      if (b.rows.length > 100) h.push('<p class="muted small">Showing 100 of ' + b.rows.length + '.</p>');
    }
    h.push('</div></section>');
  });

  h.push('</div>');
  return h.join('');
}

