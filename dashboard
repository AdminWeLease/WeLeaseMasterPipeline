var LS_OWNERS_PIPELINE_URL =
  'https://app.leadsimple.com/v2/pipelines/WNxp-EwAKQXP5vvbrZi1ZG-gL62u3PQbqUPrGQxFOEW6EiBR' +
  '?savedViewID=%22W9Rv-EQ_LgWX-PvZpZGsPyb9fqzFlv3mPlo5PkIC3wue7Y79KpQ%3D%22';

/**
 * Lead to move-in — the whole funnel as one number.
