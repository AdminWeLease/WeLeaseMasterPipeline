     ['Market rent · occupied', money_(s.market_rent_occupied), ''],
     ['Rent charged', money_(s.rent_charged), ''],
     ['Average rent', money_(s.average_rent), '']].forEach(function (x) {
      h.push('<div class="hero-card"><div class="hero-label">' + esc_(x[0]) + '</div>' +
        '<div class="hero-value">' + esc_(x[1]) + '</div>' +
        '<div class="hero-foot muted">as of ' + esc_(s.as_of) + '</div></div>');
    });
    h.push('</div>');
