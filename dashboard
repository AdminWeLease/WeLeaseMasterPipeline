    // ============================================================ MOTION
    '/* ---- motion ----',
    '   Everything here animates OPACITY and TRANSFORM only, plus stroke-dashoffset on',
    '   the chart lines. Those are the three properties a browser can composite without',
    '   re-running layout. Animating height, width or top on a page holding 286 table',
    '   rows is how a dashboard becomes a slideshow on a four-year-old laptop.',
    '   Nothing here is longer than 900ms end to end. A dashboard is a tool people open',
    '   forty times a day, and the fortieth time an animation is charm it has become a',
    '   wait. */',
    // View entrance. The container moves, not the rows — one composited layer instead of
    // hundreds, and it reads as the page settling rather than as items marching in.
    '.view.enter{animation:viewIn var(--d3) var(--ease) both}',
    '@keyframes viewIn{from{opacity:0;transform:translate3d(0,8px,0)}to{opacity:1;transform:none}}',
    // Cards stagger, but only the first six. Beyond that the eye has stopped tracking
    // individual arrivals and the delay is just latency you chose to add.
    '.view.enter>.card:nth-child(1),.view.enter>.banner{animation:cardIn var(--d3) var(--ease) both}',
    '.view.enter>.card:nth-child(2){animation:cardIn var(--d3) var(--ease) 40ms both}',
    '.view.enter>.card:nth-child(3){animation:cardIn var(--d3) var(--ease) 80ms both}',
    '.view.enter>.card:nth-child(4){animation:cardIn var(--d3) var(--ease) 120ms both}',
    '.view.enter>.card:nth-child(5){animation:cardIn var(--d3) var(--ease) 160ms both}',
    '.view.enter>.card:nth-child(6){animation:cardIn var(--d3) var(--ease) 200ms both}',
    '@keyframes cardIn{from{opacity:0;transform:translate3d(0,10px,0)}to{opacity:1;transform:none}}',
    // Chart lines draw. The dash length is set by JS from the real path length; only the
    // offset is animated, so the geometry is untouched.
    '.lc polyline{transition:none}',
    '.lc.go polyline{animation:draw 900ms var(--ease-io) both}',
    '@keyframes draw{to{stroke-dashoffset:0}}',
    // Points arrive behind the line rather than with it, so the line leads the eye.
    '.lc.go circle.pt{animation:ptIn 260ms var(--ease) both;' +
      'animation-delay:calc(340ms + var(--i,0) * 14ms);transform-box:fill-box;transform-origin:center}',
    '@keyframes ptIn{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:none}}',
    '.lc.go .grid,.lc.go .axl{animation:fadeIn var(--d3) linear both}',
    '@keyframes fadeIn{from{opacity:0}to{opacity:1}}',
    // The donut sweeps in as a whole. Its arcs are positioned BY stroke-dashoffset, so
    // animating that would move the segments rather than reveal them — the geometry and
    // the animation would be fighting over the same property.
    '.donut.go{animation:donutIn 620ms var(--ease) both;transform-origin:50% 50%}',
    '@keyframes donutIn{from{opacity:0;transform:rotate(-24deg) scale(.9)}to{opacity:1;transform:none}}',
    // Bars grow from their own edge. scaleX on a pre-sized element, so the final width is
    // still the layout width and nothing reflows mid-animation.
    '.ffill,.gfill,.bfill,.mvbar i{transform-origin:left center}',
    '.ffill.grew,.gfill.grew,.bfill.grew,.mvbar i.grew{animation:grow 560ms var(--ease) both}',
    '@keyframes grow{from{transform:scaleX(0)}to{transform:none}}',
    // Interaction feedback. Small, fast, and on transform so it cannot shift a neighbour.
    '.card{transition:box-shadow var(--d2) var(--ease),border-color var(--d2) var(--ease)}',
    '.sc,.chip,.hero-card{transition:transform var(--d2) var(--ease),box-shadow var(--d2) var(--ease),border-color var(--d2) var(--ease)}',
    '.sc:hover,.chip:hover,.hero-card:hover{transform:translateY(-1px);box-shadow:var(--e2)}',
    '.primary,.btn-mini{transition:transform var(--d1) var(--ease),background var(--d1) var(--ease),box-shadow var(--d1) var(--ease)}',
    '.primary:active,.btn-mini:active,.ghost:active{transform:translateY(1px)}',
    '.caret{transition:transform var(--d2) var(--ease)}',
    '.card.collapsed .caret{transform:rotate(-90deg)}',
    // THE OPT-OUT IS COMPLETE, not partial. Somebody who has asked their operating system
    // for less motion has usually asked for a reason, and a dashboard is not the place to
    // negotiate. Everything below reduces to zero — including the entrances, which is why
    // the JS adds .still rather than skipping the class.
    '@media (prefers-reduced-motion:reduce){',
      '*,*::before,*::after{animation-duration:1ms!important;animation-iteration-count:1!important;',
      'transition-duration:1ms!important;scroll-behavior:auto!important}',
      '.lc polyline,.lc.still polyline{stroke-dasharray:none!important;stroke-dashoffset:0!important}',
      '.lc circle.pt{opacity:1!important;transform:none!important}',
      '.ffill,.gfill,.bfill,.mvbar i{transform:none!important}}',
    // A chart that will never animate must still be fully drawn.
    '.lc.still polyline{stroke-dasharray:none;stroke-dashoffset:0}',

    // ============================================================ EMPTY STATES
    '/* ---- empty states ----',
    '   Four kinds, visually distinct on purpose. "Nothing to do" and "this did not load"',
    '   are opposite facts and used to render identically, which is how somebody learns to',
    '   distrust every blank space on the page. Good news is quiet and green; a failure is',
    '   loud enough to stop on. */',
    '.estate{display:flex;gap:var(--s3);align-items:flex-start;padding:var(--s4) var(--s3);border-radius:var(--r2);margin:var(--s2) 0}',
    '.estate-i{flex:0 0 26px;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700}',
    '.estate-t{flex:1;min-width:0}',
    '.estate strong{display:block;font-size:var(--fs-4);color:var(--ink);margin-bottom:2px}',
    '.estate p{margin:0;font-size:var(--fs-3);color:var(--mute);line-height:1.5}',
    '.estate-a{margin-top:var(--s2)!important;color:var(--gray)!important}',
    '.estate code{background:var(--surface-3);padding:1px 5px;border-radius:3px;font-size:var(--fs-2)}',
    // Good news. Deliberately understated — a green banner every time a list is clear is
    // a celebration nobody asked for, twelve times a day.
    '.estate.clear{background:var(--good-wash)}',
    '.estate.clear .estate-i{background:var(--good);color:#fff}',
    '.estate.clear strong{color:var(--good)}',
    '.estate.quiet{padding:var(--s3);background:transparent}',
    '.estate.quiet .estate-i{background:var(--good-wash);color:var(--good)}',
    // A failure. This one is meant to stop somebody.
    '.estate.broken{background:var(--bad-wash);border:1px solid rgba(0,0,0,.06)}',
    '.estate.broken .estate-i{background:var(--bad);color:#fff}',
    '.estate.broken strong{color:var(--bad)}',
    '.estate.waiting{background:var(--surface-3)}',
    '.estate.waiting .estate-i{background:var(--line);color:var(--mute)}',
    '.estate.filtered{display:none;background:var(--surface-3)}',
    '.estate.filtered .estate-i{background:var(--line);color:var(--mute)}',

    '/* ---- maintenance notes ----',
    '   Gated in the SERVER, not with display:none — a hidden block is still in the page',
    '   source and still readable by anyone who opens the developer tools. These styles',
    '   only mark the notes an admin does see, so they are visibly addressed to them and',
    '   not mistaken for something the whole team is being told. */',
    '.adminonly{border-left-color:var(--blue);background:var(--blue-wash);color:var(--blue-dark)}',
    '.adminonly.quiet{background:transparent;border-left-color:var(--line);color:var(--mute)}',
    '.adminbadge{display:inline-block;font-size:var(--fs-1);font-weight:700;text-transform:uppercase;',
    'letter-spacing:.06em;background:var(--blue);color:#fff;border-radius:var(--rf);padding:1px 7px;margin-right:6px;vertical-align:1px}',
    '.adminonly.quiet .adminbadge{background:var(--line);color:var(--mute)}',
    '.estate-a.adminonly{border-left:3px solid var(--blue);background:var(--blue-wash);',
    'padding:7px 10px;border-radius:0 var(--r1) var(--r1) 0;color:var(--blue-dark)!important}',
    '.asof.admin{background:rgba(255,255,255,.28);font-weight:700}',
    '.asof.warn{background:var(--warn);color:#fff;font-weight:700}',
    '@media print{.adminonly{display:none!important}}',

    // ============================================================ SKELETON
    '/* ---- skeleton ----',
    '   Apps Script cannot be made faster. It CAN be stopped from looking broken while it',
    '   thinks. The skeleton is inline in the document head region, so it paints on the',
    '   first frame the browser gets — before the 300 KB of markup below it has even been',
    '   parsed — and removes itself once the real page is interactive.',
    '   Three bars and a shimmer. Anything more elaborate is a second page to maintain. */',
    '#boot{position:fixed;inset:0;z-index:200;background:var(--wash);padding:22px 20px;overflow:hidden}',
    '#boot .bwrap{max-width:1240px;margin:0 auto}',
    '#boot .bar{border-radius:var(--r3);background:var(--surface);border:1px solid var(--line);margin-bottom:var(--s3)}',
    '#boot .bhead{height:74px;background:var(--teal);border:0}',
    '#boot .bnav{height:54px}',
    '#boot .btool{height:64px}',
    '#boot .bcard{height:150px}',
    '#boot .bcard.tall{height:230px}',
    // The shimmer says "working", not "stuck". A static grey block is indistinguishable
    // from a page that has given up.
    '#boot .bar:not(.bhead){background-image:linear-gradient(100deg,var(--surface) 30%,var(--surface-3) 50%,var(--surface) 70%);background-size:200% 100%;animation:shim 1.4s linear infinite}',
    '@keyframes shim{from{background-position:200% 0}to{background-position:-200% 0}}',
    '#boot.gone{opacity:0;pointer-events:none;transition:opacity var(--d2) linear}',
    '@media (prefers-reduced-motion:reduce){#boot .bar:not(.bhead){animation:none}}',
    '@media print{#boot{display:none!important}}',

    // ============================================================ HEADER CONTROL
    '/* ---- the one header control ----',
    '   Compact density came out on 2026-09-02. It was a second row height to maintain for',
    '   a preference almost nobody changes twice, and every table it touched had to be',
    '   checked at both. Row padding is a plain value again.',
    '   What is left is the theme, as an icon. A button labelled "Dark" beside a dark',
    '   screen is ambiguous every time it is read; a symbol showing the current state is',
    '   not, and it takes a quarter of the width. */',
    'td,th{padding:7px 8px}',
    '.chrome{display:flex;align-items:center;gap:var(--s2)}',
    '.cbtn{height:32px;padding:0 12px;border-radius:var(--rf);border:1px solid rgba(255,255,255,.28);' +
      'background:rgba(255,255,255,.12);color:var(--on-dark);font:600 var(--fs-2) inherit;cursor:pointer;' +
      'transition:background var(--d1) var(--ease),transform var(--d1) var(--ease)}',
    '.cbtn:hover{background:rgba(255,255,255,.22)}',
    '.cbtn:active{transform:translateY(1px)}',
    '.cbtn:focus-visible{outline:2px solid #fff;outline-offset:2px}',
    // Square, so the glyph sits centred rather than in a stretched pill.
    '.cbtn.icon{width:32px;padding:0;display:inline-flex;align-items:center;justify-content:center}',
    '.thmi{font-size:15px;line-height:1;display:block}',

    // ============================================================ DARK
    '/* ---- dark ----',
    '   A palette swap, which is the whole reason surfaces became tokens. The washes are',
    '   NOT the light tints dimmed — a 12% tint of red on white becomes a glowing pink on',
    '   a dark card. They are re-picked at low luminance and the text colour is re-picked',
    '   with them, so the semantic pairs still pass contrast rather than merely existing. */',
    '@media (prefers-color-scheme:dark){:root:not([data-theme=light]){' + darkVars_() + '}}',
    '[data-theme=dark]{' + darkVars_() + '}',
    // The header is the one dark surface in light mode. In dark mode the page catches up
    // with it, so it needs a border to stay a distinct object rather than merging.
    '[data-theme=dark] header{border:1px solid var(--line)}',
    '@media (prefers-color-scheme:dark){:root:not([data-theme=light]) header{border:1px solid var(--line)}}',

    // ============================================================ PRINT
    '/* ---- print ----',
    '   Somebody takes a view into an owner meeting. What they need is the numbers on',
    '   paper, so: light palette regardless of theme, no chrome, no interaction affordances,',
    '   and cards that do not break across a page. Table headers repeat on every sheet,',
    '   because a delinquency list running to page three with no column names on it is a',
    '   page of unlabelled figures. */',
    '@media print{',
      ':root{--surface:#fff;--surface-2:#fff;--surface-3:#fff;--wash:#fff;--ink:#000;',
        '--gray:#222;--mute:#555;--line:#bbb;--e1:none;--e2:none;--e3:none}',
      '@page{margin:14mm}',
      'body{background:#fff}',
      '.wrap{max-width:none;padding:0}',
      '.navwrap,.toolbar,.fbfab,.tlfab,.stov,.stoverlay,.ghost,.primary,.btn-mini,',
      '.mini-sel,.ranged select{display:none!important}',
      '.view{display:block!important}',
      '.card{break-inside:avoid;page-break-inside:avoid;border:1px solid var(--line);box-shadow:none;margin-bottom:10px}',
      '.card.collapsed .card-body{display:block!important}',
      'thead{display:table-header-group}',
      'tr{break-inside:avoid;page-break-inside:avoid}',
      '.listtbl thead th{position:static;background:#fff}',
      '.lc,.donut{max-width:640px}',
      'a[href]::after{content:""}',
      // A printed page carries no hover, so a value that only exists in a tooltip is a
      // value that does not exist on paper.
      '.lctip,.xhair{display:none!important}',
      'h2{break-after:avoid;page-break-after:avoid}}'
  ].join('') + '</style>';
}

/**
 * The dark palette.
 *
 * Written once and emitted twice — under `prefers-color-scheme` for people who have
 * never touched the toggle, and under `[data-theme=dark]` for people who have. Two
 * copies of the same string rather than two hand-maintained palettes.
 */
function darkVars_() {
  return '--surface:#161C23;--surface-2:#1B222A;--surface-3:#212A33;--wash:#0F141A;' +
    '--line:#2A343E;--rowline:#232C35;--grid:#242E38;--track:#242E38;' +
    '--ink:#E9EFF4;--gray:#C6D0DA;--mute:#8B99A6;--on-dark:#fff;' +
    '--fade0:rgba(22,28,35,0);' +
    // Brand hues lifted for legibility on a dark ground — the light-mode values are
    // tuned against white and go muddy against #161C23.
    '--blue:#4EA3E0;--blue-dark:#7CBCEA;--blue-wash:#16303F;' +
    '--teal:#2C8F86;--teal-dark:#3FB0A4;--teal-wash:#12312E;' +
    '--good:#5FC08A;--good-wash:#12301F;' +
    '--warn:#E0B15C;--warn-wash:#33270F;' +
    '--bad:#F08A82;--bad-wash:#3A1D1B;' +
    '--e1:0 1px 2px rgba(0,0,0,.4),0 1px 3px rgba(0,0,0,.3);' +
    '--e2:0 2px 4px -1px rgba(0,0,0,.4),0 6px 16px -3px rgba(0,0,0,.45);' +
    '--e3:0 2px 6px -1px rgba(0,0,0,.45),0 14px 34px -6px rgba(0,0,0,.55)';
}

// ============================================================ INSURANCE COMPLIANCE

/**
 * Who is insured, who placed the policy, and who to chase.
 *
 * Two sides of the same question. Residents split three ways — through the RBP, their own
 * policy, or nothing on record. Landlords the same, where "through us" means the property
 * sits in the Surevestor group.
 *
 * TWO THINGS THIS DELIBERATELY DOES NOT DO.
 *
 * It does not guess the RBP split. If INSURANCE.RBP_CARRIERS is unset, covered households
 * are reported as covered and the panel says the split is unavailable. A guessed split is
 * worse than a missing one here, because someone would email a resident about it.
 *
 * It does not draft, send, schedule, or word anything. Whether renters insurance is
 * required, what notice a lapse calls for, and what may follow are LEASE TERMS and
 * California questions. This is a worklist and a count. Anything that goes to a resident or
 * an owner should be reviewed by counsel before it becomes a template.
 */
function insurancePanel_() {
  var owners = readTab_('Insurance_Owner');
  var tenants = readTab_('Insurance_Tenant');
  var chase = readTab_('Insurance_Outreach').filter(function (r) { return r.side; });
  var hist = readTab_('Insurance_History');
  var latest = hist.length ? hist[hist.length - 1] : null;

  var h = [];
  if (!owners.length && !tenants.length) {
    // No .card-body here. A body with no .card-head cannot be collapsed, so "Collapse all"
    // would leave this one card stubbornly open — the DOM suite catches exactly that.
    h.push('<section class="card">');
    h.push(emptyState_('waiting', {
      title: 'No insurance data yet',
      body: 'This is <strong>not</strong> the same as nobody being insured — it means the ' +
            'compliance figures have not been built.',
      adminAction: 'Run <code>buildInsuranceCompliance()</code>, or wait for tonight\u2019s ' +
        'data-quality job.'
    }));
    h.push('</section>');
    return h.join('');
  }

  var splitOn = !!(INSURANCE.RBP_CARRIERS && INSURANCE.RBP_CARRIERS.length);

  function countBy(rows, val) {
    return rows.filter(function (r) { return r.placed_by === val; }).length;
  }
  function pct(n, d) { return d ? Math.round(n / d * 100) : null; }

  // ---------- residents ----------
  var tTotal = tenants.length;
  var tRbp = countBy(tenants, INSURANCE.THROUGH_US);
  var tOwn = countBy(tenants, INSURANCE.OWN);
  var tExp = countBy(tenants, INSURANCE.EXPIRED);
  var tNone = countBy(tenants, INSURANCE.NONE);
  var tUnsplit = tenants.filter(function (r) {
    return String(r.placed_by || '').indexOf('not configured') !== -1; }).length;
  var tCovered = tenants.filter(function (r) { return r.is_covered === 'YES'; }).length;

  h.push('<section class="card" id="sec-insres">');
  h.push('<div class="card-head" onclick="toggleCard(\'insres\')" role="button" tabindex="0" ' +
    'aria-expanded="true" aria-controls="body-insres"><h2>' +
    '<span class="caret" id="car-insres">▾</span> Residents ' +
    '<span class="count" data-count="insres">' + tTotal + '</span></h2>' +
    '<span class="muted small headhint">click to collapse</span></div>');
  h.push('<div class="card-body" id="body-insres">');
  h.push('<p class="note">One policy covers a household, so this counts households, not ' +
    'people. Counting every adult separately would show a covered household as half compliant.</p>');

  h.push('<div class="hero">');
  h.push('<div class="hero-card"><div class="hero-label">Covered</div>' +
    '<div class="hero-value">' + tCovered + '</div>' +
    '<div class="hero-foot muted">' + (pct(tCovered, tTotal) === null ? '' :
      pct(tCovered, tTotal) + '% of ' + tTotal + ' households') + '</div></div>');
  if (splitOn) {
    h.push('<div class="hero-card"><div class="hero-label">Through the RBP</div>' +
      '<div class="hero-value">' + tRbp + '</div>' +
      '<div class="hero-foot muted">' + (pct(tRbp, tTotal) === null ? '' :
        pct(tRbp, tTotal) + '% · placed by us') + '</div></div>');
    h.push('<div class="hero-card"><div class="hero-label">Their own policy</div>' +
      '<div class="hero-value">' + tOwn + '</div>' +
      '<div class="hero-foot muted">' + (pct(tOwn, tTotal) === null ? '' :
        pct(tOwn, tTotal) + '% · carrier is not the RBP one') + '</div></div>');
  } else {
    h.push('<div class="hero-card"><div class="hero-label">Through the RBP</div>' +
      '<div class="hero-value">—</div>' +
      '<div class="hero-foot muted">split not configured</div></div>');
  }
  h.push('<div class="hero-card"><div class="hero-label">Expired</div>' +
    '<div class="hero-value">' + tExp + '</div>' +
    '<div class="hero-foot muted">had a policy, lapsed</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Nothing on record</div>' +
    '<div class="hero-value">' + tNone + '</div>' +
    '<div class="hero-foot muted">' + (pct(tNone, tTotal) === null ? '' :
      pct(tNone, tTotal) + '% of households') + '</div></div>');
  h.push('</div>');

  if (!splitOn) {
    h.push('<div class="coverage"><strong>' + tUnsplit + ' covered household(s) are reported ' +
      'together.</strong> Residents on the Resident Benefits Package share one carrier, so the ' +
      'carrier name is what separates them from residents who brought their own policy — ' +
      'and <code>INSURANCE.RBP_CARRIERS</code> is empty. Run ' +
      '<code>diagnoseInsurance()</code>: it lists every carrier in your data with household ' +
      'counts. Set the RBP carrier and this splits three ways. I have deliberately not ' +
      'guessed, because a guessed split is a number someone would email a resident about.</div>');
  }

  h.push(insBar_([
    { label: splitOn ? 'Through the RBP' : 'Covered', n: splitOn ? tRbp : tCovered, color: 'var(--blue)' },
    { label: 'Their own', n: splitOn ? tOwn : 0, color: 'var(--teal)' },
    { label: 'Expired', n: tExp, color: 'var(--warn)' },
    { label: 'Nothing on record', n: tNone, color: 'var(--bad)' }
  ], tTotal));
  h.push('</div></section>');

  // ---------- landlords ----------
  var oTotal = owners.length;
  var oUs = countBy(owners, INSURANCE.THROUGH_US);
  var oOwn = countBy(owners, INSURANCE.OWN);
  var oExp = countBy(owners, INSURANCE.EXPIRED);
  var oNone = countBy(owners, INSURANCE.NONE);

  h.push('<section class="card" id="sec-insown">');
  h.push('<div class="card-head" onclick="toggleCard(\'insown\')" role="button" tabindex="0" ' +
    'aria-expanded="true" aria-controls="body-insown"><h2>' +
    '<span class="caret" id="car-insown">▾</span> Landlords ' +
    '<span class="count" data-count="insown">' + oTotal + '</span></h2>' +
    '<span class="muted small headhint">click to collapse</span></div>');
  h.push('<div class="card-body" id="body-insown">');
  h.push('<p class="note">"Through us" means the property sits in a ' +
    esc_(INSURANCE.OWNER_WITH_US_GROUPS.join(' / ')) + ' property group. Group membership wins ' +
    'over the expiry date on the property record — a Surevestor property is covered whether ' +
    'or not somebody keyed a date in, and that is exactly the case that would otherwise read ' +
    'as uninsured.</p>');

  h.push('<div class="hero">');
  h.push('<div class="hero-card"><div class="hero-label">Through us</div>' +
    '<div class="hero-value">' + oUs + '</div>' +
    '<div class="hero-foot muted">' + (pct(oUs, oTotal) === null ? '' :
      pct(oUs, oTotal) + '% of ' + oTotal + ' properties') + '</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Their own policy</div>' +
    '<div class="hero-value">' + oOwn + '</div>' +
    '<div class="hero-foot muted">unexpired date on record</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Expired</div>' +
    '<div class="hero-value">' + oExp + '</div>' +
    '<div class="hero-foot muted">lapsed, not replaced</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Nothing on record</div>' +
    '<div class="hero-value">' + oNone + '</div>' +
    '<div class="hero-foot muted">' + (pct(oNone, oTotal) === null ? '' :
      pct(oNone, oTotal) + '% of properties') + '</div></div>');
  h.push('</div>');

  if (latest && !num_(latest.owner_policies_in_report)) {
    h.push('<div class="coverage">The <code>owner_insurance</code> report returned no rows, so ' +
      'every landlord figure above rests on the property record’s expiry date and group ' +
      'membership alone. Those two are enough to count coverage, but you will not see a ' +
      'carrier or a policy number.</div>');
  }

  h.push(insBar_([
    { label: 'Through us', n: oUs, color: 'var(--blue)' },
    { label: 'Their own', n: oOwn, color: 'var(--teal)' },
    { label: 'Expired', n: oExp, color: 'var(--warn)' },
    { label: 'Nothing on record', n: oNone, color: 'var(--bad)' }
  ], oTotal));
  h.push('</div></section>');

  // ---------- who to chase ----------
  h.push('<section class="card" id="sec-inschase">');
  h.push('<div class="card-head" onclick="toggleCard(\'inschase\')" role="button" tabindex="0" ' +
    'aria-expanded="true" aria-controls="body-inschase"><h2>' +
    '<span class="caret" id="car-inschase">▾</span> To chase ' +
    '<span class="count" data-count="inschase">' + chase.length + '</span></h2>' +
    '<span class="muted small headhint">click to collapse</span></div>');
  h.push('<div class="card-body" id="body-inschase">');

  if (!chase.length) {
    h.push('<p class="empty">Nobody to chase — every resident and owner policy is current.</p>');
  } else {
    var noEmail = chase.filter(function (r) { return r.email_missing === 'YES'; }).length;
    h.push('<p class="note">Expired first, then nothing on record, then expiring within ' +
      INSURANCE.EXPIRING_SOON_DAYS + ' days. Rows with no email stay on the list and are ' +
      'marked — a missing address is often the reason the policy was never chased.' +
      (noEmail ? ' <strong>' + noEmail + ' of ' + chase.length + ' have no usable email.</strong>' : '') +
      '</p>');
    h.push('<p class="note"><strong>Nothing here sends anything.</strong> “Compose” opens a ' +
      'pre-filled Gmail draft and a person presses Send. That is deliberate: whether renters ' +
      'insurance is required, what a lapse permits and what notice it takes are lease terms ' +
      'and California questions, the data is imperfect — 81 households have no carrier ' +
      'recorded at all — and an automated send has no author. The wording is a starting ' +
      'point for counsel to review, not approved copy.</p>');
    h.push('<p class="note"><strong>Send from the right mailbox.</strong> Residents must be ' +
      'written to from <code>' + esc_(INSURANCE.FROM_RESIDENTS) + '</code> and owners from ' +
      '<code>' + esc_(INSURANCE.FROM_OWNERS) + '</code>. Gmail cannot be forced to pick an ' +
      'alias from a link, so change the From line in the draft before sending. If those ' +
      'aliases are not on your account yet, ask for send-as access first.</p>');

    var recent = insRecentFollowups_(30);
    h.push('<table class="listtbl"><thead><tr><th>Side</th><th>Who</th><th>Address</th>' +
      '<th>Why</th><th>Last chased</th><th class="num">Remind</th></tr></thead><tbody>');
    chase.slice(0, 150).forEach(function (r, i) {
      var key = String(r.email || r.address || '').toLowerCase();
      var was = recent[key];
      var cta;
      if (!r.email) {
        cta = '<span class="warnpill">no email on file</span>';
      } else {
        var payload = JSON.stringify({ side: r.side, name: r.name, address: r.address,
                                       email: r.email, reason: r.reason });
        cta = '<a class="btn-mini" target="_blank" rel="noopener" href="' +
          esc_(insComposeUrl_(r)) + '" onclick="noteChase(' + i + ')">Compose</a>' +
          '<button type="button" class="btn-mini ghost" id="chase-' + i + '" ' +
          'onclick="logChase(' + i + ')">Log</button>' +
          '<script type="application/json" id="chasedata-' + i + '">' +
          payload.replace(/</g, '\\u003c') + '</script>';
      }
      h.push('<tr><td>' + esc_(r.side) + '</td>' +
        '<td class="strong">' + esc_(r.name || '—') + '</td>' +
        '<td>' + esc_(r.address || '') + '</td>' +
        '<td>' + esc_(r.reason || '') + '</td>' +
        '<td class="muted">' + (was ? esc_(was) : '—') + '</td>' +
        '<td class="num">' + cta + '</td></tr>');
    });
    h.push('</tbody></table>');
    h.push('<p class="note muted">“Last chased” reads <code>Insurance_Followups</code>, so ' +
      'the same resident is not chased twice in a week by two different people. Press ' +
      '<strong>Log</strong> after sending — Compose cannot know whether you actually sent it.</p>');
    if (chase.length > 150) {
      h.push('<p class="note muted">Showing the first 150. The full list is the ' +
        '<code>Insurance_Outreach</code> tab.</p>');
    }
  }
  h.push('</div></section>');

  return h.join('');
}

/** One horizontal stacked bar with a legend. Counts, not percentages, in the labels. */
function insBar_(parts, total) {
  if (!total) return '';
  var h = ['<div class="insbar">'];
  parts.forEach(function (p) {
    if (!p.n) return;
    h.push('<i style="width:' + (p.n / total * 100).toFixed(2) + '%;background:' + p.color +
      '" title="' + esc_(p.label + ': ' + p.n + ' of ' + total) + '"></i>');
  });
  h.push('</div><div class="legend">');
  parts.forEach(function (p) {
    if (!p.n) return;
    h.push('<span class="lg"><i style="background:' + p.color + '"></i>' + esc_(p.label) +
      ' <strong>' + p.n + '</strong></span>');
  });
  h.push('</div>');
  return h.join('');
}

// ============================================================ RENEWAL PIPELINE PANEL

/**
 * Renewals, with the 80-day inspection clock in front.
 *
 * Frank's standard: the annual inspection is completed at least 80 days before the renewal
 * date. The workbook this replaces had 209 of 266 renewal rows with a blank inspection
 * status — not because nobody looked, but because a spreadsheet cannot compare a deadline it
 * never computed against today.
 *
 * The work still happens in LeadSimple. Every row links to its process, and this view
 * reports rather than writes — nothing here creates, advances, or closes a process.
 */
function renewalPipelinePanel_() {
  var rows = readTab_('Renewal_Pipeline').filter(function (r) { return r.address; });
  if (!rows.length) {
    // Deliberately no .card-body — see insurancePanel_.
    return '<section class="card">' +
      emptyState_('waiting', {
        title: 'No renewal pipeline yet',
        body: 'An empty pipeline is <strong>not</strong> the same as nothing being due.',
        adminAction: 'Run <code>buildRenewalPipeline()</code>, or wait for tonight\u2019s ' +
          'compliance job.'
      }) + '</section>';
  }

  function n(st) { return rows.filter(function (r) { return r.inspection_status === st; }).length; }
  var overdue = n('OVERDUE'), soon = n('DUE SOON'), sched = n('SCHEDULED');
  var onTime = n('DONE ON TIME'), late = n('DONE LATE');
  var noDate = n('NO RENEWAL DATE'), notYet = n('NOT YET DUE');
  var measurable = rows.length - noDate - notYet;
  var rate = measurable ? Math.round(onTime / measurable * 100) : null;

  var h = ['<section class="card" id="sec-renclock">'];
  h.push('<div class="card-head" onclick="toggleCard(\'renclock\')" role="button" tabindex="0" ' +
    'aria-expanded="true" aria-controls="body-renclock"><h2>' +
    '<span class="caret" id="car-renclock">▾</span> Inspection clock ' +
    '<span class="count" data-count="renclock">' + rows.length + '</span></h2>' +
    '<span class="muted small headhint">click to collapse</span></div>');
  h.push('<div class="card-body" id="body-renclock">');
  h.push('<p class="note">WeLease standard: the annual inspection is completed at least ' +
    '<strong>' + RENEWAL.INSPECTION_LEAD_DAYS + ' days</strong> before the renewal date. ' +
    'An inspection counts for this cycle only if it happened within the ' +
    RENEWAL.CYCLE_WINDOW_DAYS + ' days before renewal — otherwise a unit inspected two ' +
    'years ago would read as compliant. Showing renewals inside ' + RENEWAL.HORIZON_DAYS +
    ' days.</p>');

  h.push('<div class="hero">');
  h.push('<div class="hero-card"><div class="hero-label">Past the deadline</div>' +
    '<div class="hero-value' + (overdue ? ' bad' : '') + '">' + overdue + '</div>' +
    '<div class="hero-foot muted">no inspection for this cycle</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Due within ' +
    RENEWAL.DUE_SOON_DAYS + ' days</div>' +
    '<div class="hero-value">' + soon + '</div>' +
    '<div class="hero-foot muted">bookable now</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Scheduled</div>' +
    '<div class="hero-value">' + sched + '</div>' +
    '<div class="hero-foot muted">on the calendar, not yet done</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Done on time</div>' +
    '<div class="hero-value">' + onTime + '</div>' +
    '<div class="hero-foot muted">' + (rate === null ? 'nothing measurable yet'
      : rate + '% of the ' + measurable + ' whose deadline has arrived') + '</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Done late</div>' +
    '<div class="hero-value">' + late + '</div>' +
    '<div class="hero-foot muted">inside 80 days of renewal</div></div>');
  h.push('</div>');

  h.push(insBar_([
    { label: 'Done on time', n: onTime, color: 'var(--good)' },
    { label: 'Scheduled', n: sched, color: 'var(--blue)' },
    { label: 'Done late', n: late, color: 'var(--teal)' },
    { label: 'Due soon', n: soon, color: 'var(--warn)' },
    { label: 'Past the deadline', n: overdue, color: 'var(--bad)' },
    { label: 'No renewal date', n: noDate, color: 'var(--mute)' }
  ], rows.length));

  if (noDate) {
    h.push('<div class="coverage"><strong>' + noDate + ' active tenanc' +
      (noDate === 1 ? 'y has' : 'ies have') + ' no renewal date in AppFolio</strong>, so no ' +
      'inspection deadline can be computed for them at all. They are in the table below, ' +
      'marked. Month-to-month is a legitimate reason; never entered is not, and the two are ' +
      'indistinguishable from here.</div>');
  }
  if (rate !== null && measurable >= 10 && rate < 60) {
    h.push('<div class="coverage">On-time inspection compliance is <strong>' + rate + '%</strong> ' +
      'across ' + measurable + ' renewals whose deadline has passed. The renewal process starts ' +
      'on the 15th, roughly three and a half months ahead of expiry — so the ' +
      RENEWAL.INSPECTION_LEAD_DAYS + '-day inspection deadline falls inside that window rather ' +
      'than before it. Booking the inspection at process start is what makes the deadline ' +
      'reachable.</div>');
  }
  h.push('</div></section>');

  // ---- the worklist ----
  h.push('<section class="card" id="sec-renwork">');
  h.push('<div class="card-head" onclick="toggleCard(\'renwork\')" role="button" tabindex="0" ' +
    'aria-expanded="true" aria-controls="body-renwork"><h2>' +
    '<span class="caret" id="car-renwork">▾</span> Renewals, worst first ' +
    '<span class="count" data-count="renwork">' + rows.length + '</span></h2>' +
    '<span class="muted small headhint">click to collapse</span></div>');
  h.push('<div class="card-body" id="body-renwork">');
  h.push('<p class="note">The work happens in LeadSimple — the process column links ' +
    'straight to it. This view reports; it does not create, advance, or close anything.</p>');
  h.push('<table class="listtbl"><thead><tr>' +
    '<th>Inspection</th><th>Address</th><th>Resident</th><th>Renewal date</th>' +
    '<th>Inspect by</th><th>Countdown</th><th>Rent → market</th>' +
    '<th class="num">LeadSimple</th></tr></thead><tbody>');
  rows.slice(0, 200).forEach(function (r) {
    var d = num_(r.days_to_inspection_due);
    var countdown = r.inspection_completed
      ? ('done ' + esc_(String(r.inspection_completed)) +
         (num_(r.days_early) !== null && num_(r.days_early) < 0
           ? ' · ' + Math.abs(num_(r.days_early)) + ' days late' : ''))
      : (d === null ? '—' : (d < 0 ? dayOverdue_(-d) : dayLabel_(d)));
    var rent = num_(r.current_rent), mkt = num_(r.market_rent);
    var money = rent === null ? '—'
      : money_(rent) + (mkt === null ? '' :
          ' → ' + money_(mkt) + (mkt > rent ? ' <span class="muted">(+' +
            money_(mkt - rent) + ')</span>' : ''));
    var lsCell = r.ls_process_id
      ? '<a href="https://app.leadsimple.com/processes/' + esc_(String(r.ls_process_id)) +
        '" target="_blank" rel="noopener">' + esc_(r.ls_stage || 'open') + '</a>'
      : '<span class="muted">no process</span>';
    h.push('<tr><td><span class="pill ' + esc_(r.severity || 'none') + '">' +
      esc_(r.inspection_status) + '</span></td>' +
      '<td class="strong">' + esc_(r.address) + '</td>' +
      '<td>' + esc_(r.resident || '') + '</td>' +
      '<td>' + esc_(String(r.renewal_date || '—')) + '</td>' +
      '<td>' + esc_(String(r.inspection_due_by || '—')) + '</td>' +
      '<td>' + countdown + '</td>' +
      '<td>' + money + '</td>' +
      '<td class="num">' + lsCell + '</td></tr>');
  });
  h.push('</tbody></table>');
  if (rows.length > 200) {
    h.push('<p class="note muted">Showing the first 200 of ' + rows.length +
      '. The full list is the <code>Renewal_Pipeline</code> tab.</p>');
  }
  h.push('</div></section>');
  return h.join('');
}

// ============================================================ ONBOARDING PANEL

/**
 * Where onboarding time goes, step by step.
 *
 * The cycle-time tile says onboarding takes N days. This says which step is spending them,
 * which is the only version you can act on. Frank: "we want to track where we can improve".
 *
 * Reports only. Nothing here advances, closes or creates a LeadSimple step.
 */
/**
 * Owner onboarding, as the process actually runs.
 *
 * WHAT CHANGED AND WHY, 2026-09-02. This used to list all seventeen steps of the
 * Collecting Owner Information stage in one table. Seventeen rows is a process map, not
 * a report — most of them are one-minute administrative ticks and three of them are the
 * whole job, and giving them equal weight is how a panel becomes wallpaper.
 *
 * THREE DELIBERATE CHOICES:
 *
 * 1 · TPO AND FULL MANAGEMENT ARE REPORTED APART. One process serves both, branching at
 *     the PMA confirmation. Tenant placement has no owner portal and no monthly
 *     statements, so an average across the two describes neither service.
 *
 * 2 · AUTOMATED EMAILS ARE NOT COUNTED AS WORK. A send LeadSimple performs by itself
 *     completes whether anyone is paying attention. Counting it in an adherence figure
 *     measures the automation's uptime and calls it the team's.
 *
 * 3 · FIRST TOUCH COUNTS BOTH. The owner cannot tell an automated intro email from a
 *     typed one, and the number being measured is how long they waited to hear from us.
 */
function onboardingPanel_() {
  var rows = readTab_('Onboarding_Journeys').filter(function (r) { return r.process_id; });
  if (!rows.length) {
    var note = (readTab_('Onboarding_Journeys')[0] || {}).note;
    return '<section class="card"><h2>Owner onboarding</h2>' +
      emptyState_(note ? 'broken' : 'waiting', {
        title: note ? 'Onboarding could not be measured' : 'No onboarding data yet',
        body: note ? esc_(note) : 'The journey table has not been built.',
        adminAction: 'Run <code>buildOnboardingJourneys()</code>, then refresh.'
      }) + '</section>';
  }

  var svcOf = {};
  LS_ONBOARDING.SERVICE.forEach(function (s) { svcOf[s.key] = s.label; });
  svcOf.UNKNOWN = 'Service not identified';

  var groups = ['FULL_PMA', 'TPO', 'UNKNOWN'].filter(function (k) {
    return rows.some(function (r) { return r.service === k; });
  });

  var h = ['<section class="card" id="sec-onboard"><div class="card-head"><h2>' +
    'Owner onboarding</h2><span class="muted small headhint">' + rows.length +
    ' onboarding' + (rows.length === 1 ? '' : 's') + '</span></div>'];
  h.push('<p class="note">The process LeadSimple opens when an owner is won. ' +
    '<strong>Tenant placement and full management are shown separately</strong> — one ' +
    'process serves both and they are not the same job, so an average across them ' +
    'describes neither.</p>');

  // ---- first touch, the headline ------------------------------------------------
  // How long an owner waits to hear from us at all. Automated or typed: they cannot tell.
  h.push('<h3 class="scgroup tilegroup">First touch</h3>');
  h.push('<p class="note grouphint">Process created to the first intro email reaching the ' +
    'owner. Automated sends count — the owner received an email either way, and this ' +
    'measures their wait, not ours.</p>');
  h.push('<div class="hero">');
  groups.forEach(function (g) {
    var mine = rows.filter(function (r) { return r.service === g; });
    var ft = mine.map(function (r) { return num_(r.first_touch_days); })
                 .filter(function (x) { return x !== null && x >= 0; });
    var med = median_(ft);
    var sameDay = ft.filter(function (d) { return d <= 1; }).length;
    h.push('<div class="hero-card' + (ft.length ? '' : ' blank') + '">' +
      '<div class="hero-label">' + esc_(svcOf[g]) + '</div>' +
      '<div class="hero-value">' + (med === null ? '\u2014' : daySpan_(med)) + '</div>' +
      '<div class="hero-foot muted">' +
      (ft.length
        ? Math.round(sameDay / ft.length * 100) + '% within a day \u00b7 ' +
          mine.length + ' onboarding' + (mine.length === 1 ? '' : 's')
        : 'no intro email recorded on ' + mine.length + ' onboarding' +
          (mine.length === 1 ? '' : 's')) +
      '</div></div>');
  });
  h.push('</div>');

  var noTouch = rows.filter(function (r) { return !r.first_touch_date; }).length;
  if (noTouch) {
    h.push('<p class="warnrow"><strong>' + noTouch + ' onboarding' +
      (noTouch === 1 ? ' has' : 's have') + ' no intro email recorded at all.</strong> ' +
      'Either the automation did not fire, or the step was skipped. This is the one to ' +
      'check first \u2014 an owner who has heard nothing does not know they are being ' +
      'onboarded.</p>');
  }

  // ---- the milestones ------------------------------------------------------------
  h.push('<h3 class="scgroup tilegroup">Milestones</h3>');
  h.push('<p class="note grouphint">Seven of the seventeen steps. The rest are ' +
    'administrative ticks that always complete and tell you nothing when they do. Days ' +
    'are the median from the day the process opened.</p>');
  h.push('<table class="mini2"><thead><tr><th>Milestone</th>');
  groups.forEach(function (g) {
    h.push('<th class="num">' + esc_(svcOf[g].split(' ')[0]) + ' reached</th>' +
           '<th class="num">days</th>');
  });
  h.push('</tr></thead><tbody>');
  LS_ONBOARDING.MILESTONES.forEach(function (m) {
    var cells = [], anywhere = 0;
    groups.forEach(function (g) {
      var mine = rows.filter(function (r) { return r.service === g; });
      var hit = mine.filter(function (r) { return r[m.key + '_date']; });
      anywhere += hit.length;
      var days = hit.map(function (r) { return num_(r[m.key + '_days']); })
                    .filter(function (x) { return x !== null && x >= 0; });
      var med = median_(days);
      var pct = mine.length ? Math.round(hit.length / mine.length * 100) : null;
      var target = LS_ONBOARDING.TARGET_DAYS[m.key];
      var late = (med !== null && target && med > target);
      cells.push('<td class="num">' + (pct === null ? '\u2014' :
        '<span class="tag ' + (pct >= 90 ? 'good' : (pct >= 60 ? 'warn' : 'bad')) + '">' +
        pct + '%</span>') + '</td>' +
        '<td class="num' + (late ? ' strong' : ' muted') + '">' +
        (med === null ? '\u2014' : daySpan_(med)) + '</td>');
    });
    // A milestone nothing has reached is a matcher that no longer matches a step name.
    h.push('<tr><td class="strong">' + esc_(m.label) +
      (anywhere ? '' : ' <span class="tag none">no step matched</span>') + '</td>' +
      cells.join('') + '</tr>');
  });
  h.push('</tbody></table>');
  h.push(adminNote_('A milestone reading <strong>no step matched</strong> means the step ' +
    'was renamed in LeadSimple and <code>LS_ONBOARDING.MILESTONES</code> is looking for ' +
    'the old wording. Five-minute fix, and worth making \u2014 a blank row here looks like a ' +
    'step nobody does.', { quiet: true }));

  // ---- manual emails, and whether they go out consistently ----------------------
  var mail = readTab_('Onboarding_Emails').filter(function (r) { return r.subject; });
  if (mail.length) {
    h.push('<h3 class="scgroup tilegroup">Emails the team sends by hand</h3>');
    h.push('<p class="note grouphint">Automated sends are excluded \u2014 they complete ' +
      'whether or not anyone is watching, so counting them measures LeadSimple. These are ' +
      'the ones a person has to write and send.</p>');
    h.push('<table class="mini2"><thead><tr><th>Subject</th>' +
      '<th class="num">Onboardings with this step</th><th class="num">Sent</th>' +
      '<th class="num">Still open</th><th class="num">Sent rate</th></tr></thead><tbody>');
    mail.forEach(function (r) {
      var pct = num_(r.sent_pct);
      h.push('<tr><td class="strong">' + esc_(r.subject) + '</td>' +
        '<td class="num muted">' + esc_(r.onboardings_with_this_step) + '</td>' +
        '<td class="num">' + esc_(r.sent) + '</td>' +
        '<td class="num' + (num_(r.still_open) > 0 ? ' strong' : ' muted') + '">' +
        esc_(r.still_open) + '</td>' +
        '<td class="num"><span class="tag ' +
        (pct === null ? 'none' : (pct >= 90 ? 'good' : (pct >= 60 ? 'warn' : 'bad'))) +
        '">' + (pct === null ? '\u2014' : pct + '%') + '</span></td></tr>');
    });
    h.push('</tbody></table>');
    h.push('<p class="note"><strong>Read the bottom of this table, not the top.</strong> ' +
      'A subject going out on 40% of onboardings is either optional \u2014 in which case ' +
      'it should not be a required step \u2014 or it is being missed. Both are worth ' +
      'fixing, and neither is visible from a completion count.</p>');
  }

  h.push('</section>');
  return h.join('');
}


// ============================================================ FEEDBACK

/**
 * Feedback, per view, from the people using it.
 *
 * The team can see things the data cannot: a list that is sorted wrong for how they work, a
 * column nobody reads, a number they do not trust. That only reaches us if asking costs one
 * click from the page they are already looking at — a message sent later never gets sent.
 *
 * Called from the page via google.script.run. Writes to _feedback and nothing else; it does
 * not email, notify or escalate, because a dashboard that pings people is one they stop
 * opening.
 */
function submitFeedback(payload) {
  payload = payload || {};
  var text = String(payload.text || '').trim();
  if (!text) return 'Nothing to send.';
  // Feedback silently failing is the worst of these: the person believes they have told
  // somebody about a wrong number, and nobody has been told anything.
  if (!canWrite_()) return writeBlockedMessage_();
  var row = {
    submitted_at: nowStamp_(),
    submitted_by: (function () {
      try { return Session.getActiveUser().getEmail() || 'unknown'; }
      catch (e) { return 'unknown'; }
    })(),
    view: payload.view || '',
    kind: payload.kind || 'comment',
    feedback: text.slice(0, 4000),
    status: 'NEW'
  };
  appendTab_('_feedback', [row]);
  return row.submitted_at;
}

/**
 * A floating feedback button — one per page, not one per view.
 *
 * It used to be a card at the foot of each view, which meant ten copies in the HTML and,
 * more to the point, a button you only met after scrolling past everything. The moment
 * somebody doubts a number is the moment they are LOOKING at it, and by the time they have
 * scrolled to the bottom the thought has usually gone.
 *
 * Floating and always reachable. It reads the active view from the page rather than being
 * told at render time, so one button serves all ten and the report still says which view
 * the person was on.
 */
function feedbackFab_() {
  return '<button type="button" id="fbFab" class="fbfab" onclick="openFeedbackHere()" ' +
    'title="Tell us something about this view" aria-label="Send feedback about this view">' +
    '<span class="fbfab-i" aria-hidden="true">\u270e</span>' +
    '<span class="fbfab-t">Feedback</span></button>';
}

// ============================================================ TOOLS

/**
 * Tools that are not views.
 *
 * The notice filler is a separate web app, and deliberately so. It carries pdf.js and
 * pdf-lib \u2014 a megabyte of libraries that would load for all fifteen people every time
 * anybody opened the dashboard, to serve the three who ever fill a notice. It also has a
 * different blast radius: a bug in a legal document generator should not be able to take
 * the operations dashboard down with it, and neither should want to wait on the other's
 * deploy.
 *
 * So it gets a launcher, not a tab. A nav that grows a tab per tool ends up mostly tools,
 * and every one of them is a thing the reader has to decide to ignore.
 *
 * URL lives in script properties (NOTICE_TOOL_URL) rather than in the code, because it
 * changes every time that app is redeployed and nobody should have to edit a .gs file for
 * that. Unset, the button says how to set it rather than opening a broken tab.
 */
var TOOLS = [{
  key: 'notices',
  icon: '\u{1F5CE}',
  name: 'Notice filler',
  prop: 'NOTICE_TOOL_URL',
  // Internal, for people who already know what these forms are. The compliance framing
  // belongs in the tool itself and in the template review, not on a launcher button the
  // team reads fifty times.
  blurb: 'Fill a CAA or CAR notice from a resident record. Pick the form, pick the ' +
         'household, the names and addresses fill themselves, you type the rest.'
}];

function toolsFab_() {
  return '<button type="button" id="tlFab" class="tlfab" onclick="openTools()" ' +
    'title="Tools that are not part of the dashboard" aria-label="Open tools">' +
    '<span class="tlfab-i" aria-hidden="true">\u2699</span>' +
    '<span class="tlfab-t">Tools</span></button>';
}

function toolsModal_() {
  var props;
  try { props = PropertiesService.getScriptProperties(); } catch (e) { props = null; }

  var h = ['<div id="tlOverlay" class="stov" onclick="closeTools(event)">' +
    '<div class="stbox" onclick="event.stopPropagation()">' +
    '<h3>Tools</h3>' +
    '<p class="note muted">Separate apps. They open in a new tab and leave this page ' +
    'as it is.</p>'];

  TOOLS.forEach(function (t) {
    var url = '';
    try { url = props ? (props.getProperty(t.prop) || '') : ''; } catch (e) {}
    h.push('<div class="tlrow"><span class="tlicon" aria-hidden="true">' + t.icon + '</span><div>');
    h.push('<h4>' + esc_(t.name) + '</h4>');
    h.push('<p>' + esc_(t.blurb) + '</p>');
    if (t.caution) h.push('<p class="note muted">' + esc_(t.caution) + '</p>');
    if (url) {
      h.push('<a class="btn-mini" target="_blank" rel="noopener" href="' + esc_(url) + '">' +
        'Open ' + esc_(t.name) + '</a>');
    } else {
      h.push(adminNote_('Not linked yet. Deploy the app, then set the script property ' +
        '<code>' + esc_(t.prop) + '</code> to its web app URL. ' +
        'Project Settings \u2192 Script Properties.') ||
        '<p class="note muted">This tool has not been set up yet \u2014 ask whoever looks ' +
        'after the dashboard.</p>');
    }
    h.push('</div></div>');
  });

  h.push('<div class="fbactions">' +
    '<button type="button" class="ghost" onclick="closeTools()">Close</button></div>');
  h.push('</div></div>');
  return h.join('');
}

// ============================================================ WEEKLY REPORT VIEW

/**
 * The weekly department report, with the countable half already filled.
 *
 * Grouped by department in the order the meeting runs, with last week beside every number
 * that has one — because management's own instruction is "review pattern, not perfection",
 * and a single week cannot show a pattern.
 *
 * The five named KPIs are pulled to the top of their department, because a snapshot that
 * buries the one measure that matters among fifteen counts is a snapshot nobody reads twice.
 */
function weeklyReportPanel_() {
  var rows = readTab_(WEEKLY.TAB).filter(function (r) { return r.metric; });
  if (!rows.length) {
    return '<section class="card">' + emptyState_('waiting', {
      title: 'No weekly report yet',
      body: 'This is not the same as a week with nothing in it \u2014 the report has not ' +
            'been built. It is rebuilt on Monday mornings.',
      adminAction: 'Run <code>buildWeeklyReport()</code>, or wait for Monday.'
    }) + '</section>';
  }

  var from = rows[0].week_start, to = rows[0].week_end;
  var trend = weeklyTrend_();
  var h = [];
  h.push('<section class="card"><div class="card-head"><h2>' +
    esc_(from) + ' to ' + esc_(to) + '</h2></div>');
  h.push('<p class="note">Every figure here is counted from the dashboard, so it means the ' +
    'same thing this week as last. <strong>Blank fields are for the meeting</strong> — ' +
    'issues, risks, support needed, next week’s focus. Those are the reason to be in ' +
    'the room; the counts are not.</p>');
  h.push('<p class="note muted">Copy a department block straight into your report. Where a ' +
    'number is missing the row says why rather than showing a zero.</p>');
  h.push('<p class="note muted">The window is the seven days ending on the report date. A ' +
    'value dated ' + esc_(from) + ' belongs to the week before — the boundary day is ' +
    'counted once, not in both weeks.</p>');
  if (trend.weeks.length > 1) {
    h.push('<p class="note">Showing <strong>' + trend.weeks.length + ' weeks</strong> side ' +
      'by side. One week is a number; three is a direction, and a direction is what a ' +
      'meeting can act on.</p>');
  }
  h.push('</section>');

  var byDept = groupBy_(rows, function (r) { return r.department || 'Other'; });
  var order = ['Vacancy & Leasing', 'Field', 'Resident Relations', 'Turnovers',
               'Maintenance', 'Owner Relations', 'Resident Experience', 'Compliance'];
  var depts = order.filter(function (d) { return byDept[d]; })
    .concat(Object.keys(byDept).filter(function (d) { return order.indexOf(d) === -1; }));

  depts.forEach(function (dept) {
    var list = byDept[dept];
    // KPIs first. Everything else keeps its build order, which is roughly narrative.
    var kpis = list.filter(function (r) { return /^KPI/.test(String(r.metric)); });
    var rest = list.filter(function (r) { return !/^KPI/.test(String(r.metric)); });
    var id = 'wk-' + norm_(dept).replace(/\s+/g, '-');

    h.push('<section class="card" id="sec-' + id + '">');
    h.push('<div class="card-head" onclick="toggleCard(\'' + id + '\')" role="button" ' +
      'tabindex="0" aria-expanded="true" aria-controls="body-' + id + '"><h2>' +
      '<span class="caret" id="car-' + id + '">▾</span> ' + esc_(dept) +
      '<span class="count" data-count="' + id + '">' + list.length + '</span></h2>' +
      '<span class="muted small headhint">click to collapse</span></div>');
    h.push('<div class="card-body" id="body-' + id + '">');

    if (kpis.length) {
      h.push('<div class="hero">');
      kpis.forEach(function (r) {
        var v = (r.value === '' || r.value === null) ? '—' : r.value;
        h.push('<div class="hero-card"><div class="hero-label">' +
          esc_(String(r.metric).replace(/^KPI\s*·\s*/, '')) + '</div>' +
          '<div class="hero-value">' + esc_(String(v)) + '</div>' +
          '<div class="hero-foot muted">' + esc_(r.note || r.source || '') + '</div></div>');
      });
      h.push('</div>');
    }

    // One column per week, newest first. Older weeks come from Weekly_Report_History.
    h.push('<table class="mini2"><thead><tr><th>Measure</th>');
    trend.weeks.forEach(function (wk, i) {
      h.push('<th class="num' + (i === 0 ? ' strong' : ' muted') + '">' +
        esc_(wk === from ? 'This week' : wk) + '</th>');
    });
    h.push('<th class="num">Change</th><th>Notes</th></tr></thead><tbody>');

    rest.forEach(function (r) {
      var key = (r.department || '') + '||' + r.metric;
      var series = trend.rows[key] || {};
      h.push('<tr><td class="strong">' + esc_(r.metric) + '</td>');
      trend.weeks.forEach(function (wk, i) {
        var cell = series[wk];
        var v = cell ? cell.value : '';
        h.push('<td class="num' + (i === 0 ? '' : ' muted') + '">' +
          (v === '' || v === null || v === undefined
            ? '<span class="muted">' + (i === 0 ? 'not held' : '—') + '</span>'
            : esc_(String(v))) + '</td>');
      });
      // Change against the immediately preceding week we actually have.
      var a = num_(r.value);
      var prevWk = trend.weeks[1];
      var b = prevWk && series[prevWk] ? num_(series[prevWk].value) : null;
      var chTxt = (a === null || b === null) ? '' : (a - b > 0 ? '+' + (a - b) : String(a - b));
      h.push('<td class="num muted">' + esc_(chTxt) + '</td>' +
        '<td class="muted small">' + esc_(r.note || '') + '</td></tr>');
    });
    h.push('</tbody></table></div></section>');
  });

  h.push('<section class="card"><h2>What the dashboard cannot count</h2>');
  h.push('<p class="note">These stay manual because no system holds them. That is not a ' +
    'gap to fix — it is the part of the report a person is actually needed for.</p>');
  h.push('<ul class="note">' +
    '<li><strong>Inbox compliance and response time</strong> — lives in email, not AppFolio.</li>' +
    '<li><strong>Owner vacancy updates sent</strong> — no record of the send.</li>' +
    '<li><strong>Office walk-ins, mail, procurement, payroll</strong> — no source, and ' +
    'automating them would cost more than typing them.</li>' +
    '<li><strong>Sensitive owners, escalations, vendor issues</strong> — judgement.</li>' +
    '<li><strong>Support needed and next week’s focus</strong> — the whole point of ' +
    'the meeting.</li></ul>');
  h.push('</section>');
  return h.join('');
}

// ============================================================ WHAT CHANGED

/**
 * What moved since yesterday, per tab.
 *
 * `buildThroughput` has computed added / cleared / carried per list every night since it
 * was built, and none of it has ever been on screen. This is a read of existing data, not a
 * new measurement.
 *
 * WHY PER TAB RATHER THAN PER LIST. There are around twenty lists and twelve tabs. Twenty
 * rows of movement is a report; twelve is a glance, and a glance is what somebody wants at
 * 8am. The lists are still there underneath, one click away.
 *
 * WHY ADDED AND CLEARED SEPARATELY, NOT JUST THE NET. A tab that went from 80 to 83 could
 * have taken three new items, or taken twelve and cleared nine. Those are different days.
 * The net alone hides the work.
 */
function whatChangedPanel_() {
  var thru = readTab_('Throughput');
  if (!thru.length) {
    return '<section class="card"><p class="note muted">No movement history yet — ' +
      '<code>rebuildThroughput</code> runs nightly and needs two runs before it can show a ' +
      'change. Nothing is wrong.</p></section>';
  }

  // The most recent run. Older runs stay in the tab as history.
  var latest = thru.reduce(function (a, r) {
    var d = ymd_(r.run_date);
    return (!a || (d && d > a)) ? d : a;
  }, null);
  var today = thru.filter(function (r) { return ymd_(r.run_date) === latest; });
  if (!today.length) return '';

  var firstRun = today.some(function (r) { return r.first_run; });

  // Roll the lists up to the tab they appear on.
  var byView = {};
  today.forEach(function (r) {
    var v = r.view || 'other';
    var b = byView[v] || (byView[v] = { open: 0, added: 0, cleared: 0, lists: 0 });
    b.open += (num_(r.open_now) || 0);
    b.added += (num_(r.added) || 0);
    b.cleared += (num_(r.cleared) || 0);
    b.lists++;
  });

  var labelOf = function (id) {
    var v = VIEWS.filter(function (x) { return x.id === id; })[0];
    return v ? v.label : id;
  };
  // Tab order, so this reads in the same sequence as the nav above it.
  var order = VIEWS.map(function (v) { return v.id; })
    .filter(function (id) { return byView[id]; })
    .concat(Object.keys(byView).filter(function (id) {
      return !VIEWS.some(function (v) { return v.id === id; }); }));

  var totAdded = 0, totCleared = 0, totOpen = 0;
  order.forEach(function (id) {
    totAdded += byView[id].added; totCleared += byView[id].cleared;
    totOpen += byView[id].open;
  });

  var h = ['<section class="card" id="sec-changed">'];
  h.push('<div class="card-head" onclick="toggleCard(\'changed\')" role="button" ' +
    'tabindex="0" aria-expanded="true" aria-controls="body-changed"><h2>' +
    '<span class="caret" id="car-changed">▾</span> What changed since yesterday ' +
    '<span class="count" data-count="changed">' + (totAdded + totCleared) + '</span></h2>' +
    '<span class="muted small headhint">' + esc_(latest || '') + '</span></div>');
  h.push('<div class="card-body" id="body-changed">');

  if (firstRun) {
    h.push('<p class="warnrow">First run — there is nothing to compare against yet. ' +
      'Movement appears from tomorrow.</p>');
  }

  h.push('<div class="hero">');
  h.push('<div class="hero-card"><div class="hero-label">Open now</div>' +
    '<div class="hero-value">' + totOpen + '</div>' +
    '<div class="hero-foot muted">across every list</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Arrived</div>' +
    '<div class="hero-value">' + (totAdded ? '+' + totAdded : '0') + '</div>' +
    '<div class="hero-foot muted">new since the last run</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Cleared</div>' +
    '<div class="hero-value">' + (totCleared ? '−' + totCleared : '0') + '</div>' +
    '<div class="hero-foot muted">gone since the last run</div></div>');
  var net = totAdded - totCleared;
  h.push('<div class="hero-card"><div class="hero-label">Net</div>' +
    '<div class="hero-value' + (net > 0 ? ' bad' : '') + '">' +
    (net > 0 ? '+' + net : String(net)) + '</div>' +
    '<div class="hero-foot muted">' +
    (net > 0 ? 'the queue grew' : net < 0 ? 'the queue shrank' : 'level') + '</div></div>');
  h.push('</div>');

  h.push('<table class="mini2"><thead><tr><th>Tab</th><th class="num">Open</th>' +
    '<th class="num">Yesterday</th><th class="num">Arrived</th><th class="num">Cleared</th>' +
    '<th>Movement</th></tr></thead><tbody>');
  order.forEach(function (id) {
    var b = byView[id];
    var was = b.open - b.added + b.cleared;      // where it stood before the day's movement
    var n = b.added - b.cleared;
    // A short bar so the eye finds the busy tabs without reading every number.
    var span = Math.max(1, totAdded + totCleared);
    var bar = '';
    if (b.added) bar += '<i class="mvA" style="width:' +
      Math.max(3, Math.round(b.added / span * 100)) + '%"></i>';
    if (b.cleared) bar += '<i class="mvC" style="width:' +
      Math.max(3, Math.round(b.cleared / span * 100)) + '%"></i>';
    h.push('<tr><td class="strong"><a href="#" onclick="show(\'' + esc_(id) +
        '\');return false;">' + esc_(labelOf(id)) + '</a></td>' +
      '<td class="num strong">' + b.open + '</td>' +
      '<td class="num muted">' + was + '</td>' +
      '<td class="num">' + (b.added ? '<span class="tag warn">+' + b.added + '</span>' : '—') + '</td>' +
      '<td class="num">' + (b.cleared ? '<span class="tag good">−' + b.cleared + '</span>' : '—') + '</td>' +
      '<td><span class="mvbar">' + bar + '</span> ' +
      '<span class="muted small">' + (n > 0 ? '+' + n : n < 0 ? String(n) : 'no change') +
      '</span></td></tr>');
  });
  h.push('</tbody></table>');
  h.push('<p class="note muted">"Yesterday" is the previous nightly run, not a calendar day ' +
    '— if a run was missed the comparison spans both days and the numbers are still right. ' +
    'Click a tab name to go there.</p>');
  h.push('</div></section>');
  return h.join('');
}
