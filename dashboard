  h.push('</div>');

  h.push('<div class="coverage"><strong>Matched on the resident’s name.</strong> ' +
    'LeadSimple and AppFolio share no key, so a lead is only counted when it resolves to ' +
    'exactly one move-in — anything ambiguous is written to ' +
    '<code>_ls_join_exceptions</code> rather than guessed at. ' +
    (enough
      ? 'Match rate is high enough for the median to describe the portfolio.'
      : '<strong>Not publishable as a rate yet</strong> — ' +
        (rows.length < CFG.MIN_N_TO_PUBLISH
          ? 'only ' + rows.length + ' matched leads, below the n=' + CFG.MIN_N_TO_PUBLISH + ' floor.'
          : 'only ' + rate + '% of leads matched, so this describes that subset rather than the portfolio.')) +
    '</div>');

  if (exceptions.length) {
    var byReason = {};
    exceptions.forEach(function (r) {
      var k = r.reason || 'unknown';
      byReason[k] = (byReason[k] || 0) + 1;
    });
    var keys = Object.keys(byReason).sort(function (a, b) { return byReason[b] - byReason[a]; });
    h.push('<section class="card"><div class="card-head" onclick="toggleCard(\'l2m_ex\')" ' +
      'role="button" tabindex="0" aria-expanded="true" aria-controls="body-l2m_ex">' +
      '<h2><span class="caret" id="car-l2m_ex">▾</span> Why leads did not match' +
      '<span class="count">' + exceptions.length + '</span></h2>' +
      '<span class="muted small headhint">click to collapse</span></div>');
    h.push('<div class="card-body" id="body-l2m_ex">');
    h.push('<p class="note">Not all of these are problems. A lead that has not converted ' +
      'yet is simply still open. "Ambiguous" is the one that matters — it means the name ' +
      'was too common to resolve, and no amount of tuning fixes that without a shared key.</p>');
    h.push('<table><thead><tr><th>Reason</th><th class="num">Leads</th>' +
      '<th class="num">Share</th></tr></thead><tbody>');
    keys.forEach(function (k) {
      var n = byReason[k];
      var tone = /ambiguous/i.test(k) ? 'bad' : (/still open/i.test(k) ? 'ok' : 'warn');
      h.push('<tr><td class="strong">' + esc_(k) + '</td>' +
        '<td class="num">' + n + '</td>' +
        '<td class="num"><span class="tag ' + tone + '">' +
        Math.round(n / exceptions.length * 100) + '%</span></td></tr>');
    });
    h.push('</tbody></table></div></section>');
  }

  return h.join('');
}

/**
 * Rent collection — the four figures side by side, and twelve months of trend.
 *
 * The honest caveat sits on the panel rather than in a footnote: collections are a CASH
 * figure covering every resident receipt, because receivables_activity records what was
 * received, not what it was applied to. A month clearing arrears can exceed 100%; a
 * month where someone prepays can dip. It is not a rent-only collection rate and
 * presenting it as one would be a tidy lie.
 */
function rentCollectionPanel_() {
  var s = readTab_('Portfolio_Summary')[0];
  var series = readTab_('Rent_Collection');
  if (!s && !series.length) return '';

  var h = ['<h3 class="scgroup tilegroup">Rent income and receipts</h3>'];
  h.push('<p class="note grouphint">What the portfolio could earn, what it bills, and what ' +
    'actually arrives.</p>');

  if (s) {
    var mktActive = num_(s.market_rent_active), mktOcc = num_(s.market_rent_occupied);
    var charged = num_(s.rent_charged);
    // The LAST COMPLETE month, not the current one. A month that is ten days old shown
    // beside a full month of charges is what made collections look like a collapse.
    //
    // Chosen by comparing month KEYS, not by taking the last element. Position assumes the
    // tab is sorted ascending, and the previous version of this both assumed that and read
    // the label off a raw cell that Sheets had turned into a Date — so the number and the
    // month name could come from different rows. monthNorm_ settles both.
    var keyed = series.map(function (r) { return { key: monthNorm_(r.month), row: r }; })
                      .filter(function (x) { return x.key; });
    var nowKey = monthNorm_(ymd_(today_()));

    var complete = keyed.filter(function (x) {
      // Belt and braces: a month at or after the current one cannot be complete no matter
      // what the is_partial column says. And a month flagged SUSPECT by buildRentCollection
      // is not a candidate either — its receipts are missing, so headlining it states a
      // number that is simply wrong rather than merely early.
      return x.row.is_partial !== 'YES' && x.row.is_suspect !== 'YES' && x.key < nowKey;
    }).sort(function (a, b) { return a.key < b.key ? -1 : 1; });

    var lastX = complete.length ? complete[complete.length - 1] : null;
    var last = lastX ? lastX.row : null;
    var lastKey = lastX ? lastX.key : null;
    var collected = last ? num_(last.rent_collected) : null;

    var running = keyed.filter(function (x) {
      return x.row.is_partial === 'YES' && (!lastKey || x.key > lastKey);
    }).sort(function (a, b) { return a.key < b.key ? -1 : 1; })[0];
    running = running ? running.row : null;

    // A complete month collecting far less per paying household than a single rent would
    // explain is a part-month wearing a full month's label, not a collections problem.
    var perHH = null;
    if (collected && num_(last && last.households_paying)) {
      perHH = collected / num_(last.households_paying);
    }
    var suspect = (perHH !== null && perHH < 1200);

    // Any month the builder flagged as missing receipts, said plainly. This is the line
    // that should have appeared instead of "$315,152 · August 2026".
    var suspectMonths = keyed.filter(function (x) { return x.row.is_suspect === 'YES'; });

    h.push('<div class="hero">');
    h.push('<div class="hero-card"><div class="hero-label">Market rent · active</div>' +
      '<div class="hero-value">' + money_(mktActive) + '</div>' +
      '<div class="hero-foot muted">every active unit at market</div></div>');
    h.push('<div class="hero-card"><div class="hero-label">Market rent · occupied</div>' +
      '<div class="hero-value">' + money_(mktOcc) + '</div>' +
      '<div class="hero-foot muted">the units with a resident in them</div></div>');
    h.push('<div class="hero-card"><div class="hero-label">Rent charged</div>' +
      '<div class="hero-value">' + money_(charged) + '</div>' +
      '<div class="hero-foot muted">' +
      ((mktOcc && charged !== null)
        ? (charged >= mktOcc ? 'at or above market on occupied units'
                             : money_(mktOcc - charged) + ' under market')
        : 'billed to current residents') + '</div></div>');
    // TWO measures, and the labels now say which is which.
    //
    // "Rent income" is the accountant's figure: GL 4100 + 4105, recognised in the month the
    // rent covers. It reconciles to the income statement, because it is the same ledger.
    //
    // "Resident receipts" is cash on the date it arrived, and it is ALL of it — rent, RBP,
    // pet rent, late fees, utility reimbursements, deposits. It used to be labelled "rent
    // collected", which was wrong on timing AND on scope, and invited exactly the comparison
    // that kept coming out wrong.
    var glRows = readTab_('Rent_Income_GL').filter(function (r) { return r.month; });
    var glByMonth = {};
    glRows.forEach(function (r) { glByMonth[monthNorm_(r.month)] = r; });
    var glLast = lastKey ? glByMonth[lastKey] : null;

    h.push('<div class="hero-card"><div class="hero-label">Rent income</div>' +
      '<div class="hero-value">' + (glLast ? money_(num_(glLast.rent_income)) : '—') + '</div>' +
      '<div class="hero-foot muted">' +
      (glLast ? esc_(monthLabel_(lastKey)) + ' · matches the income statement'
              : 'run <code>buildRentIncomeGL()</code>') + '</div></div>');
    h.push('<div class="hero-card"><div class="hero-label">Resident receipts</div>' +
      '<div class="hero-value">' + (collected === null ? '—' : money_(collected)) + '</div>' +
      '<div class="hero-foot muted">' +
      (last ? esc_(monthLabel_(lastKey)) + ' · all cash in, on the day it arrived'
            : 'no month recorded') + '</div></div>');
    if (suspectMonths.length) {
      h.push('<div class="coverage"><strong>' + suspectMonths.length + ' month(s) look like ' +
        'missing receipts rather than low collections.</strong> ' +
        suspectMonths.slice(0, 3).map(function (x) {
          return esc_(monthLabel_(x.key)) + ' shows ' + money_(num_(x.row.rent_collected)) +
                 ' from ' + esc_(x.row.households_paying) + ' households';
        }).join(' \u00b7 ') +
        '. Excluded from the headline figure. <code>diagnoseRentCollection()</code> compares ' +
        'each month against the same day of previous months, which is what settles it.</div>');
    }
    // The running month, judged against its own history rather than against whole months.
    if (running && running.pace_vs_same_day_median_pct !== null &&
        running.pace_vs_same_day_median_pct !== undefined && running.pace_vs_same_day_median_pct !== '') {
      var pace = num_(running.pace_vs_same_day_median_pct);
      h.push('<p class="note">' + esc_(monthLabel_(monthNorm_(running.month))) +
        ' is still running and has collected ' + money_(num_(running.rent_collected)) +
        ' so far, from ' + esc_(running.households_paying) + ' households. That is <strong>' +
        esc_(String(pace)) + '%</strong> of where a typical month stands on this date' +
        (pace >= 80 ? ' — normal.' : pace >= 60 ? ' — a little behind.'
                                               : ' — worth checking against the source.') +
        ' Part-month totals carry no percentage against charges, because that comparison is ' +
        'meaningless rather than merely unflattering.</p>');
    }
    if (suspect) {
      h.push('<div class="coverage">' + esc_(monthLabel_(lastKey)) + ' works out to ' +
        money_(Math.round(perHH)) + ' per paying household, which is below a single ' +
        'month\u2019s rent — read this as a data question, not a collections result. Run ' +
        '<code>diagnoseRentCollection()</code>.</div>');
    }
    h.push('</div>');
  }

  // The explanation belongs beside the two numbers, not in a footnote. Somebody comparing
  // this against an income statement needs to know they are not the same measure BEFORE
  // they conclude the dashboard is wrong.
  h.push('<div class="coverage"><strong>These two are different measures and will not ' +
    'agree.</strong> Rent income is recognised in the month the rent covers — on this ' +
    'portfolio about 70% of it posts on the 1st, transferred out of prepayment from money ' +
    'received the previous month. Resident receipts are cash on the day it arrived, and ' +
    'include the Resident Benefits Package, pet rent, late fees, utility reimbursements and ' +
    'deposits as well as rent. Compare rent income against your income statement; compare ' +
    'receipts against the bank.</div>');

  if (!series.length) {
    h.push('<div class="coverage">No receipt history yet — run ' +
      '<code>buildRentCollection()</code>, or wait for tonight’s portfolio job.</div>');
    return h.join('');
  }

  var withCharge = series.filter(function (r) { return num_(r.rent_charged) !== null; });
  // A month where few households appear is a data gap wearing the costume of a bad
  // month, and the tile should not let anyone mistake one for the other.
  var thin = series.filter(function (r) {
    var c = num_(r.household_coverage_pct);
    return c !== null && c < 70 && num_(r.rent_collected);
  });
  if (thin.length) {
    h.push('<p class="warnrow"><strong>' + thin.length + ' month' +
      (thin.length === 1 ? '' : 's') + ' show receipts from fewer than 70% of billed ' +
      'households</strong> — ' + thin.slice(0, 4).map(function (r) {
        return esc_(monthLabel_(r.month)) + ' at ' + num_(r.household_coverage_pct) + '%';
      }).join(', ') + '. A gap that size is missing receipts, not slow payers. Do not read ' +
      'those collection figures as a collections problem until ' +
      '<code>diagnoseRentCollection()</code> says where the rows went.</p>');
  }

  h.push('<div class="coverage"><strong>Collected is a cash figure.</strong> ' +
    'AppFolio records what was received, not what each payment settled, so this is every ' +
    'resident receipt — rent, utilities, deposits, fees. A month that clears arrears can ' +
    'read above 100%; a month with a prepayment can read below. It is not a rent-only ' +
    'collection rate.' +
    (withCharge.length < series.length
      ? ' ' + (series.length - withCharge.length) + ' of ' + series.length + ' months have no ' +
        'charged figure to compare against — <code>Portfolio_Summary_History</code> only ' +
        'has a row for months the pipeline ran in.'
      : '') + '</div>');

  if (running) {
    h.push('<p class="note"><strong>' + esc_(monthLabel_(running.month)) + ' is still ' +
      'running</strong> and shows ' + money_(running.rent_collected) + ' so far, from ' +
      esc_(running.households_paying) + ' households. It is in the table for continuity ' +
      'but is deliberately not the headline figure and carries no percentage \u2014 part ' +
      'of a month against a whole month of charges reads as a collapse when nothing is ' +
      'wrong.</p>');
  }

  return h.join('');
}

/**
 * Earned versus received.
 *
 * SPLIT OUT OF rentCollectionPanel_ ON 2026-09-02. The chart had been living inside the
 * tile group, so dropping the tiles would have taken it with them — which is not what was
 * asked for and is exactly the sort of thing you find out after deploying. Two panels,
 * two functions.
 *
 * This is the one that survives, because it is the honest comparison: what the ledger says
 * was earned against what actually arrived. The tiles answered the same question with a
 * different set of caveats attached, and two panels disagreeing politely about the same
 * money is worse than one panel.
 */
function earnedVsReceivedPanel_() {
  var series = readTab_('Rent_Collection');
  if (!series.length) return '';
  var h = [];
  var withIncome = series.filter(function (r) { return num_(r.rent_income) !== null; }).length;
  var withCharged = series.filter(function (r) { return num_(r.rent_charged) !== null; }).length;

  h.push('<section class="card"><div class="card-head"><h2>Earned versus received</h2>' +
    '</div>');
  h.push('<p class="note">Twelve months. <strong>Rent income</strong> is the general ledger ' +
    '— what was earned in the month the rent covers, the figure your income statement ' +
    'reports. <strong>Received</strong> is cash on the day it arrived, and includes the ' +
    'Resident Benefits Package, pet rent, late fees, utility reimbursements and deposits. ' +
    'They cross over: prepayment moves cash a month earlier than the income it funds, so ' +
    'expect them to trade places rather than track.</p>');

  // The chart plots what we actually HAVE for twelve months. Rent charged is drawn only
  // when there is enough of it to be a line rather than a scatter of dots — see below.
  var lines = [];
  if (withIncome) {
    lines.push({ key: 'rent_income', label: 'Rent income (ledger)', color: '#066D88', format: '$' });
  }
  lines.push({ key: 'rent_collected', label: 'Resident receipts', color: '#2EA3F2', format: '$' });
  if (withCharged >= Math.max(3, Math.round(series.length * 0.5))) {
    lines.push({ key: 'rent_charged', label: 'Rent charged (snapshot)', color: '#8FA8B4', format: '$' });
  }
  h.push(lineChart_(series, lines, { height: 260 }));

  if (!withIncome) {
    // The FACT that a line is missing changes how the chart reads, so everyone gets it.
    // The two functions that fix it are for whoever maintains this.
    h.push('<div class="coverage"><strong>The ledger line is missing.</strong> ' +
      'There is nothing to compare receipts against across twelve months, so the only ' +
      'comparison available is rent charged, which exists for ' + withCharged +
      ' month(s).</div>');
    h.push(adminNote_('<code>Rent_Income_GL</code> is empty. Run ' +
      '<code>buildRentIncomeGL()</code> then <code>rebuildPortfolio()</code>.',
      { quiet: true }));
  }
  if (withCharged < series.length) {
    h.push('<div class="coverage"><strong>Rent charged is not a twelve-month figure, and ' +
      'cannot be.</strong> It is read from a nightly snapshot, so it exists only for the ' +
      withCharged + ' month(s) the dashboard has been running — there is no way to recover ' +
      'what was billed in a month nobody recorded, and AppFolio’s rent roll is as-of-today ' +
      'only. That is why the comparison line is <em>rent income from the ledger</em>: the ' +
      'ledger remembers. Charged is shown ' +
      (lines.length > 2 ? 'as the third line, for the months it exists.'
                        : 'in the table below rather than on the chart, where a line with ' +
                          'ten gaps in it reads as a fault rather than as a young dataset.') +
      '</div>');
  }

  h.push('<table class="mini2"><thead><tr><th>Month</th>' +
    '<th class="num">Market · active</th><th class="num">Market · occupied</th>' +
    '<th class="num">Rent income</th><th class="num">Charged</th>' +
    '<th class="num">Received</th>' +
    '<th class="num">Received vs income</th><th class="num">Households paying</th>' +
    '</tr></thead><tbody>');
  series.slice().reverse().forEach(function (r) {
    // Against the LEDGER, not against the snapshot. Receipts and income cross over month to
    // month because prepayment lands the cash early, so the bands are wide on purpose —
    // 85-115% is normal, and anything outside it is worth a look rather than an alarm.
    var pct = num_(r.collected_vs_income_pct);
    var tone = pct === null ? 'none'
             : (pct >= 85 && pct <= 115) ? 'good'
             : (pct >= 70 && pct <= 130) ? 'warn' : 'bad';
    h.push('<tr' + (r.is_partial === 'YES' ? ' class="off"' : '') + '>' +
      '<td class="strong">' + esc_(monthLabel_(r.month)) +
      (r.is_partial === 'YES' ? ' <span class="tag none">part month</span>' : '') + '</td>' +
      '<td class="num muted">' + (num_(r.market_rent_active) === null ? '—' : money_(r.market_rent_active)) + '</td>' +
      '<td class="num muted">' + (num_(r.market_rent_occupied) === null ? '—' : money_(r.market_rent_occupied)) + '</td>' +
      '<td class="num">' + (num_(r.rent_income) === null
        ? '<span class="muted">—</span>' : money_(r.rent_income)) + '</td>' +
      '<td class="num muted">' + (num_(r.rent_charged) === null
        ? '<span class="muted">not snapshotted</span>' : money_(r.rent_charged)) + '</td>' +
      '<td class="num strong">' + money_(r.rent_collected) + '</td>' +
      '<td class="num">' + (pct === null
        ? '<span class="muted">' + (r.is_partial === 'YES' ? 'month not over' : 'no ledger figure') + '</span>'
        : '<span class="tag ' + tone + '">' + pct + '%</span>') + '</td>' +
      '<td class="num muted">' + esc_(r.households_paying) +
      (num_(r.household_coverage_pct) !== null
        ? ' <span class="tag ' + (num_(r.household_coverage_pct) < 70 ? 'bad' : 'none') + '">' +
          num_(r.household_coverage_pct) + '%</span>' : '') + '</td></tr>');
  });
  h.push('</tbody></table></section>');
  return h.join('');
  return h.join('');
}

function lsPerformancePanel_() {
  if (!lsEnabled_()) return '';
  var types = readTab_('LS_Compliance');
  var deals = readTab_('LS_Deals');
  if (!types.length && !deals.length) return '';

  var open = types.reduce(function (a, r) { return a + (num_(r.open) || 0); }, 0);
  var over = types.reduce(function (a, r) { return a + (num_(r.overdue) || 0); }, 0);
  var pct  = open ? Math.round(over / open * 100) : null;

  var active = deals.filter(function (d) { return d.is_active === 'YES'; });
  var stale  = active.filter(function (d) { return d.is_stale === 'YES'; }).length;
  var won  = deals.filter(function (d) { return d.stage_status === 'won'; }).length;
  var lost = deals.filter(function (d) { return d.stage_status === 'lost'; }).length;
  var winPct = (won + lost) ? Math.round(won / (won + lost) * 100) : null;

  var h = ['<h3 class="scgroup tilegroup">Process execution</h3>'];
  h.push('<p class="note grouphint">Is the work we committed to actually getting done, ' +
    'and on time?</p>');
  h.push('<div class="hero">');
  h.push('<div class="hero-card ' + (pct === null ? '' : (pct > 15 ? 'bad' : (pct > 5 ? 'ok' : 'good'))) +
    '"><div class="hero-label">Processes overdue</div>' +
    '<div class="hero-value">' + (pct === null ? '—' : pct) + '<span class="hero-unit">%</span></div>' +
    '<div class="hero-foot muted">' + over + ' of ' + open + ' open' +
    (open < CFG.MIN_N_TO_PUBLISH ? ' · below n=' + CFG.MIN_N_TO_PUBLISH : '') + '</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Open processes</div>' +
    '<div class="hero-value">' + open + '</div>' +
    '<div class="hero-foot muted">across ' + types.length + ' type' +
    (types.length === 1 ? '' : 's') + '</div></div>');
  h.push('<div class="hero-card ' + (winPct === null ? '' : (winPct >= 50 ? 'good' : 'ok')) + '">' +
    '<div class="hero-label">Owner win rate</div>' +
    '<div class="hero-value">' + (winPct === null ? '—' : winPct) + '<span class="hero-unit">%</span></div>' +
    '<div class="hero-foot muted">' + won + ' won of ' + (won + lost) + ' decided</div></div>');
  h.push('<div class="hero-card ' + (stale ? 'ok' : 'good') + '">' +
    '<div class="hero-label">Pipeline gone quiet</div>' +
    '<div class="hero-value">' + stale + '</div>' +
    '<div class="hero-foot muted">of ' + active.length + ' active deals</div></div>');
  h.push('</div>');
  h.push('<div class="coverage">Source: LeadSimple. These four have <strong>no industry ' +
    'benchmark</strong> — they are internal execution measures, so there is no target ' +
    'tick to read them against. Detail on the Process Adherence and Owners Pipeline ' +
    'tabs.</div>');
  return h.join('');
}

function renderKPI_(notices) {
  var rows = readTab_('Metrics').filter(function (r) { return r.period === 'ALL'; });
  var byCat = groupBy_(rows, function (r) { return r.kpi_category || 'Other'; });
  var order = ['Collections', 'Vacancy & Leasing', 'Portfolio', 'Maintenance', 'Lease Renewal',
               'Move-Out', 'Applications', 'Turnover', 'Make Ready', 'Move-In',
               'Onboarding', 'Communication', 'Workflow Compliance'];
  var cats = order.filter(function (c) { return byCat[c]; })
    .concat(Object.keys(byCat).filter(function (c) { return order.indexOf(c) === -1; }));

  var live = rows.filter(function (r) { return r.value !== null && r.value !== ''; });
  var deferred = rows.filter(function (r) { return r.status === 'deferred'; });
  var blocked = rows.filter(function (r) { return r.status === 'blocked'; });

  var h = ['<div id="view-performance" class="view">'];
  (notices || []).filter(function (n) { return n.view === 'performance'; }).forEach(function (n) {
    h.push(viewNotice_(n.id, n.html));
  });

  // Tiles grouped by the question they answer. Twelve numbers in one undifferentiated
  // wall makes the reader do the sorting; three labelled groups of four does not.
  var byId = indexBy_(rows, 'metric_id');
  TILE_GROUPS.forEach(function (g) {
    var cards = g.metrics.map(function (id) { return byId[id]; })
                        .filter(function (m) { return !!m; });
    var absent = g.metrics.filter(function (id) { return !byId[id]; });
    if (!cards.length && !absent.length) return;
    h.push('<h3 class="scgroup tilegroup">' + esc_(g.label) + '</h3>');
    h.push('<p class="note grouphint">' + esc_(g.note) + '</p>');
    if (cards.length) {
      h.push('<div class="hero">');
      cards.forEach(function (m) { h.push(heroCard_(m)); });
      h.push('</div>');
    }
    // A metric named here but absent from the Metrics tab is a wiring gap, not a data
    // gap, and it used to vanish without trace.
    if (absent.length) {
      h.push(adminNote_(absent.length + ' metric' +
        (absent.length === 1 ? ' in this group is' : 's in this group are') +
        ' not in the <code>Metrics</code> tab at all: ' +
        absent.map(function (id) { return '<code>' + esc_(id) + '</code>'; }).join(', ') +
        '. Either the id does not exist in the registry, or <code>computeMetrics()</code> ' +
        'has not run since it was added. Run <code>diagnosePerformanceView()</code>.'));
    }
  });

  // The "Rent income and receipts" tile group came off on 2026-09-02. It answered the
  // same question as Earned versus received below it, with a different set of caveats
  // attached, and two panels disagreeing politely about the same money is worse than one.
  // rentCollectionPanel_ is left in the file rather than deleted — the Rent_Collection tab
  // still feeds the Delinquency view — but nothing calls it here.
  h.push(earnedVsReceivedPanel_());
  h.push(lsPerformancePanel_());
