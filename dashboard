/**
 * Properties with no PM-prefixed group in AppFolio.
 *
 * These are the rows that land on "Unassigned" everywhere else on the dashboard.
 * They are not a data defect here — they are a data defect in AppFolio, and the only
 * way to clear them is to open each property and set a PM group. So this is a
 * worksheet: address, owner, units, and the property ID you need to find it.
 *
 * Properties whose management has ended are excluded. They have no manager because
 * nobody manages them, which is correct.
 */
function unassignedPanel_() {
  var pm = pmLookup_();
  var props = readTab_('Properties_Units');
  if (!props.length) return '';

  var units = readTab_('Unit_Directory');
  var unitCount = {};
  units.forEach(function (u) {
    if (!u.property_id) return;
    unitCount[u.property_id] = (unitCount[u.property_id] || 0) + 1;
  });

  var seen = {};
  var closingRows = [];
  var rows = props.filter(function (p) {
    if (!p.property_id || seen[p.property_id]) return false;
    seen[p.property_id] = true;
    if (pm[p.property_id]) return false;              // already has a PM group
    if (isExcluded_(p)) return false;
    if (!isActiveProperty_(p)) return false;          // AppFolio says management ended

    // AND the naming convention, for the same reason door history needs it:
    // management_end_date is not maintained, so isActiveProperty_ alone still let
    // handed-back properties through. Asking someone to assign a manager to a
    // property WeLease no longer manages is worse than showing nothing — it is
    // busywork that looks like a real task.
    if (isEndingMgmt_(p)) { closingRows.push(p); return false; }
    return true;
  }).map(function (p) {
    var groups = [];
    readTab_('PM_Groups').forEach(function (g) {
      if (String(g.property_id) === String(p.property_id) && g.property_group_name) {
        groups.push(String(g.property_group_name));
      }
    });
    return {
      address: addr_(p) || String(p.property_name || p.property || ''),
      owners: p.owners || '',
      units: unitCount[p.property_id] || num_(p.units) || 0,
      id: String(p.property_id),
      // A property can sit in reporting groups like "Solar" and still have no manager.
      // Showing them stops this reading as "no groups at all", which sends people looking
      // in the wrong place.
      other: groups.length ? groups.join(' · ') : 'none'
    };
  }).sort(function (a, b) { return (b.units - a.units) || (a.address < b.address ? -1 : 1); });

  var h = ['<section class="card" id="sec-unassigned">'];
  h.push('<div class="card-head"><h2>Properties with no manager assigned' +
    '<span class="count">' + rows.length + '</span></h2></div>');

  // Offboarding properties still need a manager until handover — residents, rent and
  // maintenance do not pause. They are held in their own block so clearing the main
  // list is not blocked by properties on their way out.
  function closingBlock_() {
    if (!closingRows.length) return '';
    var t = ymd_(today_());
    var out = ['<h3 class="scgroup">Closing, and still without a manager</h3>'];
    out.push('<p class="note">Flagged for offboarding by the naming convention but with ' +
      'no <code>management_end_date</code> yet \u2014 so still under management. They need ' +
      'an owner until handover completes.</p>');
    out.push('<table><thead><tr><th>Address</th><th>Owner</th><th class="num">Units</th>' +
      '<th>Closes</th><th>Property ID</th></tr></thead><tbody>');
    closingRows.map(function (p) {
      var e = endingMgmt_(p);
      var d = (e && e.date) ? daysBetween_(t, e.date) : null;
      return { p: p, date: (e && e.date) || '', days: d,
               overdue: !!(e && e.date && e.date < t) };
    }).sort(function (a, b) {
      if (a.overdue !== b.overdue) return a.overdue ? -1 : 1;
      if (a.days === null) return 1;
      if (b.days === null) return -1;
      return a.days - b.days;
    }).forEach(function (x) {
      var when = x.date
        ? esc_(x.date) + ' \u00b7 ' + dayOverdue_(x.days)
        : 'no date in the property name';
      out.push('<tr><td class="strong">' + esc_(addr_(x.p) ||
          String(x.p.property_name || x.p.property || '')) + '</td>' +
        '<td class="muted">' + esc_(x.p.owners || '') + '</td>' +
        '<td class="num">' + (unitCount[x.p.property_id] || num_(x.p.units) || 0) + '</td>' +
        '<td><span class="tag cell ' + (x.overdue ? 'bad' : (x.date ? 'warn' : 'none')) + '">' +
          when + '</span></td>' +
        '<td class="muted idcell">' + esc_(String(x.p.property_id)) + '</td></tr>');
    });
    out.push('</tbody></table>');
    return out.join('');
  }

  var totalUnits = rows.reduce(function (a, r) { return a + r.units; }, 0);
  h.push('<p class="note">' + rows.length + ' active propert' +
    (rows.length === 1 ? 'y' : 'ies') + ' covering ' + totalUnits + ' unit' +
    (totalUnits === 1 ? '' : 's') + ' have no group beginning "' + PM_GROUP_PREFIX +
    '" in AppFolio. Every one of their rows shows as <strong>Unassigned</strong> on the ' +
    'operational views, so filtering by a manager hides them. Fix in AppFolio: open the ' +
    'property, add it to the right PM group. The change appears here after the next ' +
    'nightly run.</p>');

  h.push('<table><thead><tr><th>Address</th><th>Owner</th>' +
    '<th class="num">Units</th><th>Other groups</th><th>Property ID</th>' +
    '</tr></thead><tbody>');
  rows.forEach(function (r) {
    h.push('<tr><td class="strong">' + esc_(r.address) + '</td>' +
      '<td class="muted">' + esc_(r.owners) + '</td>' +
      '<td class="num">' + r.units + '</td>' +
      '<td class="muted">' + esc_(r.other) + '</td>' +
      '<td class="muted idcell">' + esc_(r.id) + '</td></tr>');
  });
  h.push('</tbody></table>');
  h.push('<p class="note">Property ID is included because AppFolio\u2019s search is faster ' +
    'on the ID than on a partial address. It is shown here only \u2014 never on a resident ' +
    'or owner-facing list.</p>');
  h.push(closingBlock_());
  h.push('</section>');
  return h.join('');
}

function leasingFunnel_() {
  var apps = inScopeIncludingInactive_(readTab_('Applications'));

  function appPanel_(months) {
    var cutoff = ymd_(addDays_(today_(), -Math.round(months * 30.4)));
    var set = (months >= 999) ? apps : apps.filter(function (a) {
      var rd = ymd_(a.received);
      return rd && rd >= cutoff;
    });
    if (!set.length) return '<p class="muted small">No applications in this period.</p>';
    var byStatus = groupBy_(set, function (r) { return r.application_status || 'Unknown'; });
    var statuses = Object.keys(byStatus).sort(function (a, b) {
      return byStatus[b].length - byStatus[a].length;
    });
    var maxA = byStatus[statuses[0]].length;
    var out = ['<p class="note">' + set.length + ' applications.</p>'];
    statuses.forEach(function (st) {
      var n = byStatus[st].length;
      var tone = /approv|convert/i.test(st) ? 'good' : (/den|cancel/i.test(st) ? 'bad' : 'neutral');
      out.push('<div class="frow"><span class="flabel">' + esc_(st) + '</span>' +
        '<span class="ftrack"><span class="ffill ' + tone + '" style="width:' +
        Math.max(2, n / maxA * 100).toFixed(1) + '%"></span></span>' +
        '<span class="fval">' + n + '<span class="muted"> \u00b7 ' +
        Math.round(n / set.length * 100) + '%</span></span></div>');
    });
    return out.join('');
  }

  var vac = readTab_('Unit_Vacancy');
  var posted = vac.filter(function (r) {
    return String(r.posted_to_website || '').toLowerCase() === 'yes';
  }).length;
  var unposted = vac.length - posted;
  var over60 = vac.filter(function (r) { return (num_(r.days_vacant) || 0) > 60; }).length;

  var h = ['<div class="split">'];

  h.push('<section class="card"><div class="card-head"><h2>Applications by outcome</h2>' +
    rangeSelect_('appRange') + '</div>');
  // Same range vocabulary as the charts, and keyed the same way, so setRange's
  // variant map works here without a special case.
  h.push(rangedBlock_('appRange', function (take) {
    return { key: take, html: appPanel_(take) };
  }));
  h.push('</section>');

  h.push('<section class="card"><h2>Vacancy breakdown</h2>' +
    '<p class="note">' + vac.length + ' vacant units right now.</p>');
  [['Advertised on the website', posted, 'good'],
   ['Not yet advertised', unposted, unposted > 0 ? 'bad' : 'good'],
   ['Vacant over 60 days', over60, over60 > 0 ? 'bad' : 'good']].forEach(function (x) {
    h.push('<div class="frow"><span class="flabel">' + x[0] + '</span>' +
      '<span class="ftrack"><span class="ffill ' + x[2] + '" style="width:' +
      Math.max(2, (vac.length ? x[1] / vac.length * 100 : 0)).toFixed(1) + '%"></span></span>' +
      '<span class="fval">' + x[1] + '</span></div>');
  });
  h.push('<p class="note">Units not advertised are the most preventable vacancy loss on this page.</p>');
  h.push('</section>');

  h.push('</div>');
  return h.join('');
}

/**
 * Metric units, long and short.
 *
 * "34d" is the same abbreviation the countdown pills already gave up, and it reads
 * no better on a benchmark than it did on a lease expiry.
 */
function unitOf_(benchmarkUnit) {
  // Every unit the registry actually uses: days (26), percent (8), hours (2), units (1).
  // An unrecognised unit rendered as a bare number with no label at all, which is how
  // "2.5" quietly stopped meaning hours.
  var u = String(benchmarkUnit || '').toLowerCase();
  if (u === 'percent') return { long: '%', joiner: '' };
  if (u === 'days')    return { long: 'days', joiner: ' ', singular: 'day' };
  if (u === 'hours')   return { long: 'hours', joiner: ' ', singular: 'hour' };
  if (u === 'units')   return { long: 'units', joiner: ' ', singular: 'unit' };
  return { long: u ? u : '', joiner: u ? ' ' : '' };
}

/** A value written the way a person would say it: "34 days", "1 day", "94%". */
function unitValue_(v, u) {
  if (v === null || v === undefined || v === '') return '\u2014';
  if (u.singular) {
    var n = num_(v);
    return esc_(v) + ' ' + (n !== null && Math.abs(n) === 1 ? u.singular : u.long);
  }
  return esc_(v) + u.long;
}

/**
 * Why is this tile blank?
 *
 * Thirteen of sixteen tiles rendered an identical dash plus "no benchmark", which told
 * nobody anything. Three completely different situations produced the same pixels: the
 * source system is not connected, the registry never defined a benchmark, and the
 * calculation ran but found nothing to measure. Each needs a different action from a
 * different person, so each now says which it is.
 */
function blankReason_(m) {
  var st = String(m.status || '');
  if (st === 'deferred') {
    return { short: 'source not connected',
             long: 'The registry marks this metric deferred, waiting on ' +
                   String(m.system || 'another system').split('+')[0] + '. Now that ' +
                   'LeadSimple is live, a metric still marked deferred needs its status ' +
                   'set to active in welease-metric-registry-v2.json.' };
  }
  if (st === 'blocked') {
    return { short: 'no source available',
             long: 'No endpoint in any connected system carries what this metric needs.' };
  }
  if (st === 'not_implemented') {
    return { short: 'no calculation written',
             long: 'Defined in the registry, but there is no entry for it in CALC in Metrics.gs.' };
  }
  if (st === 'not_run') {
    return { short: 'ran out of time',
             long: 'computeMetrics hit its execution budget before reaching this one. Re-run it.' };
  }
  if (st === 'error') {
    return { short: 'calculation failed', long: 'The calculation threw. See _errors.' };
  }
  return { short: 'nothing to measure',
           long: 'The calculation ran and returned no value \u2014 usually no rows matched ' +
                 'its window or its join. Not a failure on its own, but worth checking if ' +
                 'you expected a number.' };
}

function heroCard_(m) {
  var hasValue = !(m.value === null || m.value === '');
  var v = hasValue ? m.value : '—';
  var u = unitOf_(m.benchmark_unit);
  var cls = benchClass_(m);
  var noBench = (m.benchmark_median === null || m.benchmark_median === '');
  var reason = hasValue ? null : blankReason_(m);

  var foot;
  if (reason) {
    foot = '<span class="blankwhy" title="' + esc_(reason.long) + '">' +
           esc_(reason.short) + '</span>';
  } else if (noBench) {
    foot = '<span class="muted">no benchmark set</span>';
  } else {
    foot = 'target ' + unitValue_(m.benchmark_median, u) +
           ' <span class="dot ' + cls + '"></span>' + esc_(prettyBench_(m.vs_benchmark));
  }

  return '<div class="hero-card ' + (reason ? 'blank' : cls) + '">' +
    '<div class="hero-label">' + esc_(m.name) + '</div>' +
    '<div class="hero-value">' + esc_(v) +
      (hasValue ? '<span class="hero-unit">' + u.joiner + u.long + '</span>' : '') + '</div>' +
    '<div class="hero-foot">' + foot + '</div></div>';
}

/**
 * Bullet row — value bar with a benchmark marker. Reads instantly and, unlike a gauge,
 * does not need a legend. Bar length is scaled against the benchmark, so "past the
 * marker" always means the same thing regardless of unit.
 */
function metricRow_(r) {
  var off = (r.status === 'deferred' || r.status === 'blocked' ||
             r.status === 'not_implemented' || r.status === 'not_run');
  var v = num_(r.value);
  var med = num_(r.benchmark_median), top = num_(r.benchmark_top25);
  var u = unitOf_(r.benchmark_unit);
  var inv = r.direction === 'higher_is_better';
  var cls = benchClass_(r);

  var bar = '';
  if (!off && v !== null && med !== null) {
    var scale = Math.max(v, med, top || 0) * 1.25 || 1;
    var pct = Math.min(100, Math.max(2, v / scale * 100));
    var mMed = Math.min(100, med / scale * 100);
    var mTop = top === null ? null : Math.min(100, top / scale * 100);
    bar = '<div class="bullet"><div class="bfill ' + cls + '" style="width:' + pct.toFixed(1) + '%"></div>' +
      (mTop !== null ? '<i class="mark top" style="left:' + mTop.toFixed(1) + '%"></i>' : '') +
      '<i class="mark med" style="left:' + mMed.toFixed(1) + '%"></i></div>';
  } else if (!off && v !== null) {
    bar = '<div class="bullet"><div class="bfill neutral" style="width:100%"></div></div>';
  }

  var right;
  if (off) {
    right = '<span class="muted small">' + esc_(r.notes || r.status) + '</span>';
  } else if (r.publishable && String(r.publishable).indexOf('NO') === 0) {
    right = '<span class="tag warn">insufficient data (n=' + esc_(r.n) + ')</span>';
  } else {
    right = '<span class="tag ' + cls + '">' + esc_(prettyBench_(r.vs_benchmark)) + '</span>';
  }

  // The row shows the metric's NAME. Everything else — targets, sample size, how the
  // number is built — moves behind the info icon. "Days Without Revenue target 34d ·
  // top 21d · n=47" made every row read like a formula, and the reader had to decode
  // three numbers before finding the one that mattered.
  return '<div class="mrow' + (off ? ' off' : '') + '">' +
    '<div class="mname">' + esc_(r.name) +
      (inv ? ' <span class="inv" title="Higher is better">&#8593;</span>' : '') +
      metricInfo_(r, u, med, top) + '</div>' +
    '<div class="mval">' + (v === null ? '—'
      : esc_(r.value) + '<span class="munit">' + u.joiner + u.long + '</span>') + '</div>' +
    '<div class="mbar">' + bar + '</div>' +
    '<div class="mstat">' + right + '</div></div>';
}

/**
 * The info icon and its panel.
 *
 * Click, not hover: hover tooltips are unreachable on a tablet, and the team opens
 * this board on one. Rendered inline and toggled with a class, so it costs no round
 * trip and survives the page being served from cache.
 */
function metricInfo_(r, u, med, top) {
  var lines = [];
  if (num_(r.value) !== null) {
    lines.push(['Our result', unitValue_(r.value, u), '']);
  }
  // A WeLease-set target and an industry survey median are different claims, and
  // calling both "industry average" made one of them a lie.
  var ours = /welease/i.test(String(r.benchmark_source || ''));
  if (med !== null) {
    lines.push([ours ? 'Target (WeLease standard)' : 'Target (industry average)',
                unitValue_(med, u),
                ours ? 'Set by WeLease, not a survey figure. This is the number we hold ourselves to.'
                     : 'The median of the firms surveyed. Landing here is ordinary, not good.']);
  }
  if (top !== null) {
    lines.push([ours ? 'Top performance (WeLease standard)' : 'Top quartile',
                unitValue_(top, u),
                ours ? 'Our own definition of a good result.'
                     : 'The strongest quarter of firms surveyed. This is the number to aim at.']);
  }
  if (r.direction) {
    lines.push(['Direction',
      r.direction === 'higher_is_better' ? 'Higher is better' : 'Lower is better',
      r.direction === 'higher_is_better'
        ? 'A longer bar is a better result for this one.'
        : 'A shorter bar is a better result.']);
  }
  if (r.n !== null && r.n !== undefined && r.n !== '') {
    lines.push(['Sample size', 'n = ' + esc_(r.n),
      (num_(r.n) !== null && num_(r.n) < 30)
        ? 'Below 30 the figure is not published as a rate — too few cases to trust.'
        : 'The number of cases behind this figure.']);
  }
  if (r.period) lines.push(['Period', esc_(r.period), 'The window this figure covers.']);
  if (r.notes) lines.push(['Note', esc_(r.notes), '']);
  if (!lines.length) return '';

  var body = lines.map(function (l) {
    return '<div class="miline"><span class="mikey">' + l[0] + '</span>' +
      '<span class="mival">' + l[1] + '</span>' +
      (l[2] ? '<span class="mihint">' + esc_(l[2]) + '</span>' : '') + '</div>';
  }).join('');

  return '<span class="minfo">' +
    '<button type="button" class="ibtn" onclick="toggleInfo(this)" aria-expanded="false" ' +
      'aria-label="What does ' + esc_(r.name) + ' mean?" title="What this measures">i</button>' +
    '<span class="ipanel" role="note">' +
      '<strong>' + esc_(r.name) + '</strong>' + body +
      '<span class="mifoot">' + (ours
      ? 'A WeLease standard, not a survey figure and not a legal requirement.'
      : 'Benchmarks are industry survey targets, not legal or contractual requirements.') +
      '</span>' +
    '</span></span>';
}

