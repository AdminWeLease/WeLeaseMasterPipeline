    h.push('<section class="card"><div class="card-head"><h2>Doors under management</h2>' +
      rangeSelect_('doorRange') + '</div>');
    h.push('<p class="note">New doors from unit creation dates, lost doors from property ' +
      'management end dates. A resident move-out is not a lost door. Churn is plotted on the ' +
      'right axis.</p>');
    // Rolling twelve months, not the current one. Properties leave management a
    // handful of times a year, so on most days "lost this month" was a zero that
    // read as a broken tile rather than a quiet month.
    var yr = doors.slice(-12);
    var opening = num_(yr[0].doors_start);
    var sum = function (k) {
      return yr.reduce(function (a, r) { return a + (num_(r[k]) || 0); }, 0);
    };
    var newY = sum('new_doors'), lostY = sum('lost_doors'), netY = newY - lostY;
    var rate = function (n) { return opening ? (Math.round(n / opening * 1000) / 10) : 0; };
    var span = monthLabel_(yr[0].month, true) + ' – ' + monthLabel_(last.month, true);

    h.push('<div class="hero" style="margin-bottom:14px">' +
      '<div class="hero-card"><div class="hero-label">Total doors</div>' +
      '<div class="hero-value">' + esc_(last.total_doors) + '</div>' +
      '<div class="hero-foot muted">as of ' + esc_(monthLabel_(last.month)) + '</div></div>' +
      '<div class="hero-card"><div class="hero-label">New · 12 months</div>' +
      '<div class="hero-value">' + newY + '</div>' +
      '<div class="hero-foot muted">' + rate(newY) + '% growth · ' + esc_(span) + '</div></div>' +
      '<div class="hero-card"><div class="hero-label">Lost · 12 months</div>' +
      '<div class="hero-value">' + lostY + '</div>' +
      '<div class="hero-foot muted">' + rate(lostY) + '% churn · ' + esc_(span) + '</div></div>' +
      '<div class="hero-card ' + (netY >= 0 ? 'good' : 'bad') + '">' +
      '<div class="hero-label">Net · 12 months</div><div class="hero-value">' +
      (netY >= 0 ? '+' : '') + netY + '</div>' +
      '<div class="hero-foot muted">' + (netY >= 0 ? '+' : '') + rate(netY) + '% on ' +
      opening + ' doors</div></div></div>');

    // Scheduled departures are a separate number from churn on purpose: these doors
    // are still under management, still earning, still being worked.
    var pipe = (typeof offboardingPipeline_ === 'function') ? offboardingPipeline_() : null;
    if (pipe && pipe.properties) {
      h.push('<div class="hero" style="margin-bottom:14px">' +
        '<div class="hero-card ' + (pipe.overdue_properties ? 'bad' : '') + '">' +
        '<div class="hero-label">Scheduled to leave</div>' +
        '<div class="hero-value">' + pipe.doors + '</div>' +
        '<div class="hero-foot muted">' + pipe.doors + ' door' + (pipe.doors === 1 ? '' : 's') +
        ' across ' + pipe.properties + ' propert' + (pipe.properties === 1 ? 'y' : 'ies') +
        '</div></div>' +
        '<div class="hero-card ' + (pipe.overdue_properties ? 'bad' : 'good') + '">' +
        '<div class="hero-label">Past their handover date</div>' +
        '<div class="hero-value">' + pipe.overdue_doors + '</div>' +
        '<div class="hero-foot muted">' + pipe.overdue_properties + ' propert' +
        (pipe.overdue_properties === 1 ? 'y' : 'ies') + ' still managed and billed</div></div>' +
        '<div class="hero-card"><div class="hero-label">No closure date</div>' +
        '<div class="hero-value">' + pipe.undated + '</div>' +
        '<div class="hero-foot muted">flagged by name, date missing</div></div>' +
        '</div>');
      h.push('<p class="note"><strong>Scheduled is not the same as lost.</strong> These ' +
        'properties carry the <code>z</code> naming flag but no ' +
        '<code>management_end_date</code>, so they are still under management \u2014 ' +
        'residents in place, rent collected. They are deliberately kept out of churn ' +
        'above, which counts confirmed departures only. Detail on the ' +
        'Leasing view under Properties ending management.</p>');
    }

    // Churn can only count what management_end_date records. If that is empty across a
    // whole year, say which field is missing rather than drawing a flat line.
    if (!lostY) {
      h.push('<p class="warnrow">No doors recorded as lost in the last 12 months, so churn ' +
        'reads 0%. Departures are counted from <code>management_end_date</code> only \u2014 ' +
