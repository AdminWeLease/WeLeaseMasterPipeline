// ============================================================ LEADSIMPLE

/**
 * Process adherence — the compliance half of LeadSimple.
 *
 * These are worklists, with statuses and follow-up dates, because a process that is
 * 339 days overdue is not a reporting line: someone has to pick it up. The owners
 * pipeline is deliberately NOT a worklist — that selling happens in LeadSimple, and
 * a second place to set a status would just disagree with the first.
 *
 * PM group cannot be resolved from LeadSimple. Its processes carry a LeadSimple
 * property id, not an AppFolio one, and guessing a join on address would put rows
 * under the wrong manager. They sit under Unassigned until that join exists, which
 * is honest — the manager filter simply does not narrow these lists yet.
 *
 * CALIFORNIA: reporting only. Several process types cover evictions, notices and
 * deposits. Nothing here triggers any of them.
 */
var LS_URGENT = {
  OVERDUE_BAD_DAYS: 14,     // beyond this, overdue stops being a scheduling wobble
  STALE_BAD_DAYS: 60
};

function leadSimpleBlocks_(pm) {
  if (!lsEnabled_()) return [];
  var out = [];
  var t = ymd_(today_());
  var open = readTab_('LS_Processes').filter(function (r) { return r.is_open === 'YES'; });

  function addr_ls_(r) {
    var a = String(r.property_address || '').trim();
    if (!a) return String(r.process_name || '(no property)');
    return a + (r.unit ? ' #' + r.unit : '');
  }
  function who_(r) { return r.owner || 'nobody'; }

  // ---- 1. overdue processes --------------------------------------------------
  var overdue = open.filter(function (r) { return num_(r.days_overdue) > 0; })
    .map(function (r) {
      var d = num_(r.days_overdue);
      return { days: d, sort: -d, pm: UNASSIGNED, key: String(r.process_id), src: r,
        noLink: true, extLink: r.link || '',
        cells: [r.process_type || 'Unknown', addr_ls_(r), who_(r), r.stage || '',
                dayOverdue_(-d)],
        sev: d > LS_URGENT.OVERDUE_BAD_DAYS ? 'bad' : 'warn' };
    }).sort(function (a, b) { return a.sort - b.sort; });

  var worst = overdue.length ? Math.abs(overdue[0].days) : 0;
  out.push(block_('Processes past their due date', overdue,
    ['Process', 'Property', 'Owner', 'Stage', 'Overdue'],
    'Open LeadSimple processes with a due date in the past, oldest first' +
    (worst ? ' — the oldest is ' + daySpan_(worst) + ' past due' : '') + '. ' +
    'Anything beyond ' + daySpan_(LS_URGENT.OVERDUE_BAD_DAYS) + ' is red. ' +
    'CALIFORNIA: several process types cover notices, evictions and deposits — ' +
    'this reports them, it does not act on them.',
    'ls_overdue', 'processes', 'LS_Processes'));

  // ---- 2. stalled ------------------------------------------------------------
  // Untouched, not late. A process with no due date can never be overdue and would
  // otherwise never appear anywhere — which is how work disappears quietly.
  var stalled = open.filter(function (r) {
    return r.is_stalled === 'YES' && !(num_(r.days_overdue) > 0);
  }).map(function (r) {
    var d = num_(r.days_since_update) || 0;
    return { days: d, sort: -d, pm: UNASSIGNED, key: String(r.process_id), src: r,
      noLink: true, extLink: r.link || '',
      cells: [r.process_type || 'Unknown', addr_ls_(r), who_(r), r.stage || '',
              dayLabel_(-d)],
      sev: d > LS_URGENT.STALE_BAD_DAYS ? 'bad' : 'warn' };
  }).sort(function (a, b) { return a.sort - b.sort; });

  out.push(block_('Processes with no recent activity', stalled,
    ['Process', 'Property', 'Owner', 'Stage', 'Last touched'],
    'Open, not yet overdue, and nobody has touched them. Shown separately because a ' +
    'process with no due date can never become overdue — without this list it would ' +
    'never surface at all.',
    'ls_stalled', 'processes', 'LS_Processes'));

  // ---- 3. unassigned ---------------------------------------------------------
  var unassigned = open.filter(function (r) { return r.is_unassigned === 'YES'; })
    .map(function (r) {
      var d = num_(r.days_since_update) || 0;
      return { days: d, sort: -d, pm: UNASSIGNED, key: String(r.process_id), src: r,
        noLink: true, extLink: r.link || '',
        cells: [r.process_type || 'Unknown', addr_ls_(r), r.stage || '',
                r.due_date || 'no due date', dayLabel_(-d)],
        sev: 'bad' };
    }).sort(function (a, b) { return a.sort - b.sort; });

  out.push(block_('Open processes with no owner', unassigned,
    ['Process', 'Property', 'Stage', 'Due', 'Last touched'],
    'Nobody is named on these. They are red regardless of age: an unowned process ' +
    'is not late yet only because no one has looked at it.',
    'ls_unassigned', 'processes', 'LS_Processes'));

  // ---- 4. no due date --------------------------------------------------------
  var noDue = open.filter(function (r) {
    return r.no_due_date === 'YES' && r.is_unassigned !== 'YES';
  }).map(function (r) {
    var d = num_(r.days_since_update) || 0;
    return { days: d, sort: -d, pm: UNASSIGNED, key: String(r.process_id), src: r,
      noLink: true, extLink: r.link || '',
      cells: [r.process_type || 'Unknown', addr_ls_(r), who_(r), r.stage || '',
              dayLabel_(-d)],
      sev: d > LS_URGENT.STALE_BAD_DAYS ? 'warn' : 'ok' };
  }).sort(function (a, b) { return a.sort - b.sort; });

  out.push(block_('Open processes with no due date', noDue,
    ['Process', 'Property', 'Owner', 'Stage', 'Last touched'],
    'These cannot appear on the overdue list no matter how long they run, so an empty ' +
    'overdue list does not mean everything is on time. Fix in LeadSimple by setting a ' +
    'due date on the process.',
    'ls_no_due', 'processes', 'LS_Processes'));

  return out;
}

