    deferred.length + '</strong> awaiting a source system · <strong>' + blocked.length +
    '</strong> with no source. <span class="muted">Nothing is estimated. What cannot be measured says so.</span></div>');

  h.push('<section class="card guide"><h2>How to read these bars</h2>' +
    '<div class="guiderow">' +
      '<div class="gbar"><span class="gfill good" style="width:34%"></span>' +
      '<i class="gmark top" style="left:34%"></i><i class="gmark med" style="left:62%"></i></div>' +
      '<div class="gtext"><strong>The bar is our result.</strong> The two ticks are the industry ' +
      'benchmarks: the <span class="tick teal">teal</span> tick is the top-quartile target, the ' +
      '<span class="tick gray">grey</span> tick is the median.</div>' +
    '</div>' +
    '<div class="guidekeys">' +
      '<span class="pill good">top quartile</span> better than the teal tick \u2014 among the ' +
      'strongest quarter of firms surveyed' +
      '<span class="sep"></span>' +
      '<span class="pill ok">at benchmark</span> between the two ticks \u2014 about average' +
      '<span class="sep"></span>' +
      '<span class="pill bad">below benchmark</span> past the grey tick \u2014 below the survey median' +
    '</div>' +
    '<p class="note">Most metrics are better when LOWER, so a shorter bar is good. The few marked ' +
    '&#8593; are the opposite \u2014 longer is better \u2014 and are scored that way automatically. ' +
    'Benchmarks are industry survey targets, not legal or contractual requirements.</p>' +
    '</section>');

  cats.forEach(function (cat) {
    var items = byCat[cat];
    var hasLive = items.some(function (r) { return r.value !== null && r.value !== ''; });
    h.push('<section class="card' + (hasLive ? '' : ' dim') + '"><h2>' + esc_(cat) + '</h2>');
    h.push('<div class="metrics">');
