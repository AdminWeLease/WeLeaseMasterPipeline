/**
 * Owners pipeline — REPORTING ONLY.
 *
 * No status column and no follow-up dates on purpose. LeadSimple is where this work is
 * actually done, and a second status field here would drift from it within a week.
 * What this view adds is the thing LeadSimple does not put in front of anyone: how
 * much of the active pipeline has gone quiet.
 */
/**
 * Where the quiet deals sit, by assignee.
 *
 * The same question the process workload table answers, asked of the pipeline: a high
 * deal count is a capacity conversation, a high quiet SHARE is a different one, and
 * they rarely land on the same person. Reporting only — no statuses here, because the
 * next step gets recorded in LeadSimple.
 */
function lsPipelineWorkload_() {
  var deals = readTab_('LS_Deals').filter(function (d) { return d.is_active === 'YES'; });
  if (!deals.length) return '';

  var by = {};
  deals.forEach(function (d) {
    var who = d.assignee || 'Unassigned';
    var u = by[who] || (by[who] = { who: who, active: 0, quiet: 0, noTask: 0,
                                    neverTouched: 0, overdueTask: 0, longest: 0 });
    u.active++;
    if (d.is_stale === 'YES') u.quiet++;
    if (d.no_next_task === 'YES') u.noTask++;
    if (d.never_contacted === 'YES') u.neverTouched++;
    if (num_(d.next_task_days_overdue) > 0) u.overdueTask++;
    var q = num_(d.days_since_last_touch);
    if (q !== null) u.longest = Math.max(u.longest, q);
  });

  var rows = Object.keys(by).map(function (k) {
    var u = by[k];
    u.pct = u.active ? Math.round(u.quiet / u.active * 100) : 0;
    return u;
  }).sort(function (a, b) { return (b.quiet - a.quiet) || (b.active - a.active); });

  var h = ['<section class="card"><h2>Where the quiet deals sit</h2>'];
  h.push('<p class="note">Active deals per person, worst first. Carrying 40 deals with 2 ' +
    'quiet is a different situation from carrying 6 with 5 quiet, and only the share ' +
    'separates them.</p>');
  h.push('<table><thead><tr><th>Person</th><th class="num">Active</th>' +
    '<th class="num">Gone quiet</th><th class="num">Share quiet</th>' +
    '<th class="num">No next step</th><th class="num">Overdue task</th>' +
    '<th>Longest quiet</th></tr></thead><tbody>');
  rows.forEach(function (u) {
    var tone = u.pct >= 75 ? 'bad' : (u.pct >= 40 ? 'warn' : (u.quiet ? 'ok' : 'good'));
    h.push('<tr><td class="strong">' + esc_(u.who) + '</td>' +
      '<td class="num">' + u.active + '</td>' +
      '<td class="num strong">' + u.quiet + '</td>' +
      '<td class="num"><span class="tag ' + tone + '">' + u.pct + '%</span></td>' +
      '<td class="num muted">' + u.noTask + '</td>' +
      '<td class="num muted">' + u.overdueTask + '</td>' +
      '<td>' + (u.longest
        ? '<span class="tag cell ' + (u.longest > 60 ? 'bad' : 'warn') + '">' +
          esc_(daySpan_(u.longest)) + '</span>'
        : '<span class="muted">—</span>') + '</td></tr>');
  });
  h.push('</tbody></table>');
  var nobody = rows.filter(function (u) { return u.who === 'Unassigned'; })[0];
  if (nobody) {
    h.push('<p class="warnrow"><strong>' + nobody.active + ' active deal' +
      (nobody.active === 1 ? '' : 's') + ' belong to nobody.</strong> They will not appear ' +
      'on anyone’s list in LeadSimple either, so they go quiet by default.</p>');
  }
  h.push('</section>');
  return h.join('');
}

function lsPipelinePanel_() {
  if (!lsEnabled_()) return '';
  var deals = readTab_('LS_Deals');
  var funnel = readTab_('LS_Owners_Funnel');
  if (!deals.length) {
    return '<section class="card"><h2>Owners pipeline</h2>' +
      '<p class="warnrow">No deals yet — <code>LS_Deals</code> is empty. Run ' +
      '<code>rebuildLeadSimple()</code>.</p></section>';
  }

  var active = deals.filter(function (d) { return d.is_active === 'YES'; });
  var stale = active.filter(function (d) { return d.is_stale === 'YES'; });
  var noTask = active.filter(function (d) { return d.no_next_task === 'YES'; });
  var never = active.filter(function (d) { return d.never_contacted === 'YES'; });
  var won = deals.filter(function (d) { return d.stage_status === 'won'; }).length;
  var lost = deals.filter(function (d) { return d.stage_status === 'lost'; }).length;
  var winPct = (won + lost) ? Math.round(won / (won + lost) * 100) : null;

  var h = ['<div class="hero">'];
  h.push('<div class="hero-card"><div class="hero-label">Active deals</div>' +
