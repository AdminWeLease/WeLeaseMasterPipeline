    '<span class="hero-unit"> days</span></div>' +
    '<div class="hero-foot muted">pulled up by the long tail</div></div>');
  h.push('<div class="hero-card ' + (rate === null ? '' : (rate >= 70 ? 'good' : (rate >= 50 ? 'ok' : 'bad'))) + '">' +
    '<div class="hero-label">Leads matched</div>' +
    '<div class="hero-value">' + (rate === null ? '—' : rate) + '<span class="hero-unit">%</span></div>' +
    '<div class="hero-foot muted">' + rows.length + ' of ' + examined + ' by resident name</div></div>');
  h.push('<div class="hero-card"><div class="hero-label">Fastest / slowest</div>' +
