/**
 * Leasing funnel + vacancy breakdown.
 * Both panels are borrowed from the previous Data Studio board — "Converted
 * Applications" by status, and the vacancy split between advertised and pending
 * to post. They answer questions a single KPI number cannot: where applicants
 * fall out, and how much vacancy is self-inflicted.
 */
/**
 * Portfolio panel — the tiles and the door-growth series.
 * Growth history is rebuilt from unit created_on and property management dates, so
 * the full picture exists today rather than accumulating from here forward.
 */
/**
 * Leasing activity by month, with a range selector.
 * Bars are rendered for every month and hidden client-side, so switching range is
 * instant and needs no server round-trip.
 */
function leasingChart_() {
  var rows = readTab_('Leasing_Activity');
  if (!rows.length) return '';
  // monthNorm_, not String() — String(a Date) begins with the weekday name, so a raw sort
  // would order these by "Fri" before "Mon" the moment Sheets coerces a month cell.
  rows.sort(function (a, b) { return monthNorm_(a.month) < monthNorm_(b.month) ? -1 : 1; });

  var h = ['<section class="card"><div class="card-head"><h2>Leasing activity by month</h2>' +
    rangeSelect_('leaseRange') + '</div>'];
  h.push('<p class="note">Rebuilt from event dates, so the history is complete rather than ' +
    'accumulating from today. Hover any point for the month and value.</p>');
  h.push(lineChartRanged_(rows, [
    { key: 'move_ins',     label: 'Move-ins',     color: '#2EA3F2' },
    { key: 'move_outs',    label: 'Move-outs',    color: '#C0392B' },
    { key: 'notices',      label: 'Notices',      color: '#D9A400' },
    { key: 'applications', label: 'Applications', color: '#066D88', dashed: true }
  ], { height: 320 }, 'leaseRange'));
  h.push('</section>');
  return h.join('');
}

