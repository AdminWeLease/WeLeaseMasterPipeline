/**
 * WeLease Pipeline — DASHBOARD  v2.0.0 · 2026-08-05
 * Requires Core_v2.gs and Metrics.gs.
 *
 * Two views, one page:
 *   ACTION  (default) — what needs doing today, filterable by PM group
 *   KPIs             — portfolio performance against benchmarks
 *
 * DEPLOY: Deploy > New deployment > Web app
 *   Execute as: Me · Access: Anyone within WeLease Property Management
 *
 * Colour follows each metric's own direction field. Five metrics are better when
 * HIGHER — renewal lead times, resolved-without-dispatch, units per team member.
 * Nothing here hardcodes "lower is green".
 */

/**
 * WeLease palette. The four brand colours are fixed; everything else is derived
 * from them so nothing on the page is an unrelated hue.
 *
 *   Bright Blue #2EA3F2 · Deep Teal #066D88 · Dark Gray #494949 · White #FFFFFF
 *
 * Severity colours are deliberately desaturated toward the brand: a stock browser
 * red next to Deep Teal reads as an error in the design, not an error in the data.
 */
var BRAND = {
  blue: '#2EA3F2', teal: '#066D88', gray: '#494949', white: '#FFFFFF',
  blueDark: '#1B87D1', blueWash: '#EAF5FE',
  tealDark: '#05586E', tealWash: '#E6F1F4',
  ink: '#2B2B2B', line: '#DDE4E9', wash: '#F4F7F9', mute: '#767E86',
  good: '#0F8A5F', goodWash: '#E7F4EE',
  warn: '#B26A00', warnWash: '#FDF2E3',
  bad:  '#C0392B', badWash:  '#FCEBE9'
};

/**
 * The WeLease bunny, white on transparent, inlined as base64.
 *
 * Inline rather than a Drive link on purpose: a Drive-hosted image needs its own
 * permissions, and a web app that renders for one person and shows a broken icon
 * for everyone else is worse than no logo. ~11 KB against a page already measured
 * in hundreds.
 *
 * It is a white silhouette, so it is only legible on a dark surface. Keep it on
 * the teal header.
 */
var WL_LOGO = 'data:image/png;base64,';

/**
 * When the data behind the page was last rebuilt, written the way someone reading it
 * at their desk would say it.
 *
 * A bare date could not distinguish "the 5am run landed" from "the 5am run failed and
 * you are looking at yesterday". The hour is the whole point.
 */
function refreshLabel_(stamp) {
  var raw = String(stamp || '').trim();
  if (!raw || raw === 'not yet run') return 'Not yet run';

  var d = parseDate_(raw);
  if (!d) return 'Refreshed ' + raw;

  // Frank's format: Refreshed 08/14/2026 2:24 AM. A relative "today at" reads nicely
  // until someone is comparing two screenshots, and then only the date settles it.
  var mm = ('0' + (d.getMonth() + 1)).slice(-2);
  var dd = ('0' + d.getDate()).slice(-2);
  var yyyy = d.getFullYear();
  var h = d.getHours();
  var ampm = h >= 12 ? 'PM' : 'AM';
  var h12 = h % 12; if (h12 === 0) h12 = 12;
  var min = ('0' + d.getMinutes()).slice(-2);

  // A timestamp with no time component means the stamp itself carried no clock.
  var hasTime = /\d{1,2}:\d{2}/.test(raw);
  return 'Refreshed ' + mm + '/' + dd + '/' + yyyy +
         (hasTime ? ' ' + h12 + ':' + min + ' ' + ampm : '');
}

/**
 * Header bar, shared by the live page and the failure page.
 *
 * The refresh legend sits with the title rather than across the header, because it
 * describes the page as a whole and the team checks it first thing every morning.
 */
function brandHeader_(noteHtml) {
  return '<header><div class="brand">' +
    // NOT class "mark" — that name is already taken by the benchmark tick on the
    // Performance bullets, and the later rule was silently shrinking the header
    // logo to a 2px sliver.
    '<img class="logo" src="' + WL_LOGO + '" alt="WeLease" width="52" height="34">' +
    '<div><h1>WeLease Property Management</h1>' +
    '<p class="sub">Operations Dashboard' + (noteHtml || '') + '</p></div></div>' +
    // Display preferences, not data controls, so they live on the header rather than in
    // the filter bar — a person sets these once and then forgets they exist. Labels say
    // what the button will DO, not what is currently on, because "Dark" next to a dark
    // screen is ambiguous every single time.
    // ONE CONTROL, AND IT IS AN ICON. Compact went because it was a second row height to
    // maintain for a preference almost nobody changes twice — and every table it touched
    // had to be re-checked at both densities. The theme control stays, as a symbol: a
    // word next to a dark screen reading "Dark" is ambiguous every single time, whereas a
    // sun on a dark page is unmistakably an offer to make it light.
    '<div class="chrome">' +
      '<button type="button" id="thmBtn" class="cbtn icon" onclick="cycleTheme()" ' +
      'aria-label="Switch between dark, light and following your computer">' +
      '<span class="thmi" aria-hidden="true">\u25D0</span></button>' +
    '</div>' +
    '</header>';
}

var URGENT = {
  LEASE_EXPIRY_DAYS: 120,   // renewals need a long runway — decision, market rate, signature
  DELINQ_DAYS: 30,
  INSPECTION_MONTHS: 12,
  VACANT_DAYS: 60,
  MOVEIN_LOOKAHEAD: 21      // three weeks — the window the team can actually act on
};

// Property groups serve several purposes in AppFolio. Only the PM-prefixed ones are
// management assignments; "Solar", "IRS Compliance Fee" and similar are reporting
// groups and must never appear as a manager filter. A property can belong to both.
var PM_GROUP_PREFIX = 'PM';

/**
 * Tab order, grouped by the work rather than by when each was built.
 *
 * Frank, 2026-08-24: related tabs next to each other, reporting at the end. Somebody
 * working delinquency moves to collections next; somebody in leasing moves to renewals.
 * Putting them adjacent saves a scan of the whole bar every time.
 *
 * The two reporting tabs sit last because they are read once a week, not worked daily —
 * and a tab you open on Tuesday should not sit between two you open hourly.
 */
var VIEWS = [
  { id: 'action',      label: 'Needs Attention' },   // always first — the front page

  // Leasing a unit and keeping the resident in it.
  { id: 'leasing',     label: 'Leasing' },
  { id: 'renewals',    label: 'Lease Renewals' },

  // The property itself.
  { id: 'maintenance', label: 'Maintenance' },
  { id: 'utilities',   label: 'Utility Billing' },

  // Money in, money out.
  { id: 'delinquency', label: 'Delinquency' },
  { id: 'collections', label: 'Collections' },

  // Obligations and the people we answer to.
  { id: 'insurance',   label: 'Insurance' },
  { id: 'processes',   label: 'Process Adherence' },
  { id: 'pipeline',    label: 'Owners Pipeline' },

  // Read weekly, not worked daily.
  { id: 'weekly',      label: 'Weekly Report' },
  { id: 'performance', label: 'Performance' }
];

/**
 * LeadSimple views are only worth a tab once the data is there. A tab that opens on
 * "nothing configured" trains people to stop clicking it.
 */
function lsEnabled_() {
  try {
    return (typeof systemEnabled_ === 'function') && systemEnabled_('leadsimple') &&
           readTab_('LS_Processes').length > 0;
  } catch (e) { return false; }
}

function doGet(e) {
  var view = (e && e.parameter && e.parameter.view) || 'action';
  var live = !!(e && e.parameter && e.parameter.live);
  // Before anything renders, and before the cache decision below, because ?maint= changes
  // which page this person should be getting.
  applyMaintParam_(e);
  var html;
  try {
    // Admins get a live render. The cache holds the team's page by construction, so
    // serving it to a maintainer would hide the very notes they are here to see — and
    // there are two of them, so the cost is two slow page loads a day.
    // Whichever page this person should be getting, cached. ?maint=0 lands on the team
    // copy, which is exactly what it is for.
    if (!live && view === 'action') {
      var cached = readDashboardCache_(isAdmin_());
      if (cached) {
        return HtmlService.createHtmlOutput(cached)
          .setTitle('WeLease Operations')
          .addMetaTag('viewport', 'width=device-width, initial-scale=1');
      }
    }
    var t0 = new Date().getTime();
    html = renderPage_(view);
    var ms = new Date().getTime() - t0;
    if (ms > 20000) {
      try { logError_('dashboard', 'slow render', 'Page took ' + Math.round(ms / 1000) + 's.'); } catch (e2) {}
    }
  } catch (err) {
    // A blank page tells nobody anything. Render the failure instead.
    try { logError_('dashboard', 'render', err.message + ' | ' + (err.stack || '').slice(0, 400)); } catch (e2) {}
    html = '<!DOCTYPE html><html><head><meta charset="utf-8">' + css_() + '</head><body><div class="wrap">' +
      brandHeader_('<span class="asof">Could not render</span>') +
      '<section class="card"><h2>Something failed while building the page</h2>' +
      '<p class="warnrow">' + esc_(err.message) + '</p>' +
      '<p class="note">Most common causes: a job has not run yet so a tab is missing, or the ' +
      'page exceeded the execution limit. Check <code>_errors</code> and <code>_refresh_log</code> ' +
      'in the sheet.</p>' +
      '<pre class="trace">' + esc_((err.stack || 'no stack trace').slice(0, 1200)) + '</pre>' +
      '</section></div></body></html>';
  }
  return HtmlService.createHtmlOutput(html)
    .setTitle('WeLease Operations')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/** Run from the editor to test rendering without deploying. Prints timing and errors. */
function testDashboardRender() {
  var t0 = new Date().getTime();
  try {
    var html = renderPage_('action');
    Logger.log('OK — ' + html.length + ' chars in ' + ((new Date().getTime() - t0) / 1000).toFixed(1) + 's');
    return 'OK';
  } catch (err) {
    Logger.log('FAILED after ' + ((new Date().getTime() - t0) / 1000).toFixed(1) + 's');
    Logger.log(err.message);
    Logger.log(err.stack);
    return 'FAILED: ' + err.message;
  }
}

// ============================================================ PRE-RENDER

/**
 * The page is built from data that only changes overnight, so building it on every
 * request is wasted work. The nightly chain renders it once and parks the HTML in a
 * Drive file; doGet serves that. Rendering moves off the critical path entirely.
 *
 * ?live=1 forces a fresh render, which is also how you check a change before the
 * next nightly run.
 */
var DASH_CACHE_PROP = 'DASHBOARD_CACHE_FILE_ID';
var DASH_CACHE_NAME = 'welease-dashboard-cache.html';
// TWO CACHES, because there are two versions of the page.
//
// Serving the maintainer a live render kept their notes correct and made the dashboard
// slow for the one person who opens it most — 2-5 seconds on every load while everybody
// else got a cached page instantly. Rendering twice on a nightly trigger costs a few
// seconds that nobody waits for, and buys a fast page for everyone.
//
// The admin copy is no staler than the team copy: both are rebuilt by the same job, and
// the maintenance notes describe the state those jobs just left behind. ?live=1 still
// forces a fresh render if you want one.
var DASH_CACHE_PROP_ADMIN = 'DASHBOARD_CACHE_FILE_ID_ADMIN';
var DASH_CACHE_NAME_ADMIN = 'welease-dashboard-cache-admin.html';

function cacheDashboard_(html, forAdmin) {
  var props = PropertiesService.getScriptProperties();
  var prop = forAdmin ? DASH_CACHE_PROP_ADMIN : DASH_CACHE_PROP;
  var name = forAdmin ? DASH_CACHE_NAME_ADMIN : DASH_CACHE_NAME;
  var id = props.getProperty(prop);
  var file = null;
  if (id) { try { file = DriveApp.getFileById(id); } catch (e) { file = null; } }
  if (file) file.setContent(html);
  else {
    file = DriveApp.createFile(name, html, MimeType.HTML);
    props.setProperty(prop, file.getId());
  }
  // READABLE BY THE TEAM. Under "execute as user" the page is fetched from Drive as the
  // VISITOR, not as the owner. An unshared cache file throws for everybody else, the read
  // falls back to a live render, and the only symptom is that the dashboard quietly got
  // slow for fourteen people and fast for one.
  // Domain view-only: it is a rendered copy of a page they are already looking at.
  try {
    file.setSharing(DriveApp.Access.DOMAIN_WITH_LINK, DriveApp.Permission.VIEW);
  } catch (e) {
    logError_('dashboard', 'cache sharing',
      'Could not share the cache file with the domain: ' + e.message + '. Every team ' +
      'member will fall back to a live render, which works but is slow. Share ' +
      name + ' manually, or the page will stay slow for everyone but you.');
  }
  props.setProperty('DASHBOARD_CACHED_AT', nowStamp_());
  return file.getId();
}

function readDashboardCache_(forAdmin) {
  var id = PropertiesService.getScriptProperties()
    .getProperty(forAdmin ? DASH_CACHE_PROP_ADMIN : DASH_CACHE_PROP);
  if (!id) return null;
  try { return DriveApp.getFileById(id).getBlob().getDataAsString(); }
  catch (e) { return null; }
}

/** Nightly job. Renders every view and caches the result. */
function buildDashboardCache() {
  var t0 = new Date().getTime();
  invalidateTab_();                       // always render from the freshly written tabs
  // TWO AUDIENCES, TWO CACHES. This job runs on a trigger, so it runs as the OWNER —
  // and without an explicit audience the cached HTML is an ADMIN render that then gets
  // served to all fifteen people. That is what defeated the admin gate: the gate worked,
  // and its answer was thrown away and replaced with a copy an admin had made.
  //
  // The admin copy exists so the maintainer is not the only person on a slow page. It
  // costs a second render on a nightly job nobody waits for.
  // Rendered twice, explicitly, rather than relying on who happens to be running the job.
  // try/finally on each, because a render that throws must not leave the audience pinned
  // for whatever runs next in the same execution.
  var html, adminHtml;
  _renderAs = 'team';
  try { html = renderPage_('action'); }
  finally { _renderAs = null; }
  cacheDashboard_(html, false);

  invalidateTab_();
  _renderAs = 'admin';
  try { adminHtml = renderPage_('action'); }
  finally { _renderAs = null; }
  cacheDashboard_(adminHtml, true);
  var secs = ((new Date().getTime() - t0) / 1000).toFixed(1);
  var kb = Math.round(html.length / 1024);
  logRun_('buildDashboardCache', 'derived', '-', html.length, new Date().getTime() - t0,
          'two renders in ' + secs + 's · team ' + kb + ' KB · admin ' +
          Math.round(adminHtml.length / 1024) + ' KB');
  // Nightly this is harmless — nobody waits for it. But it is the metric that will
  // creep, and it is now two renders rather than one, so make the creep visible rather
  // than discovering it at the six-minute timeout.
  if (secs > 90 || kb > 700) {
    logError_('dashboard', 'cache size',
      'Two renders took ' + secs + 's and the page is ' + kb + ' KB. Still within ' +
      'limits, but worth trimming before it is not: reduce the chart range variants or ' +
      'cap list lengths in renderListView_.');
  }
  Logger.log('Dashboard cached: ' + Math.round(html.length / 1024) + ' KB in ' + secs + 's');
  return { bytes: html.length, seconds: secs };
}

// ============================================================ SHARED DATA

function isPMGroup_(name) {
  return String(name || '').trim().toUpperCase().indexOf(PM_GROUP_PREFIX) === 0;
}

function pmLookup_() {
  var map = {};
  readTab_('PM_Groups').forEach(function (r) {
    if (!r.property_id) return;
    // Only PM-prefixed groups are management assignments. A property in both
    // "PM Frank, Jennifer" and "Solar" must resolve to the PM group, never to
    // whichever row happened to come last.
    if (isPMGroup_(r.property_group_name)) map[r.property_id] = r.property_group_name;
  });
  return map;
}

var UNASSIGNED = 'Unassigned';

/**
 * PM group for a row. ONE resolver, used by every list.
 *
 * Lists were resolving this inconsistently, and rows that landed on "Unassigned" were
 * unreachable because that value was never offered in the dropdown — so filtering by a
 * manager silently dropped them and the counts stopped adding up.
 *
 * Order: the unit's entry in the address book, then the property map, then Unassigned.
 */
function pmOf_(map, propertyId, unitId) {
  if (unitId) {
    var e = addressBook_()[unitId];
    if (e && e.pm_group && e.pm_group !== UNASSIGNED) return e.pm_group;
  }
  return (propertyId && map[propertyId]) ? map[propertyId] : UNASSIGNED;
}

/** Groups present in the data, so the dropdown always covers every row. */
/**
 * Groups present in the data, so the dropdown always covers every row.
 *
 * LeadSimple lists are excluded from the Unassigned COUNT. Their rows are hardcoded to
 * Unassigned because a LeadSimple process carries a LeadSimple property id that cannot
 * be joined to a PM group — a known limitation, not a missing assignment in AppFolio.
 * Counting them made the banner read 134 when the real answer was two dummy properties,
 * which sent us looking in AppFolio for something that was not there.
 *
 * They still appear under Unassigned in the dropdown, so the filter reaches them.
 */
function pmList_(map, rows) {
  var seen = {};
  Object.keys(map).forEach(function (k) { seen[map[k]] = true; });

  // Which properties exist at all, so an unresolvable row can be told apart from a
  // property that simply has no manager.
  // Properties_All includes hidden and offboarded records; Properties_Units does not.
  // Utility rows land on offboarded properties — 70 of them on the live data — and
  // against the visible directory alone they looked like properties needing a manager.
  var known = {}, notManaged = {};
  try {
    var all = readTab_('Properties_All');
    if (!all.length) all = readTab_('Properties_Units');
    all.forEach(function (p) {
      var id = String(p.property_id === null || p.property_id === undefined ? '' : p.property_id);
      if (!id) return;
      known[id] = true;
      // A property on its way out, or already gone, is not a missing assignment.
      if (!isActiveProperty_(p) || isEndingMgmt_(p) || isExcluded_(p)) notManaged[id] = true;
    });
  } catch (e) {}

  var fixable = 0, unjoinable = 0, notAssignable = 0, anyUnassigned = false;
  (rows || []).forEach(function (b) {
    var noJoin = String(b.id || '').indexOf('ls_') === 0;
    b.rows.forEach(function (r) {
      if (r.pm !== UNASSIGNED) { seen[r.pm] = true; return; }
      anyUnassigned = true;
      if (noJoin) { unjoinable++; return; }
      // Three reasons a row lands on Unassigned, and only one is fixable in AppFolio.
      var pid = (r.src || {}).property_id;
      if (pid === null || pid === undefined || pid === '') { notAssignable++; return; }
      if (!known[String(pid)]) { notAssignable++; return; }
      if (notManaged[String(pid)]) { notAssignable++; return; }
      fixable++;
    });
  });

  var list = Object.keys(seen).sort();
  if (anyUnassigned) list.push(UNASSIGNED);
  return { groups: list, unassigned: fixable, unjoinable: unjoinable,
           not_assignable: notAssignable };
}

// ============================================================ URGENCY BUILDERS

/**
 * Every list obeys the same house rules:
 *   - identified by street address, never by property or unit id
 *   - TPO properties excluded, except vacancies and move-ins
 *   - rows cleared in _acknowledgments are hidden
 */
function urgencies_(pm) {
  var t = ymd_(today_());
  var U = [];

  // ACTIVE TENANCY. Former residents linger in several reports — a delinquency balance
  // survives the move-out, and a renewal record outlives the lease. Filtering only on
  // unit was not enough: it kept rows for people who left months ago.
  var live = liveTenancy_();
  var activeUnits = live.units;

  // last inspection per unit, used by several lists
  var lastInsp = {};
  readTab_('Inspections').forEach(function (r) {
    if (!r.unit_id) return;
    var di = ymd_(r.inspected_on);
    if (di && (!lastInsp[r.unit_id] || di > lastInsp[r.unit_id])) lastInsp[r.unit_id] = di;
  });

  // ---- 1. leases expiring, with signature status -------------------------------
  // MATCHING MATTERS. Keying renewals by unit alone surfaced the ORIGINAL lease
  // signature — a lease expiring Aug 2026 showed "signed 2025-08-12", which is when
  // the current term was signed, not evidence of a renewal. A renewal record is only
  // relevant when its previous_lease_end lines up with the lease that is expiring.
  var renByUnitEnd = {};
  readTab_('Renewals').forEach(function (r) {
    var prev = ymd_(r.previous_lease_end);
    if (!prev || !r.unit_id) return;
    renByUnitEnd[r.unit_id + '|' + prev] = r;
  });
  function renewalFor_(unitId, expiresOn) {
    if (!unitId || !expiresOn) return null;
    // exact, then a few days either side — lease end and renewal start rarely align to the day
    for (var off = 0; off <= 5; off++) {
      var a = renByUnitEnd[unitId + '|' + ymd_(addDays_(expiresOn, off))];
      if (a) return a;
      var b = renByUnitEnd[unitId + '|' + ymd_(addDays_(expiresOn, -off))];
      if (b) return b;
    }
    return null;
  }

  var exp = dropTPO_(readTab_('Lease_Expirations')).filter(function (r) {
    return isActiveTenancy_(r, live);
  }).map(function (r) {
    var expOn = ymd_(r.lease_expires);
    var d = daysBetween_(t, expOn);
    var ren = renewalFor_(r.unit_id, expOn);
    var sig, tone;
    if (!ren)                        { sig = 'no renewal started'; tone = 'bad'; }
    else if (ren.countersigned_date) { sig = 'signed ' + ymd_(ren.countersigned_date); tone = 'good'; }
    else if (ren.renewal_sent_date)  { sig = 'out for signature since ' + ymd_(ren.renewal_sent_date); tone = 'warn'; }
    else                             { sig = 'created, not sent'; tone = 'bad'; }
    var li = lastInsp[r.unit_id];
    var liAge = li ? Math.round(daysBetween_(li, t) / 30) : null;
    return { days: d, sort: d, pm: pmOf_(pm, r.property_id, r.unit_id), key: addr_(r), src: r,
      cells: [addr_(r), r.tenant_name || '', expOn || '', sig,
              li ? (li + ' (' + liAge + ' mo)') : 'never',
              dayOverdue_(d)],
      sev: tone === 'good' ? 'good' : (d !== null && d <= 45 ? 'bad' : tone) };
  }).filter(function (r) { return r.days !== null && r.days <= URGENT.LEASE_EXPIRY_DAYS; })
    .sort(function (a, b) { return a.sort - b.sort; });
  var noExpiry = dropTPO_(readTab_('Lease_Expirations')).filter(function (r) {
    return isActiveTenancy_(r, live) && !ymd_(r.lease_expires);
  });

  U.push(block_('Leases expiring within ' + URGENT.LEASE_EXPIRY_DAYS + ' days', exp,
    ['Address', 'Resident', 'Expires', 'Renewal status', 'Last inspection', 'Countdown'],
    'Renewal status is matched on previous_lease_end, so it reflects THIS renewal cycle \u2014 ' +
    'not the signature on the current lease. "No renewal started" inside 45 days is ours to fix. ' +
    'Last inspection is shown so a renewal decision is not made blind.' +
    (noExpiry.length ? ' A further ' + noExpiry.length + ' active leases carry NO expiry date ' +
      'in AppFolio and cannot appear on a countdown \u2014 listed separately below.' : ''),
    'expiring', 'renewals', 'Lease_Expirations'));

  // ---- 1c. active leases with no expiry date -----------------------------------
  // Roughly half the lease_expiration_detail rows come back with lease_expires empty.
  // Month-to-month, holdover, or simply never entered. They are real, active tenancies
  // that cannot appear on any countdown — so an empty expiring list does not mean
  // nothing is due. Each is a renewal conversation with no date attached, and a resident
  // who can give notice at any time.
  var mtm = noExpiry.map(function (r) {
    var li = lastInsp[r.unit_id];
    return { days: 0, sort: 0, pm: pmOf_(pm, r.property_id, r.unit_id), key: addr_(r), src: r,
      cells: [addr_(r), r.tenant_name || '', r.status || '\u2014',
              li || 'never', 'no expiry recorded'],
      sev: 'warn' };
  }).sort(function (a, b) { return String(a.cells[0]) < String(b.cells[0]) ? -1 : 1; });

  U.push(block_('Active leases with no expiry date', mtm,
    ['Address', 'Resident', 'Status', 'Last inspection', 'Expiry'],
    'lease_expires is blank in AppFolio \u2014 month-to-month, holdover, or not entered. ' +
    'These cannot appear on a countdown, so an empty expiring list is not the same as ' +
    'nothing being due.',
    'no_expiry', 'renewals', 'Lease_Expirations'));

  // ---- 1b. rent payment timing, this month ------------------------------------
  // The band is WeLease's rule: green paid on the 1st, yellow while we are still
  // inside the 2nd-to-5th window, red once we are past the 5th and they still owe.
  var ackRT = ackSet_('rent_timing');
  var rt = readTab_('Rent_Timing_Current').map(function (r) {
    var band = String(r.band || 'red');
    return { days: num_(r.past_due) || 0, sort: -(num_(r.past_due) || 0),
      pm: pmOf_(pm, r.property_id, r.unit_id), key: r.occupancy_id, src: r,
      cells: [addr_(r), r.tenant || '',
              r.paid_on_day
                ? ('paid on day ' + r.paid_on_day + ' \u2014 balance remains')
                : 'nothing received',
              (num_(r.days_late) > 0 ? daySpan_(num_(r.days_late)) + ' past the 5th' : 'within grace'),
              money_(r.past_due)],
      sev: band === 'green' ? 'good' : (band === 'yellow' ? 'warn' : 'bad') };
  }).filter(function (r) { return !isAcked_(ackRT, r.key); })
    .sort(function (a, b) { return a.sort - b.sort; });
  var redN = rt.filter(function (r) { return r.sev === 'bad'; }).length;
  U.push(block_('Rent outstanding this month', rt,
    ['Address', 'Resident', 'Payment', 'Timing', 'Balance'],
    'Every row here owes money \u2014 that is why it is on the list. Yellow means we are ' +
    'still inside the 2nd\u20135th window; red means the 5th has passed and a balance ' +
    'remains. ' + redN + ' currently red. A partial payment does not clear a row: ' +
    '"paid on day 1 \u2014 balance remains" is a different conversation from "nothing ' +
    'received", but neither is settled. This is a point-in-time view and changes daily ' +
    '\u2014 the aged list below is the one to trend. CALIFORNIA: reporting only, late fees ' +
    'and notices are governed by statute and lease terms.',
    'rent_timing', 'delinquency', 'Rent_Timing_Current'));

  // ---- 2. delinquency aged past 30 days ----------------------------------------
  var ackD = ackSet_('delinquency');
  var del = dropTPO_(readTab_('Delinquency_Aged')).map(function (r) {
    var aged = (num_(r['30_to60']) || 0) + (num_(r['60_to90']) || 0) + (num_(r['90_plus']) || 0);
    return { days: aged, sort: -aged, pm: pmOf_(pm, r.property_id, r.unit_id), key: addr_(r), src: r,
      cells: [addr_(r), r.name || '', r.tenant_status || '', money_(aged)],
      sev: (num_(r['90_plus']) || 0) > 0 ? 'bad' : 'warn' };
  }).filter(function (r) { return r.days > 0 && !isAcked_(ackD, r.key) && isActiveTenancy_(r, live); })
    .sort(function (a, b) { return a.sort - b.sort; });
  U.push(block_('Delinquency aged past ' + URGENT.DELINQ_DAYS + ' days', del,
    ['Address', 'Resident', 'Status', 'Aged balance'],
    'Cycle-independent — excludes residents inside the grace period. CALIFORNIA: reporting only.',
    'delinquency', 'delinquency'));

  // ---- 2b. former residents with balances -------------------------------------
  // Scoped to the last 90 days, where recovery is realistic. Older balances are not
  // dropped — they are summarised in one line so total exposure stays visible without
  // burying the rows anyone can still act on.
  var FORMER_WINDOW = 90;
  var ackF = ackSet_('former');
  // Deliberately includes properties whose management has ended — the balance is still
  // owed, and hiding it because we handed the property back would lose real money.
  var formerAll = inScopeIncludingInactive_(readTab_('Delinquency_Aged')).filter(function (r) {
    return !isActiveTenancy_(r, live) && (num_(r.amount_receivable) || 0) > 0;
  }).map(function (r) {
    var bal = num_(r.amount_receivable) || 0;
    var mo = moveOutDateOf_(r, live) || ymd_(r.move_out);
    var since = mo ? daysBetween_(mo, t) : null;
    var evicted = /evict/i.test(String(r.delinquency_notes || ''));
    return { bal: bal, since: since, mo: mo, evicted: evicted, row: r };
  });

  var formerRecent = formerAll.filter(function (x) {
    return x.since !== null && x.since <= FORMER_WINDOW;
  });
  var formerOld = formerAll.filter(function (x) {
    return x.since === null || x.since > FORMER_WINDOW;
  });
  var oldTotal = formerOld.reduce(function (s2, x) { return s2 + x.bal; }, 0);

  var former = formerRecent.map(function (x) {
    var r = x.row;
    return { days: x.bal, sort: -x.bal, pm: pmOf_(pm, r.property_id, r.unit_id), key: r.occupancy_id, src: r,
      cells: [addr_(r), r.name || '', x.mo || 'unknown',
              x.since !== null ? dayLabel_(-x.since) : '\u2014',
              (r.in_collections ? (r.collections_agency || 'in collections') : 'not placed'),
              money_(x.bal)],
      sev: x.evicted ? 'bad' : (x.since > 60 ? 'bad' : 'warn') };
  }).filter(function (r) { return !isAcked_(ackF, r.key); })
    .sort(function (a, b) { return a.sort - b.sort; });

  var recentTotal = former.reduce(function (s2, r) { return s2 + (num_(r.days) || 0); }, 0);
  U.push(block_('Former residents with balances \u2014 last ' + FORMER_WINDOW + ' days', former,
    ['Address', 'Resident', 'Moved out', 'Since', 'Collections', 'Balance'],
    money_(recentTotal) + ' across ' + former.length + ' households that left in the last ' +
    FORMER_WINDOW + ' days \u2014 recent enough that recovery is realistic. ' +
    (formerOld.length
      ? 'A further ' + formerOld.length + ' older households carry ' + money_(oldTotal) +
        ', not listed here; most are with an agency or already written off. '
      : '') +
    'Held separately so none of it distorts the current delinquency rate. ' +
    '"Not placed" means no agency is recorded \u2014 those are the recoverable ones. ' +
    'CALIFORNIA: collections and eviction records are compliance-sensitive; reporting only.',
    'former', 'collections'));

  // ---- 3. no inspection in 12 months --------------------------------------------
  var ackI = ackSet_('inspections');
  // ANNUAL inspections only. This list used to count any inspection, so a unit with a
  // move-out walkthrough last month read as recently inspected — and 17% of the account's
  // inspection records are named in a way that would have done exactly that.
  var lastAnnual = {};
  readTab_('Inspections').forEach(function (r) {
    if (!r.unit_id) return;
    var nm = String(r.inspection_name || '');
    if (!RENEWAL.ANNUAL_NAME.test(nm) || RENEWAL.NOT_ANNUAL.test(nm)) return;
    var d = ymd_(r.inspected_on) || ymd_(r.marked_done_on);
    if (!d || d > t) return;                       // future dates are bookings, not visits
    if (!lastAnnual[r.unit_id] || d > lastAnnual[r.unit_id]) lastAnnual[r.unit_id] = d;
  });
  var stale = dropTPO_(readTab_('Unit_Directory')).map(function (u) {
    var last = lastAnnual[u.unit_id] || null;
    var age = last ? daysBetween_(last, t) : 9999;
    return { days: age, sort: -age, pm: pmOf_(pm, u.property_id, u.unit_id), key: addr_(u), src: u,
      cells: [addr_(u), last || 'never recorded', last ? Math.round(age / 30) + ' mo ago' : '—'],
      sev: last ? 'warn' : 'bad' };
  }).filter(function (r) { return r.days > 365 && !isAcked_(ackI, r.key); })
    .sort(function (a, b) { return a.sort - b.sort; });
  U.push(block_('No ANNUAL inspection in ' + URGENT.INSPECTION_MONTHS + ' months', stale,
    ['Address', 'Last annual inspection', 'Age'],
    'Counts only inspections named "annual" or "AI" — a move-in, move-out, vacancy or ' +
    'ad-hoc visit does not reset this clock. "Never recorded" may mean the unit predates ' +
    'inspection tracking. This list is independent of the renewal date: a unit with no ' +
    'renewal due still needs seeing once a year.',
    'inspections', 'renewals', 'Unit_Directory'));

  // ---- 4. renewals awaiting countersignature ------------------------------------
  var ackR = ackSet_('renewals');
  var renOut = dropTPO_(readTab_('Renewals')).filter(function (r) { return !r.countersigned_date; })
    .map(function (r) {
      var start = ymd_(r.lease_start);
      var d = start ? daysBetween_(t, start) : null;
      var stillHere = isActiveTenancy_(r, live);
      return { days: d, sort: d === null ? 9999 : d, pm: pmOf_(pm, r.property_id, r.unit_id),
        key: addr_(r) + '|' + (r.tenant_name || ''),
        src: r,
        cells: [addr_(r), r.tenant_name || '—',
                r.renewal_sent_date ? 'sent ' + ymd_(r.renewal_sent_date) : 'NOT SENT',
                stillHere ? 'active' : 'not active',
                start ? (d < 0 ? daySpan_(Math.abs(d)) + ' past start' : 'starts ' + dayLabel_(d)) : '—'],
        sev: !stillHere ? 'none' : (d !== null && d < 0) ? 'bad' : (!r.renewal_sent_date ? 'bad' : 'warn'),
        inactive: !stillHere };
    }).filter(function (r) { return !isAcked_(ackR, r.key); })
      .sort(function (a, b) { return (a.inactive ? 1 : 0) - (b.inactive ? 1 : 0) || a.sort - b.sort; });
  U.push(block_('Renewals awaiting countersignature', renOut,
    ['Address', 'Resident', 'Sent for signature', 'Tenancy', 'New lease starts'],
    'Tenancy is verified against the rent roll — a renewal on a unit that is no longer active is ' +
    'stale data, not a live task. "NOT SENT" means we have not issued the document yet.', 'awaiting', 'renewals', 'Renewals'));

  // ---- 5. upcoming move-ins (TPO INCLUDED) --------------------------------------
  var mi = readTab_('Tenant_Tickler').filter(function (r) {
    var e = String(r.event || '').toLowerCase().replace(/[^a-z]/g, '');
    return r.move_in_date && e.indexOf('movein') !== -1 && e.indexOf('notice') === -1;
  }).map(function (r) {
    var d = daysBetween_(t, ymd_(r.move_in_date));
    return { days: d, sort: d, pm: pmOf_(pm, r.property_id, r.unit_id), key: addr_(r), src: r,
      cells: [addr_(r), r.tenant || '', ymd_(r.move_in_date) || '',
              (isTPO_(r) ? 'TPO' : ''), dayLabel_(d)],
      sev: d <= 3 ? 'bad' : 'ok' };
  }).filter(function (r) { return r.days !== null && r.days >= 0 && r.days <= URGENT.MOVEIN_LOOKAHEAD; })
    .sort(function (a, b) { return a.sort - b.sort; });
  U.push(block_('Move-ins in the next ' + URGENT.MOVEIN_LOOKAHEAD + ' days', mi,
    ['Address', 'Resident', 'Move-in', 'Type', 'When'],
    'Includes TPO placements. Confirm rent-ready status and that the move-in inspection is booked.',
    'movein', 'leasing'));

  // ---- 6. vacant over 60 days (TPO INCLUDED) ------------------------------------
  var vac = readTab_('Unit_Vacancy').map(function (r) {
    var d = num_(r.days_vacant);
    return { days: d, sort: -(d || 0), pm: pmOf_(pm, r.property_id, r.unit_id), key: addr_(r), src: r,
      cells: [addr_(r), r.advertised_rent ? money_(r.advertised_rent) : '',
              (isTPO_(r) ? 'TPO' : ''), daySpan_(d)],
      sev: d > 90 ? 'bad' : 'warn' };
  }).filter(function (r) { return r.days !== null && r.days > URGENT.VACANT_DAYS; })
    .sort(function (a, b) { return a.sort - b.sort; });
  U.push(block_('Vacant over ' + URGENT.VACANT_DAYS + ' days', vac,
    ['Address', 'Advertised', 'Type', 'Vacant'],
    'Median vacancy looks healthy; this tail is where revenue actually leaks.', 'vacancy', 'leasing'));

  // ---- 7. vacant but not advertised (TPO INCLUDED) ------------------------------
  var unposted = readTab_('Unit_Vacancy').filter(function (r) {
    return String(r.posted_to_website || '').toLowerCase() !== 'yes';
  }).map(function (r) {
    var dv = num_(r.days_vacant);
    return { days: dv, sort: -(dv || 0), pm: pmOf_(pm, r.property_id, r.unit_id), key: addr_(r), src: r,
      cells: [addr_(r), r.available_on ? ymd_(r.available_on) : '', (isTPO_(r) ? 'TPO' : ''),
              (dv === null ? '—' : daySpan_(dv) + ' vacant')],
      sev: (dv || 0) > 14 ? 'bad' : 'warn' };
  }).sort(function (a, b) { return a.sort - b.sort; });
  U.push(block_('Vacant but not advertised', unposted,
    ['Address', 'Available', 'Type', 'Vacant'],
    'posted_to_website is not Yes. The most preventable vacancy loss on this page.', 'unposted', 'leasing'));

  // ---- 8. deposits past the standard --------------------------------------------
  var ackDep = ackSet_('deposits');
  var dep = dropTPO_(readTab_('Deposit_Compliance').filter(function (r) {
    return r.review_required === 'YES';
  })).map(function (r) {
    return { days: num_(r.days_elapsed), sort: -(num_(r.days_elapsed) || 0),
      pm: pmOf_(pm, r.property_id, r.unit_id), key: r.occupancy_id, src: r,
      cells: [addr_(r), r.tenant || '', String(r.status || '').replace(/_/g, ' ').toLowerCase(),
              String(r.occupancy_id || ''), daySpan_(num_(r.days_elapsed))],
      sev: r.status === 'CANNOT_MEASURE_OWNER_HELD' ? 'warn' : 'bad' };
  }).filter(function (r) { return !isAcked_(ackDep, r.key); })
    .sort(function (a, b) { return a.sort - b.sort; });
  U.push(block_('Deposits past the ' + CFG.DEPOSIT_DISPOSITION_DAYS + '-day standard', dep,
    ['Address', 'Resident', 'Status', 'Ref', 'Elapsed'],
    'To clear a row: add its Ref to the _acknowledgments tab under list "deposits". ' +
    'That hides it here only — it does not change AppFolio and does not satisfy a compliance ' +
    'obligation. CALIFORNIA: surface to counsel.', 'deposits', 'leasing'));

  // ---- 9. work orders open over 14 days ------------------------------------------
  var ackW = ackSet_('work_orders');
  var wo = dropTPO_(readTab_('Work_Orders').filter(function (r) {
    return !r.completed_on && !r.canceled_on && r.created_at;
  })).map(function (r) {
    var d = daysBetween_(r.created_at, t);
    return { days: d, sort: -(d || 0), pm: pmOf_(pm, r.property_id, r.unit_id),
      key: r.work_order_number || r.work_order_id, src: r, linkCol: 1,
      cells: [String(r.work_order_number || r.work_order_id || ''), addr_(r),
              r.vendor || 'no vendor', r.assigned_user || 'unassigned',
              String(r.job_description || '').slice(0, 60), daySpan_(d)],
      sev: d > 45 ? 'bad' : 'warn' };
  }).filter(function (r) { return r.days !== null && r.days > CFG.WORK_ORDER_AGING_DAYS &&
                                  !isAcked_(ackW, r.key); })
    .sort(function (a, b) { return a.sort - b.sort; });
  U.push(block_('Work orders open over ' + CFG.WORK_ORDER_AGING_DAYS + ' days', wo,
    ['WO #', 'Address', 'Vendor', 'Assigned', 'Job', 'Open'],
    'WO number matches AppFolio so you can open it directly. "No vendor" on an aged order is ' +
    'usually the reason it is aged.', 'workorders', 'maintenance', 'Work_Orders'));

  // ---- 10. under-market units nearing renewal ------------------------------------
  var rtm = dropTPO_(readTab_('Rent_To_Market')).map(function (r) {
    var d = r.lease_to ? daysBetween_(t, ymd_(r.lease_to)) : null;
    return { days: d, sort: d === null ? 9999 : d, pm: pmOf_(pm, r.property_id, r.unit_id), key: addr_(r), src: r,
      cells: [addr_(r), money_(r.rent) + ' vs ' + money_(r.market_rent), money_(r.gap) + '/mo',
              (r.gap_pct || '') + '%', d === null ? '—' : (d < 0 ? 'expired' : dayLabel_(d))],
      sev: d !== null && d <= 60 ? 'bad' : 'warn' };
  }).filter(function (r) { return r.days !== null && r.days >= 0 && r.days <= 120; })
    .sort(function (a, b) { return a.sort - b.sort; });
  U.push(block_('Under-market units renewing within 120 days', rtm,
    ['Address', 'Rent vs market', 'Monthly gap', 'Gap %', 'Lease ends'],
    'Source: rent_roll — actual rent against AppFolio market_rent (falling back to ' +
    'computed_market_rent), joined to the lease end date. Gap only. CALIFORNIA: any increase is ' +
    'governed by statute, local ordinance, and lease terms.', 'undermarket', 'renewals', 'Rent_To_Market'));

  // ---- 11. properties ending management ------------------------------------------
  var ackE = ackSet_('ending_mgmt');
  var seen = {};
  var ending = readTab_('Properties_Units').map(function (r) {
    var e = endingMgmt_(r);
    if (!e) return null;
    if (seen[r.property_id]) return null;
    seen[r.property_id] = true;
    var d = e.date ? daysBetween_(t, e.date) : null;
    return { days: d, sort: d === null ? 9999 : d, pm: pmOf_(pm, r.property_id, r.unit_id), key: addr_(r),
      src: r, overdue: d !== null && d < 0,
      cells: [addr_(r), e.date || 'no date in name', r.owners || '',
              // A property whose name carries no date has no countdown to show, and an
              // empty pill reads as "nothing to do" rather than "we cannot tell".
              d === null ? '—' : dayOverdue_(d)],
      sev: d === null ? 'warn' : (d < 0 ? 'bad' : 'warn') };
  }).filter(function (r) { return r && !isAcked_(ackE, r.key); })
    .sort(function (a, b) { return (b.overdue ? 1 : 0) - (a.overdue ? 1 : 0) || a.sort - b.sort; });
  var overdueN = ending.filter(function (r) { return r.overdue; }).length;
  U.push(block_('Properties ending management', ending,
    ['Address', 'Closure date', 'Owner', 'Timing'],
    'Detected from the naming convention: leading "z" plus a date in parentheses. ' +
    overdueN + ' past their date, ' + (ending.length - overdueN) + ' upcoming. ' +
    'Overdue first — a property past its closure date is still being managed and billed.',
    'ending_mgmt', 'leasing'));

  // ---- 12. upcoming move-outs -----------------------------------------------
  var mo = dropTPO_(readTab_('Tenant_Tickler').filter(isMoveOutEvent_)).map(function (r) {
    var d = daysBetween_(t, ymd_(r.move_out_date));
    return { days: d, sort: d, pm: pmOf_(pm, r.property_id, r.unit_id), key: addr_(r), src: r,
      cells: [addr_(r), r.tenant || '', ymd_(r.move_out_date) || '',
              r.move_out_reason || 'not recorded',
              dayLabel_(d)],
      sev: d <= 7 ? 'bad' : 'warn' };
  }).filter(function (r) { return r.days !== null && r.days >= 0 && r.days <= 60; })
    .sort(function (a, b) { return a.sort - b.sort; });
  U.push(block_('Move-outs in the next 60 days', mo,
    ['Address', 'Resident', 'Move-out', 'Reason', 'When'],
    'Reason drives retention analysis \u2014 "not recorded" on more than half of move-outs is ' +
    'signal being discarded. Start the pre-move-out inspection and deposit clock from here.',
    'moveout', 'leasing'));

  // Follow-ups the team committed to. Runs first so it sits at the top of the day.
  if (typeof followUpBlocks_ === 'function') {
    try { U = U.concat(followUpBlocks_(pm)); }
    catch (e) { logError_('dashboard', 'followUpBlocks_', e.message); }
  }

  // Collections — vendor bills, stalled approvals, owner shortfalls, former residents.
  if (typeof collectionsBlocks_ === 'function') {
    try { U = U.concat(collectionsBlocks_(pm)); }
    catch (e) { logError_('dashboard', 'collectionsBlocks_', e.message); }
  }

  // LeadSimple process adherence. Compliance work only — the owners pipeline is
  // reporting, not a worklist, because the selling happens in LeadSimple itself.
  if (typeof leadSimpleBlocks_ === 'function') {
    try { U = U.concat(leadSimpleBlocks_(pm)); }
    catch (e) { logError_('dashboard', 'leadSimpleBlocks_', e.message); }
  }

  // Utility billing schedule. Guarded: if Dashboard_Utilities_patch.gs is missing the
  // dashboard still renders and the failure lands in _errors instead of a blank page.
  if (typeof utilityScheduleBlocks_ === 'function') {
    try { U = U.concat(utilityScheduleBlocks_(pm)); }
    catch (e) { logError_('dashboard', 'utilityScheduleBlocks_', e.message); }
  }

  return U;
}

function block_(title, rows, headers, note, id, view, sourceTab) {
  // "Nothing outstanding" and "the source tab is empty" look identical on screen and
  // mean opposite things. Carry the source so the empty state can tell them apart.
  var srcRows = sourceTab ? readTab_(sourceTab).length : null;
  return { title: title, rows: rows, headers: headers, note: note, id: id,
           view: view || 'action', count: rows.length,
           sourceTab: sourceTab || null, sourceRows: srcRows };
}

// ============================================================ RENDER

function renderPage_(view) {
  var pm = pmLookup_();
  var U = urgencies_(pm);
  var pmInfo = pmList_(pm, U);
  var groups = pmInfo.groups;
  var log = readTab_('_refresh_log');
  var lastRun = log.length ? log[log.length - 1].run_at : 'not yet run';

  var h = ['<!DOCTYPE html><html><head><meta charset="utf-8">' +
    '<meta name="viewport" content="width=device-width,initial-scale=1">' + css_() +
    '</head><body>'];

  // FIRST FRAME. This is the whole of the perceived-speed work.
  //
  // Apps Script takes two to five seconds to hand over a page and nothing in this file
  // can change that. What it can change is what somebody looks at while it happens. The
  // skeleton is the first markup in the body, so the browser paints it on the first
  // frame it gets — before the 300 KB below has been parsed — and it removes itself once
  // the real page is wired up.
  //
  // It deliberately mirrors the LAYOUT rather than showing a spinner. A spinner says
  // "wait"; a shape says "your dashboard is arriving, and here is where things will be",
  // and the eye has already found the nav by the time the nav exists.
  h.push('<div id="boot"><div class="bwrap">' +
    '<div class="bar bhead"></div><div class="bar bnav"></div><div class="bar btool"></div>' +
    '<div class="bar bcard tall"></div><div class="bar bcard"></div><div class="bar bcard"></div>' +
    '</div></div>');
  h.push('<div class="wrap">');

  h.push(brandHeader_('<span class="asof">' + esc_(refreshLabel_(lastRun)) + '</span>' +
    adminBadge_()));
  // First thing under the header, because it changes what every button on the page does.
  h.push(readOnlyBanner_());

  // Sticky so the team can move between views from anywhere in a long list rather
  // than scrolling back to the top first.
  var lsOn = lsEnabled_();
  // ONE ROW, SCROLLED — not wrapped.
  //
  // Twelve tabs at a fixed 150px need 1,855px and the content column is 1,200px, so the
  // old flex-wrap nav was silently two rows tall on every screen anybody uses. That is
  // not just a look: --navh said 60px, the real height was 91px, and the sticky filter
  // bar was therefore parked 31px UNDERNEATH the nav with the sticky table headers off
  // by the same amount. It had been that way since the twelfth tab was added.
  //
  // A single scrolling row fixes the cause rather than the symptom: the height is now
  // constant no matter how many tabs exist, so the offsets cannot drift again. The
  // sliding indicator is one element that transforms, so switching views costs no
  // layout work regardless of how many tabs there are.
  h.push('<div class="navwrap"><nav class="tabs" id="navTabs" role="tablist" ' +
    'aria-label="Dashboard views"><span class="tabind" id="tabInd" aria-hidden="true"></span>');
  VIEWS.filter(function (v) {
    return lsOn || (v.id !== 'processes' && v.id !== 'pipeline');
  }).forEach(function (v) {
    var n = U.filter(function (b) { return b.view === v.id; })
             .reduce(function (s, b) { return s + b.count; }, 0);
    // The pipeline view holds no blocks, so the generic count is 0. Its badge is the
    // number people actually want to see without opening the tab.
    if (v.id === 'pipeline' && lsOn) {
      try {
        n = readTab_('LS_Deals').filter(function (d) {
          return d.is_active === 'YES' && d.is_stale === 'YES'; }).length;
      } catch (e) { n = 0; }
    }
    h.push('<button id="tab-' + v.id + '" class="tab" role="tab" tabindex="-1" ' +
      'aria-controls="view-' + v.id + '" aria-selected="false" ' +
      'onclick="show(\'' + v.id + '\')">' +
      '<span class="tabl">' + esc_(v.label) + '</span>' +
      (v.id !== 'action' && v.id !== 'performance' && n
        ? '<span class="tabn">' + n + '</span>' : '') + '</button>');
  });
  h.push('</nav></div>');

  // Filters are shared across every operational view.
  h.push('<div class="toolbar"><div class="tool"><label>Manager</label>' +
    '<select id="pmSel" onchange="applyFilters()"><option value="">All managers</option>');
  groups.forEach(function (g) { h.push('<option value="' + esc_(g) + '">' + esc_(g) + '</option>'); });
  h.push('</select></div><div class="tool grow"><label>Search</label>' +
    '<input id="q" type="search" placeholder="Address or resident\u2026" oninput="applyFilters()"></div>' +
    '<button class="ghost" onclick="toggleAll()" id="collapseBtn">Collapse all</button>' +
    '<span id="pmCount" class="muted small"></span></div>');
  if (typeof masterUnits_ === 'function') {
