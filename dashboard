      h.push('<div class="coverage">Market rent on active units exceeds rent currently charged by ' +
        '<strong>' + money_(s.revenue_gap) + '</strong> a month. That gap is vacancy, ' +
        'non-revenue units, and under-market leases combined \u2014 not a single fixable number.</div>');
    }
