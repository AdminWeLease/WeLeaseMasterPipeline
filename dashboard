  // A block whose view id does not match a rendered view is built, filtered out, and
  // never seen — which is exactly how "Leases expiring within 120 days" stayed invisible
  // across three sessions. Catch it loudly instead.
  var knownViews = {};
  VIEWS.forEach(function (v) { knownViews[v.id] = true; });
  var orphaned = U.filter(function (b) { return !knownViews[b.view]; });
  if (orphaned.length) {
