    '<div class="hero-foot muted">of ' + deals.length + ' total</div></div>');
  h.push('<div class="hero-card ' + (stale.length > active.length / 2 ? 'bad' : 'ok') + '">' +
    '<div class="hero-label">Gone quiet</div><div class="hero-value">' + stale.length + '</div>' +
    '<div class="hero-foot muted">' +
    (active.length ? Math.round(stale.length / active.length * 100) : 0) +
    '% of active, no contact recently</div></div>');
  h.push('<div class="hero-card ' + (noTask.length ? 'ok' : 'good') + '">' +
    '<div class="hero-label">No next step</div><div class="hero-value">' + noTask.length + '</div>' +
    '<div class="hero-foot muted">active, nothing scheduled</div></div>');
  h.push('<div class="hero-card ' + (winPct === null ? '' : (winPct >= 50 ? 'good' : 'ok')) + '">' +
    '<div class="hero-label">Win rate</div><div class="hero-value">' +
    (winPct === null ? '—' : winPct) + '<span class="hero-unit">%</span></div>' +
    '<div class="hero-foot muted">' + won + ' won of ' + (won + lost) + ' decided</div></div>');
  h.push('</div>');

  h.push('<div class="coverage">Open the live board in ' +
    '<a class="af" href="' + LS_OWNERS_PIPELINE_URL + '" target="_blank" rel="noopener">' +
    'LeadSimple</a> to work these — this view reports, LeadSimple records. ' +
    'Win rate counts <strong>won ÷ (won + lost)</strong>. ' +
    'Deals sitting in nurture, passive or past are excluded from the denominator on ' +
    'purpose — a deal nobody has decided on yet is not a loss, and counting it as one ' +
    'would understate the rate badly.</div>');

  // The list first. The funnel is context; this is the work.
  h.push('<section class="card"><div class="card-head"><h2>Active deals that have gone quiet' +
    '<span class="count">' + stale.length + '</span></h2></div>');
  if (!stale.length) {
    h.push('<p class="empty">Every active deal has been touched recently.</p>');
  } else {
    h.push('<p class="note">Active in the pipeline, but no call, email or inbound contact ' +
      'recorded recently. Ordered by how long they have been quiet. This is reporting only ' +
      '— work them in LeadSimple, which is where the next step gets recorded.</p>');
    h.push('<table class="listtbl"><thead><tr><th>Deal</th><th>Contact</th><th>Owner</th>' +
      '<th>Stage</th><th class="num">Units</th><th>Next step</th>' +
      '<th class="num">Quiet for</th></tr></thead><tbody>');
    stale.slice().sort(function (a, b) {
      var x = num_(a.days_since_last_touch), y = num_(b.days_since_last_touch);
      if (x === null) return -1;
      if (y === null) return 1;
      return y - x;
    }).slice(0, 100).forEach(function (d) {
      var q = num_(d.days_since_last_touch);
      var tone = (q === null || q > 30) ? 'bad' : 'warn';
      var next = d.next_task_due
        ? (num_(d.next_task_days_overdue) > 0
            ? '<span class="tag bad">' + esc_(dayLabel_(-num_(d.next_task_days_overdue))) + '</span>'
            : esc_(d.next_task_due))
        : '<span class="tag warn">none scheduled</span>';
      h.push('<tr><td class="strong">' +
        (d.link ? '<a class="af" href="' + esc_(d.link) + '" target="_blank">' +
           esc_(d.deal_name || 'Deal') + '</a>' : esc_(d.deal_name || 'Deal')) + '</td>' +
        '<td class="muted">' + esc_(d.contact || d.company || '') + '</td>' +
        '<td class="muted">' + esc_(d.assignee || 'nobody') + '</td>' +
        '<td class="muted">' + esc_(d.stage || '') + '</td>' +
        '<td class="num">' + (num_(d.num_units) || '') + '</td>' +
        '<td>' + next + '</td>' +
        '<td class="num"><span class="tag cell ' + tone + '">' +
        (q === null ? 'no contact yet' : esc_(daySpan_(q))) + '</span></td></tr>');
    });
    h.push('</tbody></table>');
    if (stale.length > 100) {
      h.push('<p class="muted small">Showing 100 of ' + stale.length + '.</p>');
    }
    if (never.length) {
      h.push('<p class="warnrow">' + never.length + ' active deal' +
        (never.length === 1 ? ' has' : 's have') + ' never been contacted at all. Those are ' +
        'the ones where the first touch is still the missing step.</p>');
    }
  }
  h.push('</section>');

  h.push(lsPipelineWorkload_());

  if (funnel.length) {
    var maxN = funnel.reduce(function (a, r) { return Math.max(a, num_(r.deals) || 0); }, 0) || 1;
    h.push('<section class="card"><h2>Deals by stage</h2>');
    h.push('<p class="note">Every deal on record, including closed and nurture. Context for ' +
      'the list above rather than a worklist of its own.</p>');
    funnel.forEach(function (r) {
      var n = num_(r.deals) || 0;
      var st = String(r.stage_status || '');
      var tone = st === 'won' ? 'good' : (st === 'lost' ? 'bad' :
                 (st === 'active' ? 'neutral' : 'neutral'));
      h.push('<div class="frow"><span class="flabel">' + esc_(r.stage || 'No stage') +
        '<span class="muted"> · ' + esc_(st || 'unknown') + '</span></span>' +
        '<span class="ftrack"><span class="ffill ' + tone + '" style="width:' +
        Math.max(2, n / maxN * 100).toFixed(1) + '%"></span></span>' +
        '<span class="fval">' + n + '</span></div>');
    });
    h.push('</section>');
  }

  return h.join('');
}

