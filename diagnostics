  '2025-11': 1101340.13, '2025-12': 1089109.97, '2026-01': 1090372.50,
  '2026-02': 1097738.69, '2026-03': 1091388.79, '2026-04': 1087419.48,
  '2026-05': 1127352.22, '2026-06': 1124257.45, '2026-07': 1119990.85
};
var CASHFLOW_BASELINE_SUB = {
  '2025-08': 19166, '2025-09': 19166, '2025-10': 19171, '2025-11': 19171,
  '2025-12': 35726, '2026-01': 23006, '2026-02': 22885, '2026-03': 21262,
  '2026-04': 12141, '2026-05': 17106, '2026-06': 17356, '2026-07': 17356
};

function reconcileRentIncome() {
  var gl = readTab_('Rent_Income_GL').filter(function (r) { return r.month; });
  var out = ['--- OUR LEDGER FIGURE vs APPFOLIO\'S CASH FLOW STATEMENT ---', ''];
  if (!gl.length) {
    out.push('Rent_Income_GL is empty. Run buildRentIncomeGL(), then this again.');
    Logger.log(out.join('\n'));
    return out.join('\n');
  }

  var ours = {};
  gl.forEach(function (r) { ours[monthNorm_(r.month)] = num_(r.rent_income); });

  out.push('Baseline: the 12-month cash flow exported 2026-08-19. 4100 + 4105.');
  out.push('');
  out.push('month      AppFolio        ours        difference');
  var worst = 0, checked = 0, missing = [], offenders = [], pcts = [], diffs = [];
  Object.keys(CASHFLOW_BASELINE_2026).sort().forEach(function (m) {
    var want = CASHFLOW_BASELINE_2026[m] + (CASHFLOW_BASELINE_SUB[m] || 0);
    var got = ours[m];
    if (got === null || got === undefined) {
      missing.push(m);
      out.push('  ' + m + money_(Math.round(want)).padStart(14) + '            —' +
               '          not pulled');
      return;
    }
    checked++;
    var diff = got - want;
    var pct = Math.abs(diff) / want * 100;
    if (pct > worst) worst = pct;
    pcts.push(pct);
    diffs.push({ m: m, pct: pct, want: want, got: got, sign: diff < 0 ? -1 : (diff > 0 ? 1 : 0) });
    if (pct > 2) offenders.push({ m: m, pct: pct, want: want, got: got });
    out.push('  ' + m + money_(Math.round(want)).padStart(14) +
             money_(Math.round(got)).padStart(14) +
             (diff >= 0 ? '  +' : '  ') + money_(Math.round(diff)) +
             (pct > 2 ? '   <<< off by ' + pct.toFixed(1) + '%' : ''));
  });

  out.push('');
  if (!checked) {
    out.push('>> No overlapping month. Widen INCOME_GL.MONTHS or check the pull window.');
  } else if (worst <= 2) {
    out.push('>> AGREES within ' + worst.toFixed(1) + '% on all ' + checked + ' month(s).');
    out.push('   The ledger figure on the dashboard is the same number your accountant reads.');
  } else {
    // READ THE SHAPE, DO NOT LIST THE POSSIBILITIES.
    //
    // This used to end with "either an account is missing or the window clipped a month",
    // which is two guesses dressed as a finding — and it sent the last round of this
    // looking at the account configuration when the accounts were fine.
    //
    // The two causes look nothing alike, and the tell is DIRECTION plus SPREAD:
    //
    //   A MISSING ACCOUNT is short in every month, in the same direction, by a similar
    //   proportion — because an account does not appear and disappear month to month.
    //   It can be small: dropping subsidised rent is under 2% here, which is why a
    //   threshold-based test misses it entirely.
    //
    //   A CLIPPED WINDOW is one month, at the edge of the range, wrong by a lot —
    //   because 93% of this portfolio's rent posts on the 1st, so a month missing its
    //   first day comes back at single digits of itself.
    //
    //   ORDINARY DRIFT goes both ways and stays small.
    //
    // The direction test runs over EVERY month, not just the ones past a threshold.
    var months = Object.keys(CASHFLOW_BASELINE_2026).sort();
    var edge = [months[0], months[months.length - 1]];
    var big = offenders.filter(function (o) { return o.pct > 25; });

    var neg = diffs.filter(function (d) { return d.sign < 0; }).length;
    var pos = diffs.filter(function (d) { return d.sign > 0; }).length;
    var oneWay = (neg === checked || pos === checked) && checked >= 4;
    var medPct = median_(pcts.slice()) || 0;

    if (big.length && big.every(function (o) { return edge.indexOf(o.m) > -1; })) {
      out.push('>> ONE MONTH IS CLIPPED, THE REST AGREE. This is a window boundary, not a');
      out.push('   configuration problem — the accounts are right.');
      big.forEach(function (o) {
        out.push('   ' + o.m + ' returned ' + Math.round(o.got / o.want * 100) +
                 '% of the month. It sits at the ' +
                 (o.m === edge[0] ? 'START' : 'END') + ' of the pull window.');
      });
      out.push('   Rent posts on the 1st here, so a window beginning on the 2nd loses almost');
      out.push('   the entire month. buildRentIncomeGL now starts the window on the 1st of a');
      out.push('   month rather than counting back in days.');
      out.push('   FIX: re-run buildRentIncomeGL(). The clipped month should come back whole.');
      var rest = pcts.filter(function (x) { return x <= 25; });
      if (rest.length) {
        out.push('   The other ' + rest.length + ' month(s) agree within ' +
                 Math.max.apply(null, rest).toFixed(1) + '%, which is normal ledger drift.');
      }
    } else if (oneWay && neg === checked) {
      out.push('>> EVERY MONTH IS SHORT, none over, median ' + medPct.toFixed(1) + '%.');
      out.push('   That is an income account missing from INCOME_GL.ACCOUNTS — an account');
      out.push('   cannot come and go month to month. Note it does NOT need to be a large');
      out.push('   gap: dropping subsidised rent alone is under 2%.');
      out.push('   FIX: run discoverGlAccounts(35) and add whatever 4-series account carries');
      out.push('   the difference. Both known ids should be set: 4100 = 27, 4105 = 28.');
    } else if (oneWay && pos === checked) {
      out.push('>> EVERY MONTH IS OVER, none under, median ' + medPct.toFixed(1) + '%.');
      out.push('   An account is being counted that the statement excludes, or the basis is');
      out.push('   wrong. INCOME_GL.BASIS is currently ' + INCOME_GL.BASIS + '.');
      out.push('   FIX: run discoverGlAccounts(35) and check nothing beyond 4100/4105 resolves.');
    } else {
      out.push('>> DISAGREES by up to ' + worst.toFixed(1) + '%: ' + neg + ' month(s) short, ' +
               pos + ' over, median ' + medPct.toFixed(1) + '%.');
      out.push('   Not a missing account — that would be short in every month. Not a clipped');
      out.push('   window — that would be one month at the edge. Most likely posting-date');
      out.push('   differences between the accrual ledger and the exported statement.');
      if (offenders.length) {
        out.push('   Worst: ' + offenders.slice(0, 3).map(function (o) {
          return o.m + ' ' + (o.got > o.want ? '+' : '') +
                 Math.round(o.got - o.want); }).join(', '));
      }
    }
  }
  if (missing.length) {
    out.push('   Not pulled: ' + missing.join(', ') + '. INCOME_GL.MONTHS is ' +
             INCOME_GL.MONTHS + '.');
  }
  Logger.log(out.join('\n'));
  return out.join('\n');
}
