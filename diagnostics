// ============================================================ 5. TARGETED DIAGNOSTICS

// ============================================================ A. DEPOSIT FLOW

/**
 * Takes recent move-outs and pulls EVERY general ledger entry for those
 * occupancies across ALL accounts — not just the deposit accounts we assumed.
 * Wherever the deposit money actually goes, this finds it.
 */
function diagnoseDepositFlow() {
  var t0 = new Date().getTime();
  var from = ymd_(addDays_(today_(), -180));
  var to   = ymd_(today_());
  var out  = [];

  // 1. Recent move-outs
  var tick = afReport_('tenant_tickler', { occurred_on_from: from, occurred_on_to: to });
  sleepFor_('appfolio');
  var moveOuts = getMoveOuts_(tick);
  finding_(out, 'deposit', 'Move-outs in window',
    moveOuts.length + ' between ' + from + ' and ' + to +
    ' (tenant_tickler returned ' + tick.length + ' rows)', null);

  if (!moveOuts.length) {
    finding_(out, 'deposit', 'ABORTED — no move-outs matched',
      'None of the ' + tick.length + ' tickler rows qualified as a move-out.',
      'Run diagnoseTicklerEvents() to see the real event values.');
    writeTab_('_deposit_diagnostic', out, { headers: ['system','question','answer','action_required','discovered_at'] });
    return out;
  }

  // 2. SAMPLE SELECTION — this is where the 2026-08-05 run went wrong.
  //    Taking the 8 MOST RECENT move-outs selected residents who had only just left,
  //    plus scheduled future-dated move-outs. Nothing had been disposed yet, so every
  //    traced entry fell before the move-out date and the diagnostic learned nothing.
  //
  //    Correct window: move-outs SETTLED long enough ago that a disposition should
  //    exist, but recent enough to sit inside the GL pull. 30 to 150 days back.
  var todayStr = ymd_(today_());
  var windowEnd   = ymd_(addDays_(today_(), -30));    // at least 30d elapsed
  var windowStart = ymd_(addDays_(today_(), -150));

  var future = moveOuts.filter(function (m) { return ymd_(m.move_out_date) > todayStr; });
  if (future.length) {
    finding_(out, 'deposit', 'Future-dated move-outs excluded',
      future.length + ' rows have a move_out_date after today — scheduled, not completed.',
      'Expected. Noting it so the count is not mistaken for missing data.');
  }

  var settled = moveOuts.filter(function (m) {
    var d = ymd_(m.move_out_date);
    return d && d <= windowEnd && d >= windowStart;
  }).sort(function (a, b) { return ymd_(a.move_out_date) < ymd_(b.move_out_date) ? 1 : -1; });

  finding_(out, 'deposit', 'Settled move-outs available',
    settled.length + ' with a move_out_date between ' + windowStart + ' and ' + windowEnd,
    settled.length ? null : 'None in range — widen the window and re-run.');

  if (!settled.length) {
    writeTab_('_deposit_diagnostic', out, { headers: ['system','question','answer','action_required','discovered_at'] });
    return out;
  }

  var recent = settled.slice(0, 10);
  finding_(out, 'deposit', 'Sample move-out dates',
    recent.map(function (m) { return ymd_(m.move_out_date); }).join(' · '),
    'Every one of these should have a disposition by now.');

  var propIds = [], occIds = {};
  recent.forEach(function (m) {
    occIds[m.occupancy_id] = ymd_(m.move_out_date);
    if (m.property_id && propIds.indexOf(m.property_id) === -1) propIds.push(m.property_id);
  });
  finding_(out, 'deposit', 'Tracing',
    recent.length + ' settled move-outs across ' + propIds.length + ' properties · ids: ' + propIds.join(', '), null);

  // properties is an object with additive sub-fields
  var gl = afReport_('general_ledger', {
    posted_on_from: ymd_(addDays_(today_(), -200)),
    posted_on_to: ymd_(addDays_(today_(), 1)),
    properties: { properties_ids: propIds }
  }, { maxPages: 10 });
  sleepFor_('appfolio');
  finding_(out, 'deposit', 'GL entries for those properties', gl.length, null);

  // 3. Every entry for those occupancies, across ALL accounts
  var traced = gl.filter(function (e) {
    return String(e.party_type || '') === 'Occupancy' && occIds[e.party_id];
  }).map(function (e) {
    return {
      occupancy_id: e.party_id, party_name: e.party_name,
      move_out_date: occIds[e.party_id], post_date: ymd_(e.post_date),
      days_after_move_out: daysBetween_(occIds[e.party_id], ymd_(e.post_date)),
      account_id: e.account_id, account_name: e.account_name,
      txn_type: e.type, debit: num_(e.debit), credit: num_(e.credit),
      bank_account: e.bank_account, description: e.description, reference: e.reference
    };
  }).sort(function (a, b) {
    if (a.occupancy_id !== b.occupancy_id) return a.occupancy_id - b.occupancy_id;
    return a.post_date < b.post_date ? -1 : 1;
  });

  writeTab_('_deposit_trace', traced.length ? traced : [{ note: 'no GL entries matched these occupancies' }]);
  finding_(out, 'deposit', 'Traced GL entries', traced.length + ' → _deposit_trace tab',
    'READ THIS TAB. Find rows where post_date is AFTER move_out_date. The account_name ' +
    'and txn_type on those rows is what stops the deposit clock.');

  var post = traced.filter(function (r) { return r.days_after_move_out !== null && r.days_after_move_out >= 0; });
  finding_(out, 'deposit', 'GL entries AFTER move-out', post.length + ' of ' + traced.length + ' traced',
    post.length ? null : 'ZERO — no ledger activity at all after these residents left. Widen the window or check whether move-out accounting is posted elsewhere.');
  finding_(out, 'deposit', 'Accounts active AFTER move-out',
    post.length ? distinctWithCounts_(post, 'account_name', 30) : '(none)',
    post.length ? 'The disposition account is in this list.' : null);
  finding_(out, 'deposit', 'Transaction types AFTER move-out',
    post.length ? distinctWithCounts_(post, 'txn_type', 30) : '(none)',
    post.length ? 'The disposition transaction type is in this list.' : null);
  finding_(out, 'deposit', 'Days-after-move-out spread',
    post.length ? ('min ' + Math.min.apply(null, post.map(function (r) { return r.days_after_move_out; })) +
                   ' · max ' + Math.max.apply(null, post.map(function (r) { return r.days_after_move_out; }))) : '(none)',
    null);

  // 4. Debits vs credits on the deposit liability accounts specifically
  var depIds = DEPOSIT_GL.MGMT_HELD.concat(DEPOSIT_GL.OWNER_HELD);
  var dep = gl.filter(function (e) { return depIds.indexOf(e.account_id) !== -1; });
  var debits = dep.filter(function (e) { return num_(e.debit) > 0; });
  finding_(out, 'deposit', 'Deposit liability — debits vs credits',
    debits.length + ' debits (money out) · ' +
    dep.filter(function (e) { return num_(e.credit) > 0; }).length + ' credits (money in)',
    debits.length === 0
      ? 'ZERO DEBITS. Deposits are never reduced through these accounts for these properties. ' +
        'Check _deposit_trace for the real path, then ask AppFolio support how security deposit ' +
        'refunds post for this tenant.'
      : 'Debits exist — their txn_type is the clock stop.');
  if (debits.length) {
    finding_(out, 'deposit', 'Debit transaction types', distinctWithCounts_(debits, 'type', 20), null);
  }

  writeTab_('_deposit_diagnostic', out, { headers: ['system','question','answer','action_required','discovered_at'] });
  logRun_('diagnoseDepositFlow', 'appfolio', '_deposit_trace', traced.length, new Date().getTime() - t0, null);
  return out;
}

