// ============================================================ REPAIRS

/**
 * Blanks the literal text "null" that appendTab_ used to write.
 *
 * typeof null === 'object', so the old mapper sent it to JSON.stringify and produced a
 * four-character string. Every appendTab_ tab carries them. Re-pulling would fix it,
 * but LS_Tasks_Completed alone is an hour, so this repairs in place.
 *
 * Deliberately narrow: only the exact string "null", only in tabs written by appendTab_.
 * A cell that legitimately reads "null" as a word would be a false positive, which is
 * why this is a hand-run repair and not something readTab_ does silently on every read.
 */
function repairNullText() {
  var TABS = ['Metrics_History', 'LS_Tasks_All', 'LS_Tasks_Completed', 'Portfolio_Summary_History',
              'SM_High_Level_History', 'Collections_History', 'Insurance_History',
              'Item_Status_Log', 'Throughput'];
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var out = [], grand = 0;

  TABS.forEach(function (name) {
    var sh = ss.getSheetByName(name);
    if (!sh || sh.getLastRow() < 2) { out.push('  ' + name + ': not present or empty'); return; }
    var rng = sh.getDataRange();
    var vals = rng.getValues();
    var hits = 0;
    for (var r = 1; r < vals.length; r++) {
      for (var c = 0; c < vals[r].length; c++) {
        if (vals[r][c] === 'null') { vals[r][c] = ''; hits++; }
      }
    }
    if (hits) { rng.setValues(vals); invalidateTab_(name); }
    grand += hits;
    out.push('  ' + name + ': ' + hits + ' cell(s) cleared of ' +
             ((vals.length - 1) * (vals[0] || []).length) + ' checked');
  });

  var text = 'Cleared ' + grand + ' literal "null" cells.\n' + out.join('\n') +
             '\n\nappendTab_ no longer writes them. This is a one-off.';
  Logger.log(text);
  return text;
}

// ============================================================ LEADSIMPLE PROBE

/**
 * What a completed task ACTUALLY looks like.
 *
 * lsCompletedTaskRow_ reads t.step.name and t.skipped because the registry says
 * Task.step and Task.skipped. Across 68,000 tasks both came back empty for every
 * single row, which means either the fields are named differently, or they are not
 * returned on the list endpoint at all.
 *
 * I got this wrong the same way twice now — writing extraction against a registry's
 * description instead of the payload. This prints the payload.
 *
 * PII: values are shown as types and lengths, not contents, except for the small set
 * of structural fields the metrics need.
 */
function lsProbeTask(sampleSize) {
  if (!systemEnabled_('leadsimple')) return 'LeadSimple is disabled.';
  var n = sampleSize || 50;
  var res = lsGet2_('/tasks', { due_type: 'completed', per_page: n, page: 1 }, n);
  var rows = (res && (res.data || res.results || res)) || [];
  if (!Array.isArray(rows) || !rows.length) {
    Logger.log('No completed tasks returned.');
    return 'none';
  }

  var out = [];
  out.push('Sampled ' + rows.length + ' completed task(s).');
  out.push('');
  out.push('--- TOP-LEVEL KEYS ---');
  var keys = {};
  rows.forEach(function (t) { Object.keys(t).forEach(function (k) { keys[k] = 1; }); });
  Object.keys(keys).sort().forEach(function (k) {
    var v = null;
    for (var i = 0; i < rows.length && v === null; i++) {
      if (rows[i][k] !== null && rows[i][k] !== undefined) v = rows[i][k];
    }
    var t = v === null ? 'always null' : (Array.isArray(v) ? 'array' : typeof v);
    var hint = '';
    if (v && typeof v === 'object' && !Array.isArray(v)) {
      hint = '  { ' + Object.keys(v).join(', ') + ' }';
    }
    out.push('  ' + k.padEnd(22) + t.padEnd(14) + hint);
  });

  out.push('');
  out.push('--- FIELD COVERAGE ACROSS THE SAMPLE ---');
  out.push('Counting how many of the ' + rows.length + ' carry a usable value. A field that is');
  out.push('merely null in a small sample is NOT absent — reporting it that way is how the');
  out.push('first version of this probe misread process and auto_send_error.');
  [['step', 'step label for the onboarding and renewal durations'],
   ['skipped', 'skipped_step_rate'],
   ['auto_send', 'automation_failure_rate'],
   ['auto_send_error', 'automation_failure_rate'],
   ['completed_at', 'every duration'],
   ['process', 'process type and created/closed dates'],
   ['deal', 'tasks attached to a deal rather than a process']
  ].forEach(function (pair) {
    var k = pair[0];
    var filled = rows.filter(function (t) {
      return t[k] !== undefined && t[k] !== null && t[k] !== '';
    }).length;
    // For a boolean, "present on every row" says nothing — false is present. Report
    // how many are actually TRUE, or the field looks universal when it is never set.
    var isBool = rows.some(function (t) { return typeof t[k] === 'boolean'; });
    var extra = isBool
      ? '   (' + rows.filter(function (t) { return t[k] === true; }).length + ' true)'
      : '';
    out.push('  ' + String(filled).padStart(4) + '/' + rows.length + '  ' +
             k.padEnd(18) + pair[1] + extra);
  });

  // The step object has no name field. Show what it does have.
  var withStep = rows.filter(function (t) { return t.step; });
  if (withStep.length) {
    out.push('');
    out.push('--- WHAT A STEP LOOKS LIKE ---');
    out.push('  keys: ' + Object.keys(withStep[0].step).join(', '));
    out.push('  there is no "name" — the label is description, with kind as a fallback');
    withStep.slice(0, 5).forEach(function (t) {
      out.push('    description: ' + JSON.stringify(t.step.description) +
               '   kind: ' + JSON.stringify(t.step.kind) +
               '   order: ' + JSON.stringify(t.step.sort_order));
    });
  }

  // Is a zero skip rate real, or does due_type=completed exclude skipped tasks?
  out.push('');
  out.push('--- IS ANYTHING EVER SKIPPED? ---');
  var skippedHere = rows.filter(function (t) { return t.skipped === true; }).length;
  out.push('  completed sample: ' + skippedHere + ' of ' + rows.length + ' skipped');
  try {
    var alt = lsGet2_('/tasks', { per_page: n, page: 1 }, n);
    var altRows = (alt && (alt.data || alt.results || alt)) || [];
    var altSkipped = altRows.filter(function (t) { return t.skipped === true; }).length;
    out.push('  unfiltered sample: ' + altSkipped + ' of ' + altRows.length + ' skipped');
    if (!skippedHere && altSkipped) {
      out.push('  >> Skipped tasks exist but do NOT appear under due_type=completed.');
      out.push('     skipped_step_rate cannot be measured from the completed set — it needs');
      out.push('     the unfiltered pull. Tell me and I will change the seed.');
    } else if (!skippedHere && !altSkipped) {
      out.push('  >> No skipped task in either sample. A zero rate may simply be true,');
      out.push('     but a wider sample would settle it: lsProbeTask(200).');
    }
  } catch (e) {
    out.push('  unfiltered probe failed: ' + e.message);
  }

  out.push('');
  out.push('--- WHAT IS time_to_first_touch MEASURED FROM? ---');
  out.push('The first version of this check compared it only against created_at ->');
  out.push('first_contacted_at and reported UNCLEAR at a median ratio of 23.4. That ruled');
  out.push('out every unit but could not say why. This tests several baselines, and looks');
  out.push('at the SPREAD as well as the median — a real relationship is tight.');
  try {
    var dl = lsGet2_('/pipelines/' + LS.OWNERS_PIPELINE_ID + '/deals',
                     { per_page: 100, page: 1 }, 100);
    var deals = (dl && (dl.data || dl.results || dl)) || [];
    var secs = function (a, b) {
      if (!a || !b) return null;
      var t = (new Date(b).getTime() - new Date(a).getTime()) / 1000;
      return isFinite(t) && t >= 0 ? t : null;
    };
    var BASELINES = [
      ['created_at', 'first_contacted_at'],
      ['last_assigned_at', 'first_contacted_at'],
      ['created_at', 'last_emailed_at'],
      ['created_at', 'last_called_at']
    ];
    BASELINES.forEach(function (b) {
      var rs = [];
      deals.forEach(function (d) {
        var v = num_(d.time_to_first_touch);
        if (!v) return;
        var e = secs(d[b[0]], d[b[1]]);
        if (e === null || e <= 0) return;
        rs.push(e / v);
      });
      if (!rs.length) { out.push('  ' + b[0] + ' -> ' + b[1] + ': no comparable deals'); return; }
      rs.sort(function (x, y) { return x - y; });
      var med = rs[Math.floor(rs.length / 2)];
      var q1 = rs[Math.floor(rs.length * 0.25)], q3 = rs[Math.floor(rs.length * 0.75)];
      // A genuine unit conversion is the SAME multiple on every record. Wide spread
      // means the two things are not measuring the same interval at all.
      var tight = q1 > 0 && (q3 / q1) < 1.3;
      out.push('  ' + (b[0] + ' -> ' + b[1]).padEnd(40) +
               'n=' + String(rs.length).padStart(3) +
               '  median ' + (Math.round(med * 100) / 100) +
               '  q1-q3 ' + (Math.round(q1 * 100) / 100) + '-' + (Math.round(q3 * 100) / 100) +
               (tight ? '   <- TIGHT, this is the baseline' : '   (scattered)'));
    });
    out.push('');
    out.push('  A tight ratio near 1 means seconds, 60 means minutes, 3600 means hours.');
    out.push('  Scattered on every baseline means the field is derived some other way, and');
    out.push('  lead_first_touch_speed is right to compute its own from the timestamps.');
    out.push('  Nothing published reads the vendor field — it is stored raw for comparison.');
  } catch (e) {
    out.push('  probe failed: ' + e.message);
  }
  var text = out.join('\n');
  Logger.log(text);
  return text;
}

// ============================================================ RENT COLLECTION

/**
 * Why is a month's collections so far below what was charged?
 *
 * $315,152 collected against $1,020,731 charged is 31%. Either most receipts are
 * missing, or "collected" is not counting what it looks like it counts. This separates
 * the possibilities instead of guessing between them.
 */
function diagnoseRentCollection() {
  var out = [];
  var raw = readTab_('Receivables_Activity');
  var rec = inScopeIncludingInactive_(raw);
  var rr = dropTPO_(readTab_('Rent_Roll'));

  out.push('Receivables_Activity rows: ' + raw.length +
           '  (in scope: ' + rec.length + ', dropped by scope: ' + (raw.length - rec.length) + ')');
  out.push('Rent_Roll rows: ' + rr.length);
  out.push('');

  if (!raw.length) {
    out.push('The tab is EMPTY. Run rebuildFinancials().');
    Logger.log(out.join('\n'));
    return out.join('\n');
  }

  // Did the pull cover the window it asked for?
  var dates = raw.map(function (r) { return ymd_(r.txn_receipt_date); })
                 .filter(function (d) { return d; }).sort();
  out.push('--- WINDOW ---');
  out.push('requested: ' + ymd_(addDays_(today_(), -365)) + ' to ' + ymd_(today_()));
  out.push('received : ' + dates[0] + ' to ' + dates[dates.length - 1]);
  if (dates[0] > ymd_(addDays_(today_(), -350))) {
    out.push('>> The earliest receipt is well inside the requested window. The pull was');
    out.push('   probably truncated — check _errors for maxRows or maxPages on');
    out.push('   receivables_activity.');
  }

  // What the TAB actually holds, cell by cell, beside what the source says it should.
  // The tile disagreeing with this diagnostic is the whole reason this section exists:
  // the diagnostic recomputes from Receivables_Activity, the tile reads Rent_Collection,
  // and until you can see both there is no way to tell which one is wrong.
  out.push('');
  out.push('--- WHAT Rent_Collection ACTUALLY HOLDS ---');
  var tab = readTab_('Rent_Collection');
  if (!tab.length) {
    out.push('EMPTY — run rebuildPortfolio(). The tile has nothing to read.');
  } else {
    out.push('month cells come back as: ' + tab.map(function (r) {
      return Object.prototype.toString.call(r.month).replace(/\[object |\]/g, '');
    }).filter(function (t, i, a) { return a.indexOf(t) === i; }).join(', ') +
    '   (String means the format held; Date means Sheets coerced it and monthNorm_ is ' +
    'doing the repairing)');
    out.push('');
    out.push('raw cell        monthNorm_   label          collected      part?   paying HH   $/HH');
    tab.forEach(function (r) {
      var key = monthNorm_(r.month);
      var co = num_(r.rent_collected);
      var hh = num_(r.households_paying);
      var per = (co && hh) ? Math.round(co / hh) : null;
      out.push(String(r.month).slice(0, 15).padEnd(16) + String(key).padEnd(13) +
               String(monthLabel_(key)).padEnd(15) + String(co === null ? '—' : money_(co)).padEnd(15) +
               String(r.is_partial === 'YES' ? 'YES' : '').padEnd(8) +
               String(hh === null ? '—' : String(hh)).padEnd(12) +
               (per === null ? '—' : money_(per)) +
               // A complete month collecting under a single month's rent per paying
               // household is a part-month wearing a full month's label.
               ((per !== null && per < 1200 && r.is_partial !== 'YES') ? '   <<< SUSPECT' : ''));
    });
    out.push('');
    var nowKey = monthNorm_(ymd_(today_()));
    var comp = tab.map(function (r) { return { k: monthNorm_(r.month), r: r }; })
                  .filter(function (x) { return x.k && x.r.is_partial !== 'YES' && x.k < nowKey; })
                  .sort(function (a, b) { return a.k < b.k ? -1 : 1; });
    var pick = comp.length ? comp[comp.length - 1] : null;
    out.push('The tile will show: ' + (pick
      ? money_(num_(pick.r.rent_collected)) + ' labelled ' + monthLabel_(pick.k)
      : 'nothing — no complete month in the tab'));
    out.push('Today is ' + ymd_(today_()) + ', so the current month key is ' + nowKey + '.');
  }

  // Is the running month actually behind, or does it just look that way because it is not
  // over? Comparing a part month against whole months is the mistake that started all of
  // this. The only fair comparison is the SAME DAY OF MONTH in previous months.
  out.push('');
  out.push('--- IS THIS MONTH BEHIND? (same day of month, like for like) ---');
  var todayYmd = ymd_(today_());
  var dom = Number(todayYmd.slice(8, 10));
  out.push('Today is day ' + dom + ' of the month, so each row below counts only receipts');
  out.push('dated on or before day ' + dom + ' of ITS month.');
  out.push('');
  out.push('month     receipts   households        $ by day ' + dom + '     full month');
  var sameDay = {}, fullMonth = {};
  rec.forEach(function (r) {
    var d = ymd_(r.txn_receipt_date);
    var a = num_(r.txn_amount);
    if (!d || a === null) return;
    var m = monthNorm_(d);
    var day = Number(d.slice(8, 10));
    var f = fullMonth[m] || (fullMonth[m] = { n: 0, amt: 0, occ: {} });
    f.n++; f.amt += a;
    if (r.occupancy_id) f.occ[r.occupancy_id] = 1;
    if (day <= dom) {
      var b = sameDay[m] || (sameDay[m] = { n: 0, amt: 0, occ: {} });
      b.n++; b.amt += a;
      if (r.occupancy_id) b.occ[r.occupancy_id] = 1;
    }
  });
  var sdMonths = Object.keys(sameDay).sort().slice(-7);
  var thisKey = monthNorm_(todayYmd);
  var priorSd = [];
  sdMonths.forEach(function (m) {
    var b = sameDay[m], f = fullMonth[m] || { amt: 0 };
    var hh = Object.keys(b.occ).length;
    out.push('  ' + m + String(b.n).padStart(10) + String(hh).padStart(13) +
             money_(Math.round(b.amt)).padStart(18) +
             money_(Math.round(f.amt)).padStart(15) +
             (m === thisKey ? '   <- running month' : ''));
    if (m !== thisKey) priorSd.push({ amt: b.amt, hh: hh, n: b.n });
  });
  if (priorSd.length >= 3 && sameDay[thisKey]) {
    var cur = sameDay[thisKey];
    var medAmt = median_(priorSd.map(function (x) { return x.amt; }));
    var medHh = median_(priorSd.map(function (x) { return x.hh; }));
    var curHh = Object.keys(cur.occ).length;
    var ratio = medAmt ? Math.round(cur.amt / medAmt * 100) : null;
    var hhRatio = medHh ? Math.round(curHh / medHh * 100) : null;
    out.push('');
    out.push('By day ' + dom + ', a typical month had ' + money_(Math.round(medAmt)) + ' from ' +
             medHh + ' households.');
    out.push('This month has ' + money_(Math.round(cur.amt)) + ' from ' + curHh +
             ' households — ' + ratio + '% of the money, ' + hhRatio + '% of the households.');
    out.push('');
    if (ratio !== null && ratio >= 80) {
      out.push('>> NORMAL. The running month is tracking where it usually is by this date.');
      out.push('   Its total looks small only because the month is not over. Nothing is missing.');
    } else if (hhRatio !== null && hhRatio < 60) {
      out.push('>> ROWS ARE MISSING. Far fewer households have transacted than by this date in');
      out.push('   any recent month, and a collections problem does not make households');
      out.push('   disappear — it makes them pay less. Check the windowed pull ran.');
    } else {
      out.push('>> The households are there but the money is light, so this is about AMOUNTS,');
      out.push('   not missing rows — partial payments or a genuinely slow month.');
    }
  }

  // A WARNING ABOUT THE SECTION ABOVE, learned the hard way.
  //
  // The same-day comparison tells you whether this month looks like the ones before it. It
  // CANNOT tell you whether the series as a whole is right. On 2026-08-17 it reported the
  // running month at 101% of normal — correctly — while every month in the series was
  // understating rent by roughly two thirds, because they were all understating it equally.
  // An internally consistent series can be uniformly wrong, and this comparison is blind to
  // exactly that.
  //
  // The section below is the one that catches it, because it compares against a different
  // source rather than against ourselves.
  out.push('');
  out.push('--- AGAINST THE LEDGER (a different source, which is the point) ---');
  var gl = readTab_('Rent_Income_GL').filter(function (r) { return r.month; });
  if (!gl.length) {
    out.push('Rent_Income_GL is empty. Run buildRentIncomeGL() — without it there is nothing');
    out.push('here to check the receipts series against except itself, and that is how a');
    out.push('systematic shortfall stays invisible.');
  } else {
    out.push('Rent income is GL 4100 + 4105 on an accrual basis: recognised in the month the');
    out.push('rent COVERS. Receipts are cash on the day it ARRIVED, and include the Resident');
    out.push('Benefits Package, pet rent, late fees, utility reimbursements and deposits.');
    out.push('They are different measures. Expect a gap; watch its SHAPE.');
    out.push('');
    out.push('month       rent income      receipts       receipts as % of income');
    var glBy = {};
    gl.forEach(function (r) { glBy[monthNorm_(r.month)] = num_(r.rent_income); });
    var recBy = {};
    readTab_('Rent_Collection').forEach(function (r) {
      recBy[monthNorm_(r.month)] = num_(r.rent_collected);
    });
    Object.keys(glBy).sort().forEach(function (m) {
      var g = glBy[m], c = recBy[m];
      var pc = (g && c !== null && c !== undefined) ? Math.round(c / g * 100) : null;
      out.push('  ' + m + money_(Math.round(g || 0)).padStart(16) +
               (c === null || c === undefined ? '—' : money_(Math.round(c))).padStart(14) +
               (pc === null ? '' : String(pc) + '%').padStart(22) +
               (pc !== null && pc < 60 ? '   <- receipts far below income' : ''));
    });
    out.push('');
    out.push('A month where receipts run WELL BELOW rent income is the signal that matters:');
    out.push('rent income cannot exceed the cash that funded it over any long window, so a');
    out.push('persistent shortfall means receipts rows are missing, not that residents are');
    out.push('behind. Over a full year the two should be within a few percent of each other.');

    // THE SHAPE OF THE GAP NAMES ITS CAUSE.
    //
    // A cliff means truncation: rows were cut at a page boundary. A smooth slope rising
    // with recency means something is dropping rows as they AGE — and the only thing that
    // ages is the tenancy. On 2026-08-19 the slope ran 63% twelve months back to 98% last
    // month, with zero receipts from any past resident in 4,961 rows. That is not churn
    // being measured; it is churn being deleted.
    var slope = [];
    Object.keys(glBy).sort().forEach(function (m) {
      var g = glBy[m], c = recBy[m];
      if (g && c !== null && c !== undefined) slope.push({ m: m, pct: c / g * 100 });
    });
    if (slope.length >= 6) {
      var oldest = slope.slice(0, 3), newest = slope.slice(-3);
      var avg = function (a) {
        return a.reduce(function (s2, x) { return s2 + x.pct; }, 0) / a.length;
      };
      var oldAvg = avg(oldest), newAvg = avg(newest);
      out.push('');
      out.push('--- THE SHAPE OF THE GAP ---');
      out.push('oldest three months average ' + Math.round(oldAvg) + '% of rent income');
      out.push('newest three months average ' + Math.round(newAvg) + '%');
      if (newAvg - oldAvg > 15) {
        out.push('');
        out.push('>> RISING WITH RECENCY. Something is dropping rows as they age, and the only');
        out.push('   thing that ages here is the TENANCY. Check the status mix below: if there');
        out.push('   is not a single receipt from a past resident, receivables_activity is');
        out.push('   scoped to current occupancies and every mover-out took their payment');
        out.push('   history with them. Use the ledger for anything historical.');
      } else if (oldAvg - newAvg > 15) {
        out.push('>> FALLING WITH RECENCY, which is the opposite and would suggest recent rows');
        out.push('   are missing — check the most recent window of the pull.');
      } else {
        out.push('>> FLAT. Whatever the level, it is consistent across the year, so this is a');
        out.push('   definition difference rather than rows going missing.');
      }
    }
  }

  var rrCharged = 0;
  rr.forEach(function (r) {
    if (String(r.status || '').toLowerCase().indexOf('current') === -1) return;
    rrCharged += (num_(r.rent) || 0);
  });
  out.push('');
  out.push('rent CHARGED per month from the rent roll: ' + money_(Math.round(rrCharged)));

  // Per month: money, receipts, and how many households appear.
  out.push('');
  out.push('--- BY MONTH ---');
  out.push('month     receipts    net $        positive $     negative $   households');
  var byMonth = {};
  rec.forEach(function (r) {
    var m = monthKey_(r.txn_receipt_date);
    if (!m) return;
    var a = num_(r.txn_amount);
    if (a === null) return;
    var b = byMonth[m] || (byMonth[m] = { n: 0, net: 0, pos: 0, neg: 0, occ: {} });
    b.n++; b.net += a;
    if (a >= 0) b.pos += a; else b.neg += a;
    if (r.occupancy_id) b.occ[r.occupancy_id] = 1;
  });
  var months = Object.keys(byMonth).sort().slice(-14);
  months.forEach(function (m) {
    var b = byMonth[m];
    out.push('  ' + m + String(b.n).padStart(9) + money_(round2_(b.net)).padStart(14) +
             money_(round2_(b.pos)).padStart(15) + money_(round2_(b.neg)).padStart(14) +
             String(Object.keys(b.occ).length).padStart(12));
  });

  // The decisive comparison: how many households paid, against how many are billed.
  var last = months[months.length - 2] || months[months.length - 1];
  if (last) {
    var b2 = byMonth[last];
    var paying = Object.keys(b2.occ).length;
    var billed = rr.filter(function (r) {
      return String(r.status || '').toLowerCase().indexOf('current') !== -1;
    }).length;
    out.push('');
    out.push('--- THE DECIDING NUMBER (' + last + ') ---');
    out.push('households with a receipt : ' + paying);
    out.push('households on the rent roll: ' + billed);
    var cover = billed ? Math.round(paying / billed * 100) : 0;
    out.push('coverage: ' + cover + '%');
    if (cover < 70) {
      out.push('>> MOST HOUSEHOLDS ARE MISSING. This is not a definition problem, it is');
      out.push('   missing rows. Likely the report is paginated beyond what afReport_');
      out.push('   fetched, or receivables_activity only returns some payment types.');
    } else {
      out.push('>> Nearly every household appears, so rows are not missing. The shortfall');
      out.push('   is in the AMOUNTS — receivables_activity is probably reporting');
      out.push('   something narrower than a full rent payment.');
    }
  }

  // What kind of transactions are these?
  out.push('');
  out.push('--- WHAT KIND OF TRANSACTIONS ---');
  out.push('Read the STATUS block especially. Every tenancy that has ever paid should appear');
  out.push('somewhere in a 12-month window, so if Past / Former / Moved out is ZERO, the');
  out.push('report is only returning current occupancies and the history is incomplete.');
  [['payment_type', 'payment_type'], ['party', 'party'], ['status', 'status']]
    .forEach(function (f) {
      var c = {};
      rec.forEach(function (r) {
        var k = String(r[f[1]] === null || r[f[1]] === undefined ? '(blank)' : r[f[1]]);
        var a = num_(r.txn_amount) || 0;
        var e = c[k] || (c[k] = { n: 0, sum: 0 });
        e.n++; e.sum += a;
      });
      out.push(f[0] + ':');
      Object.keys(c).sort(function (x, y) { return c[y].sum - c[x].sum; }).slice(0, 10)
        .forEach(function (k) {
          out.push('  ' + String(c[k].n).padStart(7) + '  ' +
                   money_(round2_(c[k].sum)).padStart(14) + '  ' + k);
        });
    });

  out.push('');
  out.push('--- AVERAGE RECEIPT ---');
  var amts = rec.map(function (r) { return num_(r.txn_amount); })
                .filter(function (a) { return a !== null && a > 0; });
  if (amts.length) {
    out.push('median positive receipt: ' + money_(median_(amts)));
    var rents = rr.map(function (r) { return num_(r.rent); })
                  .filter(function (x) { return x && x > 0; });
    out.push('median rent charged    : ' + money_(median_(rents)));
    out.push('If the median receipt is far below the median rent, receipts are being');
    out.push('reported per charge line rather than per payment, and summing them is');
    out.push('still right — but a low household coverage above would mean rows are lost.');
  }

  var text = out.join('\n');
  Logger.log(text);
  return text;
}

/**
 * Can receivables_activity be made to return PAST tenancies?
 *
 * The evidence that it currently cannot: across 4,961 receipts spanning thirteen months,
 * every single one belongs to a Current or Notice tenancy and not one to a resident who has
 * moved out. On a portfolio with ordinary churn that is not possible — so the report is
 * scoped to current occupancies, and every mover-out took their payment history with them.
 *
 * That is why our receipts run at 63% of rent income twelve months back and 98% last month:
 * the further back you look, the more of those residents have since gone.
 *
 * This tries the parameters that might widen the scope. It is a probe, not a fix — if none
 * of them works, the answer is that receivables_activity is a CURRENT-RESIDENT report and
 * anything historical must come from the ledger.
 */
function probeReceivablesScope() {
  var from = ymd_(addDays_(today_(), -365));
  var to = ymd_(today_());
  var base = { receipt_date_from: from, receipt_date_to: to };

  var attempts = [
    ['baseline (what we pull today)', {}],
    ['property_visibility all', { property_visibility: 'all' }],
    ['tenant_status all', { tenant_status: 'all' }],
    ['occupancy_status all', { occupancy_status: 'all' }],
    ['include_past_tenants', { include_past_tenants: 'true' }],
    ['include_former_residents', { include_former_residents: 'true' }],
    ['tenancy_status all', { tenancy_status: 'all' }],
    ['status all', { status: 'all' }],
    ['include_inactive', { include_inactive: 'true' }]
  ];

  var out = ['--- CAN WE SEE PAST TENANCIES? ---', '',
             'window: ' + from + ' to ' + to, ''];
  var baseline = null;

  attempts.forEach(function (a) {
    var body = {};
    Object.keys(base).forEach(function (k) { body[k] = base[k]; });
    Object.keys(a[1]).forEach(function (k) { body[k] = a[1][k]; });

    var rows;
    try {
      rows = afReportWindowed_('receivables_activity', body,
        'receipt_date_from', 'receipt_date_to', from, to,
        { windowDays: 60, maxRows: 60000 });
    } catch (e) {
      out.push('  ' + a[0].padEnd(32) + 'REJECTED  ' + String(e.message).slice(0, 60));
      return;
    }

    var statuses = {}, total = 0;
    rows.forEach(function (r) {
      var st = String(r.status || '(blank)');
      statuses[st] = (statuses[st] || 0) + 1;
      total += (num_(r.txn_amount) || 0);
    });
    var past = Object.keys(statuses).filter(function (k) {
      return /past|former|moved|prior|inactive/i.test(k);
    });

    if (baseline === null) baseline = rows.length;
    var delta = rows.length - baseline;

    out.push('  ' + a[0].padEnd(32) + String(rows.length).padStart(6) + ' rows  ' +
             (delta > 0 ? '(+' + delta + ')' : delta < 0 ? '(' + delta + ')' : '(same)') +
             '  ' + money_(Math.round(total)).padStart(13) +
             (past.length ? '   <<< PAST TENANCIES: ' + past.join(', ') : ''));
    out.push('      statuses: ' + Object.keys(statuses).map(function (k) {
      return k + '=' + statuses[k]; }).join(', '));
    sleepFor_('appfolio');
  });

  out.push('');
  out.push('WHAT TO LOOK FOR: a row that returns MORE records than the baseline, and a status');
  out.push('list that finally contains something other than Current and Notice. If nothing');
  out.push('does, receivables_activity only knows about current residents — which is fine as');
  out.push('long as nothing historical is built on it. Rent_Income_GL already is not.');
  Logger.log(out.join('\n'));
  return out.join('\n');
}

/**
 * Does our ledger figure agree with AppFolio's own cash flow statement?
