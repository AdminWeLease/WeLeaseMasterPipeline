                      'buildInsuranceCompliance', 'buildDataQualityAudit'],
  'Diagnostic.gs (sanity)': ['sanityCheck'],
  'Dashboard.gs': ['doGet', 'renderPage_', 'urgencies_', 'block_', 'pmLookup_', 'pmOf_',
                   'buildDashboardCache', 'lineChart_', 'css_', 'js_']
};

var REQUIRED_GLOBALS = ['CFG', 'SYSTEMS', 'TABS_ACTIVE', 'VIEWS', 'BRAND', 'URGENT',
                        'COLS', 'MASTER', 'UNASSIGNED', 'DEPOSIT_GL'];

function verifyProject() {
  var missingFns = [], missingGlobals = [], ok = 0;

  Object.keys(REQUIRED_FUNCTIONS).forEach(function (file) {
    REQUIRED_FUNCTIONS[file].forEach(function (fn) {
      var found = false;
      try { found = (typeof this[fn] === 'function') || (eval('typeof ' + fn) === 'function'); }
      catch (e) { found = false; }
      if (found) ok++;
      else missingFns.push({ file: file, fn: fn });
    });
  });

  REQUIRED_GLOBALS.forEach(function (g) {
    var found = false;
    try { found = (eval('typeof ' + g) !== 'undefined'); } catch (e) { found = false; }
    if (!found) missingGlobals.push(g);
  });

  // Optional modules — absent is fine, half-present is not.
  var optional = {
    'Utility schedule.gs': ['buildUtilitySchedule', 'utilityScheduleSummary_'],
    'Dashboard utilities patch.gs': ['utilityScheduleBlocks_', 'utilitySchedulePanel_'],
    'Diagnostic.gs': ['diagnoseDepositFlow', 'diagnoseExpiringLeases'],
    'Diagnostic.gs (discovery)': ['discover', 'discoverAppFolio'],
    'Diagnostic.gs (cleanup)': ['auditSheet', 'cleanupSheet']
  };
  var partial = [];
  Object.keys(optional).forEach(function (file) {
    var present = optional[file].filter(function (fn) {
      try { return eval('typeof ' + fn) === 'function'; } catch (e) { return false; }
    });
    if (present.length && present.length < optional[file].length) {
      partial.push(file + ' — ' + present.length + '/' + optional[file].length + ' present');
    }
  });

  var byFile = {};
  missingFns.forEach(function (m) { (byFile[m.file] = byFile[m.file] || []).push(m.fn); });

  var report = [];
  if (!missingFns.length && !missingGlobals.length && !partial.length) {
    report.push('PROJECT OK — ' + ok + ' required functions present, all globals defined.');
  } else {
    report.push('PROJECT INCOMPLETE');
    Object.keys(byFile).forEach(function (f) {
      report.push('  PASTE ' + f + ' — missing: ' + byFile[f].join(', '));
    });
    if (missingGlobals.length) report.push('  MISSING GLOBALS: ' + missingGlobals.join(', '));
    partial.forEach(function (p) { report.push('  PARTIAL: ' + p); });
    report.push('');
    report.push('Apps Script shares one global scope, so file ORDER does not matter — ' +
                'but every file must be present. A function that moved between files ' +
                'exists nowhere until both are pasted.');
  }

  var text = report.join('\n');
  Logger.log(text);
  try {
    writeTab_('_project_verify', missingFns.length || missingGlobals.length
      ? missingFns.map(function (m) { return { status: 'MISSING', file: m.file, item: m.fn }; })
          .concat(missingGlobals.map(function (g) {
            return { status: 'MISSING GLOBAL', file: '?', item: g }; }))
      : [{ status: 'OK', file: 'all', item: ok + ' functions verified' }]);
  } catch (e) {}
  return text;
}


// ============================================================ 2. SHEET AUDIT & CLEANUP

/**
 * Which AppFolio-sourced tabs look truncated?
 *
 * Report pagination was broken — a GET on the report route 404s, so any report that filled
 * a page lost everything past it. The tell is a row count sitting exactly on a page
 * boundary: real data almost never lands on a round 5,000.
 *
 * Run this once after re-pulling. A tab that was truncated will grow; one that was always
 * complete will not move.
 */
/**
 * Why is the Onboarding group blank?
 *
 * There are only a few possible answers and they need different things done about them:
 * no onboarding process type matched; processes exist but none has closed; processes have
 * closed but LS_Processes never received them; or the tasks are there but carry no step
 * names because they were seeded before the step.description fix. Those four looked
 * identical from the dashboard.
 */
/**
 * The two things the insurance view needs configured, read off your own data.
 *
 * Rather than me guessing which carrier is the RBP one and which property group means
 * "insured through WeLease", this prints what is actually in the account with counts, so
 * the answer is a reading exercise rather than a guess.
 */
function diagnoseInsurance() {
  var out = ['--- INSURANCE CONFIGURATION ---', ''];
  var t = ymd_(today_());

  out.push('INSURANCE.RBP_CARRIERS        = ' + JSON.stringify(INSURANCE.RBP_CARRIERS));
  out.push('INSURANCE.OWNER_WITH_US_GROUPS = ' + JSON.stringify(INSURANCE.OWNER_WITH_US_GROUPS));

  // ---- resident carriers ----
  out.push('');
  out.push('--- 1. RESIDENT CARRIERS IN YOUR DATA ---');
  out.push('Set RBP_CARRIERS to whichever of these is the Resident Benefits Package carrier.');
  out.push('');
  var live = liveTenancy_();
  var seen = {}, carriers = {}, noCarrier = 0, households = 0;
  dropTPO_(readTab_('Tenants')).forEach(function (r) {
    var type = String(r.tenant_type || '').toLowerCase();
    if (/co.?signer|guarantor/.test(type)) return;
    if (!isActiveTenancy_(r, live)) return;
    var occ = String(r.occupancy_id || '');
    if (occ && seen[occ]) return;
    if (occ) seen[occ] = 1;
    households++;
    var c = String(r.insurance_company_name || '').trim();
    if (!c) { noCarrier++; return; }
    var exp = ymd_(r.insurance_expiration);
    var b = carriers[c] || (carriers[c] = { n: 0, current: 0, expired: 0, noDate: 0 });
    b.n++;
    if (!exp) b.noDate++; else if (exp < t) b.expired++; else b.current++;
  });
  out.push('active households: ' + households + '   with no carrier named: ' + noCarrier);
  out.push('');
  out.push('carrier                                   total  current  expired  no date   RBP?');
  var names = Object.keys(carriers).sort(function (a, b) { return carriers[b].n - carriers[a].n; });
  names.forEach(function (c) {
    var b = carriers[c];
    out.push('  ' + c.slice(0, 38).padEnd(40) + String(b.n).padStart(5) +
             String(b.current).padStart(9) + String(b.expired).padStart(9) +
             String(b.noDate).padStart(9) + '   ' + (insIsRbpCarrier_(c) ? 'YES' : ''));
  });
  if (!names.length) {
    out.push('  NONE. No active household carries an insurance_company_name.');
    out.push('  >> Either coverage is not recorded in AppFolio, or the tenant_directory');
    out.push('     columns filter dropped it — insurance_company_name must be in COLS.');
  } else if (!INSURANCE.RBP_CARRIERS.length) {
    out.push('');
    out.push('>> RBP_CARRIERS is empty, so none of the above is marked. A carrier holding a');
    out.push('   large share of households is the likely RBP one. Set it, re-run');
    out.push('   buildInsuranceCompliance(), and the three-way split goes live.');
  }

  // ---- property groups ----
  out.push('');
  out.push('--- 2. PROPERTY GROUPS (which one means "insured through WeLease"?) ---');
  var groups = {};
  readTab_('PM_Groups').forEach(function (r) {
    var g = String(r.property_group_name || '(blank)');
    groups[g] = (groups[g] || 0) + 1;
  });
  var gnames = Object.keys(groups).sort(function (a, b) { return groups[b] - groups[a]; });
  out.push('group                                     properties   matched as "through us"');
  gnames.forEach(function (g) {
    var low = g.toLowerCase();
    var hit = INSURANCE.OWNER_WITH_US_GROUPS.some(function (w) {
      return low.indexOf(String(w).toLowerCase()) !== -1; });
    out.push('  ' + g.slice(0, 38).padEnd(40) + String(groups[g]).padStart(8) +
             '        ' + (hit ? 'YES' : ''));
  });
  var withUs = insWithUsProps_();
  out.push('');
  out.push('properties matched into a WeLease-placed insurance group: ' +
           Object.keys(withUs).length);
  if (!Object.keys(withUs).length) {
    out.push('>> NONE matched. Check the exact group name above against');
    out.push('   INSURANCE.OWNER_WITH_US_GROUPS. Matching is a case-insensitive substring.');
  }

  // ---- emails ----
  out.push('');
  out.push('--- 3. CAN WE ACTUALLY EMAIL THEM? ---');
  // "0 with an email" has two completely different causes and one useless message. Either
  // the source column is absent, or it is present and empty. Say which.
  function emailReport_(label, tabName, sourceTab) {
    var rows = readTab_(tabName);
    var src = readTab_(sourceTab);
    var withEmail = rows.filter(function (r) { return insEmailOf_(r); }).length;
    out.push(label.padEnd(18) + String(rows.length).padStart(5) + ' rows   with an email: ' +
             withEmail);
    if (!rows.length || withEmail) return;

    // Which candidate columns actually exist on the SOURCE tab, and are any populated?
    var present = [], populated = [];
    if (src.length) {
      var keys = {};
      src.slice(0, 200).forEach(function (r) {
        Object.keys(r).forEach(function (k) { keys[k] = 1; });
      });
      INS_EMAIL_FIELDS.forEach(function (f) {
        if (!keys[f]) return;
        present.push(f);
        var n = src.filter(function (r) { return insFirstEmail_(r[f]); }).length;
        if (n) populated.push(f + '=' + n);
      });
      // Anything else that smells like an email column.
      Object.keys(keys).forEach(function (k) {
        if (INS_EMAIL_FIELDS.indexOf(k) === -1 && /e.?mail/i.test(k)) {
          present.push(k + ' (unexpected name)');
          var n2 = src.filter(function (r) { return insFirstEmail_(r[k]); }).length;
          if (n2) populated.push(k + '=' + n2);
        }
      });
    }
    out.push('   ' + sourceTab + ' has ' + src.length + ' row(s). Email-ish columns present: ' +
             (present.length ? present.join(', ') : 'NONE'));
    if (!present.length) {
      out.push('   >> THE COLUMN IS ABSENT. Add it to COLS.' +
               (sourceTab === 'Tenants' ? 'tenant_directory' : 'owner_directory') +
               ' in Jobs.gs, then re-run the pull. The columns filter drops anything not');
      out.push('      listed, silently.');
    } else if (!populated.length) {
      out.push('   >> The column exists and is EMPTY on every row. That is a data-entry');
      out.push('      question in AppFolio, not a wiring one — nothing here can recover it.');
    } else {
      out.push('   >> Populated in the source (' + populated.join(', ') + ') but not carried');
      out.push('      through. Re-run buildInsuranceCompliance() — this tab predates the fix.');
    }
  }
  emailReport_('Insurance_Tenant', 'Insurance_Tenant', 'Tenants');
  emailReport_('Insurance_Owner', 'Insurance_Owner', 'Owners');
  out.push('');
  out.push('Insurance_Outreach rows: ' + readTab_('Insurance_Outreach').length +
           '  (the chase list; a missing email is flagged, not filtered out)');

  Logger.log(out.join('\n'));
  return out.join('\n');
}

function diagnoseOnboarding() {
  var out = ['--- ONBOARDING ---', ''];

  var procs = readTab_('LS_Processes');
  var tasks = readTab_('LS_Tasks_All');
  out.push('LS_Processes rows: ' + procs.length + '   LS_Tasks_All rows: ' + tasks.length);

  var types = {};
  procs.forEach(function (r) {
    var t = String(r.process_type || '(none)');
    types[t] = (types[t] || 0) + 1;
  });
  // typeof guard: Apps Script files load in an arbitrary order, and if LeadSimple.gs has not
  // been pasted this file used to die with "LS_ONBOARDING is not defined" — a stack trace
  // instead of the one sentence that says what to do.
  if (typeof LS_ONBOARDING === 'undefined') {
    out.push('');
    out.push('LS_ONBOARDING is not defined, which means LeadSimple.gs has not been pasted (or');
    out.push('is an older copy). Paste the current LeadSimple.gs and run this again.');
    Logger.log(out.join('\n'));
    return out.join('\n');
  }

  var onbTypes = Object.keys(types).filter(function (t) {
    return LS_ONBOARDING.ALSO_MATCHING.test(t); });
  out.push('');
  out.push('--- 1. WHICH TYPE ARE WE MEASURING? ---');
  out.push('  measuring: ' + LS_ONBOARDING.TYPES.join(' / '));
  out.push('');
  if (!onbTypes.length) {
    out.push('  NO type contains "onboard". ' + Object.keys(types).length + ' type(s) present.');
    out.push('  >> Run lsListProcessTypes(). Either the seed has not run or the names differ.');
  } else {
    onbTypes.forEach(function (t) {
      out.push('  ' + t.padEnd(44) + String(types[t]).padStart(5) + ' in LS_Processes   ' +
               (lsIsOnboardingType_(t) ? '<- MEASURED' : 'excluded on purpose'));
    });
    if (!onbTypes.some(lsIsOnboardingType_)) {
      out.push('');
      out.push('  >> NOTHING MATCHES LS_ONBOARDING.TYPES. The owner onboarding process has');
      out.push('     probably been renamed — copy the exact name from the list above.');
    }
  }

  out.push('');
  out.push('--- 2. OPEN VS CLOSED IN LS_Processes ---');
  var onb = procs.filter(function (r) { return lsIsOnboardingType_(r.process_type); });
  var withClose = onb.filter(function (r) { return r.closed_date; }).length;
  var stages = {};
  onb.forEach(function (r) {
    var k = String(r.stage_status || '(blank)');
    stages[k] = (stages[k] || 0) + 1;
  });
  out.push('  onboarding rows: ' + onb.length + '   with a closed_date: ' + withClose);
  out.push('  stage_status: ' + Object.keys(stages).map(function (k) {
    return k + '=' + stages[k]; }).join(', '));
  if (onb.length && !withClose) {
    out.push('  >> None carries a close date. If stage_status shows completed rows anyway,');
    out.push('     closed_at is not coming through. If there are NO completed rows at all,');
    out.push('     /processes is returning open ones only — which section 3 can confirm.');
  }

  out.push('');
  out.push('--- 3. WHAT THE TASKS KNOW (the fallback source) ---');
  var union = lsOnboardingProcs_();
  var closedU = union.filter(function (p) { return p.created && p.closed; });
  var tasksOnly = union.filter(function (p) { return p.sources.indexOf('processes') === -1; });
  out.push('  onboarding processes across both tabs : ' + union.length);
  out.push('  with both an open and a close date    : ' + closedU.length);
  out.push('  known ONLY through their tasks        : ' + tasksOnly.length);
  if (tasksOnly.length) {
    out.push('  >> Confirms it: ' + tasksOnly.length + ' closed onboarding process(es) never');
    out.push('     reached LS_Processes. The metric reads both tabs now, so it works anyway.');
  }
  if (closedU.length) {
    var ds = [];
    closedU.forEach(function (p) {
      var g = daysBetween_(p.created, p.closed);
      if (g !== null && g >= 0) ds.push(g);
    });
    out.push('  median cycle time: ' + median_(ds) + ' days  (n=' + ds.length + ')');
  }

  out.push('');
  out.push('--- 4. STEP NAMES (the three step metrics need these) ---');
  var createdOf = {};
  union.forEach(function (p) { if (p.created) createdOf[p.id] = p.created; });
  var onbTasks = tasks.filter(function (t) { return createdOf[t.process_id]; });
  var named = onbTasks.filter(function (t) { return String(t.step || ''); }).length;
  out.push('  tasks on onboarding processes: ' + onbTasks.length + '   with a step name: ' + named);
  if (onbTasks.length && !named) {
    out.push('  >> Every step is blank. These were seeded before the step.description fix —');
    out.push('     re-run lsSeedCompletedTasks().');
  }
  var pats = [[/inform.*collect|collect.*inform|gather.*inform/i, 'information collected'],
              [/in\s*(the\s*)?system|enter.*(appfolio|system)|set\s*up.*system/i, 'in the system'],
              [/insurance|proof\s*of\s*ins/i, 'proof of insurance']];
  pats.forEach(function (pr) {
    var hits = {}, done = 0;
    onbTasks.forEach(function (t) {
      var st = String(t.step || '');
      if (!st || !pr[0].test(st)) return;
      hits[st] = (hits[st] || 0) + 1;
      if (ymd_(t.completed_date)) done++;
    });
    var names = Object.keys(hits);
    out.push('');
    out.push('  ' + pr[1] + ' -> ' + names.length + ' step name(s), ' + done + ' completed');
    names.slice(0, 6).forEach(function (n) {
      out.push('      ' + String(n).slice(0, 60).padEnd(62) + hits[n]);
    });
    if (!names.length) {
      out.push('      NO MATCH. Run lsListSteps() and send the list so the pattern can widen.');
    }
  });

  Logger.log(out.join('\n'));
  return out.join('\n');
}

function diagnoseTruncation() {
  var PAGE = 5000;
  var out = ['--- TABS THAT MAY HAVE BEEN TRUNCATED BY THE PAGINATION 404 ---', ''];
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var suspect = 0, checked = 0;

  ss.getSheets().forEach(function (sh) {
    var name = sh.getName();
    if (name.charAt(0) === '_') return;
    var n = Math.max(0, sh.getLastRow() - 1);          // minus the header
    if (!n) return;
    checked++;
    var onBoundary = (n % PAGE === 0);
    var justUnder = (n % PAGE >= PAGE - 5 && n >= PAGE);
    if (onBoundary || justUnder) {
      suspect++;
      out.push('  ' + name.padEnd(30) + String(n).padStart(7) + ' rows   <<< sits on a page ' +
               'boundary — very likely cut short at page ' + Math.round(n / PAGE));
    } else if (n >= PAGE) {
      out.push('  ' + name.padEnd(30) + String(n).padStart(7) + ' rows   (over one page, but ' +
               'not on a boundary — probably complete)');
    }
  });

  out.push('');
  out.push(suspect
    ? suspect + ' tab(s) look truncated out of ' + checked + ' checked. Re-run the job that ' +
      'writes each one and compare — if the count grows, it was being cut short.'
    : 'Nothing sits on a page boundary. No sign any other report was truncated.');
  out.push('');
  out.push('bill_detail is pulled in 90-day windows now and does not depend on pagination ' +
           'at all. Everything else still uses it, with a POST fallback and a ' +
           'no-progress guard.');

  Logger.log(out.join('\n'));
  return out.join('\n');
}

function knownTabs_() {
  var known = {};
  TABS_ACTIVE.forEach(function (t) { known[t] = 'active pipeline'; });
  if (typeof TABS_DEFERRED !== 'undefined') {
    Object.keys(TABS_DEFERRED).forEach(function (sys) {
      TABS_DEFERRED[sys].forEach(function (t) {
        known[t] = 'deferred — ' + sys + (systemEnabled_(sys) ? ' (live)' : ' (disabled)');
      });
    });
  }
  // Written by optional modules that may not be installed.
  ['Utility_Schedule', 'Utility_Schedule_Alerts', 'Utility_Schedule_Overrides',
   'Utility_Schedule_History', 'Utility_Schedule_Anomalies', 'Utility_Schedule_Dropped',
   '_uschedule_events', '_utility_field_discovery',
   'Master_Units', 'Master_Tenancies',
   'Rent_Market_Variance', 'Insurance_Owner', 'Insurance_Tenant', 'Insurance_Outreach',
   'Insurance_History',
   '_data_quality', '_acknowledgments', '_excluded_properties', '_excluded_tenancies',
   '_unit_variance', '_join_exceptions', '_inspection_junk', '_inspection_quality',
   '_inspection_classes', '_step_inventory', '_auth_diagnostic', '_config_diagnostic',
   '_deposit_diagnostic', '_deposit_trace', '_workorder_diagnostic', '_tickler_diagnostic',
   '_expiring_diagnostic', '_sanity', '_metric_errors', '_errors', '_refresh_log',
   'Discovery', 'Rent_To_Market', 'MoveOut_Assessment'
  ].forEach(function (t) { if (!known[t]) known[t] = 'optional module'; });
  return known;
}

/**
 * What is actually in the workbook, and whether anything still writes it.
 * Diagnostic tabs are called out separately — they were useful once and are now noise.
 */
function auditSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var known = knownTabs_();
  var rows = [];

  ss.getSheets().forEach(function (sh) {
    var name = sh.getName();
    var lastRow = sh.getLastRow(), lastCol = sh.getLastColumn();
    var cells = lastRow * lastCol;
    var role = known[name] || null;

    var verdict, why;
    if (!role) {
      verdict = 'ORPHAN';
      why = 'Nothing in the pipeline writes this tab. Left over from an earlier version, ' +
            'or created by hand.';
    } else if (/^_.*(diagnostic|trace|inventory|classes|quality|junk|variance)$/.test(name)) {
      verdict = 'DIAGNOSTIC';
      why = 'One-off investigation output. Safe to delete once the question is settled — ' +
            'it regenerates if the diagnostic is run again.';
    } else if (lastRow <= 1) {
      verdict = 'EMPTY';
      why = 'Registered but never populated. Either the job has not run, or it produces ' +
            'nothing for this portfolio.';
    } else {
      verdict = 'KEEP';
      why = role;
    }
    rows.push({ verdict: verdict, tab: name, rows: Math.max(0, lastRow - 1),
                columns: lastCol, cells: cells, role: role || '(unknown)', note: why });
  });

  rows.sort(function (a, b) {
    var rank = { ORPHAN: 0, DIAGNOSTIC: 1, EMPTY: 2, KEEP: 3 };
    return rank[a.verdict] - rank[b.verdict] || b.cells - a.cells;
  });
  writeTab_('_sheet_audit', rows);

  var counts = {};
  rows.forEach(function (r) { counts[r.verdict] = (counts[r.verdict] || 0) + 1; });
  var totalCells = rows.reduce(function (s, r) { return s + r.cells; }, 0);

  logRun_('auditSheet', 'system', '_sheet_audit', rows.length, 0,
          JSON.stringify(counts) + ' · ' + Math.round(totalCells / 1000) + 'k cells');
  Logger.log(JSON.stringify(counts, null, 1));
  Logger.log('Total cells: ' + totalCells.toLocaleString() +
             '  (Google caps a spreadsheet at 10,000,000)');
  Logger.log('Review _sheet_audit, then run cleanupSheet() to delete ORPHAN and ' +
             'DIAGNOSTIC tabs. Nothing has been deleted.');
  return { counts: counts, cells: totalCells };
}

/**
 * Deletes what auditSheet flagged. Run the audit first — this reads its output rather
 * than deciding for itself, so you can override any row by changing its verdict to KEEP.
 */
function cleanupSheet(alsoDiagnostics) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var audit = readTab_('_sheet_audit');
  if (!audit.length) {
    Logger.log('Run auditSheet() first. Nothing deleted.');
    return 'run auditSheet() first';
  }

  var deleted = [], kept = [];
  audit.forEach(function (r) {
    var v = String(r.verdict || '').toUpperCase();
    var target = (v === 'ORPHAN') || (alsoDiagnostics && v === 'DIAGNOSTIC');
    if (!target) return;
    if (r.tab === '_sheet_audit') return;                 // never delete the audit itself
    var sh = ss.getSheetByName(r.tab);
    if (!sh) return;
    if (ss.getSheets().length <= 1) { kept.push(r.tab + ' (last sheet)'); return; }
    ss.deleteSheet(sh);
    deleted.push(r.tab);
  });

  logRun_('cleanupSheet', 'system', '-', deleted.length, 0,
          'deleted: ' + (deleted.join(', ') || 'none'));
  Logger.log('Deleted ' + deleted.length + ' tab(s): ' + (deleted.join(', ') || 'none'));
  if (kept.length) Logger.log('Skipped: ' + kept.join(', '));
  Logger.log(alsoDiagnostics ? '' :
    'Diagnostic tabs were kept. Run cleanupSheet(true) to remove those as well.');
  return { deleted: deleted.length, tabs: deleted };
}

/**
 * Which .gs files should exist, and which are safe to delete.
 * Apps Script has no API to delete a file from within the project, so this prints the
 * list and you remove them in the editor.
 */
/**
 * WHAT THIS CAN AND CANNOT DO — read this before trusting the output.
 *
 * Apps Script gives a script NO way to list its own files. This function therefore
 * cannot see your editor. An earlier version printed a static list that LOOKED like a
 * detection result, which is worse than useless — it reported files as present after
 * they had been deleted, and named files that never existed in this project.
 *
 * What it CAN do is probe for functions that only exist in files which should be gone.
 * If the function answers, the file is still there. That is real evidence.
 *
 * For everything else: the file list in the editor sidebar is the source of truth.
 */
function auditScriptFiles() {
  // A function found ONLY in a file that should have been deleted. Presence proves
  // the file is still in the project.
  var FINGERPRINTS = [
    { file: 'Utility view diagnosis.gs', fns: ['diagnoseUtilityView', 'previewUtilityView',
                                               'clearDashboardCacheNow'],
      why: 'Temporary scaffolding for the utility view. Safe to delete now.' },
    { file: 'Utilities.gs', fns: ['allocateWeighted_', 'screenUtilityBill_', 'seedUtilityMaster',
                                  'utilControlTotals_'],
      why: 'Parked allocation module, superseded by Utility schedule.gs and called by nothing.' },
    { file: 'Cleanup.gs', fns: [],
      why: 'Its contents are now inside Diagnostic.gs. If it still exists you have TWO ' +
           'definitions of verifyProject, auditSheet, cleanupSheet and auditScriptFiles — ' +
           'and the copy that wins is not guaranteed. If you are reading a stale version ' +
           'of this text, that is exactly what has happened.' }
  ];

  var found = [], clean = [];
  FINGERPRINTS.forEach(function (f) {
    if (!f.fns.length) return;                 // nothing uniquely identifies it
    var present = f.fns.filter(function (fn) {
      try { return eval('typeof ' + fn) === 'function'; } catch (e) { return false; }
    });
    if (present.length) found.push({ file: f.file, evidence: present.join(', '), why: f.why });
    else clean.push(f.file);
  });

  var KEEP = [
    ['Core.gs', 'Auth, fetch, pagination, sheet I/O, logging, and every shared helper'],
    ['Shared.gs', 'Address book and normaliser, TPO, exclusions, tenancy, month labels'],
    ['Master scope.gs', 'Master_Units and Master_Tenancies — your scope decisions'],
    ['Jobs.gs', 'The four AppFolio pulls, column sets, job chain'],
    ['Metrics.gs', 'Metric calculations and computeMetrics'],
    ['Portfolio.gs', 'Summary tiles, door history, leasing activity, rent timing'],
    ['Inspections.gs', 'Inspection classifier and move-out assessment'],
    ['Data quality.gs', 'Rent-vs-market, insurance compliance, field audit'],
    ['Dashboard.gs', 'The web app: views, lists, charts, CSS'],
    ['Dashboard utilities patch.gs', 'Utility Billing view blocks and panel'],
    ['Utility schedule.gs', 'The utility posting clock'],
    ['Diagnostic.gs', 'This file — verify, audit, cleanup, sanity, discover, diagnostics']
  ];

  Logger.log('THIS FUNCTION CANNOT SEE YOUR FILE LIST.');
  Logger.log('Apps Script exposes no way to enumerate its own files. Compare the 12 below');
  Logger.log('against the editor sidebar yourself.\n');

  Logger.log('THE 12 FILES THAT SHOULD EXIST');
  KEEP.forEach(function (k) { Logger.log('  ' + k[0] + '\n      ' + k[1]); });

  Logger.log('\nDELETED FILES STILL DETECTED (by their functions)');
  if (found.length) {
    found.forEach(function (f) {
      Logger.log('  STILL PRESENT: ' + f.file);
      Logger.log('      proof: ' + f.evidence + ' still answers');
      Logger.log('      ' + f.why);
    });
  } else {
    Logger.log('  none — no function unique to a deleted file responded');
  }
  if (clean.length) Logger.log('\n  confirmed gone: ' + clean.join(', '));

  Logger.log('\nALSO DELETE, if present: Discover.gs and Sanity.gs. Their functions were');
  Logger.log('merged into Diagnostic.gs, so both copies define discover(), discoverAppFolio(),');
  Logger.log('sanityCheck() and flag_(). Nothing errors — one copy silently wins. That cannot');
  Logger.log('be detected from inside the script, which is why it has to be checked by eye.');

  return { should_exist: KEEP.length, deleted_files_still_present: found };
}

// ============================================================ 3. SANITY CHECK

var H1_2026_BASELINE = {
  occupancy_rate:            { value: 89.5,  tolerance: 8,  note: 'was 382/427 on the old denominator' },
  days_without_revenue:      { value: 29,    tolerance: 25, note: 'median days vacant — widened; the mix of vacant units changes fast, the p90 tail is the real signal' },
  maint_speed_to_repair:     { value: 9.0,   tolerance: 5,  note: 'H1 median' },
  maint_speed_to_schedule:   { value: 7.0,   tolerance: 5,  note: 'H1 median' },
  maint_owner_approval:      { value: 6.0,   tolerance: 4,  note: 'H1 median' },
  maint_cancellation_rate:   { value: 16.9,  tolerance: 8,  note: 'H1' },
  unit_churn:                { value: 31.0,  tolerance: 12, note: '15.5% H1 annualized' }
};

function flag_(out, sev, metric, issue, detail) {
  out.push({ severity: sev, metric_id: metric, issue: issue, detail: detail || null,
             checked_at: nowStamp_() });
}

function sanityCheck() {
  var t0 = new Date().getTime();
  var rows = readTab_('Metrics').filter(function (r) { return r.period === 'ALL'; });
  var out = [];

  if (!rows.length) {
    flag_(out, 'BLOCKER', '-', 'Metrics tab is empty', 'Run computeMetrics() first.');
    writeTab_('_sanity', out);
    return out;
  }

  var byId = indexBy_(rows, 'metric_id');

  // ---------- per-metric structural checks ----------
  rows.forEach(function (r) {
    var v = num_(r.value), n = num_(r.n), den = num_(r.denominator);
    var isRate = /rate|occupancy/.test(r.metric_id);
    var status = String(r.status || '');

    if (status === 'deferred' || status === 'blocked' || status === 'not_implemented') return;

    if (v === null) {
      // A metric that deliberately returns null and says why is doing its job.
      // Only an unexplained null is a problem.
      var notes = String(r.notes || '') + ' ' + String(r.detail || '');
      if (/NO SOURCE|no source|Run build/i.test(notes)) {
        flag_(out, 'LOW', r.metric_id, 'No value by design',
              String(r.notes || '').slice(0, 200));
      } else {
        flag_(out, 'HIGH', r.metric_id, 'Metric returned no value and gave no reason',
              'Status ' + status + '. Source tab may be empty.');
      }
      return;
    }
    if (isRate && (v < 0 || v > 100)) {
      flag_(out, 'BLOCKER', r.metric_id, 'Rate outside 0-100', 'value=' + v);
    }
    if (den !== null && den === 0) {
      flag_(out, 'BLOCKER', r.metric_id, 'Denominator is zero', 'Rate is meaningless.');
    }
    if (n !== null && n === 0) {
      flag_(out, 'HIGH', r.metric_id, 'Sample size is zero', 'Nothing matched the filter.');
    } else if (n !== null && n < CFG.MIN_N_TO_PUBLISH) {
      flag_(out, 'MEDIUM', r.metric_id, 'Below publication threshold',
            'n=' + n + ' (min ' + CFG.MIN_N_TO_PUBLISH + '). Show as insufficient data.');
    }
    // A median of exactly 0 on a duration metric usually means an empty date column.
    // Unless the metric says otherwise — move-in evaluation clamps early walkthroughs
    // to day 0, so zero there is a genuine top-quartile result.
    var detail = {};
    try { detail = r.detail ? JSON.parse(r.detail) : {}; } catch (e) {}
    if (/speed|leadtime|days|dispatch|approval|assessment|disposition/.test(r.metric_id) &&
        v === 0 && n > 5 && !detail.zero_is_meaningful) {
      flag_(out, 'HIGH', r.metric_id, 'Duration median is exactly zero',
            'Usually an unpopulated date field rather than instant completion.');
    }

    // Coverage matters more than the value on any metric that has to match two records.
    if (detail.match_rate_pct !== undefined && detail.match_rate_pct !== null &&
        num_(detail.match_rate_pct) < 60) {
      flag_(out, 'MEDIUM', r.metric_id, 'Low record match rate',
            detail.match_rate_pct + '% of events had a matching record (' + detail.matched +
            ' of ' + (detail.move_ins || detail.move_outs || '?') + '). The value describes only ' +
            'the matched subset — an operational gap, not necessarily a data error.');
    }
  });

  // ---------- baseline reconciliation ----------
  Object.keys(H1_2026_BASELINE).forEach(function (id) {
    var r = byId[id];
    if (!r) return;
    var v = num_(r.value);
    if (v === null) return;
    var b = H1_2026_BASELINE[id];
    var diff = Math.abs(v - b.value);
    if (diff > b.tolerance) {
      flag_(out, 'MEDIUM', id, 'Diverges from H1 2026 baseline',
            'now=' + v + ' vs baseline=' + b.value + ' (' + b.note + '), diff=' + round1_(diff) +
            '. Investigate the query before assuming the business changed.');
    }
  });

  // ---------- delinquency: compare the cycle-independent figure ----------
  // rent_roll.past_due is a snapshot that moves with the rent cycle. Pulled days after
  // rent is due it roughly doubles versus a month-end pull, which produced a false
  // alarm on 2026-08-05. The aged 30+ rate is what belongs against a baseline.
  var rd = byId['rent_delinquency_rate'];
  if (rd && rd.detail) {
    var det = {};
    try { det = JSON.parse(rd.detail); } catch (e) {}
    var agedRate = num_(det.aged_30_plus_rate);
    if (agedRate !== null) {
      if (agedRate > 6) {
        flag_(out, 'HIGH', 'rent_delinquency_rate', 'Aged 30+ delinquency above 6%',
              'aged_30_plus_rate=' + agedRate + '%. This one is cycle-independent — a real collections signal, not a timing artifact.');
      }
      var snap = num_(rd.value);
      if (snap !== null && snap > agedRate * 2.5 && snap > 8) {
        flag_(out, 'LOW', 'rent_delinquency_rate', 'Snapshot inflated by rent-cycle timing',
              'snapshot=' + snap + '% vs aged 30+=' + agedRate + '% as of ' + (det.as_of || 'today') +
              '. Expected when pulled soon after the rent due date. Publish the aged figure, or pull at month-end.');
      }
    } else {
      flag_(out, 'MEDIUM', 'rent_delinquency_rate', 'Aged 30+ rate unavailable',
            'Delinquency_Aged tab may be empty — the snapshot alone is not comparable across dates.');
    }
  }

  // ---------- cross-metric consistency ----------
  var units = readTab_('Unit_Directory').length;
  var rr = readTab_('Rent_Roll').length;
  if (units && rr && Math.abs(units - rr) > units * 0.15) {
    flag_(out, 'HIGH', 'denominators', 'Unit_Directory and Rent_Roll disagree by >15%',
          'unit_directory=' + units + ' rent_roll=' + rr +
          '. Occupancy and delinquency use different denominators — reconcile before publishing.');
  }

  var occR = byId['occupancy_rate'], vacR = byId['days_without_revenue'];
  if (occR && vacR) {
    var occPct = num_(occR.value), vacantUnits = num_(vacR.n);
    if (occPct !== null && vacantUnits !== null && units) {
      var impliedVacant = Math.round(units * (100 - occPct) / 100);
      if (Math.abs(impliedVacant - vacantUnits) > Math.max(10, impliedVacant * 0.5)) {
        flag_(out, 'MEDIUM', 'occupancy_rate', 'Occupancy and vacancy count disagree',
              'occupancy implies ~' + impliedVacant + ' vacant; unit_vacancy reports ' + vacantUnits +
              '. Different definitions of vacant — document which one the dashboard uses.');
      }
    }
  }

  var rentD = byId['rent_delinquency_rate'], totD = byId['total_delinquency_rate'];
  if (rentD && totD && num_(rentD.value) !== null && num_(totD.value) !== null) {
    if (num_(totD.numerator) < num_(rentD.numerator)) {
      flag_(out, 'BLOCKER', 'total_delinquency_rate', 'Total delinquency count is below rent delinquency',
            'Total must be a superset. Check the filters.');
    }
  }

  // ---------- maintenance data completeness ----------
  var wo = readTab_('Work_Orders');
  if (wo.length) {
    var completed = wo.filter(function (r) { return r.completed_on; }).length;
    var pct = Math.round(completed / wo.length * 100);
    if (pct < 20) {
      flag_(out, 'BLOCKER', 'maintenance', 'Only ' + pct + '% of work orders are completed',
            completed + ' of ' + wo.length + '. Speed metrics are computed on a mostly-open queue and are NOT publishable.');
    }
  } else {
    flag_(out, 'HIGH', 'maintenance', 'Work_Orders tab is empty', 'All maintenance metrics are invalid.');
  }

  // ---------- deposit compliance ----------
  var dep = readTab_('Deposit_Compliance');
  if (dep.length) {
    var exceeded = dep.filter(function (r) { return r.status === 'EXCEEDED_THRESHOLD'; }).length;
    var ownerHeld = dep.filter(function (r) { return r.status === 'CANNOT_MEASURE_OWNER_HELD'; }).length;
    if (exceeded) {
      flag_(out, 'REVIEW', 'moveout_deposit_disposition',
            exceeded + ' deposits exceeded the ' + CFG.DEPOSIT_DISPOSITION_DAYS + '-day standard',
            'CALIFORNIA — surface to counsel. Reporting only: never auto-notify a resident.');
    }
    if (ownerHeld) {
      flag_(out, 'REVIEW', 'moveout_deposit_disposition',
            ownerHeld + ' owner-held deposits cannot be measured',
            'Funds never touch WeLease trust. Visibility gap, not a data error.');
    }
  }

  // ---------- unit variance ----------
  var uv = readTab_('_unit_variance').filter(function (r) { return num_(r.variance); });
  if (uv.length) {
    var gap = uv.reduce(function (s, r) { return s + Math.abs(num_(r.variance) || 0); }, 0);
    flag_(out, 'MEDIUM', 'denominators', uv.length + ' properties disagree on unit count',
          'Total absolute gap ' + gap + ' units. Resolve before publishing any rate externally.');
  }

  out.sort(function (a, b) {
    var order = { BLOCKER: 0, HIGH: 1, REVIEW: 2, MEDIUM: 3, LOW: 4 };
    return (order[a.severity] || 9) - (order[b.severity] || 9);
  });

  writeTab_('_sanity', out.length ? out : [{ severity: 'CLEAN', issue: 'No problems detected' }]);
  var counts = {};
  out.forEach(function (f) { counts[f.severity] = (counts[f.severity] || 0) + 1; });
  logRun_('sanityCheck', 'derived', '_sanity', out.length, new Date().getTime() - t0,
          JSON.stringify(counts));
  Logger.log(out.length + ' findings: ' + JSON.stringify(counts));
  Logger.log('Blockers must be resolved before anything is published.');
  return out;
}


