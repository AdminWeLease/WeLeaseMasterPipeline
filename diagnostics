  });
  out.push('payment_type values:');
  Object.keys(types).sort(function (a, b) { return types[b] - types[a]; }).slice(0, 12)
    .forEach(function (k) { out.push('  ' + String(types[k]).padStart(6) + '  ' + k); });
  out.push('most common txn_remarks:');
  Object.keys(remarks).sort(function (a, b) { return remarks[b] - remarks[a]; }).slice(0, 12)
    .forEach(function (k) { out.push('  ' + String(remarks[k]).padStart(6) + '  ' + k); });
  out.push('');
  out.push('If any of these reliably distinguish a RENT receipt from a utility or fee,');
  out.push('the 50%-of-rent threshold can be replaced with a direct classification and');
  out.push('the measure stops depending on knowing the rent at all. Send me this list.');

  var text = out.join('\n');
  Logger.log(text);
  return text;
