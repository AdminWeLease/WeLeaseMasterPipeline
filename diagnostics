  'Core.gs': ['afReport_', 'afCall_', 'httpWithRetry_', 'writeTab_', 'appendTab_',
                 'readTab_', 'invalidateTab_', 'logRun_', 'logError_', 'nowStamp_',
                 'parseDate_', 'ymd_', 'daysBetween_', 'addDays_', 'monthKey_', 'num_',
                 'median_', 'p90_', 'vsBenchmark_', 'groupBy_', 'indexBy_',
                 'round1_', 'round2_', 'esc_', 'money_', 'sleepFor_', 'finding_',
                 'distinctWithCounts_', 'fillRate_', 'setupSheets', 'installTriggers',
                 'verifyConnections', 'buildDepositCompliance'],
  'Shared.gs': ['addr_', 'addrLink_', 'normalizeAddress_', 'cleanName_', 'norm_',
                'containsPhrase_', 'containsAllWords_', 'addressBook_', 'buildAddressBook',
                'isTPO_', 'dropTPO_', 'inScopeIncludingInactive_', 'endingMgmt_',
                'ackSet_', 'isAcked_', 'isExcluded_', 'monthLabel_',
                'liveTenancy_', 'isActiveTenancy_', 'moveOutDateOf_', 'isActiveProperty_'],
  'Master scope.gs': ['buildMasterScope', 'inMasterScope_', 'masterUnits_', 'masterTenancies_'],
  'Jobs.gs': ['rebuildAll', 'rebuildFinancials', 'rebuildLeasing', 'rebuildCompliance',
              'rebuildEverything', 'pull_'],
  'Metrics.gs': ['computeMetrics', 'dataContext_'],
  'Portfolio.gs': ['buildPortfolio', 'buildPortfolioSummary', 'buildDoorHistory',
                   'buildLeasingActivity', 'buildRentTiming'],
  'Inspections.gs': ['classifyInspection_', 'buildMoveOutAssessment', 'isMoveOutEvent_',
                     'getMoveOuts_'],
