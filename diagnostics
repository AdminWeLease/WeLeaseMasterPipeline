/**
 * Three sessions have gone by with "leases expiring in 120 days" appearing empty and
 * no way to tell which stage removed the rows. This walks the exact chain the
 * dashboard uses and reports the count after every step.
 */
function diagnoseExpiringLeases() {
  var out = [];
  var t = ymd_(today_());
  var to120 = ymd_(addDays_(today_(), 120));

  // 1 — what the API returns, ignoring the tab entirely
  var live = [];
  try {
    live = afReport_('lease_expiration_detail', {
      filter_lease_date_range_by: 'current_lease',
      ends_on_from: t, ends_on_to: to120, columns: COLS.lease_expiration_detail
    }, { maxPages: 5 });
    finding_(out, 'expiring', '1. Direct API pull', live.length + ' rows (' + t + ' to ' + to120 + ')',
      live.length ? null : 'API RETURNS NOTHING. Try filter_lease_date_range_by = "all" or check the filter value.');
  } catch (e) {
    finding_(out, 'expiring', '1. Direct API pull', 'FAILED: ' + e.message,
      'The filter combination is being rejected. This is the cause.');
  }
  if (live.length) {
    var s = live[0];
    finding_(out, 'expiring', '1a. Sample row',
      JSON.stringify({ lease_expires: s.lease_expires, occupancy_id: s.occupancy_id,
                       unit_id: s.unit_id, tenant_name: s.tenant_name, status: s.status }), null);
    finding_(out, 'expiring', '1b. lease_expires populated', fillRate_(live, 'lease_expires'),
      'If low, daysBetween_ returns null and every row is filtered out.');
    finding_(out, 'expiring', '1c. occupancy_id populated', fillRate_(live, 'occupancy_id'),
      'Tenancy matching needs this. Blank means every row is treated as not live.');
    finding_(out, 'expiring', '1d. status values', distinctWithCounts_(live, 'status', 12), null);
  }

  // 2 — what the tab holds
  var tab = readTab_('Lease_Expirations');
  finding_(out, 'expiring', '2. Lease_Expirations tab', tab.length + ' rows',
    tab.length ? null : 'TAB IS EMPTY — rebuildLeasing has not run since the last change.');

  // 3 — the dashboard filter chain, step by step
  if (tab.length) {
    var afterTPO = dropTPO_(tab);
    finding_(out, 'expiring', '3. After TPO and exclusions', afterTPO.length + ' rows',
      (tab.length - afterTPO.length) + ' removed');

    var liveT = liveTenancy_();
    var afterTen = afterTPO.filter(function (r) { return isActiveTenancy_(r, liveT); });
    finding_(out, 'expiring', '4. After active-tenancy filter', afterTen.length + ' rows',
      (afterTPO.length - afterTen.length) + ' removed. If this is the big drop, occupancy ids ' +
      'are not matching the rent roll.');

    var afterDays = afterTen.filter(function (r) {
      var d = daysBetween_(t, ymd_(r.lease_expires));
      return d !== null && d <= 120;
    });
    finding_(out, 'expiring', '5. After the 120-day window', afterDays.length + ' rows',
      afterDays.length ? 'These are what should render.' : 'ALL REMOVED HERE — check lease_expires values.');

    var occInRoll = 0;
    afterTPO.slice(0, 40).forEach(function (r) {
      if (r.occupancy_id && liveT.occupancies[String(r.occupancy_id).trim()]) occInRoll++;
    });
    finding_(out, 'expiring', '6. Occupancy match rate (first 40)',
      occInRoll + '/40 found in the rent roll',
      occInRoll === 0 ? 'ZERO MATCHES — occupancy_id is missing from one side, or the rent roll ' +
                        'pull is stale. This would empty the list on its own.' : null);
  }

  writeTab_('_expiring_diagnostic', out,
    { headers: ['system','question','answer','action_required','discovered_at'] });
  Logger.log(JSON.stringify(out, null, 1));
  return out;
}

// ============================================================ DOOR HISTORY

/**
 * Why does churn read what it reads?
 *
 * Three things must all be true before a lost door can be counted:
 *   1. the property carries a management_end_date (it lives on the PROPERTY, never
 *      on the unit — units can only be hidden)
 *   2. that property is still returned by the API, which for a hidden record means
 *      property_visibility:"all"
 *   3. its doors were placed in a month we can date
 *
 * Any one of them failing produces the same symptom: churn reads zero. This tells
 * you which one. Run it from the editor and read the log.
 */
function diagnoseDoorHistory() {
  var out = [];
  var t = ymd_(today_());

  var visP = readTab_('Properties_Units'), visU = readTab_('Unit_Directory');
  var allP = readTab_('Properties_All'),   allU = readTab_('Unit_Directory_All');

  out.push('--- STEP 1: does property_visibility:"all" return more? ---');
  if (!allP.length) {
    out.push('Properties_All is EMPTY. Run rebuildAll() first — everything below is');
    out.push('measured against the wider pull.');
    Logger.log(out.join('\n'));
    return out.join('\n');
  }
  out.push('properties  visible-only ' + visP.length + '  ·  all ' + allP.length +
           '  ·  hidden ' + (allP.length - visP.length));
  out.push('units       visible-only ' + visU.length + '  ·  all ' + allU.length +
           '  ·  hidden ' + (allU.length - visU.length));
  if (allP.length === visP.length && allU.length === visU.length) {
    out.push('>> The parameter changed nothing. Either nothing is hidden in AppFolio, or');
    out.push('   property_directory ignores property_visibility. If offboarded properties');
    out.push('   exist and are not in this count, it is the latter — raise it with AppFolio.');
  } else {
    out.push('>> Hidden records ARE being recovered. Door history uses this wider set.');
  }

  out.push('');
  out.push('--- STEP 2: management_end_date, the only signal churn counts ---');
  var seen = {}, ended = [], zFlagged = [], zOverdue = [], zUndated = [], both = 0;
  allP.forEach(function (p) {
    var id = String(p.property_id || '');
    if (!id || seen[id]) return;
    seen[id] = true;
    var end = ymd_(p.management_end_date);
    var e = endingMgmt_(p);
    if (end) { ended.push({ p: p, id: id, date: end }); if (e) both++; }
    else if (e) {
      zFlagged.push({ p: p, id: id, date: e.date, raw: e.raw });
      if (e.date && e.date < t) zOverdue.push(e); else if (!e.date) zUndated.push(e);
    }
  });
  out.push(ended.length + ' propert' + (ended.length === 1 ? 'y has' : 'ies have') + ' the field set');
  if (ended.length) {
    var ds = ended.map(function (x) { return x.date; }).sort();
    out.push('  range ' + ds[0] + ' to ' + ds[ds.length - 1]);
    var wasVisible = 0;
    var visIds = {};
    visP.forEach(function (p) { visIds[String(p.property_id)] = 1; });
    ended.forEach(function (x) { if (visIds[x.id]) wasVisible++; });
    out.push('  of those, ' + wasVisible + ' appear in the visible-only pull and ' +
             (ended.length - wasVisible) + ' are hidden');
    if (ended.length - wasVisible > 0) {
      out.push('  >> CONFIRMED: ' + (ended.length - wasVisible) + ' ended propert' +
               (ended.length - wasVisible === 1 ? 'y was' : 'ies were') + ' invisible to the');
      out.push('     old pull. That is why lost doors read near zero. Fixed by the wider pull.');
    }
    var doors = 0;
    var unitsByProp = {};
    allU.forEach(function (u) {
      if (u.property_id) unitsByProp[String(u.property_id)] = (unitsByProp[String(u.property_id)] || 0) + 1;
    });
    ended.forEach(function (x) { doors += unitsByProp[x.id] || num_(x.p.units) || 0; });
    out.push('  doors attached to ended properties: ' + doors);
    var noUnits = ended.filter(function (x) { return !unitsByProp[x.id]; });
    if (noUnits.length) {
      out.push('  ' + noUnits.length + ' of them return NO units even with visibility:all,');
      out.push('  so their door count comes from the property\u2019s own units field.');
    }
    var noStart = ended.filter(function (x) { return !ymd_(x.p.management_start_date); });
    if (noStart.length) {
      out.push('  >> WARNING: ' + noStart.length + ' ended propert' +
               (noStart.length === 1 ? 'y has' : 'ies have') + ' no management_start_date, so');
      out.push('     their doors can never be placed in a month and will not appear as lost.');
      out.push('     ' + noStart.slice(0, 6).map(function (x) {
        return x.p.property_name || x.id; }).join(' | '));
    }
  } else {
    out.push('  >> Churn can only read 0%. Nothing has a completed offboarding date.');
  }

  out.push('');
  out.push('--- STEP 3: the z naming flag (scheduled, still managed, NOT churn) ---');
  out.push(zFlagged.length + ' flagged and still active');
  out.push('  past their date and still managed: ' + zOverdue.length);
  out.push('  no readable date in the name: ' + zUndated.length);
  if (zUndated.length) {
    out.push('  ' + zUndated.slice(0, 8).map(function (e) { return e.raw; }).join(' | '));
  }
  out.push(both + ' propert' + (both === 1 ? 'y carries' : 'ies carry') +
           ' both a z name and an end date (offboarded, name not tidied up)');

  out.push('');
  out.push('--- STEP 4: what the dashboard will show ---');
  var dh = readTab_('Door_History');
  if (!dh.length) {
    out.push('Door_History is empty — run rebuildPortfolio().');
  } else {
    var yr = dh.slice(-12);
    var lost = yr.reduce(function (a, r) { return a + (num_(r.lost_doors) || 0); }, 0);
    var gained = yr.reduce(function (a, r) { return a + (num_(r.new_doors) || 0); }, 0);
    out.push('last 12 months: +' + gained + ' new, -' + lost + ' lost, net ' + (gained - lost));
    var drift = 0;
    dh.forEach(function (r) {
      if (num_(r.doors_start) + num_(r.new_doors) - num_(r.lost_doors) !== num_(r.total_doors)) drift++;
    });
    out.push(drift ? '>> ' + drift + ' month(s) do not reconcile — report this.'
                   : 'running balance reconciles in every month');
  }

  var text = out.join('\n');
  Logger.log(text);
  return text;
}

// ============================================================ PERFORMANCE VIEW

/**
 * Why is a Performance tile blank?
 *
 * A tile needs four things to land: an entry in the registry, status active, a
 * calculation in CALC, and data for that calculation to find. A benchmark tick needs a
 * fifth — a benchmark block in the registry. On screen, all five failures looked the
 * same: a dash.
 *
 * This reports each one separately, per metric, and names the file to edit.
 */
function diagnosePerformanceView() {
  var out = [];
  var reg;
  try { reg = loadRegistry_(); }
  catch (e) {
    Logger.log('Registry could not be loaded: ' + e.message +
               '\nREGISTRY_FILE_ID may be unset or the file may have moved.');
    return 'Registry could not be loaded: ' + e.message;
  }
  var regMetrics = (reg && reg.metrics) || [];
  var rows = readTab_('Metrics').filter(function (r) { return r.period === 'ALL'; });
  var byId = indexBy_(rows, 'metric_id');

  out.push('REGISTRY: ' + regMetrics.length + ' metrics defined');
  out.push('METRICS TAB: ' + rows.length + ' rows with period=ALL');
  var lastRun = rows.length ? rows[0].run_date : '(never)';
  out.push('LAST computeMetrics RUN: ' + lastRun);
  out.push('');

  var byStatus = {}, noCalc = [], noBench = [], nullValue = [], live = [];
  regMetrics.forEach(function (m) {
    var st = String(m.status || 'active');
    byStatus[st] = (byStatus[st] || 0) + 1;
    var row = byId[m.id];
    var hasCalc = false;
    try { hasCalc = typeof CALC[m.id] === 'function'; } catch (e) {}
    var hasBench = !!(m.benchmark && (m.benchmark.median !== null && m.benchmark.median !== undefined
                                      && m.benchmark.median !== ''));
    if (!hasCalc && st !== 'deferred' && st !== 'blocked') noCalc.push(m.id);
    if (!hasBench) noBench.push(m.id);
    if (row && (row.value === null || row.value === '')) nullValue.push(m.id + ' [' + (row.status || '') + ']');
    if (row && row.value !== null && row.value !== '') live.push(m.id);
  });

  out.push('--- STATUS IN THE REGISTRY ---');
  Object.keys(byStatus).sort().forEach(function (k) {
    out.push('  ' + byStatus[k] + '  ' + k);
  });
  if (byStatus.deferred) {
    out.push('  >> ' + byStatus.deferred + ' metric(s) are DEFERRED. computeMetrics never even');
    out.push('     calls their calculation, so they publish a null no matter what data exists.');
    out.push('     LeadSimple is live now — any deferred LeadSimple metric needs its status');
    out.push('     changed to "active" in welease-metric-registry-v2.json.');
    var defs = regMetrics.filter(function (m) { return m.status === 'deferred'; });
    out.push('     ' + defs.map(function (m) {
      return m.id + ' (' + String(m.system || '?') + ')'; }).join(', '));
  }

  out.push('');
  out.push('--- BENCHMARKS ---');
  out.push(noBench.length + ' of ' + regMetrics.length + ' metrics have NO benchmark median.');
  if (noBench.length) {
    out.push('  Those tiles can never show a target tick. Not a bug — the registry simply');
    out.push('  has no survey figure for them. Add benchmark.median to the registry entry.');
    out.push('  ' + noBench.slice(0, 25).join(', '));
  }

  out.push('');
  out.push('--- CALCULATIONS ---');
  if (noCalc.length) {
    out.push(noCalc.length + ' active metric(s) have NO entry in CALC in Metrics.gs:');
    out.push('  ' + noCalc.join(', '));
  } else {
    out.push('Every active metric has a calculation.');
  }

  out.push('');
  out.push('--- WHAT LANDED ---');
  out.push(live.length + ' metric(s) published a value: ' + live.join(', '));
  out.push(nullValue.length + ' published a null:');
  nullValue.forEach(function (x) { out.push('  ' + x); });

  out.push('');
  out.push('--- TILES ON THE DASHBOARD ---');
  var wired = [], missing = [];
  (typeof TILE_GROUPS === 'undefined' ? [] : TILE_GROUPS).forEach(function (g) {
    g.metrics.forEach(function (id) {
      if (byId[id]) wired.push(id); else missing.push(g.label + ' -> ' + id);
    });
  });
  out.push(wired.length + ' tile id(s) resolve to a Metrics row.');
  if (missing.length) {
    out.push(missing.length + ' tile id(s) do NOT exist in the Metrics tab — these render');
    out.push('as a warning on the page. Fix the id in TILE_GROUPS (Dashboard.gs) or add the');
    out.push('metric to the registry:');
    missing.forEach(function (x) { out.push('  ' + x); });
  }

  out.push('');
  out.push('--- WHAT TO DO ---');
  if (byStatus.deferred) out.push('1. Flip deferred LeadSimple metrics to active in the registry.');
  if (noBench.length)    out.push('2. Add benchmark.median where you want a target tick.');
  if (noCalc.length)     out.push('3. Write the missing CALC entries, or mark those metrics deferred.');
  if (missing.length)    out.push('4. Correct the ids in TILE_GROUPS.');
  out.push('Then: computeMetrics() -> rebuildDashboardCache() -> new deployment version.');

  var text = out.join('\n');
  Logger.log(text);
  return text;
}

/**
 * The 64-versus-0 puzzle: the banner counts rows sitting on Unassigned while the
 * worksheet finds no properties without a manager. Both numbers cannot be right.
 */
function diagnoseUnassigned() {
  var out = [];
  var pm = pmLookup_();
  var props = readTab_('Properties_Units');
  var book = addressBook_();

  out.push('PM_Groups rows: ' + readTab_('PM_Groups').length);
  out.push('Properties with a PM-prefixed group: ' + Object.keys(pm).length);
  out.push('Properties_Units rows: ' + props.length);
  out.push('');

  var seen = {}, noGroup = [], closing = 0, excluded = 0, inactive = 0;
  props.forEach(function (p) {
    var id = String(p.property_id || '');
    if (!id || seen[id]) return;
    seen[id] = true;
    if (pm[id]) return;
    if (isExcluded_(p)) { excluded++; return; }
    if (!isActiveProperty_(p)) { inactive++; return; }
    if (isEndingMgmt_(p)) { closing++; return; }
    noGroup.push(p);
  });

  out.push('--- PROPERTIES WITH NO PM GROUP ---');
  out.push('reaching the worksheet: ' + noGroup.length);
  out.push('held back as excluded: ' + excluded);
  out.push('held back as management ended: ' + inactive);
  out.push('held back as closing (z name): ' + closing);
  noGroup.slice(0, 15).forEach(function (p) {
    out.push('   ' + String(p.property_id) + '  ' + (p.property_name || p.property || ''));
  });

  // THE ACTIONABLE PART: which lists produce Unassigned rows, and why.
  out.push('');
  out.push('--- WHERE THE UNASSIGNED ROWS ACTUALLY COME FROM ---');
  out.push('The banner counts ROWS across every list. A row lands on Unassigned when');
  out.push('pmOf_ cannot resolve it — which happens for three different reasons, and only');
  out.push('one of them is fixable in AppFolio.');
  out.push('');
  var U = [];
  try { U = urgencies_(pm); } catch (e) { out.push('  urgencies_ failed: ' + e.message); }

  var perBlock = [];
  U.forEach(function (b) {
    var un = b.rows.filter(function (r) { return r.pm === UNASSIGNED; });
    if (!un.length) return;

    // Classify the reason, using the first few rows as the sample.
    var noProp = 0, propUnknown = 0, propNoGroup = 0;
    un.forEach(function (r) {
      var src = r.src || {};
      var pid = src.property_id;
      if (pid === null || pid === undefined || pid === '') { noProp++; return; }
      if (!seen[String(pid)]) { propUnknown++; return; }
      propNoGroup++;
    });
    perBlock.push({ id: b.id, title: b.title, n: un.length,
                    noProp: noProp, unknown: propUnknown, noGroup: propNoGroup });
  });
  perBlock.sort(function (a, b) { return b.n - a.n; });

  var totNoProp = 0, totUnknown = 0, totNoGroup = 0;
  out.push('list                          rows   no property id   property not in   property has');
  out.push('                                     on the row       Properties_Units  no PM group');
  perBlock.forEach(function (b) {
    totNoProp += b.noProp; totUnknown += b.unknown; totNoGroup += b.noGroup;
    out.push('  ' + String(b.id).padEnd(28) + String(b.n).padStart(5) +
             String(b.noProp).padStart(17) + String(b.unknown).padStart(18) +
             String(b.noGroup).padStart(14));
  });
  out.push('  ' + 'TOTAL'.padEnd(28) + String(totNoProp + totUnknown + totNoGroup).padStart(5) +
           String(totNoProp).padStart(17) + String(totUnknown).padStart(18) +
           String(totNoGroup).padStart(14));

  out.push('');
  out.push('--- WHAT TO CLEAN ---');
  if (totNoGroup) {
    out.push(totNoGroup + ' row(s): the property EXISTS and simply has no PM-prefixed group.');
    out.push('   THIS is the fixable one. Add those properties to a PM group in AppFolio.');
    out.push('   They are listed on Performance under "Properties with no manager assigned".');
  }
  if (totUnknown) {
    out.push(totUnknown + ' row(s): the row carries a property_id that is not in');
    out.push('   Properties_Units at all. Usually a hidden or offboarded property whose');
    out.push('   records still appear on a financial report. Nothing to fix in AppFolio —');
    out.push('   these should be scoped out, not assigned.');
  }
  if (totNoProp) {
    out.push(totNoProp + ' row(s): the row has NO property_id. Vendor bills, owner-level');
    out.push('   charges and similar are not attached to a property, so no manager can ever');
    out.push('   be derived. Nothing to fix — the banner should not be counting these.');
  }
  out.push('');
  out.push('If the fixable count is 0 and the banner still shows a large number, the');
  out.push('banner is counting rows that were never assignable. Tell me the split above');
  out.push('and I will narrow what it counts.');
  var text = out.join('\n');
  Logger.log(text);
  return text;
}

// ============================================================ SHOWMOJO

/**
 * What ShowMojo actually returns, and whether its listing codes can be joined to
 * AppFolio.
 *
 * The registry's formulas for the ShowMojo metrics were written against fields that do
 * not exist — it assumed listing_and_showing_metrics carried listed_date, leased_date
 * and showings_count, when that report is an event log. This prints the real fields so
 * nobody writes against imagined ones again, and probes the listing_code join that
 * speed_to_listing and speed_to_first_applicant both depend on.
 */
function diagnoseShowMojo() {
  var out = [];
  out.push('Project timezone: ' + Session.getScriptTimeZone() + '   CFG.TZ: ' + CFG.TZ);
  if (Session.getScriptTimeZone() !== CFG.TZ) {
    out.push('  >> MISMATCH. ShowMojo parses dates in the ShowMojo account timezone.');
    out.push('     A mismatch shifts every date boundary and silently clips records.');
  }
  out.push('');

  out.push('--- TABS ---');
  ['SM_High_Level', 'SM_Listing_Performance', 'SM_Listings', 'SM_Showings',
   'SM_Listing_Showing', 'SM_Prospects', 'SM_Listing_Funnel'].forEach(function (t) {
    var rows = readTab_(t);
    var keys = rows.length ? Object.keys(rows[0]) : [];
    out.push('  ' + t + ': ' + rows.length + ' rows' +
             (keys.length ? '  [' + keys.slice(0, 12).join(', ') +
              (keys.length > 12 ? ', +' + (keys.length - 12) + ' more' : '') + ']' : ''));
  });

  out.push('');
  out.push('--- PII CHECK ---');
  var leaked = [];
  ['SM_Showings', 'SM_Prospects', 'SM_Listings'].forEach(function (t) {
    var rows = readTab_(t);
    if (!rows.length) return;
    Object.keys(rows[0]).forEach(function (k) {
      if (SM_DROP_FIELDS.indexOf(k) !== -1) leaked.push(t + '.' + k);
    });
  });
  out.push(leaked.length
    ? '  >> PERSONAL DATA PRESENT: ' + leaked.join(', ') + ' — SM_DROP_FIELDS did not apply.'
    : '  No name, email, phone or free-text note fields reached the sheet.');

  out.push('');
  out.push('--- MARKET STATUS VALUES ---');
  var st = {};
  readTab_('SM_Listings').forEach(function (r) {
    var k = String(r.market_status || '(blank)');
    st[k] = (st[k] || 0) + 1;
  });
  var keys = Object.keys(st);
  if (!keys.length) out.push('  SM_Listings is empty.');
  keys.sort(function (a, b) { return st[b] - st[a]; }).forEach(function (k) {
    var leasedLike = /leas|rent|off.?market|inactive/i.test(k);
    out.push('  ' + String(st[k]).padStart(4) + '  ' + k + (leasedLike ? '   <- counted as leased' : ''));
  });
  out.push('  showings_per_lease treats the marked values as leased. If that is wrong,');
  out.push('  widen or narrow the pattern in CALC.showings_per_lease.');

  out.push('');
  out.push('--- LISTING CODE -> APPFOLIO JOIN ---');
  out.push('CORRECTION: an earlier version of this diagnostic reported that most codes');
  out.push('"contain an AppFolio unit_id". That was a substring test against ids like "6"');
  out.push('and "2", which appear inside every street number and zip. It matched noise.');
  out.push('listing_code is an ADDRESS, not an id:');
  out.push('  AppfolioAPI-<STREET>-<ZIP>-<BEDS>-<BATHS>-<UNIT?>');
  out.push('');
  var codes = readTab_('SM_Listings').map(function (r) { return String(r.listing_code || ''); })
                                     .filter(function (c) { return c; });
  if (!codes.length) {
    out.push('  No listing_code values to inspect.');
  } else {
    var parsed = 0, withUnit = 0;
    codes.forEach(function (c) {
      var p = smCodeParse_(c);
      if (p) { parsed++; if (p.unit) withUnit++; }
    });
    out.push('  ' + codes.length + ' codes · ' + parsed + ' parse cleanly · ' +
             withUnit + ' carry a unit');
    out.push('  samples:');
    codes.slice(0, 4).forEach(function (c) {
      var p = smCodeParse_(c);
      out.push('    ' + c);
      out.push('      -> street "' + (p ? p.street : '?') + '"  zip ' + (p ? p.zip : '?') +
               '  unit "' + (p && p.unit ? p.unit : '(none)') + '"');
    });

    var j = readTab_('SM_Unit_Join').filter(function (r) { return r.unit_id; });
    var ex = readTab_('_sm_join_exceptions').filter(function (r) { return r.source === 'listing_join'; });
    out.push('');
    if (!j.length && !ex.length) {
      out.push('  buildShowMojoJoin() has not run yet. Run it, then re-run this.');
    } else {
      var rate = codes.length ? Math.round(j.length / codes.length * 100) : 0;
      out.push('  JOINED: ' + j.length + ' of ' + codes.length + ' (' + rate + '%)');
      var why = {};
      ex.forEach(function (r) { var k = r.reason || 'unknown'; why[k] = (why[k] || 0) + 1; });
      Object.keys(why).sort(function (a, b) { return why[b] - why[a]; }).forEach(function (k) {
        out.push('    ' + String(why[k]).padStart(4) + '  ' + k);
      });
      if (rate >= 60) {
        out.push('  >> Good enough to build on. speed_to_listing, speed_to_first_applicant');
        out.push('     and showings_per_lease all read this join.');
      } else {
        out.push('  >> Below 60%. Those metrics describe the matched subset, not the');
        out.push('     portfolio, and say so in their notes. The reasons above tell you');
        out.push('     whether it is address formatting or genuinely missing units.');
      }
    }
  }

  out.push('');
  out.push('--- WHAT "OFF MARKET" MEANS ---');
  out.push('ShowMojo has no leased status. A listing goes off market when it leases, when');
  out.push('the owner pulls it, or when it is paused. showings_per_lease therefore counts');
  out.push('a listing as leased only when its joined AppFolio unit recorded a move-in');
  out.push('after it left the market. Off-market listings with no move-in are withdrawals.');

  var text = out.join('\n');
  Logger.log(text);
  return text;
}

// ============================================================ RENT TIMING

/**
 * How much of each month the rent-timing trend actually covers.
 *
 * The measure depends on knowing a household's rent, and the only rent this pipeline
 * stores is today's. Former residents have none at all. This prints, per month, how
 * many occupancy-months were measurable against how many produced receipts — so the
 * older the month, the more obvious the gap becomes.
 */
/**
 * Does the rent-timing picture agree with what is actually outstanding?
 *
 * The two numbers come from opposite directions — timing is built from receipts, the
 * aged receivables are built from charges — so if they agree, the picture is real. If
 * they do not, this says by how much and in which direction, which is the part that
 * every previous round of this argument was missing.
 *
 * Run it whenever the timing chart looks wrong. It answers in one screen.
 */
function reconcileRentTiming() {
  var out = [];
  var thisMonth = monthKey_(ymd_(today_()));
  var day = today_().getDate();

  var timing = readTab_('Rent_Timing').filter(function (r) {
    return monthNorm_(r.month) === thisMonth; })[0];
  if (!timing) {
    Logger.log('No Rent_Timing row for ' + thisMonth + ' — run rebuildPortfolio().');
    return 'No row for ' + thisMonth;
  }

  out.push('RENT TIMING vs WHAT IS OUTSTANDING  ·  ' + thisMonth + ', day ' + day);
  out.push('');
  out.push('From receipts (Rent_Timing):');
  out.push('  households on the rent roll   ' + timing.households);
  out.push('  satisfied before the 1st      ' + (timing.before_1st || 0) +
           '   <- prepayment, applied on the 1st');
  out.push('  satisfied on the 1st          ' + (timing.on_1st || 0));
  out.push('  2nd to 5th                    ' +
           ((num_(timing.on_2nd) || 0) + (num_(timing.on_3rd) || 0) +
            (num_(timing.on_4th) || 0) + (num_(timing.on_5th) || 0)));
  out.push('  after the 5th                 ' + (timing.after_5th || 0));
  out.push('  nothing that reaches the rent ' + (timing.short_paid || 0));
  out.push('  window closed                 ' + (timing.window_closed || 'YES'));

  // The independent check. These are built from charges, not receipts.
  var owes = 0, owesRent = 0, total = 0, aged0 = 0;
  readTab_('Delinquency_Aged').forEach(function (d) {
    var st = String(d.tenant_status || '').toLowerCase();
    if (st.indexOf('current') === -1 && st.indexOf('notice') === -1) return;
    owes++;
    if ((num_(d.delinquent_rent) || 0) > 0) owesRent++;
    total += num_(d.amount_receivable) || 0;
    aged0 += num_(d['00_to30']) || num_(d['0_to30']) || 0;
  });

  var live = readTab_('Rent_Roll').filter(function (r) {
    var st = String(r.status || '').toLowerCase();
    return st.indexOf('current') !== -1 || st.indexOf('notice') !== -1;
  }).length;

  out.push('');
  out.push('From the aged receivables (independent of receipts):');
  out.push('  live households               ' + live);
  out.push('  owing anything                ' + owes);
  out.push('  owing RENT                    ' + owesRent);
  out.push('  paid up entirely              ' + (live - owes));
  out.push('  balance outstanding           $' + Math.round(total));
  out.push('  of which 0-30 days            $' + Math.round(aged0) +
           '   <- mostly this month, charged on the 1st');

  // The comparison that settles it.
  var timingLate = (num_(timing.after_5th) || 0) + (num_(timing.short_paid) || 0);
  out.push('');
  out.push('THE COMPARISON:');
  out.push('  timing says not yet paid      ' + timingLate);
  out.push('  receivables say owing rent    ' + owesRent);
  var gap = timingLate - owesRent;
  if (Math.abs(gap) <= Math.max(5, owesRent * 0.15)) {
    out.push('  -> they agree. The picture is real.');
  } else if (gap > 0) {
    out.push('  -> timing reports ' + gap + ' MORE unpaid than actually owe rent.');
    out.push('     That is the prepayment gap: households whose money arrived last month.');
    out.push('     If this is large after a rebuild, the carry-forward is not reaching them.');
  } else {
    out.push('  -> timing reports ' + (-gap) + ' FEWER unpaid than owe rent.');
    out.push('     Receipts are being credited that the ledger has not settled.');
  }
  if (String(timing.window_closed) === 'NO') {
    out.push('');
    out.push('  NOTE: day ' + day + '. The month has not reached the 5th, so "after the 5th"');
    out.push('  cannot mean anything yet. The headline on screen uses the last closed month.');
  }

  Logger.log(out.join('\n'));
  return out.join('\n');
}

function diagnoseRentTiming() {
  var out = [];
  var rec = inScopeIncludingInactive_(readTab_('Receivables_Activity'));
  var rr = dropTPO_(readTab_('Rent_Roll'));
  var rentByOcc = {};
