function setupSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), made = [], failed = [];
  var tabs = TABS_ACTIVE.slice();
  Object.keys(TABS_DEFERRED).forEach(function (s) {
    if (systemEnabled_(s)) tabs = tabs.concat(TABS_DEFERRED[s]);
  });

  // ONE call to list the sheets, not one per tab.
  //
  // This used to run ss.getSheetByName() inside the loop — around seventy round trips to the
  // Spreadsheet service on a file that now holds sixty-odd tabs of real data, and on
  // 2026-08-17 it timed out. Reading the names once and comparing in memory turns that into
  // a single call plus one insert per genuinely missing tab, which on a normal run is zero.
  var existing = {};
  ss.getSheets().forEach(function (sh) { existing[sh.getName()] = true; });

  var missing = tabs.filter(function (t) { return !existing[t]; });
  missing.forEach(function (t, i) {
    // Per-tab try/catch: if the service does time out part way, we keep the record of what
    // was created rather than losing the whole run and not knowing where it stopped.
    try {
      ss.insertSheet(t);
      made.push(t);
      // Flush every few inserts so the work is committed incrementally.
      if (i % 5 === 4) SpreadsheetApp.flush();
    } catch (e) {
      failed.push(t + ' (' + String(e.message).slice(0, 60) + ')');
    }
  });
  if (failed.length) {
    logError_('setup', 'setupSheets',
      failed.length + ' tab(s) could not be created: ' + failed.join(', ') +
      '. Re-run setupSheets() — it only creates what is missing, so running it again is safe ' +
      'and picks up where this stopped.');
  }
  try { setupAcknowledgments(); } catch (e) { logError_('setup', 'acknowledgments', e.message); }
  try { setupExclusions(); } catch (e) { logError_('setup', 'exclusions', e.message); }
  try { setupExcludedTenancies(); } catch (e) { logError_('setup', 'tenancies', e.message); }
  try { if (typeof setupItemStatus === 'function') setupItemStatus(); }
  catch (e) { logError_('setup', 'item status', e.message); }
  try { if (typeof setupMasterScope === 'function') setupMasterScope(); }
  catch (e) { logError_('setup', 'master scope', e.message); }
  try { setupTeamRoster(); } catch (e) { logError_('setup', 'team roster', e.message); }
  try { if (typeof setupOwnerUpdateScope === 'function') setupOwnerUpdateScope(); }
  catch (e) { logError_('setup', 'owner update scope', e.message); }
  try { if (typeof setupDealReview === 'function') setupDealReview(); }
  catch (e) { logError_('setup', 'deal review', e.message); }
  logRun_('setupSheets', 'system', '-', made.length, 0,
          tabs.length + ' expected · ' + missing.length + ' missing · created: ' +
          (made.join(', ') || 'none') + (failed.length ? ' · FAILED: ' + failed.join(', ') : ''));
  return made;
}

/**
 * The one number no API can supply.
 *
 * units_per_team_member needs a headcount. Inferring it from who has open work would
 * drop anyone having a quiet week, so it is a tab a person maintains.
 */
function setupTeamRoster() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Team_Roster') || ss.insertSheet('Team_Roster');
  if (sh.getLastRow() > 0) return 'already exists';
  sh.getRange(1, 1, 1, 4).setValues([['name', 'role', 'fte', 'counts_toward_ratio']])
    .setFontWeight('bold');
  sh.setFrozenRows(1);
  sh.getRange(3, 1).setValue(
    'One row per person. fte blank counts as 1; use 0.5 for half time. Set ' +
    'counts_toward_ratio to NO for anyone who does not carry doors (bookkeeping, ' +
    'marketing). Only units_per_team_member reads this tab.');
  return 'created';
}

function verifyConnections() {
  var r = [];
  Object.keys(SYSTEMS).forEach(function (name) {
    var s = SYSTEMS[name];
    if (!s.enabled) { r.push(s.label + ' DISABLED — ' + (s.blockedReason || 'not configured')); return; }
    try {
      if (name === 'appfolio') {
        r.push('AppFolio OK — property_directory returned ' +
               afReport_('property_directory', {}, { maxPages: 1 }).length + ' rows');
      } else if (name === 'leadsimple') {
        // lsGet2_, not lsGet_. The retired adapter was still wired in here, so this check
        // reported "LeadSimple FAILED" every time while LeadSimple was working fine — a
        // verifier that lies is worse than no verifier, because it sends you debugging a
        // connection that was never down.
        var acct = (lsGet2_('/info/account', {}, 1) || {}).data || {};
        r.push('LeadSimple OK — account "' + (acct.name || '?') + '" (id ' + (acct.id || '?') + ')');
      } else if (name === 'showmojo') {
        // smFetch_, not smReport_ — same reason.
        r.push('ShowMojo OK — high_level_metrics returned ' +
               smFetch_('high_level_metrics', ymd_(addDays_(today_(), -7)), ymd_(today_())).length +
               ' rows');
      }
    } catch (e) { r.push(s.label + ' FAILED — ' + e.message.slice(0, 250)); }
  });

  try {
    var reg = loadRegistry_();
    var act = activeMetrics_(), def = deferredMetrics_();
    r.push('Registry OK — v' + reg.version + ' · ' + reg.metrics.length + ' total · ' +
           act.length + ' active · ' + def.length + ' deferred · ' +
           act.filter(function (m) { return m.status === 'tracked'; }).length + ' shippable');
  } catch (e) { r.push('Registry FAILED — ' + e.message.slice(0, 250)); }

  Logger.log(r.join('\n'));
  logRun_('verifyConnections', 'system', '-', r.length, 0, r.join(' | '));
  return r;
}

/**
 * The nightly schedule, in one place.
 *
 * installTriggers() creates these and verifyTriggers() checks them against what is
 * actually installed. They used to be separate lists, which is how a schedule drifts
 * from the thing that is supposed to verify it.
 */
function expectedTriggers_() {
  var jobs = [
    { fn: 'rebuildAll', h: 2, m: 0 },
    { fn: 'rebuildFinancials', h: 2, m: 30 },
    { fn: 'rebuildLeasing', h: 3, m: 0 },
    { fn: 'rebuildCompliance', h: 3, m: 30 },
    { fn: 'rebuildCollections', h: 3, m: 45 },
    { fn: 'rebuildPortfolio', h: 4, m: 0 },
    { fn: 'rebuildMasterScope', h: 4, m: 10 },
    { fn: 'buildUtilitySchedule', h: 4, m: 15 },
    { fn: 'rebuildLeadSimple', h: 4, m: 20 },
    { fn: 'rebuildShowMojo', h: 4, m: 25 },
    { fn: 'computeMetrics', h: 4, m: 30 },
    { fn: 'rebuildDataQuality', h: 4, m: 45 },
    { fn: 'rebuildThroughput', h: 4, m: 50 },
    // The notice filler reads this. It runs before the cache rather than after, so that a
    // morning notice is filled from the same pull the dashboard is showing.
    { fn: 'buildNoticeMergeFeed', h: 4, m: 55 },
    { fn: 'rebuildDashboardCache', h: 5, m: 0 },
    // MONTHLY, not daily. The snapshot freezes a closed month for the review; running it
    // nightly would overwrite the thing whose whole value is that it does not change.
    // The 15th matches the renewal process cadence the team already works to.
    { fn: 'exportMonthlySnapshot', h: 6, m: 0, dayOfMonth: 15 },
    // DAILY, at 05:30 — after rebuildDashboardCache at 05:00, which is the last of the
    // nightly chain. The export copies the tabs those jobs just rebuilt; running it before
    // them would ship yesterday's numbers under today's date.
    { fn: 'exportDailySnapshot', h: 5, m: 30 },
    // The weekly roll-up, Monday morning, so it is on the screen before Tuesday's meeting.
    { fn: 'buildWeeklyReport', h: 6, m: 30, weekDay: 'MONDAY' }
  ];
  return jobs.filter(function (j) {
    if (j.fn === 'rebuildLeadSimple') return systemEnabled_('leadsimple');
    if (j.fn === 'rebuildShowMojo') return systemEnabled_('showmojo');
    var ok = false;
    try { ok = typeof eval(j.fn) === 'function'; } catch (e) {}
    return ok;
  });
}

function installTriggers() {
  ScriptApp.getProjectTriggers().forEach(function (t) { ScriptApp.deleteTrigger(t); });
  var jobs = expectedTriggers_();
  jobs.forEach(function (j) {
    var b = ScriptApp.newTrigger(j.fn).timeBased().atHour(j.h).nearMinute(j.m);
    // onMonthDay, onWeekDay and everyDays are mutually exclusive — calling two throws.
    if (j.dayOfMonth) b.onMonthDay(j.dayOfMonth);
    else if (j.weekDay) b.onWeekDay(ScriptApp.WeekDay[j.weekDay]);
    else b.everyDays(1);
    b.inTimezone(CFG.TZ).create();
  });
  logRun_('installTriggers', 'system', '-', jobs.length, 0,
          jobs.map(function (j) { return j.fn; }).join(', '));
  Logger.log(jobs.length + ' trigger(s) installed:\n' +
    jobs.map(function (j) {
      return '  ' + String(j.h).padStart(2, '0') + ':' + String(j.m).padStart(2, '0') + '  ' +
             j.fn + (j.dayOfMonth ? '   (monthly, on the ' + j.dayOfMonth + 'th)'
                   : j.weekDay ? '   (weekly, ' + j.weekDay.toLowerCase() + ')' : '');
    }).join('\n') +
    '\n\nEvery previous trigger was deleted first, including any continuation from a ' +
    'resumable job. If a seed or a refresh was mid-flight, restart it.');
  return jobs.map(function (j) { return j.fn; });
}
