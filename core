}

/** Only metrics whose source system is currently enabled. */
function activeMetrics_() {
  return loadRegistry_().metrics.filter(function (m) {
    var root = String(m.system).split('+')[0];
    return systemEnabled_(root) && m.status !== 'deferred';
  });
}

function deferredMetrics_() {
  return loadRegistry_().metrics.filter(function (m) { return m.status === 'deferred'; });
}


// ============================================================ FOUNDATION
//
// Helpers every module depends on. They previously lived in Discover_v2.gs (a
// DIAGNOSTICS file that someone will eventually delete), in Metrics.gs, and in
// Dashboard.gs. readTab_ alone was called 84 times from nine files while being defined
// in the metrics module. Deleting a diagnostics file should never break the pipeline,
// so anything foundational lives here.

/**
 * Rate-limit pacing. Null-safe by design: a missing or renamed constant should
 * slow us down, never abort a run mid-discovery. (This is exactly what broke the
 * 2026-08-05 run — Utilities.sleep(undefined) throws.)
 * Lives here for now; moves to Core when Core is next reissued.
 */
function sleepFor_(systemName) {
  var ms = (SYSTEMS[systemName] && SYSTEMS[systemName].sleepMs) || 2500;
  Utilities.sleep(ms);
}

function finding_(out, system, question, answer, action) {
  out.push({ system: system, question: question, answer: String(answer).slice(0, 900),
             action_required: action || null, discovered_at: nowStamp_() });
}

function distinctWithCounts_(rows, field, limit) {
  var counts = {};
  rows.forEach(function (r) {
    var v = r[field];
    if (v === null || v === undefined || v === '') v = '(null)';
    counts[v] = (counts[v] || 0) + 1;
  });
  return Object.keys(counts).sort(function (a, b) { return counts[b] - counts[a]; })
    .slice(0, limit || 40).map(function (k) { return k + ' (' + counts[k] + ')'; }).join(' \u00b7 ');
}

function fillRate_(rows, field) {
  if (!rows.length) return '0/0';
  var f = rows.filter(function (r) {
    return r[field] !== null && r[field] !== undefined && r[field] !== '';
  }).length;
  return f + '/' + rows.length + ' (' + Math.round(f / rows.length * 100) + '%)';
}

/**
 * Reads a tab into objects, MEMOISED for the life of the execution.
 *
 * Without the cache the dashboard re-read the same sheets a dozen times — Work_Orders
 * and Rent_Roll run to thousands of rows, and getDataRange().getValues() is the
 * expensive call in Apps Script. That is what pushed page rendering past the timeout.
 */
/**
 * Read-through cache for tab reads.
 *
 * Lived in Metrics.gs, which meant every readTab_ call in the project depended on a
 * variable declared in an unrelated file — delete or fail to paste that one file and
 * the whole pipeline throws. It belongs with the function that uses it.
 */
var _tabCache = {};

function readTab_(name) {
  if (name in _tabCache) return _tabCache[name];
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
  if (!sh || sh.getLastRow() < 2) { _tabCache[name] = []; return _tabCache[name]; }
  var vals = sh.getDataRange().getValues();
  var hdr = vals[0];
  _tabCache[name] = vals.slice(1).map(function (row) {
    var o = {};
    for (var i = 0; i < hdr.length; i++) {
      var v = row[i];
      // Sheets coerces anything date-shaped into a Date, which stringifies as
      // "Aug 31 2025 23:00:00 GMT-0700 (Pacific Daylight Time)" when rendered.
      // Normalise on the way in so nothing downstream has to care.
      if (v instanceof Date) v = Utilities.formatDate(v, CFG.TZ, 'yyyy-MM-dd');
      o[hdr[i]] = (v === '') ? null : v;
    }
    return o;
  });
  return _tabCache[name];
}

/** Jobs that rewrite a tab must clear it, or later reads in the same run go stale. */
/**
 * Empty a tab without the "No rows returned" sentinel.
 *
 * writeTab_(tab, []) clears the sheet and writes a placeholder string into A1, which is
 * right for a report that legitimately returned nothing and very wrong for a scratch tab
 * you are just draining. Using it on the Metrics tab destroyed a full set of metrics.
 */
function clearTabRows_(tabName) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(tabName);
  if (!sh) return 0;
  sh.clear();
  try { invalidateTab_(tabName); } catch (e) {}
  return 0;
}

function invalidateTab_(name) {
  if (name) delete _tabCache[name]; else _tabCache = {};
}

function round1_(x) { return x === null || x === undefined ? null : Math.round(x * 10) / 10; }

function round2_(x) { return x === null || x === undefined ? null : Math.round(x * 100) / 100; }

/**
 * Rounding applied to every number published to the Metrics tab.
 *
 * median_ averages the two middle values when n is even, and a plain / 2 in binary
 * floating point produces 1.2650000000000001. That went straight into the sheet and
 * onto the dashboard. It is not specific to renewal increases — any metric built on
 * a median or a raw division can leak it, so this is applied once at the boundary
 * rather than patched into individual calculations.
 *
 * Four decimal places: enough to keep a rate meaningful, short enough that the
 * artefact cannot survive it.
 */
var PUBLISH_DP = 4;

function publishNum_(x) {
  if (x === null || x === undefined || x === '') return x;
  var n = Number(x);
  if (typeof x === 'boolean' || !isFinite(n)) return x;
  if (typeof x === 'string' && String(n) !== x.trim()) return x;   // real text, leave alone
  var f = Math.pow(10, PUBLISH_DP);
  return Math.round(n * f) / f;
}

function esc_(s) {
  if (s === null || s === undefined) return '';
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function money_(v) {
  var n = num_(v);
  if (n === null) return '\u2014';
  return '$' + Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
