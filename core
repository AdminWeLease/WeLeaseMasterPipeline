function today_() { return new Date(); }

function ymd_(d) {
  if (!d) return null;
  d = parseDate_(d);
  return (!d || isNaN(d.getTime())) ? null : Utilities.formatDate(d, CFG.TZ, 'yyyy-MM-dd');
}

/**
 * Parses the date formats AppFolio actually returns.
 *
 * PREVIOUS BUG: this appended 'T00:00:00' to ANY 10-character string so that ISO dates
 * read at local midnight rather than UTC. A zero-padded US date is also 10 characters,
 * so '06/12/2026' became '06/12/2026T00:00:00' and returned NULL — silently, and
 * indistinguishably from a date that was simply absent. Padded slash dates appear in
 * charge descriptions, which is exactly where the utility service periods live.
 *
 * Now the ISO fixup is applied only to strings that are actually ISO.
 */
function parseDate_(s) {
  if (!s) return null;
  if (s instanceof Date) return s;
  s = String(s).trim();
  if (!s) return null;
  var iso = /^\d{4}-\d{2}-\d{2}$/.test(s);
  var d = new Date(iso ? s + 'T00:00:00' : s);
  return isNaN(d.getTime()) ? null : d;
}

function daysBetween_(a, b) {
  a = parseDate_(a); b = parseDate_(b);
  return (!a || !b) ? null : Math.round((b - a) / 86400000);
}

/**
 * Human day label. ONE implementation, used by every list.
 *
 * "in 21 days" and "21 days ago" instead of "21d". The abbreviation saved four
 * characters and cost a beat of translation on every row, on a page people read
 * dozens of times a day.
 *
 * Positive is the future, negative is the past. Singular is handled, so nothing
 * ever reads "in 1 days".
 */
function dayLabel_(days) {
  if (days === null || days === undefined || days === '') return '';
  var n = Math.round(Number(days));
  if (!isFinite(n)) return '';
  if (n === 0)  return 'today';
  if (n === 1)  return 'tomorrow';
  if (n === -1) return 'yesterday';
  var abs = Math.abs(n), unit = abs === 1 ? 'day' : 'days';
  return n > 0 ? 'in ' + abs + ' ' + unit : abs + ' ' + unit + ' ago';
}

/**
 * Elapsed duration, with no direction implied — for "open 34 days", "vacant 61
 * days", where the number is an age rather than a countdown.
 */
function daySpan_(days) {
  if (days === null || days === undefined || days === '') return '';
  var n = Math.round(Number(days));
  if (!isFinite(n)) return '';
  return n + (Math.abs(n) === 1 ? ' day' : ' days');
}

/**
 * Overdue phrasing, for a deadline that has already passed.
 * Falls through to dayLabel_ while the deadline is still ahead.
 */
function dayOverdue_(days) {
  if (days === null || days === undefined || days === '') return '';
  var n = Math.round(Number(days));
  if (!isFinite(n)) return '';
  if (n >= 0) return dayLabel_(n);
  var abs = Math.abs(n);
  return abs + (abs === 1 ? ' day' : ' days') + ' overdue';
}

function addDays_(d, n) {
