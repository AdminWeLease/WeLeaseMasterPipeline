}

/** ShowMojo: form-urlencoded (NOT JSON), and no pagination — always bound by date. */
function smReport_(reportName, startDate, endDate, opts) {
  // Retired, not deleted, so the failure names itself rather than 401-ing quietly.
  //
  // Two bugs, both verified 2026-08-12:
  //   1. Sent 'Bearer <token>'. ShowMojo requires  Token token="<token>"  and returns
  //      401 for anything else.
  //   2. Read data.results / data.data at the top level. Every ShowMojo response wraps
  //      results as {"response":{"status":..,"data":[..]}}, so this found nothing even
  //      when the call succeeded.
  //
  // ShowMojo.gs does it correctly. This is the same shape of mistake as LeadSimple's
  // LS_AUTH_MODE default — a one-line auth error recorded as a vendor problem.
  throw new Error('smReport_ is retired. Use smFetch_ in ShowMojo.gs — this adapter ' +
                  'sent a Bearer header and never unwrapped the response envelope.');
}

function httpWithRetry_(url, options, system) {
  var attempt = 0, lastErr = null;
  while (attempt <= CFG.MAX_RETRIES) {
    var resp;
    try { resp = UrlFetchApp.fetch(url, options); }
    catch (e) {
      lastErr = e;
      Utilities.sleep(CFG.BACKOFF_BASE_MS * Math.pow(2, attempt++));
      continue;
    }
    var code = resp.getResponseCode(), text = resp.getContentText();

    if (code >= 200 && code < 300) {
      try { return { code: code, parsed: JSON.parse(text), raw: text }; }
      catch (e) { throw new Error(system + ' returned non-JSON (HTTP ' + code + '): ' + text.slice(0, 300)); }
    }
    if (code === 429) {
      // attempt++ used to live in the FALSE branch of the ternary only. When the API
      // sends a retry-after header — which is exactly when a real 429 happens — the
      // counter never moved and `while (attempt <= MAX_RETRIES)` never terminated. It
      // did not give up after four tries; it spun until Apps Script killed the
      // execution at six minutes, with no partial result and no readable error.
      // Applies to every API here, AppFolio included.
      var h = resp.getAllHeaders();
      var wait = parseInt(h['X-RateLimit-Retry-After'] || h['x-ratelimit-retry-after'] || 0, 10);
      attempt++;
      Utilities.sleep(wait > 0 ? wait * 1000 : CFG.BACKOFF_BASE_MS * Math.pow(2, attempt));
      continue;
    }
    if (code >= 500) {
      lastErr = new Error(system + ' HTTP ' + code + ': ' + text.slice(0, 200));
      Utilities.sleep(CFG.BACKOFF_BASE_MS * Math.pow(2, attempt++));
      continue;
    }
    // 4xx other than 429 — not retryable. Fail loudly: AppFolio 400 bodies name
    // the exact filter combination that broke.
    throw new Error(system + ' HTTP ' + code + ' — ' + url + '\n' + text.slice(0, 500));
  }
  throw lastErr || new Error(system + ': exhausted retries for ' + url);
}

function buildQuery_(obj) {
  return Object.keys(obj).filter(function (k) {
    return obj[k] !== null && obj[k] !== undefined && obj[k] !== '';
  }).map(function (k) {
    return encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]);
  }).join('&');
}

// ============================================================ SHEET I/O

/** Empty dates write as null, never '' — empty strings break Looker type detection. */
function writeTab_(tabName, rows, opts) {
  opts = opts || {};
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(tabName) || ss.insertSheet(tabName);

  if (!rows || !rows.length) {
    sh.clear();
    sh.getRange(1, 1).setValue('No rows returned ' + nowStamp_());
    return 0;
  }
  var headers = opts.headers || unionKeys_(rows);
  var out = [headers];
  rows.forEach(function (r) {
    out.push(headers.map(function (h) {
      var v = r[h];
      if (v === undefined || v === '' || v === null) return null;
      return (typeof v === 'object') ? JSON.stringify(v) : v;
    }));
  });
  sh.clear();
  // Plain-text format on month columns BEFORE the values land. '2026-08' is a date-like
  // string, so Sheets stores it as a real date and readTab_ hands back a Date — which is
  // how an August figure came to be labelled July on the rent tile. monthNorm_ repairs it
  // on read; this stops it happening. Applied to any column named month or *_month.
  var monthCols = [];
  headers.forEach(function (h, i) {
    if (/^month$|_month$|^month_/.test(String(h))) monthCols.push(i + 1);
  });
  monthCols.forEach(function (c) {
    try { sh.getRange(2, c, Math.max(1, out.length - 1), 1).setNumberFormat('@'); } catch (e) {}
  });

  sh.getRange(1, 1, out.length, headers.length).setValues(out);
  sh.setFrozenRows(1);
  sh.getRange(1, 1, 1, headers.length).setFontWeight('bold');
  try { invalidateTab_(tabName); } catch (e) {}
  return rows.length;
}

/**
 * Append rows to a tab, keeping to whatever header row the sheet already has.
 *
 * WHY THIS READS THE SHEET'S OWN HEADER. The old version wrote a header only when the tab
 * was empty, then wrote every subsequent batch positionally against the headers the CALLER
 * computed. The moment a builder gained a field, the two disagreed and every value after
 * the new one landed one column to the left of its heading — silently, in a tab that had
 * been correct for months.
 *
 * That is exactly what adding `view` to the Throughput ledger did: `view` went into the
 * `open_now` column, `open_now` into `added`, and so on down the row. Nothing errored.
 * The Throughput panel simply started reading a tab name where it expected a count.
 *
 * So the sheet's header row is now the authority. A key the sheet has never seen is added
 * as a NEW column at the end, which is safe for readers (they key by name) and reversible.
 * A key the caller omits writes blank rather than shifting the row.
 */
function appendTab_(tabName, rows, headers) {
  if (!rows || !rows.length) return 0;
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(tabName) || ss.insertSheet(tabName);
  headers = headers || unionKeys_(rows);

  if (sh.getLastRow() === 0) {
    sh.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold');
    sh.setFrozenRows(1);
  } else {
    // Reconcile against what is actually on the sheet.
    var live = sh.getRange(1, 1, 1, Math.max(1, sh.getLastColumn())).getValues()[0]
      .map(function (h) { return String(h === null || h === undefined ? '' : h).trim(); });
    while (live.length && !live[live.length - 1]) live.pop();

    if (live.length) {
      var have = {};
      live.forEach(function (h) { have[h] = true; });
      // Any key on the incoming rows that the sheet has no column for.
      var extra = [];
      var wanted = unionKeys_(rows);
      headers.concat(wanted).forEach(function (h) {
        if (h && !have[h] && extra.indexOf(h) === -1) extra.push(h);
      });
      if (extra.length) {
        sh.getRange(1, live.length + 1, 1, extra.length)
          .setValues([extra]).setFontWeight('bold');
        // Guarded: logError_ appends, so logging a header change on the ERROR tab itself
        // would call back into here. Silence there rather than risk the loop.
        if (tabName !== CFG.ERROR_TAB) {
          logError_('core', 'appendTab_',
            tabName + ': added column' + (extra.length > 1 ? 's' : '') + ' ' + extra.join(', ') +
            ' to match the data. Rows written before now hold no value there.');
        }
      }
      headers = live.concat(extra);
    }
  }

  var out = rows.map(function (r) {
    return headers.map(function (h) {
      var v = r[h];
      // typeof null === 'object', so the old one-liner sent null to JSON.stringify and
      // wrote the literal text "null" into the cell. Every tab written through here
      // carries those — Metrics_History, LS_Tasks_Completed, the lot — and they read
      // back as a four-character string rather than an empty cell. writeTab_ always
      // checked for null; this did not.
      if (v === undefined || v === '' || v === null) return null;
      return (typeof v === 'object') ? JSON.stringify(v) : v;
    });
  });
  sh.getRange(sh.getLastRow() + 1, 1, out.length, headers.length).setValues(out);
  try { invalidateTab_(tabName); } catch (e) {}
  return out.length;
}

function unionKeys_(rows) {
  var seen = {}, keys = [];
  for (var i = 0; i < Math.min(rows.length, 200); i++) {
    for (var k in rows[i]) if (!seen[k]) { seen[k] = true; keys.push(k); }
  }
  return keys;
}

/**
 * NEITHER OF THESE MAY THROW. This is not defensive tidiness — it is the difference
 * between a degraded panel and a blank page.
 *
 * Since the web app runs as "User accessing the web app", the spreadsheet is opened as
 * the VISITOR. Anyone without edit access cannot append a row, so every one of these
 * calls throws for them. Nineteen of them sit inside catch blocks in the render path:
 *
 *     try { h.push(somePanel_()); }
 *     catch (e) { logError_('dashboard', 'somePanel_', e.message); }   // <- throws again
 *
 * A throw from inside the handler escapes the catch and takes the whole page with it. So
 * a panel failing gracefully for the owner became a white screen for a viewer, and the
 * error log — the one place that would have explained it — is exactly what could not be
 * written. Swallowing here is the correct behaviour.
 *
 * The failure is not lost: writability is probed once per execution and reported on the
 * page, so a read-only visitor is told why nothing they do is saving.
 */
var _canWrite = null;

/** Can this visitor write to the workbook at all? Probed once, cheaply. */
function canWrite_() {
  if (_canWrite !== null) return _canWrite;
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    // getEditors() throws for a viewer, and touches no data. Cheaper and safer than
    // writing a probe row and having to remember to remove it.
    ss.getEditors();
    _canWrite = true;
  } catch (e) {
    _canWrite = false;
  }
  return _canWrite;
}

function logRun_(job, system, tab, count, ms, note) {
  try {
    appendTab_(CFG.LOG_TAB, [{ run_at: nowStamp_(), job: job, system: system, tab: tab,
      rows: count, duration_sec: Math.round(ms / 1000), note: note || null }],
      ['run_at', 'job', 'system', 'tab', 'rows', 'duration_sec', 'note']);
  } catch (e) {
    _canWrite = false;
    try { Logger.log('logRun_ could not write: ' + e.message); } catch (e2) {}
  }
}

function logError_(system, context, message) {
  try {
    appendTab_(CFG.ERROR_TAB, [{ run_at: nowStamp_(), system: system, context: context,
      message: String(message).slice(0, 500) }],
      ['run_at', 'system', 'context', 'message']);
  } catch (e) {
    // Remembered rather than swallowed silently, so the page can say so once.
    _canWrite = false;
    try { Logger.log('logError_ could not write: ' + system + '/' + context + ': ' + message); }
    catch (e2) {}
  }
}

/**
 * WHO WE ARE, TO PEOPLE OUTSIDE WELEASE.
 *
 * Frank, 2026-08-24: no personal address appears in anything a landlord or a resident sees.
 * Owners are written to from owners@weleaseusa.com, residents from residents@weleaseusa.com.
 * Personal addresses are for internal work only.
 *
 * There are two good reasons beyond preference. A reply to a personal address sits in one
 * inbox while that person is on leave; a reply to the shared one is seen by whoever is
 * covering. And an owner who has a personal address treats it as a private line, which is
 * how commitments get made outside the record.
 *
 * INTERNAL ATTRIBUTION IS DIFFERENT AND STAYS PERSONAL. The status log records who changed
 * what — "yuliana set this to Vendor" — and replacing that with a shared mailbox would
 * destroy an audit trail to satisfy a rule about external correspondence. The distinction
 * is audience, not address.
 */
// ============================================================ WHO SEES THE PLUMBING
/**
 * ADMIN VISIBILITY.
 *
 * The dashboard carries two kinds of note and they have been mixed together since the
 * start:
 *
 *   INTERPRETATION — "September is still running", "TPO properties are excluded",
 *   "paying early counts as early". These change how a number should be READ. Everyone
 *   needs them. Hiding them would leave the team confidently misreading the page, which
 *   is worse than any amount of clutter.
 *
 *   MAINTENANCE — "run buildRenewalPipeline()", "the Foo tab is empty", "set the script
 *   property NOTICE_TOOL_URL", "this is a code defect". These are instructions to whoever
 *   maintains the thing. To everybody else they are noise that reads as breakage, and
 *   fifteen of them across the page is how a working dashboard comes to look broken.
 *
 * Only the second kind is gated. That distinction is the whole design.
 *
 * WHO COUNTS AS AN ADMIN lives in a script property, not in this file, so the list can
 * change without a deploy: Project Settings -> Script Properties -> DASHBOARD_ADMINS,
 * comma separated. OWNERS is seeded below so the dashboard is never left with nobody
 * able to see its own maintenance notes.
 */
var ADMIN = {
  PROP: 'DASHBOARD_ADMINS',
  // The floor. Anyone here is an admin whether or not the property is set.
  ALWAYS: ['frank@weleaseusa.com'],
  // When the visitor cannot be identified at all, is everybody an admin or nobody?
  // NOBODY, deliberately — the whole point of this is that the team stops seeing
  // maintenance chatter, and a failure that quietly shows it to all fifteen people again
  // would be indistinguishable from not having built this. Admins get a one-line notice
  // instead, so it is never silent.
  FALLBACK_ADMIN: false
};

var _adminCache = null;

/**
 * FORCES A PARTICULAR AUDIENCE'S RENDER, whoever is running.
 *
 *   null     decide from the admin list, which is what a live page load does
 *   'team'   no maintenance notes
 *   'admin'  maintenance notes
 *
 * THIS IS WHY THE GATE DID NOT WORK, ORIGINALLY. The nightly job renders Needs Attention
 * and caches the HTML, and doGet serves that file. The job runs on a trigger, so it runs
 * as the OWNER — which means the cached page was an admin render handed to all fifteen
 * people. No amount of identity fixing could have helped, and changing the deployment's
 * execution mode did not touch it either, because triggers still run as their owner.
 *
 * BOTH audiences are now cached, which is the other half of the same problem. Serving the
 * admin a live render kept the notes correct and made the page slow for the one person who
 * opens it most — so the job renders twice, nightly, and everybody gets a cached page.
 */
var _renderAs = null;

/**
 * Set from the URL, once, at the top of doGet.
 *   null   nothing said — the admin list decides
 *   false  ?maint=0 — hide the notes, so a maintainer can see the team's page
 *
 * IT CAN ONLY EVER SHOW LESS. No value grants the maintenance notes to somebody the admin
 * list does not already include, which is why it needs no secret — and why the team's link
 * never changes. Their URL is the plain one, exactly as it was shared.
 *
 * It exists for verification. Adding ?maint=0 to your own bookmark shows you precisely
 * what your colleagues see, in one second. That is the check that would have caught the
 * cached page serving an admin render on the first round rather than the third.
 */
var _maintOverride = null;

/** Reads ?maint= off the request. Called once, from doGet. */
function applyMaintParam_(e) {
  _maintOverride = null;
  var v = e && e.parameter && e.parameter.maint;
  if (v === undefined || v === null || v === '') return;
  v = String(v).trim().toLowerCase();
  if (v === '0' || v === 'team' || v === 'false') _maintOverride = false;
  // Anything else is ignored. Nothing here can grant access, only remove it.
}

/** The signed-in visitor, or '' when Apps Script will not say. */
function currentUserEmail_() {
  try {
    var e = Session.getActiveUser().getEmail();
    if (e) return String(e).toLowerCase().trim();
  } catch (err) { /* no scope, or an anonymous visitor */ }
  return '';
}

/** Is the person looking at this page one of the maintainers? */
function isAdmin_() {
  // Order matters, and it is: the cache build wins over everything, then the URL, then
  // identity. The cache is served to people who never asked for it, so nothing a single
  // visitor says may change what goes into it.
  if (_renderAs !== null) return _renderAs === 'admin';
  if (_maintOverride !== null) return _maintOverride;
  if (_adminCache !== null) return _adminCache;
  var me = currentUserEmail_();
  if (!me) { _adminCache = ADMIN.FALLBACK_ADMIN; return _adminCache; }

  var list = ADMIN.ALWAYS.slice();
  try {
    var raw = PropertiesService.getScriptProperties().getProperty(ADMIN.PROP) || '';
    raw.split(/[,;\s]+/).forEach(function (x) {
      x = String(x).toLowerCase().trim();
      if (x && list.indexOf(x) === -1) list.push(x);
    });
  } catch (e) { /* properties unavailable — fall back to the floor list */ }

  _adminCache = list.indexOf(me) > -1;
  return _adminCache;
}

/** True when Apps Script would not tell us who is looking. */
function identityUnavailable_() { return currentUserEmail_() === ''; }

/**
 * Run this from the editor. It reports who you are and what you can reach.
 *
 * As of 2026-09-05 the web app is deployed as "User accessing the web app", so the page
 * runs as whoever opened it. That makes identity reliable — and it makes ACCESS the thing
 * that varies, which is what this now checks.
 */
function whoAmI() {
  var me = currentUserEmail_();
  var eff = '';
  try { eff = Session.getEffectiveUser().getEmail() || ''; } catch (e) { eff = '(unavailable)'; }
  var out = [
    'Signed in as (active user) : ' + (me || '(BLANK — identity is not reaching the script)'),
    'Running as (effective user): ' + eff,
    'Treated as an admin        : ' + (isAdmin_() ? 'YES' : 'no'),
    'Can write to the workbook  : ' + (canWrite_() ? 'yes' : 'NO — read only'),
    '',
    'Admin list in force:'
  ];
  var list = ADMIN.ALWAYS.slice();
  try {
    var raw = PropertiesService.getScriptProperties().getProperty(ADMIN.PROP) || '';
    if (raw) out.push('  ' + ADMIN.PROP + ' = ' + raw);
    else out.push('  ' + ADMIN.PROP + ' is not set — only the built-in list applies.');
    raw.split(/[,;\s]+/).forEach(function (x) {
      x = String(x).toLowerCase().trim();
      if (x && list.indexOf(x) === -1) list.push(x);
    });
  } catch (e) { out.push('  (script properties unavailable)'); }
  list.forEach(function (x) { out.push('  ' + x); });
  // BOTH CASES, not just the current one. The setting can be changed back, and a second
  // deployment of the same project can differ from the first — so this reports what it
  // observes rather than restating what somebody intended.
  if (me && eff && me === eff) {
    out.push('', 'Active and effective match, so this deployment runs as the visitor.',
             'That is "User accessing the web app", which is the current setting.',
             'Identity is reliable here; ACCESS is the thing that now varies — run',
             'verifyTeamAccess() to see what a colleague can actually reach.');
  } else if (me && eff) {
    out.push('', 'Active and effective differ, so this deployment runs as its OWNER.',
             'That is "Execute as: Me". The admin gate still works — it reads the active',
             'user, which is you — and the team needs no access to the workbook.');
  }
  Logger.log(out.join('\n'));
  return out.join('\n');
}

/**
 * WHAT THE TEAM CAN ACTUALLY REACH. Run this after changing the deployment or the
 * sharing, and it will tell you what a colleague will experience before they tell you.
 *
 * Under "execute as user" the dashboard opens the workbook, the cache file and the
 * notice feed as the VISITOR. Each one has its own sharing, each fails differently, and
 * two of the three fail quietly:
 *
 *   workbook not shared      -> the page does not render at all. Loud, at least.
 *   workbook view-only       -> the page renders and nothing saves. Silent.
 *   cache file not shared    -> every load becomes a live render. Silent, and slow.
 */
function verifyTeamAccess() {
  var out = ['--- WHAT A VISITOR CAN REACH ---', ''];
  var ok = function (label, fn) {
    try { out.push('OK    ' + label + ' — ' + fn()); return true; }
    catch (e) { out.push('FAIL  ' + label + ' — ' + e.message); return false; }
  };

  ok('The workbook opens', function () {
    return SpreadsheetApp.getActiveSpreadsheet().getName();
  });
  out.push((canWrite_() ? 'OK    ' : 'READ  ') + 'Write access — ' +
    (canWrite_() ? 'yes, statuses and notes will save'
                 : 'NO. The page renders, and nothing anyone types is saved.'));

  // Both copies. The admin one is why the maintainer is not the only person on a slow
  // page, so a missing admin cache is worth reporting rather than shrugging at.
  [[DASH_CACHE_PROP, 'team'], [DASH_CACHE_PROP_ADMIN, 'maintainer']].forEach(function (pair) {
    var id = null;
    try { id = PropertiesService.getScriptProperties().getProperty(pair[0]); } catch (e) {}
    if (!id) {
      out.push('TODO  Cached page (' + pair[1] + ') — not built yet. ' +
               'Run rebuildDashboardCache().');
      return;
    }
    ok('Cached page (' + pair[1] + ') is readable', function () {
      var f = DriveApp.getFileById(id);
      var acc = String(f.getSharingAccess());
      return Math.round(f.getSize() / 1024) + ' KB, shared: ' + acc +
        (acc === 'PRIVATE'
          ? '  <-- PRIVATE. Only you can read it; everyone else silently falls back to a ' +
            'live render, which is slow. Run rebuildDashboardCache() to re-share it.'
          : '');
    });
  });

  out.push('');
  var me = currentUserEmail_(), eff = '';
  try { eff = Session.getEffectiveUser().getEmail() || ''; } catch (e) {}
  if (me && eff && me === eff) {
    out.push('DEPLOYMENT: "User accessing the web app" — the current setting.');
    out.push('  Identity is reliable here, so the admin list is what decides who sees the');
    out.push('  maintenance notes. Everyone needs EDITOR on the workbook to save a status,');
    out.push('  a note, an insurance chase or feedback — which you have already granted.');
  } else {
    out.push('DEPLOYMENT: "Execute as: Me".');
    out.push('  The script reads and writes as its owner, so nobody needs access to the');
    out.push('  workbook. Identity for the admin list usually resolves in-domain; if the');
    out.push('  active user above is blank, it is not resolving here.');
  }
  out.push('');
  out.push('To see exactly what the team sees, add ?maint=0 to your dashboard URL.');
  out.push('Their link is unchanged and needs no parameter.');
  out.push('');
  out.push('Either way: the admin gate hides maintenance notes on the PAGE. It is not a');
  out.push('permission boundary and was never meant to be one.');

  Logger.log(out.join('\n'));
  return out.join('\n');
}

var WELEASE_CONTACT = {
  OWNERS: 'owners@weleaseusa.com',
  RESIDENTS: 'residents@weleaseusa.com',
  GENERAL: 'owners@weleaseusa.com',

  // Any weleaseusa.com address that is not one of the shared boxes is a personal one.
  SHARED: ['owners@weleaseusa.com', 'residents@weleaseusa.com', 'info@weleaseusa.com',
           'maintenance@weleaseusa.com', 'accounting@weleaseusa.com'],
  ANY_WELEASE: /[A-Za-z0-9._%+-]+@weleaseusa\.com/gi
};

/** The address to show a given audience. Defaults to the owners box. */
function weleaseContact_(audience) {
  var a = String(audience || '').toLowerCase();
  if (a.indexOf('resident') !== -1 || a.indexOf('tenant') !== -1) {
    return WELEASE_CONTACT.RESIDENTS;
  }
  return WELEASE_CONTACT.OWNERS;
}

function isSharedMailbox_(email) {
  var e = String(email || '').trim().toLowerCase();
  if (!e) return false;
  for (var i = 0; i < WELEASE_CONTACT.SHARED.length; i++) {
    if (WELEASE_CONTACT.SHARED[i] === e) return true;
  }
  return false;
}

/**
 * Replaces any personal WeLease address in outward-facing text with the shared mailbox.
 *
 * Enforced in code rather than left as a convention, because a convention survives exactly
 * as long as the person who remembers it. Anything written into an owner pack, an owner
 * report or a resident reminder passes through here.
 *
 * Returns the text and a count, so the caller can say what it changed rather than silently
 * rewriting somebody's contact details.
 */
function scrubPersonalEmails_(text, audience) {
  var shared = weleaseContact_(audience);
  var n = 0;
  var out = String(text === null || text === undefined ? '' : text)
    .replace(WELEASE_CONTACT.ANY_WELEASE, function (m) {
      if (isSharedMailbox_(m)) return m;
      n++;
      return shared;
    });
  return { text: out, replaced: n, shared: shared };
}

function nowStamp_() { return Utilities.formatDate(new Date(), CFG.TZ, 'yyyy-MM-dd HH:mm:ss'); }

// ============================================================ REGISTRY

var _registryCache = null;

function loadRegistry_() {
  if (_registryCache) return _registryCache;
  var r = JSON.parse(DriveApp.getFileById(prop_('REGISTRY_FILE_ID')).getBlob().getDataAsString());
  if (!Array.isArray(r.metrics)) {
    throw new Error('REGISTRY_FILE_ID points at the wrong file — no metrics array. ' +
                    'Top keys: ' + Object.keys(r).slice(0, 8).join(', '));
  }
