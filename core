}

function monthKey_(d) {
  d = parseDate_(d);
  return d ? Utilities.formatDate(d, CFG.TZ, 'yyyy-MM') : null;
}

/**
 * A month cell, back to 'yyyy-MM', whatever the sheet handed us.
 *
 * monthKey_ writes the string '2026-08'. Sheets sees a date-like string and stores a real
 * date, so readTab_ can hand back a Date object instead — and Date(2026-08-01 00:00 UTC)
 * read in America/Los_Angeles is July 31st at 5pm. Anything that then asked the Date which
 * month it was got JULY for an AUGUST row. That is how $315,152 of August money came to sit
 * under a "July 2026 · last complete month" label on the rent tile.
 *
 * Every read of a month column goes through here. Strings pass straight through, so this is
 * free when Sheets behaves.
 */
function monthNorm_(v) {
  if (v === null || v === undefined || v === '') return '';
  if (typeof v === 'string') {
    var m = v.match(/^(\d{4})-(\d{2})/);
    if (m) return m[1] + '-' + m[2];
  }
  if (Object.prototype.toString.call(v) === '[object Date]' && !isNaN(v.getTime())) {
    // The Date's OWN calendar fields, not a re-format through a timezone. Apps Script builds
    // a Date from a sheet cell in the script's timezone already, so getFullYear/getMonth are
    // the month the sheet displays. Re-formatting through CFG.TZ would apply a second offset
    // to a value that had already been converted once, which is the shift, not the fix.
    return v.getFullYear() + '-' + ('0' + (v.getMonth() + 1)).slice(-2);
  }
  return monthKey_(v) || String(v);
}

function num_(v) {
  if (v === null || v === undefined || v === '') return null;
  var n = parseFloat(String(v).replace(/[$,]/g, ''));
  return isNaN(n) ? null : n;
}

function median_(arr) {
  var a = arr.filter(function (x) { return x !== null && x !== undefined && !isNaN(x); })
             .sort(function (x, y) { return x - y; });
  if (!a.length) return null;
  var m = Math.floor(a.length / 2);
  return a.length % 2 ? a[m] : (a[m - 1] + a[m]) / 2;
}

function p90_(arr) {
  var a = arr.filter(function (x) { return x !== null && x !== undefined && !isNaN(x); })
             .sort(function (x, y) { return x - y; });
  return a.length ? a[Math.min(a.length - 1, Math.floor(a.length * 0.9))] : null;
}

/**
 * Direction-aware benchmark comparison.
 * Five metrics are INVERTED — the three renewal lead times, resolved-without-dispatch,
 * and units-per-team-member are better when HIGHER. Hardcoding the operator reports
 * the business backwards. Always read direction from the registry.
 */
function vsBenchmark_(value, benchmark, direction) {
  if (value === null || !benchmark) return null;
  var med = benchmark.median, top = benchmark.top_25_pct;
  if (direction === 'higher_is_better') {
    if (value >= top) return 'top_quartile';
    if (value >= med) return 'at_benchmark';
    return 'below_benchmark';
  }
  if (value <= top) return 'top_quartile';
  if (value <= med) return 'at_benchmark';
  return 'below_benchmark';
}

function groupBy_(rows, keyFn) {
  var out = {};
  rows.forEach(function (r) {
    var k = keyFn(r);
    if (k === null || k === undefined) return;
    (out[k] = out[k] || []).push(r);
  });
  return out;
}

function indexBy_(rows, key) {
  var out = {};
  rows.forEach(function (r) { if (r[key] !== undefined && r[key] !== null) out[r[key]] = r; });
  return out;
}

// ============================================================ DEPOSIT COMPLIANCE

/**
 * Security deposit disposition clock. AppFolio only — no workflow system needed.
 *
 * START: tenant_tickler.move_out_date, keyed on occupancy_id
 * STOP:  earliest general_ledger post_date of a DEBIT to a management-held deposit
 *        liability for that occupancy, on or after move-out
 *
 * Owner-held deposits are flagged CANNOT_MEASURE — those funds never touch WeLease's
 * trust account, so the disposition may never post here. Never counted compliant,
 * never counted late.
 *
 * CALIFORNIA: Civil Code 1950.5 governs. CFG.DEPOSIT_DISPOSITION_DAYS is WeLease's
 * stated standard, not a legal determination. This REPORTS. It must never trigger a
 * notice, a fee, or any resident communication.
 */
function buildDepositCompliance(fromDate, toDate) {
  var t0 = new Date().getTime();
  fromDate = fromDate || ymd_(addDays_(today_(), -400));
  toDate = toDate || ymd_(today_());

  var ticklers = afReport_('tenant_tickler', { occurred_on_from: fromDate, occurred_on_to: toDate });
  Utilities.sleep(SYSTEMS.appfolio.sleepMs);

  var moveOuts = getMoveOuts_(ticklers);   // shared matcher — defined in Inspections.gs

  var allGl = DEPOSIT_GL.MGMT_HELD.concat(DEPOSIT_GL.OWNER_HELD, DEPOSIT_GL.FORFEIT,
                                          DEPOSIT_GL.OWNER_REFUNDED, DEPOSIT_GL.DEPOSIT_CASH);
  var gl = afReport_('general_ledger', {
    posted_on_from: fromDate,
    posted_on_to: ymd_(addDays_(today_(), 1)),
    gl_account_ids: allGl
  });

  // party_type === 'Occupancy' means party_id === occupancy_id
  var byOcc = {};
  gl.forEach(function (e) {
    if (String(e.party_type || '') !== 'Occupancy') return;
    if (e.party_id === null || e.party_id === undefined) return;
    (byOcc[e.party_id] = byOcc[e.party_id] || []).push(e);
  });

  var threshold = CFG.DEPOSIT_DISPOSITION_DAYS;
  var out = moveOuts.map(function (mo) {
    var moveOut = ymd_(mo.move_out_date);
    var entries = (byOcc[mo.occupancy_id] || []).filter(function (e) {
      var pd = ymd_(e.post_date);
      return pd && moveOut && pd >= moveOut;
    });
    var ownerHeld = entries.some(function (e) { return DEPOSIT_GL.OWNER_HELD.indexOf(e.account_id) !== -1; });
    var disp = entries.filter(function (e) {
      return DEPOSIT_GL.MGMT_HELD.indexOf(e.account_id) !== -1 && num_(e.debit) > 0;
    }).sort(function (a, b) { return ymd_(a.post_date) < ymd_(b.post_date) ? -1 : 1; });

    var dispDate = disp.length ? ymd_(disp[0].post_date) : null;
    var elapsed = daysBetween_(moveOut, dispDate || ymd_(today_()));
    var held = num_(mo.deposit);

    // A resident with no deposit on file and no deposit-account activity is outside
    // the metric entirely. Counting them as compliant would inflate the rate;
    // counting them as late would be wrong. They get their own bucket.
    var noDeposit = (!held || held === 0) && entries.length === 0;

    var status = noDeposit ? 'NO_DEPOSIT_HELD'
      : (ownerHeld && !disp.length) ? 'CANNOT_MEASURE_OWNER_HELD'
      : dispDate ? (elapsed <= threshold ? 'WITHIN_THRESHOLD' : 'EXCEEDED_THRESHOLD')
      : (elapsed <= threshold ? 'OPEN_WITHIN_THRESHOLD' : 'OPEN_EXCEEDED_THRESHOLD');

    function sumWhere(ids, field) {
      return entries.filter(function (e) { return ids.indexOf(e.account_id) !== -1; })
                    .reduce(function (s, e) { return s + (num_(e[field]) || 0); }, 0);
    }

    return {
      occupancy_id: mo.occupancy_id, tenant: mo.tenant || null,
      property_id: mo.property_id || null, property_name: mo.property_name || null,
      property_street: mo.property_street || null, property_street2: mo.property_street2 || null,
      unit: mo.unit || null, tenant_id: mo.tenant_id || null,
      unit_id: mo.unit_id || null, move_out_date: moveOut,
      move_out_reason: mo.move_out_reason || null,
      deposit_on_file: num_(mo.deposit), disposition_date: dispDate,
      days_elapsed: elapsed, threshold_days: threshold, status: status,
      owner_held: ownerHeld || null,
      amount_disposed: disp.length ? num_(disp[0].debit) : null,
      disposition_account: disp.length ? disp[0].account_name : null,
      disposition_txn_type: disp.length ? disp[0].type : null,
      disposition_entries: disp.length,
      amount_forfeited: sumWhere(DEPOSIT_GL.FORFEIT, 'credit') || null,
      owner_refunded: sumWhere(DEPOSIT_GL.OWNER_REFUNDED, 'credit') || null,
      gl_entries_found: entries.length,
      review_required: (status === 'EXCEEDED_THRESHOLD' || status === 'OPEN_EXCEEDED_THRESHOLD' ||
                        status === 'CANNOT_MEASURE_OWNER_HELD') ? 'YES' : null
    };
  }).sort(function (a, b) { return (b.days_elapsed || 0) - (a.days_elapsed || 0); });

  var n = writeTab_('Deposit_Compliance', out);
  logRun_('buildDepositCompliance', 'appfolio', 'Deposit_Compliance', n,
          new Date().getTime() - t0,
          'threshold=' + threshold + 'd · move-outs=' + moveOuts.length + ' · GL rows=' + gl.length);

  function countBy(s) { return out.filter(function (r) { return r.status === s; }).length; }
  var measured = out.filter(function (r) {
    return r.status === 'WITHIN_THRESHOLD' || r.status === 'EXCEEDED_THRESHOLD';
  });
  var days = measured.map(function (r) { return r.days_elapsed; });

  var summary = {
    run_date: nowStamp_(),
    metric: 'moveout_deposit_disposition',
    period: fromDate + ' to ' + toDate,
    threshold_days: threshold,
    move_outs_total: out.length,
    measured_n: measured.length,
    within_threshold: countBy('WITHIN_THRESHOLD'),
    exceeded_threshold: countBy('EXCEEDED_THRESHOLD'),
    still_open_within: countBy('OPEN_WITHIN_THRESHOLD'),
    still_open_exceeded: countBy('OPEN_EXCEEDED_THRESHOLD'),
    no_deposit_held: countBy('NO_DEPOSIT_HELD'),
    cannot_measure_owner_held: countBy('CANNOT_MEASURE_OWNER_HELD'),
    compliance_rate_pct: measured.length
      ? Math.round(countBy('WITHIN_THRESHOLD') / measured.length * 100) : null,
    median_days: median_(days),
    p90_days: p90_(days),
    publishable: measured.length >= CFG.MIN_N_TO_PUBLISH
      ? 'YES' : 'NO — n below ' + CFG.MIN_N_TO_PUBLISH
  };
  appendTab_('Metrics_History', [summary]);

  var breaches = out.filter(function (r) { return r.review_required === 'YES'; }).length;
  if (breaches) {
    logError_('compliance', 'deposit_disposition', breaches +
      ' move-outs need review (past threshold, or owner-held and unmeasurable). ' +
      'REPORTING ONLY — escalate to a human. Never auto-notify a resident or assess a fee from this.');
  }
  Logger.log(JSON.stringify(summary, null, 1));
  return summary;
}

