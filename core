// ============================================================ APPFOLIO ADAPTER

/**
 * POST an AppFolio report. Trust the SLUG, never the AppFolio UI title —
 * they frequently disagree.
 */
/**
 * AppFolio returns next_page_url as a PATH, not an absolute URL. Passing it
 * straight to UrlFetchApp produces "http:///api/v2/..." — empty host, bad request.
 * Any report large enough to paginate hits this.
 */
function afOrigin_() {
  var m = String(SYSTEMS.appfolio.base).match(/^(https?:\/\/[^\/]+)/);
  return m ? m[1] : 'https://welease.appfolio.com';
}

function afAbsUrl_(u, basePath) {
  if (!u) return null;
  u = String(u).trim();
  if (/^https?:\/\/[^\/]/.test(u)) return u;              // already absolute with a host
  u = u.replace(/^https?:\/\/+/, '/');                     // "http:///path" -> "/path"
  if (u.indexOf('//') === 0) return 'https:' + u;           // protocol-relative

  // QUERY-ONLY next_page_url — "?metadata_id=bill_detail_...&page=1" with no path at all.
  // Some reports return it this way, and pasting it onto the origin gave
  // "https://host/?metadata_id=..." — the account root, not the report, hence a 404 and
  // zero vendor bills every night. The path has to come from the report we asked for.
  if (u.charAt(0) === '?') {
    if (!basePath) return null;                             // no path to hang it on
    return (/^https?:\/\//.test(basePath) ? basePath : afOrigin_() + basePath) + u;
  }

  return afOrigin_() + (u.charAt(0) === '/' ? u : '/' + u);
}

/**
 * The query half of a URL, as an object. Used to carry pagination params from a
 * next_page_url into a POST body.
 */
function afQueryParams_(url) {
  var q = String(url || '');
  var i = q.indexOf('?');
  if (i === -1) return {};
  var out = {};
  q.slice(i + 1).split('&').forEach(function (pair) {
    if (!pair) return;
    var eq = pair.indexOf('=');
    var k = decodeURIComponent(eq === -1 ? pair : pair.slice(0, eq)).replace(/\+/g, ' ');
    var v = eq === -1 ? '' : decodeURIComponent(pair.slice(eq + 1).replace(/\+/g, ' '));
    if (k) out[k] = v;
  });
  return out;
}

function afReport_(slug, body, opts) {
  opts = opts || {};
  var maxPages = opts.maxPages || 50;
  var payload = body || {};
  if (opts.paginate === false) payload.paginate_results = false;

  var maxRows = opts.maxRows || 60000;
  var reportUrl = SYSTEMS.appfolio.base + '/' + slug + '.json';
  var rows = [], page = 0, next = null;
  // If the POST fallback below is ignored by the server it will hand back page 1 again,
  // with the same next_page_url — and this loop would happily re-fetch it until maxPages,
  // producing 20 copies of the same 5,000 rows. A repeated URL means no progress, so stop.
  var seenNext = {};
  while (page < maxPages) {
    var resp;
    if (page === 0) {
      resp = afCall_('post', reportUrl, payload);          // page 1 failing is a real failure
    } else {
      // A later page failing should cost that page, not the whole report. bill_detail
      // returned page 1 fine and 404'd on page 2, and the throw discarded everything —
      // so a pagination bug looked exactly like "this account has no vendor bills".
      try {
        resp = afCall_('get', next, null);
      } catch (eGet) {
        // A GET on a report route returns 404. These endpoints are POST-only, and
        // bill_detail is simply the first report big enough to ever ask for a second page
        // — so this path had never actually run. The pagination params live in the
        // next_page_url's query string; carry them into a POST body instead.
        var retryPayload = null;
        try {
          retryPayload = afQueryParams_(next);
          Object.keys(payload).forEach(function (k) {
            if (!(k in retryPayload)) retryPayload[k] = payload[k];
          });
          resp = afCall_('post', reportUrl, retryPayload);
          if (page === 1) {
            logRun_('afReport_', 'appfolio', slug, 0, 0,
              'Pagination fell back to POST — GET on the report route returns 404. ' +
              'Expected, not a fault.');
          }
        } catch (ePost) {
          logError_('appfolio', slug,
            'Page ' + (page + 1) + ' failed as a GET (' + eGet.message.split('\n')[0] + ') ' +
            'and as a POST (' + ePost.message.split('\n')[0] + '). Keeping the ' +
            rows.length + ' row(s) already fetched — treat this report as INCOMPLETE. ' +
            'Params tried: ' + JSON.stringify(retryPayload || afQueryParams_(next)));
          break;
        }
      }
    }

    var data = resp.parsed;
    rows = rows.concat(data.results || (Array.isArray(data) ? data : []));
    // reportUrl is passed so a query-only next_page_url has a path to attach to.
    next = afAbsUrl_(data.next_page_url, reportUrl);
    if (!next) break;
    if (seenNext[next]) {
      logError_('appfolio', slug,
        'Pagination stopped making progress — the server returned the same next page twice ' +
        '(' + next + '). Kept ' + rows.length + ' row(s); this report is INCOMPLETE. Narrow ' +
        'the date range so it fits in one page.');
      break;
    }
    seenNext[next] = 1;
    if (rows.length >= maxRows) {
      logError_('appfolio', slug, 'Stopped at maxRows (' + maxRows + '). Narrow the date range or add filters.');
      break;
    }
    page++;
    Utilities.sleep(SYSTEMS.appfolio.sleepMs);
  }
  if (page >= maxPages) logError_('appfolio', slug, 'Hit maxPages — data may be truncated.');
  return rows;
}


/**
 * A date-ranged report pulled in windows, so pagination never has to work.
 *
 * bill_detail over a 400-day lookback is well past the 5,000-row page limit, and paging it
 * depends on the server accepting a second request the way we send it. Splitting the range
 * up front does not — each window is its own page-one POST, which is the request shape that
 * has always worked.
 *
 * A window that comes back at the row cap is split in half and retried, because a full page
 * means the window was too wide and rows were silently dropped off the end.
 *
 *   slug     report name
 *   body     the usual filters, WITHOUT the two date keys
 *   fromKey  e.g. 'occurred_on_from'      toKey  e.g. 'occurred_on_to'
 *   from,to  'yyyy-MM-dd'
 */
function afReportWindowed_(slug, body, fromKey, toKey, from, to, opts) {
  opts = opts || {};
  var windowDays = opts.windowDays || 90;
  var pageCap = opts.pageCap || 5000;
  var minDays = 2;                       // below this, splitting cannot help
  var out = [], windows = 0;

  function pull(a, b, depth) {
    var payload = {};
    Object.keys(body || {}).forEach(function (k) { payload[k] = body[k]; });
    payload[fromKey] = a;
    payload[toKey] = b;

    var rows = afReport_(slug, payload, { maxPages: opts.maxPages || 3,
                                          maxRows: opts.maxRows || 60000 });
    windows++;

    var span = daysBetween_(a, b);
    if (rows.length >= pageCap && span !== null && span > minDays && depth < 6) {
      // The window filled a page exactly. Assume it was truncated and halve it.
      var mid = ymd_(addDays_(parseDate_(a), Math.floor(span / 2)));
      // rows from this attempt are dropped, not merged — the two halves re-fetch them.
      pull(a, mid, depth + 1);
      pull(ymd_(addDays_(parseDate_(mid), 1)), b, depth + 1);
      return;
    }
    out = out.concat(rows);
    sleepFor_('appfolio');
  }

  var cur = parseDate_(from), stop = parseDate_(to);
  if (!cur || !stop) {
    logError_('appfolio', slug, 'Unreadable window ' + from + '..' + to + ' — pulling ' +
              'the whole range in one call instead.');
    var p = {}; Object.keys(body || {}).forEach(function (k) { p[k] = body[k]; });
    p[fromKey] = from; p[toKey] = to;
    return afReport_(slug, p, opts);
  }

  var guard = 0;
  while (cur.getTime() <= stop.getTime() && guard++ < 40) {
    var end = addDays_(cur, windowDays - 1);
    if (end.getTime() > stop.getTime()) end = stop;
    pull(ymd_(cur), ymd_(end), 0);
    cur = addDays_(end, 1);
  }

  logRun_('afReportWindowed_', 'appfolio', slug, out.length, 0,
          from + ' to ' + to + ' in ' + windows + ' window(s) of ' + windowDays + ' days');
  return out;
}

function afCall_(method, url, payload) {
  var auth = 'Basic ' + Utilities.base64Encode(
    prop_('APPFOLIO_CLIENT_ID') + ':' + prop_('APPFOLIO_CLIENT_SECRET'));
  var options = {
    method: method,
    headers: { 'Authorization': auth, 'Accept': 'application/json' },
    muteHttpExceptions: true
  };
  // AppFolio returns HTTP 406 without this. Do not remove.
  if (method === 'post') {
    options.contentType = 'application/json';
    options.payload = JSON.stringify(payload || {});
  }
  return httpWithRetry_(url, options, 'appfolio');
}

