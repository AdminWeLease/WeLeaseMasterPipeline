}

var LS_OUT_OF_SCOPE = ['/properties', '/units', '/property_groups', '/contacts',
  '/conversations', '/text_messages', '/calls', '/notes', '/uploaded_files',
  '/webhook_subscriptions', '/accounts'];

function lsAssertInScope_(path) {
  LS_OUT_OF_SCOPE.forEach(function (p) {
